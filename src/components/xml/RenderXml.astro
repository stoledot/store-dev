---
// src/components/RenderXml.astro
import type { NodoXML } from "../../features/xml/xmlParser";

interface Props {
  nodo: NodoXML;
}

const { nodo } = Astro.props;
---

{
  nodo.tipo === "texto" ? (
    nodo.valor
  ) : nodo.etiqueta === "math-theorem" ? (
    /* 1. Ejemplo: Envolver en múltiples divs, leer atributo 'title' y agregar clases */
    <div class="my-6 rounded-lg border-l-4 border-indigo-600 bg-indigo-50 p-4 shadow-sm">
      <div class="mb-2 font-bold text-indigo-900">
        Teorema{nodo.atributos.title ? `: ${nodo.atributos.title}` : ""}
      </div>
      <div class="prose text-gray-800">
        {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
      </div>
    </div>
  ) : nodo.etiqueta === "caja" ? (
    /* 2. Ejemplo: Mapear un atributo XML (color="rojo") a clases dinámicas */
    <div
      class:list={[
        "rounded p-3 border",
        nodo.atributos.color === "rojo" && "bg-red-100 border-red-400 text-red-900",
        nodo.atributos.color === "azul" && "bg-blue-100 border-blue-400 text-blue-900",
      ]}
    >
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
    </div>
  ) : nodo.etiqueta === "negrita" ? (
    /* 3. Ejemplo: Cambiar etiqueta XML por etiqueta HTML con clases */
    <strong class="font-semibold text-black">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
    </strong>
  ) : (
    /* 4. Fallback por defecto para cualquier etiqueta desconocida o sin formato especial */
    (() => {
      const Tag = nodo.etiqueta as any;
      return (
        <Tag {...nodo.atributos}>
          {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
        </Tag>
      );
    })()
  )
}