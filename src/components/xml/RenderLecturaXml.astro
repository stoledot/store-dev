---
//src/components/xml/RenderLecturaXml.astro
import type { NodoXML } from "../../features/xml/xmlParser";

interface Props {
  nodo: NodoXML;
  planId?: number;
  completedTopicIds?: string[];
}

const { nodo, planId, completedTopicIds = [] } = Astro.props;
const esElemento = nodo.tipo === "elemento";
const etiqueta = esElemento ? nodo.etiqueta : "";
const titulo = esElemento 
  ? nodo.atributos["data-title"] ?? nodo.atributos.title ?? ""
  : "";
const numeroTema = esElemento
  ? nodo.atributos.id?.match(/^tema-(\d{3})$/)?.[1]
  : undefined;
const nivel = esElemento && nodo.atributos["data-difficulty"]
  ? nodo.atributos["data-difficulty"].toLowerCase()
  : "";
const numeroEjercicio = esElemento
  ? nodo.atributos.id?.match(/-ej-(\d+)$/)?.[1]
  : undefined;
---

{!esElemento ? (
  nodo.valor
) : etiqueta === "lectura" ? (
  <article class="render-lectura-content mx-auto w-full max-w-none space-y-2 rounded-lg bg-[#f4f1e8] text-black">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </article>
) : etiqueta === "meta" ? (
  <div class="sr-only text-black meta bloc-omitir" aria-hidden="true">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>
) : etiqueta === "title" ? (
  <span class="bloc-omitir">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</span>
) : etiqueta === "summary" ? (
  <p class="mt-2 max-w-3xl text-base leading-7 text-black sm:text-lg bloc-omitir">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </p>
) 

: etiqueta === "chapter" ? (
  <div id={nodo.atributos.id} class="in-one-page fb-chapter-block scroll-mt-32">
    {titulo && (
      <header class="fb-structural-heading mx-auto max-w-2xl px-4 py-12 text-center text-stone-900 sm:py-16">
        {/* Etiqueta superior estilo libro */}
        <p class="font-serif text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">
          Capítulo
        </p>

        {/* Ornamento divisorio sutil */}
        <div class="my-4 flex items-center justify-center gap-3 text-stone-300" aria-hidden="true">
          <span class="h-px w-10 bg-current"></span>
          <span class="text-[10px]">❖</span>
          <span class="h-px w-10 bg-current"></span>
        </div>

        {/* Título principal */}
        <h2
          id={nodo.atributos.id ? `${nodo.atributos.id}-heading` : undefined}
          class="font-serif text-3xl font-normal leading-tight tracking-tight text-stone-950 sm:text-4xl"
        >
          {titulo}
        </h2>
      </header>
    )}
  </div>


  <div>
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>
  
)
: etiqueta === "section" ? (
  <div
    id={nodo.atributos.id}
    aria-labelledby={nodo.atributos.id ? `${nodo.atributos.id}-heading` : undefined}
    class="fb-section-block scroll-mt-32 in-one-page"
  >
    {titulo && (
      <header class="fb-structural-heading mx-auto max-w-2xl px-4 pt-8 pb-4 text-center text-stone-900 sm:pt-10">
        {/* Etiqueta superior discreta */}
        <p class="font-serif text-[11px] font-medium uppercase tracking-[0.25em] text-stone-400">
          Sección
        </p>

        {/* Título de sección (en cursiva clásica, sin ornamento pesado) */}
        <h2
          id={nodo.atributos.id ? `${nodo.atributos.id}-heading` : undefined}
          class="mt-1.5 font-serif text-xl font-normal italic tracking-normal text-stone-800 sm:text-2xl"
        >
          {titulo}
        </h2>

        {/* Pequeña línea de cierre minimalista */}
        <div class="mx-auto mt-3 h-px w-8 bg-stone-200" aria-hidden="true"></div>
      </header>
    )}
  </div>


  <div class="hijos-section p-2 sm:p-3">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>

) : etiqueta === "sub-section" ? (

  <div id={nodo.atributos.id} class="scroll-mt-32 scroll-mt-6 in-one-page">
    <header class="mb-2 flex items-start gap-2 border-b border-white/10 pb-2">
      {numeroTema && (
        <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-cyan-300/10 text-xs font-extrabold tabular-nums text-black ring-1 ring-cyan-300/20" aria-label={`Tema ${Number(numeroTema)}`}>
          {Number(numeroTema)}
        </span>
      )}
      <div class="min-w-0 flex-1">
        <p class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-black">Tema{numeroTema ? ` ${Number(numeroTema)}` : ""}</p>
        {titulo && <h3 class="mt-0.5 text-lg font-bold leading-snug text-black sm:text-xl">{titulo}</h3>}
      </div>
      {planId && nodo.atributos.id && <button type="button" data-plan-topic={nodo.atributos.id} data-plan-id={planId} disabled={completedTopicIds.includes(nodo.atributos.id)} class="shrink-0 rounded-lg border border-amber-700 px-3 py-2 text-xs font-bold text-amber-900">{completedTopicIds.includes(nodo.atributos.id) ? 'TEMA COMPLETADO ✓' : 'TEMA COMPLETADO'}</button>}
    </header>
    <div class="hijos-sub-seccion">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
    </div>
  </div>

  

) : etiqueta === "sub-sub-section" ? (

  <div id={nodo.atributos.id} class="scroll-mt-32">
    {titulo && <h5 class="flex items-center gap-2 text-base font-semibold text-black"><span class="h-4 w-0.5 rounded-full bg-cyan-400" aria-hidden="true"></span>{titulo}</h5>}
    {planId && nodo.atributos.id && <button type="button" data-plan-topic={nodo.atributos.id} data-plan-id={planId} disabled={completedTopicIds.includes(nodo.atributos.id)} class="my-2 rounded-lg border border-amber-700 px-3 py-2 text-xs font-bold text-amber-900">{completedTopicIds.includes(nodo.atributos.id) ? 'TEMA COMPLETADO ✓' : 'TEMA COMPLETADO'}</button>}
    <div class="hijos-sub-sub-seccion">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
    </div>
  </div>
  

) : etiqueta === "sub-sub-sub-section" ? (

  <div id={nodo.atributos.id} class="scroll-mt-32">
    {titulo && <h5 class="flex items-center gap-2 text-sm font-medium text-black"><span class="h-3.5 w-0.5 rounded-full bg-cyan-400/70" aria-hidden="true"></span>{titulo}</h5>}
    {planId && nodo.atributos.id && <button type="button" data-plan-topic={nodo.atributos.id} data-plan-id={planId} disabled={completedTopicIds.includes(nodo.atributos.id)} class="my-2 rounded-lg border border-amber-700 px-3 py-2 text-xs font-bold text-amber-900">{completedTopicIds.includes(nodo.atributos.id) ? 'TEMA COMPLETADO ✓' : 'TEMA COMPLETADO'}</button>}
    <div class="hijos-sub-sub-sub-seccion">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </div>

  

) : 
etiqueta === "p" ? (

  <p class="scroll-mt-32 text-[0.96rem] leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</p>

) : etiqueta === "ul" ? (

  <ul class="scroll-mt-32 my-2 space-y-1 pl-5 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</ul>

) : etiqueta === "li" ? (

  <li class="pl-0.5 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</li>

) : etiqueta === "math-definition" ? (

  <aside class="scroll-mt-32 math-definition rounded-lg border border-emerald-300/15 p-2.5" aria-label={titulo || "Definición"}>
    <div class="mb-1.5 flex items-center gap-2 text-sm font-bold text-black"><span class="grid size-6 place-items-center rounded-md bg-emerald-300/10 text-black" aria-hidden="true">✓</span>{titulo || "Definición"}</div>
    <div class="space-y-2 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </aside>

) : etiqueta === "math-remark" ? (

  <aside class="scroll-mt-32 math-remark rounded-lg border border-amber-300/15 bg-amber-200/[0.055] p-2.5" aria-label={titulo || "Observación"}>
    <p class="mb-1.5 text-sm font-bold text-black">{titulo || "Para tener en cuenta"}</p>
    <div class="space-y-2 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </aside>

) : etiqueta === "math-formula" ? (

  <figure class="scroll-mt-32 math-formula my-2 overflow-x-auto rounded-lg border border-violet-300/15 bg-violet-300/[0.055] px-2.5 py-2 text-center">
    {titulo && <figcaption class="mb-1.5 text-[0.65rem] font-bold uppercase tracking-wider text-black">{titulo}</figcaption>}
    <div class="min-w-max font-mono text-base leading-7 text-black sm:text-lg" role="math" aria-label={titulo || "Fórmula matemática"}>
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
    </div>
  </figure>

) : etiqueta === "math-example" ? (

  <div id={nodo.atributos.id} class="scroll-mt-32 math-example overflow-hidden rounded-lg border border-sky-300/15">
    <header class="flex items-center gap-2 border-b border-sky-300/10 bg-sky-300/[0.04] px-2.5 py-2">
      <span class="grid size-6 place-items-center rounded-md bg-sky-300/10 text-xs font-bold text-black" aria-hidden="true">✓</span>
      <h5 class="text-sm font-bold text-black">{titulo || "Ejemplo resuelto"}</h5>
    </header>
    <div class="space-y-2 p-2.5 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </div>

) : etiqueta === "math-examples" ? (

  <div class="scroll-mt-32 space-y-2 math-examples" aria-label={titulo || "Ejemplos"}>
    {titulo && <h5 class="text-sm font-bold text-black">{titulo}</h5>}
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>

) : etiqueta === "math-exercises" ? (

  <section class="scroll-mt-32 space-y-2 math-exercises" aria-label={titulo || "Ejercicios"}>
    <h5 class="flex items-center gap-2 text-sm font-bold text-black"><span class="grid size-6 place-items-center rounded-md bg-orange-300/10 text-black" aria-hidden="true">✎</span>{titulo || "Practica lo aprendido"}</h5>
    <ol class="space-y-2">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</ol>
  </section>

) : etiqueta === "math-exercise" ? (

  <li id={nodo.atributos.id} class="scroll-mt-32 rounded-lg border border-orange-300/15 p-2.5 math-exercise">
    <div class="mb-2 flex flex-wrap items-center gap-2">
      <span class="text-[0.65rem] font-bold uppercase tracking-wider text-orange-200">Ejercicio{numeroEjercicio ? ` ${numeroEjercicio}` : ""}</span>
      {nivel && <span class="rounded-full bg-orange-200/10 px-2 py-0.5 text-[0.65rem] font-semibold text-orange-100 ring-1 ring-orange-200/15">{nivel === "basic" ? "Básico" : nivel === "intermediate" ? "Intermedio" : nivel === "advanced" ? "Avanzado" : nivel}</span>}
    </div>
    <div class="space-y-2 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </li>

) : etiqueta === "math-solutions" ? (

  <div class="scroll-mt-32 space-y-2 math-solutions" aria-label={titulo || "Soluciones"}>
    <h5 class="text-sm font-bold text-black">{titulo || "Soluciones"}</h5>
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>

) : etiqueta === "math-solution" ? (

  <details class="scroll-mt-32 math-solution group rounded-lg border border-white/10 open:border-cyan-300/20 ">
    <summary class="flex min-h-10 cursor-pointer list-none items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold text-cyan-100 marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400">
      <span>Ver solución</span><span class="text-sm text-cyan-300 transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="space-y-2 border-t border-white/10 px-3 py-2.5 leading-7 text-black">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}</div>
  </details>

) : etiqueta === "table" ? (

  <div class="scroll-mt-32 my-3 overflow-x-auto rounded-lg border border-white/10 shadow-sm">
    <table class="w-full border-collapse text-left text-sm text-black">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
    </table>
  </div>

) : etiqueta === "thead" ? (

  <thead class="border-b border-white/10 text-xs font-bold uppercase tracking-wider text-black">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </thead>

) : etiqueta === "tbody" ? (
  <tbody class="divide-y divide-white/[0.06] text-black">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </tbody>
) : etiqueta === "tr" ? (
  <tr class="transition-colors hover:bg-white/[0.035]">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </tr>
) : etiqueta === "th" ? (
  <th scope="col" class="whitespace-nowrap px-2.5 py-2 font-bold">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </th>
) : etiqueta === "td" ? (
  <td class="px-2.5 py-2 leading-relaxed">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </td>
 
): etiqueta === "math-figure" ? (
  <figure
    id={nodo.atributos.id}
    class="scroll-mt-32 math-figure my-3 rounded-lg border border-sky-300/15 bg-sky-300/[0.035] p-2.5 shadow-sm text-black"
  >
    {titulo && (
      <figcaption class="mb-2 text-center text-[0.65rem] font-bold uppercase tracking-wider text-black">
        {titulo}
      </figcaption>
    )}
    <div class="flex min-h-24 w-full items-center justify-center overflow-x-auto rounded-lg border border-white/[0.06] bg-black/10 p-2 text-black [&_svg]:h-auto [&_svg]:max-w-full">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
    </div>
  </figure>
): ["svg", "g", "path", "polygon", "polyline", "rect", "circle", "ellipse", "line", "text", "tspan", "defs", "marker", "use"].includes(etiqueta) ? (
  (() => {
    const Tag = etiqueta as any;
    return (
      <Tag {...nodo.atributos}>
        {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
      </Tag>
    );
  })()


) : (
  <div class="scroll-mt-32 rounded-md border border-dashed border-white/15 px-2.5 py-2">
    <span class="sr-only">Contenido: </span>
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} planId={planId} completedTopicIds={completedTopicIds} />)}
  </div>
)

}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-plan-topic]').forEach(button => {
    button.addEventListener('click', async () => {
      const planId = button.dataset.planId;
      const topicId = button.dataset.planTopic;
      if (!planId || !topicId) return;
      button.disabled = true;
      try {
        const response = await fetch(`/api/planes-estudio/${planId}/temas/${encodeURIComponent(topicId)}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ completed: true }) });
        if (!response.ok) throw new Error('No se pudo guardar el avance.');
        button.textContent = 'TEMA COMPLETADO ✓';
        button.classList.add('bg-emerald-100');
        button.dataset.completed = 'true';
        document.dispatchEvent(new CustomEvent('plan-topic-completed'));
      } catch (error) { window.alert(error instanceof Error ? error.message : 'Error al guardar.'); }
      finally { button.disabled = button.dataset.completed === 'true'; }
    });
  });
</script>

<style is:global>
  /* El contenido conserva un tono cálido y limpio dentro de las hojas oscuras del visor. */
  .render-lectura-content,
  .render-lectura-content * {
    color: #111 !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }

  .render-lectura-content * {
    background-color: transparent !important;
    background-image: none !important;
  }

  .render-lectura-content h2,
  .render-lectura-content h3,
  .render-lectura-content h5,
  .render-lectura-content .fb-structural-heading p {
    font-weight: 700 !important;
    letter-spacing: -0.015em;
  }

  .render-lectura-content h2 { font-size: 1.35rem; line-height: 1.3; }
  .render-lectura-content h3 { font-size: 1.15rem; line-height: 1.35; }
  .render-lectura-content h5 { font-size: 1rem; line-height: 1.4; }

  .render-lectura-content summary { cursor: pointer; }
</style>
