---
import type { NodoXML } from "../../features/xml/xmlParser";

interface Props {
  nodo: NodoXML;
}

const { nodo } = Astro.props;
const esElemento = nodo.tipo === "elemento";
const etiqueta = esElemento ? nodo.etiqueta : "";
const titulo = esElemento
  ? nodo.atributos["data-title"] ?? nodo.atributos.title ?? ""
  : "";
const numeroTema = esElemento
  ? nodo.atributos.id?.match(/^tema-(\d{3})$/)?.[1]
  : undefined;
const nivel = esElemento && nodo.atributos["data-difficulty"]
  ? nodo.atributos["data-difficulty"].toLowerCase()
  : "";
const numeroEjercicio = esElemento
  ? nodo.atributos.id?.match(/-ej-(\d+)$/)?.[1]
  : undefined;
---

{!esElemento ? (
  nodo.valor
) : etiqueta === "lectura" ? (
  <article class="mx-auto max-w-5xl space-y-8 text-slate-700">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </article>
) : etiqueta === "meta" ? (
  <div class="sr-only" aria-hidden="true">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </div>
) : etiqueta === "title" ? (
  <span>{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</span>
) : etiqueta === "summary" ? (
  <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600 sm:text-lg">
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </p>
) : etiqueta === "section" ? (
  <section
    id={nodo.atributos.id}
    aria-labelledby={nodo.atributos.id ? `${nodo.atributos.id}-heading` : undefined}
    class="scroll-mt-32 overflow-hidden rounded-3xl border border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-sky-50 shadow-sm"
  >
    {titulo && (
      <header class="border-b border-indigo-100 bg-white/80 px-5 py-6 sm:px-8">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-indigo-600">Etapa</p>
        <h2 id={nodo.atributos.id ? `${nodo.atributos.id}-heading` : undefined} class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          {titulo}
        </h2>
      </header>
    )}
    <div class="space-y-5 p-4 sm:p-7">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
    </div>
  </section>
) : etiqueta === "sub-section" ? (
  <section id={nodo.atributos.id} class="scroll-mt-32 scroll-mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
    <header class="mb-6 flex items-start gap-4 border-b border-slate-100 pb-5">
      {numeroTema && (
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-indigo-600 text-sm font-extrabold tabular-nums text-white shadow-sm" aria-label={`Tema ${Number(numeroTema)}`}>
          {Number(numeroTema)}
        </span>
      )}
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-indigo-600">Tema{numeroTema ? ` ${Number(numeroTema)}` : ""}</p>
        {titulo && <h3 class="mt-1 text-xl font-bold leading-snug text-slate-900 sm:text-2xl">{titulo}</h3>}
      </div>
    </header>
    <div class="space-y-6">
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
    </div>
  </section>
) : etiqueta === "sub-sub-section" ? (
  <section id={nodo.atributos.id} class="scroll-mt-32 space-y-4">
    {titulo && <h4 class="flex items-center gap-2 text-lg font-semibold text-slate-900"><span class="h-5 w-1 rounded-full bg-sky-500" aria-hidden="true"></span>{titulo}</h4>}
    <div class="space-y-4">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </section>
) : etiqueta === "p" ? (
  <p class="scroll-mt-32 text-[0.98rem] leading-7 text-slate-700">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</p>
) : etiqueta === "ul" ? (
  <ul class="scroll-mt-32 my-3 space-y-2 pl-5 marker:text-indigo-500">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</ul>
) : etiqueta === "li" ? (
  <li class="pl-1 leading-7 text-slate-700">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</li>
) : etiqueta === "math-definition" ? (
  <aside class="scroll-mt-32 rounded-2xl border border-emerald-200 bg-emerald-50/80 p-4 sm:p-5" aria-label={titulo || "Definición"}>
    <div class="mb-2 flex items-center gap-2 text-sm font-bold text-emerald-900"><span class="grid size-7 place-items-center rounded-lg bg-emerald-600 text-white" aria-hidden="true">✓</span>{titulo || "Definición"}</div>
    <div class="space-y-3 leading-7 text-emerald-950">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </aside>
) : etiqueta === "math-remark" ? (
  <aside class="scroll-mt-32 rounded-2xl border border-amber-200 bg-amber-50 p-4 sm:p-5" aria-label={titulo || "Observación"}>
    <p class="mb-2 text-sm font-bold text-amber-900">{titulo || "Para tener en cuenta"}</p>
    <div class="space-y-3 leading-7 text-amber-950">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </aside>
) : etiqueta === "math-formula" ? (
  <figure class="scroll-mt-32 my-4 overflow-x-auto rounded-2xl border border-violet-200 bg-violet-50 px-5 py-5 text-center">
    {titulo && <figcaption class="mb-3 text-xs font-bold uppercase tracking-wider text-violet-700">{titulo}</figcaption>}
    <div class="min-w-max font-mono text-base leading-8 text-violet-950 sm:text-lg" role="math" aria-label={titulo || "Fórmula matemática"}>
      {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
    </div>
  </figure>
) : etiqueta === "math-example" ? (
  <section id={nodo.atributos.id} class="scroll-mt-32 overflow-hidden rounded-2xl border border-sky-200 bg-sky-50/60">
    <header class="flex items-center gap-3 border-b border-sky-200 bg-sky-100/70 px-4 py-3">
      <span class="grid size-8 place-items-center rounded-xl bg-sky-600 text-sm font-bold text-white" aria-hidden="true">✓</span>
      <h5 class="font-bold text-sky-950">{titulo || "Ejemplo resuelto"}</h5>
    </header>
    <div class="space-y-3 p-4 leading-7 text-slate-700">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </section>
) : etiqueta === "math-examples" ? (
  <section class="scroll-mt-32 space-y-4" aria-label={titulo || "Ejemplos"}>
    {titulo && <h5 class="text-base font-bold text-slate-900">{titulo}</h5>}
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </section>
) : etiqueta === "math-exercises" ? (
  <section class="scroll-mt-32 space-y-4" aria-label={titulo || "Ejercicios"}>
    <h5 class="flex items-center gap-2 text-base font-bold text-slate-900"><span class="grid size-8 place-items-center rounded-xl bg-orange-100 text-orange-800" aria-hidden="true">✎</span>{titulo || "Practica lo aprendido"}</h5>
    <ol class="space-y-3">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</ol>
  </section>
) : etiqueta === "math-exercise" ? (
  <li id={nodo.atributos.id} class="scroll-mt-32 rounded-2xl border border-orange-200 bg-orange-50/70 p-4 sm:p-5">
    <div class="mb-2 flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-orange-800">Ejercicio{numeroEjercicio ? ` ${numeroEjercicio}` : ""}</span>
      {nivel && <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-orange-800 ring-1 ring-orange-200">{nivel === "basic" ? "Básico" : nivel === "intermediate" ? "Intermedio" : nivel === "advanced" ? "Avanzado" : nivel}</span>}
    </div>
    <div class="space-y-3 leading-7 text-slate-700">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </li>
) : etiqueta === "math-solutions" ? (
  <section class="scroll-mt-32 space-y-3" aria-label={titulo || "Soluciones"}>
    <h5 class="text-sm font-bold text-slate-800">{titulo || "Soluciones"}</h5>
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </section>
) : etiqueta === "math-solution" ? (
  <details class="scroll-mt-32 group rounded-2xl border border-slate-200 bg-white open:border-indigo-200 open:bg-indigo-50/40">
    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-4 py-3 font-semibold text-indigo-900 marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
      <span>Ver solución</span><span class="text-sm text-indigo-600 group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="space-y-3 border-t border-indigo-100 px-4 py-4 leading-7 text-slate-700">{nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}</div>
  </details>
) : (
  <div class="scroll-mt-32 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3">
    <span class="sr-only">Contenido: </span>
    {nodo.hijos.map((hijo) => <Astro.self nodo={hijo} />)}
  </div>
)}
