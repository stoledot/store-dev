---
interface Props { groupId?: string; saved?: boolean; mine?: boolean; }
const { groupId='', saved=false, mine=false } = Astro.props;
---
<section class="social-feed" data-social-feed data-group={groupId} data-saved={saved?'1':'0'} data-mine={mine?'1':'0'}>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-[.18em] text-brand">Comunidad</p><h2 class="mt-1 font-serif text-2xl">Publicaciones</h2></div><label class="text-sm">Ordenar <select data-sort class="ml-2 rounded-lg border border-line bg-surface px-3 py-2"><option value="relevance">Relevancia</option><option value="recent">Más recientes</option></select></label></div>
  <div data-feed-list class="grid gap-4"></div><p data-feed-empty class="hidden rounded-xl border border-dashed border-line p-6 text-center text-sm text-muted">Aún no hay publicaciones.</p><button data-feed-more class="mt-4 hidden rounded-lg border border-line px-4 py-2 text-sm font-semibold">Cargar más</button><p data-feed-status class="mt-3 text-center text-sm text-muted" aria-live="polite"></p>
</section>
<script is:inline src="/social.js"></script>
