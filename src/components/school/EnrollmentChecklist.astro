---
import type { EnrollmentStep } from '../../features/school/enrollmentChecklist';
const { steps, compact = false } = Astro.props as { steps: EnrollmentStep[]; compact?: boolean };
const completed = steps.filter((step) => step.done).length;
const percent = Math.round((completed / steps.length) * 100);
---
<section class="rounded-2xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="enrollment-checklist-title">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div><p class="text-xs font-bold uppercase tracking-[.16em] text-brand">Tu inscripción</p><h2 id="enrollment-checklist-title" class="mt-1 font-serif text-2xl">Tu ruta para comenzar</h2><p class="mt-1 text-sm text-muted">Completa estos pasos. Marcaremos cada uno automáticamente.</p></div>
    <span class="rounded-full bg-paper px-3 py-1.5 text-xs font-semibold text-muted">{completed} de {steps.length}</span>
  </div>
  <div class="mt-4 h-2 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="Progreso de inscripción" aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}><div class="h-full rounded-full bg-emerald-500 transition-all" style={`width:${percent}%`}></div></div>
  <ol class="mt-5 space-y-2">
    {steps.map((step, index) => <li><a href={step.href} class={`flex items-center gap-3 rounded-xl border p-3 transition ${step.done ? 'border-emerald-200 bg-emerald-50/70' : 'border-line bg-paper hover:border-brand'}`}>
      <span class={`grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold ${step.done ? 'bg-emerald-600 text-white' : 'bg-line text-muted'}`} aria-label={step.done ? 'Completado' : 'Pendiente'}>{step.done ? '✓' : index + 1}</span>
      <span class="min-w-0 flex-1"><span class={`block text-sm font-semibold ${step.done ? 'text-emerald-900' : 'text-ink'}`}>{step.title}</span>{!compact && <span class="mt-0.5 block text-xs leading-5 text-muted">{step.done ? 'Completado' : step.description}</span>}</span>
      {step.done ? <span class="text-xs font-semibold text-emerald-700">Listo</span> : <span class="text-sm font-semibold text-brand">Continuar →</span>}
    </a></li>)}
  </ol>
  {completed === steps.length && <p class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm font-medium text-emerald-800">¡Todo listo! Ya completaste tu proceso de inscripción.</p>}
</section>
