---
interface Props {
  lecturas: {
    id: number;
    title: string;
    image_url: string;
    type: string;
    description: string;
  }[];
}

const { lecturas = [] } = Astro.props;

const CONFIG_TIPOS: Record<string, { label: string; cta: string }> = {
  'book': { 
    label: 'Libros', 
    cta: 'Explorar libro'
  },
  'article': { 
    label: 'Artículos', 
    cta: 'Leer artículo completo' 
  },
  'magazine-edition': { 
    label: 'Ediciones de Revista', 
    cta: 'Ver edición'
  },
  'plan-estudio': { 
    label: 'Planes de Estudio', 
    cta: 'Comenzar plan' 
  },
};

const ORDEN_TIPOS = ['book', 'article', 'magazine-edition', 'plan-estudio'];

// Agrupamos y filtramos solo los tipos que tienen contenido
const seccionesActivas = ORDEN_TIPOS.map((tipo) => {
  const items = lecturas.filter((lectura) => lectura.type === tipo);
  return {
    tipo,
    config: CONFIG_TIPOS[tipo] || { label: tipo, cta: 'Ver más' },
    items,
  };
}).filter((seccion) => seccion.items.length > 0);
---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-20">
  {seccionesActivas.map(({ tipo, config, items }) => (
    <section aria-labelledby={`heading-${tipo}`} class="space-y-8">
      
      {/* Encabezado amplio y limpio */}
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-5">
        <div class="flex items-center gap-3.5">
          <h2 
            id={`heading-${tipo}`} 
            class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
          >
            {config.label}
          </h2>
          <span class="inline-flex items-center justify-center px-3 py-1 text-xs font-semibold rounded-full bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 border border-indigo-200/70 dark:border-indigo-800/70">
            {items.length}
          </span>
        </div>
      </div>

      {/* Grid amplio: máximo 3 columnas en pantallas grandes (o 2 en tablets) */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        {items.map((lectura) => (
          <article class="group relative flex flex-col bg-white dark:bg-slate-900 rounded-3xl overflow-hidden border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300">
            
            {/* Contenedor de Imagen Cuadrada (1:1) con buen aire */}
            <div class="p-4 pb-0">
              <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800">
                <img
                  src={lectura.image_url}
                  alt={lectura.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
                />
                <div class="absolute inset-0 ring-1 ring-inset ring-black/5 dark:ring-white/10 rounded-2xl pointer-events-none" />
              </div>
            </div>

            {/* Contenido con padding generoso y tipografía más grande */}
            <div class="flex flex-col flex-grow p-6 sm:p-7">
              <h3 class="text-xl sm:text-2xl font-bold leading-snug text-slate-900 dark:text-white mb-3 line-clamp-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                <a href={`/lecturas/${lectura.id}`} class="focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {lectura.title}
                </a>
              </h3>

              <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed line-clamp-4 mb-6 flex-grow">
                {lectura.description}
              </p>

              {/* Footer / CTA */}
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                <span>{config.cta}</span>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-indigo-50 dark:bg-indigo-950/60 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-500 transition-colors duration-200">
                  <svg 
                    class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform duration-200" 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </div>

          </article>
        ))}
      </div>

    </section>
  ))}
</div>
