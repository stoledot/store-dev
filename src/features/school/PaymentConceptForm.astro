---
import type { PaymentConcept } from './paymentConcepts';
import { toMajorUnits } from '../../money';

interface Props {
  concept?: PaymentConcept;
  currency: string;
}
const { concept, currency } = Astro.props;
const input = 'mt-1 block w-full rounded border border-line bg-white px-3 py-2';
const units = [{ value: 'day', title: 'Días' }, { value: 'week', title: 'Semanas' },
  { value: 'month', title: 'Meses' }, { value: 'year', title: 'Años' }];
---
<form method="POST" class="space-y-3">
  <input type="hidden" name="action" value="save" />
  {concept && <input type="hidden" name="concept_id" value={concept.id} />}
  <label class="block text-sm">Nombre<input name="title" required maxlength="160" value={concept?.title} class={input} /></label>
  <label class="block text-sm">Descripción<textarea name="description" rows="2" maxlength="10000" class={input}>{concept?.description}</textarea></label>
  <div class="grid gap-3 sm:grid-cols-2">
    <label class="block text-sm">Inicio del período de cobertura<input type="date" name="period_start_on" required value={concept?.period_start_on} class={input} /></label>
    <label class="block text-sm">Fin del período de cobertura (inclusive, opcional)<input type="date" name="period_end_on" value={concept?.period_end_on ?? ''} class={input} /></label>
    <label class="block text-sm">Duración alternativa<input type="number" name="duration_count" min="1" max="10000" step="1" value={concept?.duration_count ?? ''} class={input} /></label>
    <label class="block text-sm">Unidad de duración<select name="duration_unit" class={input}><option value="">Sin duración</option>{units.map(item => <option value={item.value} selected={concept?.duration_unit === item.value}>{item.title}</option>)}</select></label>
    <label class="block text-sm">Importe<input type="number" name="amount" min="0.001" max="10000000" step="any" required value={concept ? toMajorUnits(concept.amount_cents, concept.currency) : ''} class={input} /></label>
    <label class="block text-sm">Moneda (código de tres letras)<input name="currency" required pattern="[A-Za-z]{3}" maxlength="3" value={concept?.currency ?? currency} class={input} /></label>
    <label class="block text-sm">Días de anticipación (vacío = sin límite)<input type="number" name="advance_days" min="0" max="10000" step="1" value={concept?.advance_days ?? ''} class={input} /></label>
    <label class="block text-sm">Días de gracia para el acceso<input type="number" name="grace_days" min="0" max="10000" step="1" required value={concept?.grace_days ?? 0} class={input} /></label>
    <label class="block text-sm">¿Puede pagarse después del inicio?
      <select name="allow_after_start" required class={input}><option value="">Selecciona</option><option value="1" selected={concept?.allow_after_start === 1}>Sí</option><option value="0" selected={concept?.allow_after_start === 0}>No, cancelar al iniciar</option></select>
    </label>
    <label class="block text-sm">¿Controla el acceso?
      <select name="required_for_access" required class={input}><option value="">Selecciona</option><option value="1" selected={concept?.required_for_access === 1}>Sí</option><option value="0" selected={concept?.required_for_access === 0}>No</option></select>
    </label>
    <label class="block text-sm">Recurrencia<select name="recurrence_unit" class={input}><option value="once" selected={!concept || concept.recurrence_unit === 'once'}>Pago único</option>{units.map(item => <option value={item.value} selected={concept?.recurrence_unit === item.value}>{item.title}</option>)}</select></label>
    <label class="block text-sm">Repetir cada (solo recurrentes)<input type="number" name="recurrence_count" min="1" max="10000" step="1" value={concept?.recurrence_count ?? ''} class={input} /></label>
    <label class="block text-sm">Último inicio de recurrencia (opcional)<input type="date" name="recurrence_end_on" value={concept?.recurrence_end_on ?? ''} class={input} /></label>
    <label class="block text-sm">Grupo de cobro (opcional)<input name="group_name" maxlength="160" value={concept?.group_name ?? ''} class={input} /></label>
  </div>
  <p class="text-xs text-muted">Usa fecha final o duración; si no indicas ninguna, la cobertura es indefinida. La gracia se cuenta desde el inicio. Si hay coberturas recurrentes superpuestas al ingresar, se asignan la vigente más reciente y las futuras. Los conceptos con el mismo grupo deben usar la misma moneda.</p>
  <button class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white">{concept ? 'Guardar concepto' : 'Agregar concepto'}</button>
</form>
