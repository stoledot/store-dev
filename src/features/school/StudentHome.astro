
---
import type { getSchoolHomeSummary } from './homeSummary';

interface Props {
  summary: Awaited<ReturnType<typeof getSchoolHomeSummary>>;
}

const { summary } = Astro.props;

/**
 * lecturas:
 * {
 *   l_title: string;
 *   school_lectura_id: number;
 *   customer_id: number;
 * }
 */
const lecturas = summary.lecturasCustomer;
---

<section class="my-6 space-y-8 sm:my-10">

  <!-- ENCABEZADO -->
  <div class="relative overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-paper via-surface to-paper p-6 shadow-sm sm:p-8 lg:p-10">
    <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-brand/10 blur-3xl"></div>

    <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-brand">
          <span class="h-2 w-2 rounded-full bg-brand"></span>
          Tu espacio de aprendizaje
        </span>

        <h2 class="mt-5 max-w-2xl font-serif text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Es buen momento para continuar aprendiendo.
        </h2>

        <p class="mt-4 max-w-xl text-sm leading-7 text-muted sm:text-base">
          Tus cursos, lecturas, inscripciones y avisos, reunidos en un solo lugar.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:min-w-72">
        <a href="/account/courses"
          class="group rounded-2xl border border-line bg-surface/90 p-4 transition hover:-translate-y-1 hover:border-brand hover:shadow-md">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 016.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
            </svg>
          </span>
          <span class="mt-4 block text-xs font-medium text-muted">Cursos disponibles</span>
          <span class="mt-1 block text-3xl font-bold tabular-nums">{summary.courseCount}</span>
        </a>

        <a href="/account/notificaciones"
          class="group rounded-2xl border border-line bg-surface/90 p-4 transition hover:-translate-y-1 hover:border-brand hover:shadow-md">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4-5.7V5a2 2 0 10-4 0v.3A6 6 0 006 11v3.2a2 2 0 01-.6 1.4L4 17h5m6 0a3 3 0 11-6 0"/>
            </svg>
          </span>
          <span class="mt-4 block text-xs font-medium text-muted">Avisos sin leer</span>
          <span class="mt-1 block text-3xl font-bold tabular-nums">{summary.unreadCount}</span>
        </a>
      </div>
    </div>
  </div>


  <!-- LECTURAS -->
  <div class="overflow-hidden rounded-3xl border border-line bg-surface shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line p-5 sm:p-7">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">Material de estudio</p>
        <h3 class="mt-1 font-serif text-2xl sm:text-3xl">Tus lecturas</h3>
        <p class="mt-2 text-sm text-muted">Textos y materiales asignados para acompañar tu aprendizaje.</p>
      </div>

      <span class="rounded-full bg-brand/10 px-4 py-2 text-sm font-bold text-brand">
        {lecturas.length} {lecturas.length === 1 ? 'lectura' : 'lecturas'}
      </span>
    </div>

    {lecturas.length > 0 ? (
      <div class="grid gap-3 p-5 sm:grid-cols-2 sm:p-7 xl:grid-cols-3">
        {lecturas.map((lectura) => (
          <article class="group relative flex min-h-44 flex-col overflow-hidden rounded-2xl border border-line bg-paper p-5 transition duration-200 hover:-translate-y-1 hover:border-brand/50 hover:shadow-lg">
            <div class="flex items-start justify-between gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand/10 text-brand transition group-hover:bg-brand group-hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v14m0-14C10.8 5.7 8.5 5 5 5H3v14h2c3.5 0 5.8.7 7 2m0-14c1.2-1.3 3.5-2 7-2h2v14h-2c-3.5 0-5.8.7-7 2"/>
                </svg>
              </span>

              <span class="rounded-full border border-line px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-muted">
                Lectura
              </span>
            </div>

            <h4 class="mt-4 text-base font-semibold leading-snug">
              {lectura.l_title}
            </h4>

            <a
              href={`/account/lecturas/${encodeURIComponent(String(lectura.school_lectura_id))}`}
              class="mt-auto flex items-center justify-between pt-5 text-sm font-bold text-brand"
            >
              <span>Comenzar lectura</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="px-6 py-12 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-brand/10 text-brand">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v14m0-14C10.8 5.7 8.5 5 5 5H3v14h2c3.5 0 5.8.7 7 2m0-14c1.2-1.3 3.5-2 7-2h2v14h-2c-3.5 0-5.8.7-7 2"/>
          </svg>
        </div>
        <h4 class="mt-4 font-serif text-xl">Aún no tienes lecturas asignadas</h4>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted">
          Cuando la escuela te asigne material de estudio, aparecerá aquí para que puedas consultarlo.
        </p>
      </div>
    )}
  </div>


  <!-- CONTENIDO PRINCIPAL -->
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.85fr)]">

    <!-- CURSOS -->
    <div class="rounded-3xl border border-line bg-surface p-5 shadow-sm sm:p-7">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">A tu ritmo</p>
          <h3 class="mt-1 font-serif text-2xl sm:text-3xl">Tus cursos</h3>
        </div>
        <a href="/account/courses" class="text-sm font-semibold text-brand underline underline-offset-4">
          Ver todos →
        </a>
      </div>

      {summary.courses.length ? (
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {summary.courses.map(course => (
            <article class="flex min-h-44 flex-col rounded-2xl border border-line bg-paper p-5 transition hover:border-brand/50 hover:shadow-md">
              <p class="text-xs font-bold uppercase tracking-wide text-muted">
                {course.progress_status === 'completed' ? 'Completado' : course.progress_status === 'in_progress' ? 'En curso' : 'Disponible'}
              </p>

              <h4 class="mt-2 text-lg font-semibold leading-snug">{course.title}</h4>

              {course.lesson_title && (
                <p class="mt-2 text-sm leading-5 text-muted">
                  {course.progress_status === 'completed' ? 'Repasar' : 'Siguiente'}: {course.lesson_title}
                </p>
              )}

              <a
                href={course.lesson_slug ? `/escuela/cursos/${encodeURIComponent(course.slug)}/${encodeURIComponent(course.lesson_slug)}` : '/account/courses'}
                class="mt-auto inline-flex min-h-11 items-center self-start pt-3 text-sm font-bold text-brand underline underline-offset-4"
              >
                {!course.lesson_slug ? 'Ver curso' : course.progress_status === 'completed' ? 'Repasar' : course.progress_status === 'in_progress' ? 'Continuar' : 'Comenzar'} →
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-5 rounded-2xl border border-dashed border-line bg-paper p-6">
          <p class="text-sm leading-6 text-muted">
            Aún no tienes cursos disponibles.
            <a href="#programas" class="font-semibold text-brand underline"> Explora los programas</a> para encontrar tu siguiente paso.
          </p>
        </div>
      )}
    </div>


    <!-- COLUMNA LATERAL -->
    <div class="space-y-6">

      <!-- INSCRIPCIONES -->
      {summary.diagnostics.length > 0 && (
        <div class="rounded-3xl border border-line bg-surface p-5 shadow-sm sm:p-6">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">Tu proceso</p>
          <h3 class="mt-1 font-serif text-2xl">Inscripciones</h3>

          <ul class="mt-5 space-y-3">
            {summary.diagnostics.map(item => (
              <li class="rounded-2xl border border-line bg-paper p-4 text-sm">
                <strong class="text-base">{item.title}</strong>

                {item.closed_at ? (
                  <p class="mt-2 leading-6">
                    Tu inscripción tiene baja definitiva. Para reincorporarte, contacta a la escuela y
                    <a class="font-semibold text-brand underline" href={`/subprogramas/${encodeURIComponent(item.subprogram_id)}#diagnostico`}> envía un nuevo diagnóstico</a>.
                  </p>
                ) : item.enrollment_status === 'suspended' ? (
                  <p class="mt-2 leading-6">
                    Tu inscripción está en baja temporal.
                    <a class="font-semibold text-brand underline" href="/account/payments"> Paga tus adeudos vencidos</a> para reactivarla.
                  </p>
                ) : item.status === 'pending' ? (
                  <p class="mt-2 leading-6 text-muted">Tu diagnóstico está en revisión.</p>
                ) : item.status === 'rejected' ? (
                  <p class="mt-2 leading-6">
                    Tu diagnóstico necesita atención.
                    <a class="font-semibold text-brand underline" href={`/subprogramas/${encodeURIComponent(item.subprogram_id)}#diagnostico`}> Enviar uno nuevo</a>.
                  </p>
                ) : item.due_count > 0 ? (
                  <p class="mt-2 leading-6">
                    Diagnóstico aprobado. {item.enrollment_due_count > 0 ? 'Tienes pendiente el pago de inscripción. ' : ''}
                    Tienes {item.due_count} {item.due_count === 1 ? 'pago disponible' : 'pagos disponibles'}.
                    <a class="font-semibold text-brand underline" href="/account/payments"> Revisar pagos</a>.
                  </p>
                ) : item.enrollment_required && !item.enrollment_valid ? (
                  <p class="mt-2 leading-6">
                    Necesitas una inscripción vigente.
                    <a class="font-semibold text-brand underline" href="/account/payments"> Consulta tus pagos</a> o contacta a la escuela.
                  </p>
                ) : !item.modality_valid ? (
                  <p class="mt-2 leading-6">
                    Tu esquema de pago aún no tiene un pago vigente.
                    <a class="font-semibold text-brand underline" href="/account/payments"> Consulta tus pagos</a> o contacta a la escuela.
                  </p>
                ) : item.group_title ? (
                  <p class="mt-2 leading-6 text-muted">Acceso habilitado · Grupos: {item.group_title}</p>
                ) : (
                  <p class="mt-2 leading-6 text-muted">Acceso habilitado. La escuela debe asignarte un grupo.</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}


      <!-- NOTIFICACIONES -->
      {summary.notifications.length > 0 && (
        <div class="rounded-3xl border border-line bg-surface p-5 shadow-sm sm:p-6">
          <div class="flex items-end justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">Para ti</p>
              <h3 class="mt-1 font-serif text-2xl">Avisos recientes</h3>
            </div>
            <a href="/account/notificaciones" class="text-sm font-semibold text-brand underline underline-offset-4">Ver todos</a>
          </div>

          <ul class="mt-5 space-y-3">
            {summary.notifications.map(notification => (
              <li class="rounded-2xl border border-line bg-paper p-4 text-sm">
                <strong>{notification.title}</strong>
                <p class="mt-1 whitespace-pre-wrap leading-6 text-muted">{notification.message}</p>
              </li>
            ))}
          </ul>
        </div>
      )}


      <!-- ESTADO VACÍO -->
      {summary.diagnostics.length === 0 && summary.notifications.length === 0 && (
        <div class="rounded-3xl border border-line bg-paper p-6">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 text-brand">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5-1a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="mt-4 font-serif text-xl">Tu siguiente paso</h3>
          <p class="mt-2 text-sm leading-6 text-muted">
            Aquí verás tus diagnósticos y avisos cuando comiences tu inscripción.
          </p>
          <a href="#programas" class="mt-4 inline-block text-sm font-bold text-brand underline underline-offset-4">
            Conocer los programas →
          </a>
        </div>
      )}
    </div>
  </div>
</section>
