---
import { env } from 'cloudflare:workers';

interface Props {
  program: 'matematicas' | 'lectura';
}

const { program } = Astro.props;
const { results: subprograms } = await env.DB.prepare(`
  SELECT s.id, s.title, s.description, s.education_level, s.image_url, s.duration_description
    FROM school_subprograms s
    JOIN school_programs p ON p.slug = s.program_slug
   WHERE s.program_slug = ? AND s.status = 'active' AND p.status = 'active'
   ORDER BY s.title COLLATE NOCASE
`).bind(program).all<{
  id: string;
  title: string;
  description: string;
  education_level: string;
  image_url: string;
  duration_description: string;
}>();
---

<section class="mt-12" aria-labelledby="subprogramas">
  <div class="max-w-2xl">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">Encuentra tu camino</p>
    <h2 id="subprogramas" class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">Explora los subprogramas</h2>
    <p class="mt-3 text-sm leading-6 text-muted">Conoce las opciones disponibles y encuentra la ruta que mejor se adapte a tus objetivos.</p>
  </div>
  {subprograms.length === 0 ? (
    <p class="mt-6 rounded-2xl border border-dashed border-line p-6 text-sm text-muted">Todavía no hay subprogramas disponibles.</p>
  ) : (
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {subprograms.map((subprogram) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-surface">
          {subprogram.image_url && <img src={subprogram.image_url} alt="" loading="lazy" decoding="async" class="aspect-square w-full object-cover" />}
          <div class="flex flex-1 flex-col p-6">
            {subprogram.education_level && <p class="text-xs font-semibold uppercase tracking-wider text-brand">{subprogram.education_level}</p>}
            <h3 class="mt-2 font-serif text-2xl">{subprogram.title}</h3>
            {subprogram.description && <p class="mt-3 whitespace-pre-line text-sm leading-6 text-muted">{subprogram.description}</p>}
            {subprogram.duration_description && <p class="mt-4 text-xs font-medium text-muted">Duración: {subprogram.duration_description}</p>}
            <a href={`/subprogramas/${encodeURIComponent(subprogram.id)}`} class="mt-6 inline-flex min-h-11 items-center self-start rounded-full border border-line px-5 py-2 text-sm font-semibold hover:border-brand">Conocer subprograma <span aria-hidden="true" class="ml-2">→</span></a>
          </div>
        </article>
      ))}
    </div>
  )}
</section>
