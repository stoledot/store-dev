---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getCustomerEmail } from '../../features/auth/customer';
import { magazineAccessMode } from '../../features/magazines/access';
import { formatMoney } from '../../money';
import { mediaUrl } from '../../features/media/url';
import { getConfig } from '../../config';
const slug=Astro.params.slug??'';
const magazine=await env.DB.prepare("SELECT * FROM math_magazines WHERE slug=? AND status='published'").bind(slug).first<any>();if(!magazine)return new Response('Revista no encontrada.',{status:404});
const email=await getCustomerEmail(Astro.cookies),mode=email?await magazineAccessMode(env.DB,email,magazine.id):null;
const latest=await env.DB.prepare("SELECT id,slug,issue_number,volume,title,issue_date,summary,cover_image_key FROM math_magazine_issues WHERE magazine_id=? AND status='published' ORDER BY issue_date DESC,updated_at DESC LIMIT 1").bind(magazine.id).first<any>();
const query=mode==='all'?env.DB.prepare("SELECT id,slug,issue_number,volume,title,issue_date,summary,cover_image_key FROM math_magazine_issues WHERE magazine_id=? AND status='published' ORDER BY issue_date DESC,updated_at DESC LIMIT 100").bind(magazine.id):mode==='latest'&&latest?env.DB.prepare("SELECT id,slug,issue_number,volume,title,issue_date,summary,cover_image_key FROM math_magazine_issues WHERE id=? AND status='published'").bind(latest.id):null;
const issues=query?(await query.all<any>()).results??[]:[];
const offers=(await env.DB.prepare("SELECT p.slug AS product_slug,p.name AS product_name,s.slug AS plan_slug,s.title AS plan_title,s.description,s.unit_amount_minor,s.currency,s.interval_unit,s.interval_count,s.magazine_access FROM content_subscriptions s JOIN product_content_subscriptions ps ON ps.subscription_id=s.id JOIN products p ON p.id=ps.product_id WHERE s.magazine_id=? AND s.status='active' AND p.active=1 ORDER BY s.magazine_access,s.title,p.name").bind(magazine.id).all<any>()).results??[];
const imageBase=getConfig().images.baseUrl;
---
<Layout title={magazine.title} description={magazine.description||magazine.title} image={magazine.cover_image_key?mediaUrl(magazine.cover_image_key,imageBase):undefined}><main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><header class="overflow-hidden rounded-3xl border border-line bg-surface"><div class="grid md:grid-cols-[16rem_1fr]">{magazine.cover_image_key&&<img class="h-72 w-full object-cover md:h-full" src={mediaUrl(magazine.cover_image_key,imageBase)} alt={`Portada de ${magazine.title}`}/>}<div class="p-6 sm:p-10"><p class="text-xs font-semibold uppercase tracking-[.18em] text-brand">Revista matemática {magazine.frequency&&`· ${magazine.frequency}`}</p><h1 class="mt-3 font-serif text-3xl sm:text-5xl">{magazine.title}</h1>{magazine.publisher&&<p class="mt-3 text-sm text-muted">{magazine.publisher}{magazine.editor?` · Edición de ${magazine.editor}`:''}</p>}{magazine.description&&<p class="mt-5 max-w-3xl whitespace-pre-wrap leading-7 text-muted">{magazine.description}</p>}{mode&&<p class="mt-5 inline-flex rounded-full bg-green-100 px-3 py-1.5 text-sm font-semibold text-green-800">{mode==='all'?'Tienes acceso al archivo completo':'Tienes acceso a la edición vigente'}</p>}</div></div></header>
{offers.length>0&&!mode&&<section class="mt-8 rounded-2xl border border-line bg-surface p-5 sm:p-7"><p class="text-xs font-semibold uppercase tracking-widest text-brand">Acceso por suscripción</p><h2 class="mt-2 font-serif text-2xl">Elige tu acceso a la revista</h2><p class="mt-2 text-sm text-muted">El checkout de cada producto mostrará las condiciones legales y solicitará una sola autorización para los cargos recurrentes.</p><div class="mt-5 grid gap-4 md:grid-cols-2">{offers.map(o=><article class="rounded-xl border border-line bg-white p-5"><p class="text-xs uppercase tracking-wider text-muted">{o.magazine_access==='all'?'Archivo completo':'Edición vigente'}</p><h3 class="mt-1 text-lg font-semibold">{o.plan_title}</h3>{o.description&&<p class="mt-2 text-sm text-muted">{o.description}</p>}<p class="mt-4 text-xl font-semibold">{formatMoney(o.unit_amount_minor,o.currency)} <span class="text-sm font-normal text-muted">cada {o.interval_count} {o.interval_unit==='year'?'año':'mes'}</span></p><a href={`/products/${o.product_slug}`} class="mt-4 inline-flex rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white">Ver producto y suscribirme →</a></article>)}</div></section>}
{mode&&<section class="mt-8"><div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-widest text-muted">Tu biblioteca</p><h2 class="mt-1 font-serif text-2xl">{mode==='all'?'Ediciones disponibles':'Edición más reciente'}</h2></div><a class="text-sm underline" href="/account/revistas">Ir a mis revistas →</a></div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{issues.map(i=><article class="overflow-hidden rounded-2xl border border-line bg-surface">{(i.cover_image_key||magazine.cover_image_key)&&<img class="h-52 w-full object-cover" src={mediaUrl(i.cover_image_key||magazine.cover_image_key,imageBase)} alt={`Portada ${i.title}`} loading="lazy"/>}<div class="p-5"><p class="text-xs uppercase tracking-wider text-muted">{i.volume?`Vol. ${i.volume} · `:''}Núm. {i.issue_number} · {i.issue_date}</p><h3 class="mt-2 text-lg font-semibold">{i.title}</h3>{i.summary&&<p class="mt-2 line-clamp-3 text-sm text-muted">{i.summary}</p>}<a class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href={`/revistas/${magazine.slug}/${i.slug}`}>Leer edición →</a></div></article>)}</div>{!issues.length&&<p class="rounded-xl border border-dashed p-6 text-sm text-muted">La revista todavía no tiene ediciones publicadas.</p>}</section>}
{!mode&&<section class="mt-8 rounded-2xl border border-line bg-surface p-6"><h2 class="font-serif text-2xl">Última edición</h2>{latest?<article class="mt-4 flex flex-col gap-4 sm:flex-row">{(latest.cover_image_key||magazine.cover_image_key)&&<img class="h-56 w-40 rounded-xl object-cover" src={mediaUrl(latest.cover_image_key||magazine.cover_image_key,imageBase)} alt={`Portada ${latest.title}`}/>}<div><p class="text-xs uppercase tracking-wider text-muted">{latest.volume?`Vol. ${latest.volume} · `:''}Núm. {latest.issue_number} · {latest.issue_date}</p><h3 class="mt-2 text-xl font-semibold">{latest.title}</h3>{latest.summary&&<p class="mt-2 max-w-2xl text-sm leading-6 text-muted">{latest.summary}</p>}<p class="mt-4 text-sm text-muted">Suscríbete para leer las ediciones incluidas en tu plan.</p></div></article>:<p class="mt-3 text-sm text-muted">Aún no se ha publicado una edición.</p>}</section>}
{offers.length===0&&<p class="mt-8 rounded-xl border border-dashed p-5 text-sm text-muted">Esta revista todavía no tiene productos de suscripción disponibles.</p>}</main></Layout>
