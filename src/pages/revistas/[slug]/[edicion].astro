---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { getCustomerEmail } from '../../../features/auth/customer';
import { magazineCanReadIssue,magazineAccessMode } from '../../../features/magazines/access';
import { parseReadingXml } from '../../../features/mathTexts/xmlReading';
import { mediaUrl } from '../../../features/media/url';
import { getConfig } from '../../../config';
if(!(await getCustomerEmail(Astro.cookies)))return Astro.redirect('/account/login',303);
const email=(await getCustomerEmail(Astro.cookies))!;
const record=await env.DB.prepare("SELECT m.id AS magazine_id,m.slug AS magazine_slug,m.title AS magazine_title,m.cover_image_key AS magazine_cover,i.id AS issue_id,i.slug AS issue_slug,i.issue_number,i.volume,i.title AS issue_title,i.author,i.issue_date,i.summary,i.xml_source_key,i.cover_image_key FROM math_magazines m JOIN math_magazine_issues i ON i.magazine_id=m.id WHERE m.slug=? AND i.slug=? AND m.status='published' AND i.status='published'").bind(Astro.params.slug??'',Astro.params.edicion??'').first<any>();
if(!record)return new Response('Edición no encontrada.',{status:404});
const mode=await magazineAccessMode(env.DB,email,record.magazine_id);if(!mode||!(await magazineCanReadIssue(env.DB,email,record.magazine_id,record.issue_id)))return Astro.redirect(`/revistas/${encodeURIComponent(record.magazine_slug)}?locked=1`,303);
if(!env.FILES)return new Response('Almacenamiento no configurado.',{status:503});const object=await env.FILES.get(record.xml_source_key);if(!object)return new Response('Edición no disponible.',{status:404});const edition=parseReadingXml(await object.text()),cards=edition.cards;
const rendered=cards.map((card,index)=>{let occurrence=0;const html=card.html.replace(/<figure class="reading-video" data-reading-video-ref="([^"]+)" data-reading-video-title="([^"]*)"><figcaption>[\s\S]*?<\/figure>/g,(_all,ref,title)=>`<section class="my-5 rounded-2xl border border-indigo-100 bg-white p-4"><h3 class="mb-3 font-semibold">${title}</h3><video class="w-full rounded-xl bg-black" controls playsinline preload="metadata" src="/api/revistas/${encodeURIComponent(record.magazine_slug)}/${encodeURIComponent(record.issue_slug)}/videos/${encodeURIComponent(ref)}" aria-label="${title}"></video></section>`).replace(/<aside class="reading-geogebra" data-reading-geogebra="([^"]+)">([\s\S]*?)<\/aside>/g,(_all,ref,inside)=>{const target=`mag-ggb-${index}-${occurrence++}`;return `<section class="my-5 rounded-2xl border border-indigo-200 bg-white p-4" data-geogebra-widget data-endpoint="/api/revistas/${encodeURIComponent(record.magazine_slug)}/${encodeURIComponent(record.issue_slug)}/geogebra/${encodeURIComponent(ref)}"><div class="mb-3">${inside}</div><div id="${target}" data-geogebra-target class="min-h-72 w-full overflow-hidden rounded-xl bg-gray-50"></div><p data-geogebra-status class="mt-2 text-sm" role="status">Cargando construcción interactiva…</p></section>`;});return {...card,index,html};});
const imageBase=getConfig().images.baseUrl,cover=record.cover_image_key||record.magazine_cover;
---
<Layout title={`${edition.title} — ${record.magazine_title}`} description={edition.summary||edition.title} image={cover?mediaUrl(cover,imageBase):undefined}><main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-10"><a href={`/revistas/${record.magazine_slug}`} class="text-sm underline">← {record.magazine_title}</a><header class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface">{cover&&<img class="h-64 w-full object-cover sm:h-80" src={mediaUrl(cover,imageBase)} alt={`Portada ${edition.title}`}/>}<div class="p-5 sm:p-8"><p class="text-xs font-semibold uppercase tracking-widest text-brand">{edition.volume?`Vol. ${edition.volume} · `:''}Número {edition.number} · {edition.date}</p><h1 class="mt-2 font-serif text-3xl sm:text-4xl">{edition.title}</h1><p class="mt-2 text-sm text-muted">{edition.author}{edition.date?` · ${edition.date}`:''}</p>{edition.summary&&<p class="mt-4 max-w-3xl leading-7 text-muted">{edition.summary}</p>}</div></header><div class="mt-6 grid gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]"><aside class="h-fit rounded-xl border border-line bg-surface p-4 lg:sticky lg:top-5"><h2 class="font-semibold">Contenido</h2><details class="mt-3 lg:hidden"><summary class="cursor-pointer rounded-lg bg-gray-50 p-3 text-sm">Abrir índice de edición</summary><nav class="mt-2 space-y-1">{rendered.map((c,i)=><a style={`padding-left:${Math.min((c.level-1)*12,28)}px`} class="block rounded px-2 py-2 text-sm hover:bg-gray-50" href={`#edicion-${i}`}>{i+1}. {c.title}</a>)}</nav></details><nav class="mt-3 hidden max-h-[70vh] space-y-1 overflow-y-auto lg:block">{rendered.map((c,i)=><a style={`padding-left:${Math.min((c.level-1)*12,28)}px`} class="block rounded px-2 py-2 text-sm hover:bg-gray-50" href={`#edicion-${i}`}>{i+1}. {c.title}</a>)}</nav><a href="#edicion-top" class="mt-4 block text-sm underline">↑ Volver arriba</a></aside><article id="edicion-top" class="min-w-0 space-y-5">{rendered.map((c,i)=><section id={`edicion-${i}`} class="scroll-mt-5 rounded-xl border border-line bg-surface p-5 sm:p-8"><div class="mb-4 flex items-start justify-between gap-3"><div><p class="text-xs uppercase tracking-wider text-muted">Sección {i+1}</p><h2 class="mt-1 text-2xl font-semibold">{c.title}</h2></div><a class="shrink-0 text-sm underline" href="#edicion-top">↑ Arriba</a></div><div class="tex-content prose max-w-none" set:html={c.html}></div></section>)}</article></div><nav class="sticky bottom-2 mt-8 flex items-center justify-between rounded-xl border border-line bg-white/95 p-3 shadow-lg backdrop-blur"><a href={`/revistas/${record.magazine_slug}`} class="rounded-lg border border-line px-4 py-2 text-sm">Revista</a><a href="#edicion-top" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white">↑ Inicio</a></nav></main><style>.tex-content{min-width:0;overflow-wrap:anywhere;line-height:1.85}.tex-content :global(.reading-math-env){margin:1.25rem 0;padding:1rem 1.1rem;border:1px solid var(--color-line,#d8dce3);border-left:4px solid var(--color-brand,#4f46e5);border-radius:1rem;background:var(--color-paper,#fff);box-shadow:0 8px 24px rgb(15 23 42 / .04)}.tex-content :global(.reading-math-env h3){margin:0 0 .65rem;color:var(--color-brand,#3730a3);font-size:.8rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.tex-content :global([data-geogebra-widget]){margin:1.25rem 0}.tex-content :global(mjx-container){max-width:100%;overflow-x:auto;overflow-y:hidden}.tex-content :global(table){display:block;max-width:100%;overflow-x:auto}</style><script>import '../../../features/mathTexts/geogebraClient';</script></Layout>
