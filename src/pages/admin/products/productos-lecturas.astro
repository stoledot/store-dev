---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  deleteProductLectura,
  getAllProductLecturas,
  getProductLecturasByProductId
} from '../../../features/lecturas/db';
import { listAllProducts } from '../../../features/products/db';
import { getAllLecturas } from '../../../features/lecturas/db';

const title = "Productos - Lecturas";
let error = "";
let success = "";

const nullableInteger = (value: FormDataEntryValue | null, label: string) => {
  if (value === null || String(value).trim() === "") return null;
  const parsed = Number(value);
  if (!Number.isInteger(parsed)) throw new Error(`${label} debe ser un número entero.`);
  return parsed;
};

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get("action") ?? "");
    const productId = String(form.get("productId") ?? "");
    const lecturaId = String(form.get("lecturaId") ?? "");

    if (action === "add") {
      const expirationDays = nullableInteger(form.get("expiration_days"), "Días de expiración");
      const numberOfPlans = nullableInteger(form.get("number_of_plans"), "Número de planes");
      const simultaneousDevices = nullableInteger(form.get("simultaneous_devices"), "Dispositivos simultáneos");
      const displaySection = String(form.get("display_section") ?? "").trim() || null;
      await env.DB.prepare(`
        INSERT INTO products_lecturas
          (product_id, lectura_id, expiration_days, number_of_plans, simultaneous_devices, display_section)
        VALUES (?, ?, ?, ?, ?, ?)
      `).bind(productId, lecturaId, expirationDays, numberOfPlans, simultaneousDevices, displaySection).run();
      success = "Relación agregada correctamente.";
    } else if (action === "edit") {
      const expirationDays = nullableInteger(form.get("expiration_days"), "Días de expiración");
      const numberOfPlans = nullableInteger(form.get("number_of_plans"), "Número de planes");
      const simultaneousDevices = nullableInteger(form.get("simultaneous_devices"), "Dispositivos simultáneos");
      const displaySection = String(form.get("display_section") ?? "").trim() || null;
      await env.DB.prepare(`
        UPDATE products_lecturas
        SET expiration_days = ?, number_of_plans = ?, simultaneous_devices = ?, display_section = ?
        WHERE product_id = ? AND lectura_id = ?
      `).bind(expirationDays, numberOfPlans, simultaneousDevices, displaySection, productId, lecturaId).run();
      success = "Datos de la relación actualizados correctamente.";
    } else if (action === "delete") {
      await deleteProductLectura(env.DB, productId as any, lecturaId as any);
      success = "Relación eliminada.";
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const selectedProductId = Astro.url.searchParams.get("productId") ?? "";
const selectedLecturaId = Astro.url.searchParams.get("lecturaId") ?? "";
const allRelations: any[] = (await getAllProductLecturas(env.DB)) ?? [];
const productRelations: any[] = selectedProductId
  ? ((await getProductLecturasByProductId(env.DB, selectedProductId as any)) ?? [])
  : [];
const products = (await listAllProducts(env.DB, 100)) ?? [];
const lecturas = (await getAllLecturas(env.DB)) ?? [];
const productMap = new Map(products.map((p: any) => [String(p.id), p.name]));
const selectedProductName = selectedProductId ? productMap.get(selectedProductId) : null;
const lecturaMap = new Map(lecturas.map((l: any) => [String(l.id), l.title]));
const valueOf = (row: any, snake: string, camel: string) => row[snake] ?? row[camel] ?? "";
---

<AdminLayout title={title} active="products">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Productos y Lecturas</h1>
        <p class="text-sm text-slate-500 mt-1">Vincula lecturas específicas a cada producto de tu catálogo.</p>
      </div>
      <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
        {allRelations.length} relaciones activas
      </span>
    </div>

    {error && <div class="rounded-lg bg-red-50 p-4 border border-red-200"><p class="text-sm text-red-700 font-medium">{error}</p></div>}
    {success && <div class="rounded-lg bg-emerald-50 p-4 border border-emerald-200"><p class="text-sm text-emerald-700 font-medium">{success}</p></div>}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-1">Vincular Lectura</h2>
          <p class="text-xs text-slate-500 mb-4">Asocia una lectura y configura sus datos para el producto.</p>
          <form method="post" class="space-y-4">
            <input type="hidden" name="action" value="add" />
            <div>
              <label for="add-product" class="block text-xs font-medium text-slate-700 mb-1">Producto</label>
              <select id="add-product" name="productId" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900">
                <option value="" disabled selected={!selectedProductId}>Selecciona un producto...</option>
                {products.map((p: any) => <option value={p.id} selected={String(p.id) === selectedProductId}>{p.name} (ID: {p.id})</option>)}
              </select>
            </div>
            <div>
              <label for="add-lectura" class="block text-xs font-medium text-slate-700 mb-1">Lectura</label>
              <select id="add-lectura" name="lecturaId" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900">
                <option value="" disabled selected={!selectedLecturaId}>Selecciona una lectura...</option>
                {lecturas.map((l: any) => <option value={l.id} selected={String(l.id) === selectedLecturaId}>{l.title} (ID: {l.id})</option>)}
              </select>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="block text-xs font-medium text-slate-700">Días de expiración
                <input type="number" step="1" name="expiration_days" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-xs font-medium text-slate-700">Número de planes
                <input type="number" step="1" name="number_of_plans" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-xs font-medium text-slate-700">Dispositivos simultáneos
                <input type="number" step="1" name="simultaneous_devices" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-xs font-medium text-slate-700">Sección de visualización
                <input type="text" maxlength="255" name="display_section" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
            </div>
            <button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer">+ Guardar relación</button>
          </form>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-1">Inspeccionar Producto</h2>
          <p class="text-xs text-slate-500 mb-4">Filtra para ver y editar las lecturas de un producto.</p>
          <form method="get" class="space-y-3">
            <select name="productId" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900">
              <option value="">-- Ver todos --</option>
              {products.map((p: any) => <option value={p.id} selected={String(p.id) === selectedProductId}>{p.name} (ID: {p.id})</option>)}
            </select>
            <div class="flex gap-2">
              <button type="submit" class="flex-1 rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white cursor-pointer">Filtrar</button>
              {selectedProductId && <a href={Astro.url.pathname} class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-600">Limpiar</a>}
            </div>
          </form>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {selectedProductId && <section class="bg-indigo-50/50 rounded-xl border border-indigo-200 p-5">
          <div class="mb-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Filtro activo</span>
            <h2 class="text-lg font-bold text-slate-900">{selectedProductName ?? `Producto #${selectedProductId}`}</h2>
          </div>
          {productRelations.length === 0 ? <p class="bg-white rounded-lg p-6 text-center text-sm text-slate-500">Este producto aún no tiene lecturas asociadas.</p> :
            <div class="space-y-4">
              {productRelations.map((r: any) => {
                const lId = r.lecturaId ?? r.lectura_id;
                const lTitle = lecturaMap.get(String(lId));
                return <form method="post" class="bg-white p-4 rounded-lg border border-slate-200 space-y-3">
                  <input type="hidden" name="action" value="edit" />
                  <input type="hidden" name="productId" value={selectedProductId} />
                  <input type="hidden" name="lecturaId" value={lId} />
                  <div class="flex items-center justify-between gap-2">
                    <div><p class="text-xs text-slate-400">Lectura</p><p class="text-sm font-semibold text-slate-800">({lId}) {lTitle ?? ""}</p></div>
                    <button type="submit" class="rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white cursor-pointer">Guardar cambios</button>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <label class="block text-xs font-medium text-slate-700">Días de expiración<input type="number" step="1" name="expiration_days" value={valueOf(r, "expiration_days", "expirationDays")} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /></label>
                    <label class="block text-xs font-medium text-slate-700">Número de planes<input type="number" step="1" name="number_of_plans" value={valueOf(r, "number_of_plans", "numberOfPlans")} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /></label>
                    <label class="block text-xs font-medium text-slate-700">Dispositivos simultáneos<input type="number" step="1" name="simultaneous_devices" value={valueOf(r, "simultaneous_devices", "simultaneousDevices")} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /></label>
                    <label class="block text-xs font-medium text-slate-700">Sección de visualización<input type="text" maxlength="255" name="display_section" value={valueOf(r, "display_section", "displaySection")} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /></label>
                  </div>
                </form>;
              })}
            </div>}
        </section>}

        <section class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-4">Todas las relaciones</h2>
          {allRelations.length === 0 ? <p class="py-8 text-center text-sm text-slate-500">No hay ninguna relación creada todavía.</p> :
            <div class="overflow-x-auto"><table class="w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-xs uppercase text-slate-500"><tr><th class="px-3 py-2 font-medium">Producto</th><th class="px-3 py-2 font-medium">Lectura</th><th class="px-3 py-2 font-medium">Configuración</th><th class="px-3 py-2 font-medium text-right">Acción</th></tr></thead>
              <tbody class="divide-y divide-slate-100">{allRelations.map((r: any) => {
                const pId = String(r.productId ?? r.product_id);
                const lId = r.lecturaId ?? r.lectura_id;
                const pName = productMap.get(pId);
                const lTitle = lecturaMap.get(String(lId));
                return <tr>
                  <td class="px-3 py-3 font-medium text-slate-800">({pId}) {pName ?? `Producto #${pId}`}</td>
                  <td class="px-3 py-3 font-medium text-slate-600">({lId}) {lTitle ?? ""}</td>
                  <td class="px-3 py-3 text-xs text-slate-600">Expira: {valueOf(r, "expiration_days", "expirationDays") || "—"} días · Planes: {valueOf(r, "number_of_plans", "numberOfPlans") || "—"} · Dispositivos: {valueOf(r, "simultaneous_devices", "simultaneousDevices") || "—"} · Sección: {valueOf(r, "display_section", "displaySection") || "—"}</td>
                  <td class="px-3 py-3 text-right"><div class="flex justify-end gap-2">
                    <a href={`${Astro.url.pathname}?productId=${encodeURIComponent(pId)}`} class="rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-medium text-indigo-700">Editar</a>
                    <form method="post" class="inline"><input type="hidden" name="action" value="delete" /><input type="hidden" name="productId" value={pId} /><input type="hidden" name="lecturaId" value={lId} /><button type="submit" class="rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-600 cursor-pointer">Quitar</button></form>
                  </div></td>
                </tr>;
              })}</tbody>
            </table></div>}
        </section>
      </div>
    </div>
  </div>
</AdminLayout>
