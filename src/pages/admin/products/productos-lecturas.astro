---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  insertProductLectura,
  deleteProductLectura,
  getAllProductLecturas,
  getProductLecturasByProductId
} from '../../../features/lecturas/db';
import { listAllProducts } from '../../../features/products/db';
import { getAllLecturas } from '../../../features/lecturas/db';

// Opcional: Si tienes una función para listar lecturas, impórtala aquí:
// import { listAllLecturas } from '../../../features/lecturas/db';

const title = "Productos - Lecturas";
let error = "";
let success = "";

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const action = form.get("action");
    const productId = form.get("productId");
    const lecturaId = form.get("lecturaId");

    if (action === "add") {
      await insertProductLectura(env.DB, productId as any, lecturaId as any);
      success = "Relación agregada correctamente.";
    } else if (action === "delete") {
      await deleteProductLectura(env.DB, productId as any, lecturaId as any);
      success = "Relación eliminada.";
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const selectedProductId = Astro.url.searchParams.get("productId") ?? "";
const selectedLecturaId = Astro.url.searchParams.get("lecturaId") ?? "";
const allRelations: any[] = (await getAllProductLecturas(env.DB)) ?? [];
const productRelations: any[] = selectedProductId
  ? ((await getProductLecturasByProductId(env.DB, selectedProductId as any)) ?? [])
  : [];
const products = (await listAllProducts(env.DB, 100)) ?? [];
const lecturas = (await getAllLecturas(env.DB)) ?? [];
// Mapa rápido para mostrar el nombre del producto en las tablas en lugar de solo el ID
const productMap = new Map(products.map((p: any) => [String(p.id), p.name]));
const selectedProductName = selectedProductId ? productMap.get(selectedProductId) : null;
const lecturaMap = new Map(lecturas.map((l: any) => [String(l.id), l.title]));

---

<AdminLayout title={title} active="products">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
          Productos y Lecturas
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Vincula lecturas específicas a cada producto de tu catálogo.
        </p>
      </div>
      <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
        {allRelations.length} relaciones activas
      </span>
    </div>

    <!-- Alertas de estado -->
    {error && (
      <div class="rounded-lg bg-red-50 p-4 border border-red-200 flex items-start gap-3">
        <span class="text-red-600 font-bold">✕</span>
        <p class="text-sm text-red-700 font-medium">{error}</p>
      </div>
    )}

    {success && (
      <div class="rounded-lg bg-emerald-50 p-4 border border-emerald-200 flex items-start gap-3">
        <span class="text-emerald-600 font-bold">✓</span>
        <p class="text-sm text-emerald-700 font-medium">{success}</p>
      </div>
    )}

    <!-- Grid Principal -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- COLUMNA IZQUIERDA: Acciones (4 cols en desktop) -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Tarjeta: Agregar nueva relación -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-1">
            Vincular Lectura
          </h2>
          <p class="text-xs text-slate-500 mb-4">
            Asocia una lectura a un producto existente.
          </p>

          <form method="post" class="space-y-4">
            <input type="hidden" name="action" value="add" />

            <div>
              <label for="add-product" class="block text-xs font-medium text-slate-700 mb-1">
                Producto
              </label>
              <select
                id="add-product"
                name="productId"
                required
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="" disabled selected={!selectedProductId}>
                  Selecciona un producto...
                </option>
                {products.map((p: any) => (
                  <option value={p.id} selected={String(p.id) === selectedProductId}>
                    {p.name} (ID: {p.id})
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="add-lectura" class="block text-xs font-medium text-slate-700 mb-1">
                ID de la Lectura
              </label>
              <select
                id="add-lectura"
                name="lecturaId"
                required
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="" disabled selected={!selectedLecturaId}>
                  Selecciona una lectura...
                </option>
                {lecturas.map((l: any) => (
                  <option value={l.id} selected={String(l.id) === selectedLecturaId}>
                    {l.title} (ID: {l.id})
                  </option>
                ))}
              </select>
              
            </div>

            <button
              type="submit"
              class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 active:bg-indigo-700 transition cursor-pointer"
            >
              + Guardar Relación
            </button>
          </form>
        </div>

        <!-- Tarjeta: Filtrar por Producto -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-1">
            Inspeccionar Producto
          </h2>
          <p class="text-xs text-slate-500 mb-4">
            Filtra para ver únicamente las lecturas de un producto.
          </p>

          <form method="get" class="space-y-3">
            <select
              name="productId"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
            >
              <option value="">-- Ver todos --</option>
              {products.map((p: any) => (
                <option value={p.id} selected={String(p.id) === selectedProductId}>
                  {p.name} (ID: {p.id})
                </option>
              ))}
            </select>

            <div class="flex gap-2">
              <button
                type="submit"
                class="flex-1 rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 transition cursor-pointer"
              >
                Filtrar
              </button>
              {selectedProductId && (
                <a
                  href={Astro.url.pathname}
                  class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition text-center"
                >
                  Limpiar
                </a>
              )}
            </div>
          </form>
        </div>

      </div>

      <!-- COLUMNA DERECHA: Resultados y Tablas (8 cols en desktop) -->
      <div class="lg:col-span-8 space-y-6">

        <!-- Sección condicional: Lecturas del producto filtrado -->
        {selectedProductId && (
          <section class="bg-indigo-50/50 rounded-xl border border-indigo-200 p-5">
            <div class="flex items-center justify-between mb-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">
                  Filtro activo
                </span>
                <h2 class="text-lg font-bold text-slate-900">
                  {selectedProductName ?? `Producto #${selectedProductId}`}
                </h2>
              </div>
              <span class="text-xs font-medium bg-white px-2.5 py-1 rounded-md border border-indigo-100 text-indigo-700">
                {productRelations.length} lectura(s)
              </span>
            </div>

            {productRelations.length === 0 ? (
              <div class="bg-white rounded-lg p-6 text-center border border-dashed border-indigo-200">
                <p class="text-sm text-slate-500">
                  Este producto aún no tiene lecturas asociadas. Usa el panel izquierdo para agregar una.
                </p>
              </div>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {productRelations.map((r) => {
                  const lId = r.lecturaId ?? r.lectura_id;
                  const lTitle = lecturaMap.get(String(lId)); 
                  return (
                    <div class="flex items-center justify-between bg-white p-3.5 rounded-lg border border-slate-200 shadow-xs">
                      <div class="min-w-0 pr-2">
                        <p class="text-xs text-slate-400">Lectura</p>
                        <p class="text-sm font-semibold text-slate-800 truncate">
                         ID:  {lId ?? JSON.stringify(r)}; {lTitle ?? ""}
                        </p>
                      </div>
                      <form method="post">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="productId" value={selectedProductId} />
                        <input type="hidden" name="lecturaId" value={lId} />
                        <button
                          type="submit"
                          class="rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-100 transition cursor-pointer"
                          title="Desvincular lectura"
                        >
                          Quitar
                        </button>
                      </form>
                    </div>
                  );
                })}
              </div>
            )}
          </section>
        )}

        <section class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
          <h2 class="text-base font-semibold text-slate-900 mb-4">
            Todas las relaciones
          </h2>

          {allRelations.length === 0 ? (
            <p class="py-8 text-center text-sm text-slate-500">
              No hay ninguna relación creada todavía.
            </p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-slate-200 text-xs uppercase text-slate-500">
                  <tr>
                    <th class="px-3 py-2 font-medium">Producto</th>
                    <th class="px-3 py-2 font-medium">Lectura</th>
                    <th class="px-3 py-2 font-medium text-right">Acción</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {allRelations.map((r) => {
                    const pId = String(r.productId ?? r.product_id);
                    const lId = r.lecturaId ?? r.lectura_id;
                    const pName = productMap.get(pId);
                    const lTitle = lecturaMap.get(String(lId)); 
                    return (
                      <tr>
                        <td class="px-3 py-3 font-medium text-slate-800">
                          ({pId}) {pName ?? `Producto #${pId}`}
                        </td>
                        <td class="px-3 py-3 font-medium text-slate-600">({lId}) {lTitle ?? ""}</td>
                        <td class="px-3 py-3 text-right">
                          <form method="post" class="inline">
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" name="productId" value={pId} />
                            <input type="hidden" name="lecturaId" value={lId} />
                            <button
                              type="submit"
                              class="rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-100 transition cursor-pointer"
                              title="Desvincular lectura"
                            >
                              Quitar
                            </button>
                          </form>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    </div>
  </div>
</AdminLayout>