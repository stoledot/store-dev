---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSecret } from '../../features/secrets/store';
import { getConfig } from '../../config';
import { formatMoney } from '../../money';
const slugify=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,80)||'plan';
const defaultRefund=`Solicita ayuda sobre un cobro o reembolso escribiendo a [CORREO DE SOPORTE]. Indica el correo de tu cuenta y el cargo. Las solicitudes se revisarán conforme a la legislación aplicable y a las condiciones del servicio. La cancelación detiene renovaciones futuras; el acceso del periodo ya pagado se conserva hasta su fecha de término, salvo que la ley disponga otra cosa.`;
const defaultPrivacy=`Responsable: [NOMBRE LEGAL O COMERCIAL Y DOMICILIO]. Usaremos los datos de cuenta y transacción para crear y administrar tu suscripción, habilitar contenido, procesar pagos con Stripe, atender solicitudes y cumplir obligaciones legales. No almacenamos los datos completos de tu tarjeta; Stripe procesa el pago conforme a sus términos y aviso de privacidad. Para ejercer derechos ARCO o contactar al responsable escribe a [CORREO DE PRIVACIDAD]. Completa identidad, domicilio, contacto, finalidades, transferencias y medios ARCO antes de activar el plan.`;
let error='';
if(Astro.request.method==='POST')try{
 const f=await Astro.request.formData(),action=String(f.get('_action')||'save'),id=String(f.get('id')||crypto.randomUUID());
 if(action==='delete'){await env.DB.prepare("UPDATE content_subscriptions SET status='archived',updated_at=? WHERE id=?").bind(new Date().toISOString(),id).run();return Astro.redirect('/admin/suscripciones?ok=archived',303);}
 const title=String(f.get('title')||'').trim().slice(0,160),slug=slugify(String(f.get('slug')||title)),description=String(f.get('description')||'').trim().slice(0,3000),priceId=String(f.get('stripe_price_id')||'').trim(),amount=Number(f.get('amount_minor')),currency=getConfig().currency.toLowerCase(),interval=String(f.get('interval_unit'))==='year'?'year':'month',count=Number(f.get('interval_count')),status=['active','archived'].includes(String(f.get('status')))?String(f.get('status')):'draft',refund=String(f.get('refund_policy_text')||'').trim().slice(0,8000),privacy=String(f.get('privacy_notice_text')||'').trim().slice(0,12000),privacyUrl=String(f.get('privacy_notice_url')||'').trim().slice(0,500),terms=String(f.get('subscription_terms_text')||'').trim().slice(0,12000),magazineId=String(f.get('magazine_id')||'').trim(),magazineAccess=String(f.get('magazine_access')||'').trim();
 if(!title||!/^[A-Za-z0-9_-]{1,100}$/.test(id)||!/^price_[A-Za-z0-9]+$/.test(priceId)||!Number.isSafeInteger(amount)||amount<1||!Number.isSafeInteger(count)||count<1||count>12)throw new Error('Revisa título, Price ID, importe e intervalo.');
 if(privacyUrl&&!/^https:\/\//i.test(privacyUrl))throw new Error('El enlace al aviso debe usar https://.');
 if(magazineAccess){if(!['latest','all'].includes(magazineAccess)||!magazineId||!(await env.DB.prepare("SELECT id FROM math_magazines WHERE id=? AND status='published'").bind(magazineId).first()))throw new Error('Selecciona una revista publicada y el alcance de ediciones.');}else if(magazineId)throw new Error('Selecciona también el tipo de acceso a la revista.');
 if(status==='active'&&[refund,privacy,terms].some(x=>!x||x.includes('[')))throw new Error('Completa y personaliza las políticas (sin marcas entre corchetes) antes de activar el plan.');
 const now=new Date().toISOString();
 await env.DB.prepare(`INSERT INTO content_subscriptions(id,slug,title,description,stripe_price_id,unit_amount_minor,currency,interval_unit,interval_count,status,refund_policy_text,privacy_notice_text,privacy_notice_url,subscription_terms_text,magazine_id,magazine_access,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET slug=excluded.slug,title=excluded.title,description=excluded.description,stripe_price_id=excluded.stripe_price_id,unit_amount_minor=excluded.unit_amount_minor,currency=excluded.currency,interval_unit=excluded.interval_unit,interval_count=excluded.interval_count,status=excluded.status,refund_policy_text=excluded.refund_policy_text,privacy_notice_text=excluded.privacy_notice_text,privacy_notice_url=excluded.privacy_notice_url,subscription_terms_text=excluded.subscription_terms_text,magazine_id=excluded.magazine_id,magazine_access=excluded.magazine_access,updated_at=excluded.updated_at`).bind(id,slug,title,description,priceId,amount,currency,interval,count,status,refund,privacy,privacyUrl,terms,magazineId||null,magazineAccess||null,now,now).run();
 await env.DB.prepare('DELETE FROM content_subscription_courses WHERE subscription_id=?').bind(id).run();const courseIds=[...new Set(f.getAll('course_id').map(String))].slice(0,250);if(courseIds.length)await env.DB.batch(courseIds.map(courseId=>env.DB.prepare("INSERT INTO content_subscription_courses(subscription_id,course_id) SELECT ?,id FROM school_courses WHERE id=? AND status='published'").bind(id,courseId)));
 return Astro.redirect('/admin/suscripciones?ok=saved',303);
}catch(e){error=e instanceof Error?e.message:'No se pudo guardar el plan.';}
const editId=Astro.url.searchParams.get('edit')||'',editing=editId?await env.DB.prepare('SELECT * FROM content_subscriptions WHERE id=?').bind(editId).first<any>():null;
const courses=(await env.DB.prepare("SELECT id,title,content_kind FROM school_courses WHERE status='published' ORDER BY content_kind,title COLLATE NOCASE").all<any>()).results??[];
const magazines=(await env.DB.prepare("SELECT id,title FROM math_magazines WHERE status='published' ORDER BY title COLLATE NOCASE").all<any>()).results??[];
const selected=(editing?(await env.DB.prepare('SELECT course_id FROM content_subscription_courses WHERE subscription_id=?').bind(editId).all<{course_id:string}>()).results??[]:[]).map(x=>x.course_id);
const plans=(await env.DB.prepare("SELECT s.*,(SELECT COUNT(*) FROM content_subscription_courses sc WHERE sc.subscription_id=s.id) AS content_count,(SELECT COUNT(*) FROM product_content_subscriptions ps WHERE ps.subscription_id=s.id) AS product_count,m.title AS magazine_title FROM content_subscriptions s LEFT JOIN math_magazines m ON m.id=s.magazine_id ORDER BY s.updated_at DESC").all<any>()).results??[];
const keysReady=Boolean(await getSecret(env.DB,'stripe_secret_key')&&await getSecret(env.DB,'stripe_webhook_secret'));
const defaultTerms=`El importe y la periodicidad exactos de este cargo se muestran junto al botón de contratación y en Stripe Checkout. El cobro se repetirá automáticamente con esa periodicidad hasta cancelar. Autorizo expresamente a [NOMBRE DEL COMERCIO] y a Stripe, como procesador de pagos, a realizar cargos recurrentes al método elegido. Puedes cancelar desde Mi cuenta → Suscripciones; la solicitud se procesa de inmediato y detiene la siguiente renovación. Conservas acceso hasta el fin del periodo pagado. Los impuestos aplicables se mostrarán antes del pago. Soporte: [CORREO DE SOPORTE].`;
---
<AdminLayout title="Suscripciones" active="subscriptions"><main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><header class="mb-6"><p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Acceso recurrente</p><h1 class="mt-2 font-serif text-3xl">Suscripciones</h1><p class="mt-2 text-sm text-gray-600">Configura Stripe, planes, políticas legales, cursos, lecturas y acceso a revistas. Webhook: /api/webhook/stripe. {keysReady?'Credenciales configuradas.':'Faltan credenciales de Stripe.'}</p><a class="mt-2 inline-block text-sm underline" href="/admin/revistas">Administrar revistas →</a></header>{error&&<p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}
<section class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><h2 class="text-lg font-semibold">{editing?'Editar plan':'Crear plan'}</h2><form method="POST" class="mt-4 grid gap-4 md:grid-cols-2"><input type="hidden" name="id" value={editing?.id??''}/><label class="text-sm">Nombre<input name="title" required maxlength="160" value={editing?.title??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Slug<input name="slug" value={editing?.slug??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm md:col-span-2">Descripción<textarea name="description" rows="2" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.description??''}</textarea></label>
<fieldset class="md:col-span-2 rounded-xl border border-amber-300 bg-amber-50 p-4"><legend class="px-1 text-sm font-semibold">Condiciones y consentimiento</legend><p class="mb-3 text-xs text-amber-950">El checkout muestra los textos y guarda la versión aceptada. Reemplaza los datos entre corchetes con tus datos reales antes de activar.</p><label class="mb-3 block text-sm">Política de reembolso<textarea name="refund_policy_text" required rows="4" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.refund_policy_text||defaultRefund}</textarea></label><label class="mb-3 block text-sm">Aviso de privacidad<textarea name="privacy_notice_text" required rows="6" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.privacy_notice_text||defaultPrivacy}</textarea></label><label class="mb-3 block text-sm">Enlace al aviso integral (opcional)<input name="privacy_notice_url" type="url" value={editing?.privacy_notice_url??''} placeholder="https://tudominio.mx/aviso-de-privacidad" class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="block text-sm">Condiciones y autorización expresa de cargos recurrentes<textarea name="subscription_terms_text" required rows="6" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.subscription_terms_text||defaultTerms}</textarea></label></fieldset>
<fieldset class="md:col-span-2 rounded-xl border border-indigo-200 bg-indigo-50 p-4"><legend class="px-1 text-sm font-semibold">Acceso a una revista (opcional)</legend><label class="block text-sm">Revista<select name="magazine_id" class="mt-1 block w-full rounded-lg border border-line p-2"><option value="">Esta suscripción no da acceso a una revista</option>{magazines.map(m=><option value={m.id} selected={editing?.magazine_id===m.id}>{m.title}</option>)}</select></label><label class="mt-3 block text-sm">Ediciones incluidas<select name="magazine_access" class="mt-1 block w-full rounded-lg border border-line p-2"><option value="" selected={!editing?.magazine_access}>Sin acceso a revista</option><option value="latest" selected={editing?.magazine_access==='latest'}>Solo la edición más reciente</option><option value="all" selected={editing?.magazine_access==='all'}>Todas las ediciones, anteriores y futuras</option></select></label><p class="mt-2 text-xs text-muted">Después asocia este plan con uno o más productos para ofrecerlo en la tienda.</p></fieldset>
<label class="text-sm">Stripe Price ID<input name="stripe_price_id" required pattern="price_[A-Za-z0-9]+" value={editing?.stripe_price_id??''} class="mt-1 block w-full rounded-lg border border-line p-2 font-mono"/></label><label class="text-sm">Importe (unidad menor)<input name="amount_minor" type="number" min="1" step="1" required value={editing?.unit_amount_minor??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Periodicidad<select name="interval_unit" class="mt-1 block w-full rounded-lg border border-line p-2"><option value="month" selected={editing?.interval_unit!=='year'}>Mes</option><option value="year" selected={editing?.interval_unit==='year'}>Año</option></select></label><label class="text-sm">Cada<input name="interval_count" type="number" min="1" max="12" value={editing?.interval_count??1} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Estado<select name="status" class="mt-1 block w-full rounded-lg border border-line p-2"><option value="draft" selected={!editing||editing.status==='draft'}>Borrador</option><option value="active" selected={editing?.status==='active'}>Activo</option><option value="archived" selected={editing?.status==='archived'}>Archivado</option></select></label>
<fieldset class="rounded-xl border border-line p-4 md:col-span-2"><legend class="px-1 text-sm font-semibold">Cursos y lecturas incluidas</legend><div class="grid max-h-64 gap-2 overflow-auto sm:grid-cols-2">{courses.map(c=><label class="flex items-start gap-2 rounded-lg bg-white p-2 text-sm"><input type="checkbox" name="course_id" value={c.id} checked={selected.includes(c.id)}/><span>{c.content_kind==='reading'?'Lectura':'Curso'} · {c.title}</span></label>)}</div></fieldset><div class="flex gap-3 md:col-span-2"><button class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white">Guardar plan</button>{editing&&<a href="/admin/suscripciones" class="rounded-lg border border-line px-4 py-2.5">Cancelar</a>}</div></form></section>
<section class="mt-8"><h2 class="mb-3 text-lg font-semibold">Planes registrados</h2><div class="overflow-x-auto rounded-xl border border-line"><table class="w-full min-w-[48rem] text-left text-sm"><thead><tr class="bg-gray-50"><th class="p-3">Plan</th><th class="p-3">Precio</th><th class="p-3">Contenido</th><th class="p-3">Estado</th><th class="p-3">Acción</th></tr></thead><tbody>{plans.map(p=><tr class="border-t border-line"><td class="p-3 font-semibold">{p.title}{p.magazine_title&&<div class="text-xs text-indigo-700">{p.magazine_title} · {p.magazine_access==='all'?'Archivo completo':'Edición más reciente'}</div>}</td><td class="p-3">{formatMoney(p.unit_amount_minor,p.currency)} / {p.interval_count} {p.interval_unit}</td><td class="p-3">{p.content_count} cursos/lecturas · {p.product_count} productos</td><td class="p-3">{p.status}</td><td class="p-3"><a class="underline" href={`/admin/suscripciones?edit=${encodeURIComponent(p.id)}`}>Editar</a></td></tr>)}</tbody></table></div></section></main></AdminLayout>
