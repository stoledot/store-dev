---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
const email=decodeURIComponent(Astro.params.email??'').trim().toLowerCase();
const profile=await env.DB.prepare('SELECT full_name FROM customer_profiles WHERE email=? COLLATE NOCASE').bind(email).first<{full_name:string}>();
if(!email||email.length>254)return new Response('Correo inválido',{status:400});
---
<AdminLayout title="Conversación" active="messages"><a href="/admin/messages" class="text-sm text-gray-500 hover:underline">← Volver al buzón</a><header class="my-5"><h1 class="break-all font-serif text-2xl sm:text-3xl">{profile?.full_name||email}</h1><p class="mt-1 text-sm text-gray-500">{email}</p></header>
<section class="overflow-hidden rounded-xl border border-line bg-white"><div id="chat-messages" class="h-[60vh] min-h-72 overflow-y-auto overscroll-contain p-3 sm:p-5"><p class="py-8 text-center text-sm text-gray-500">Cargando conversación…</p></div><div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2"><p id="chat-status" class="text-xs text-gray-500"></p><button id="chat-load-older" type="button" hidden class="rounded-lg border border-line px-3 py-1.5 text-xs font-semibold hover:bg-gray-50">Cargar mensajes anteriores ↑</button></div><form id="chat-form" class="flex items-end gap-2 border-t border-line p-3 sm:p-4"><textarea id="chat-body" rows="2" maxlength="5000" required placeholder="Responder al alumno…" class="min-h-12 max-h-36 flex-1 resize-y rounded-lg border border-line px-3 py-2.5 text-sm"></textarea><button class="rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white">Enviar</button></form></section>
<script define:vars={{email}}>
    const box = document.querySelector('#chat-messages');
    const form = document.querySelector('#chat-form');
    const input = document.querySelector('#chat-body');
    const status = document.querySelector('#chat-status');
    const olderButton = document.querySelector('#chat-load-older');

    if (
        !(box instanceof HTMLDivElement) ||
        !(form instanceof HTMLFormElement) ||
        !(input instanceof HTMLTextAreaElement) ||
        !(status instanceof HTMLElement) ||
        !(olderButton instanceof HTMLButtonElement)
    ) {
        throw new Error('No se encontraron todos los elementos del chat.');
    }
    const api='/api/admin/customers/'+encodeURIComponent(email)+'/messages';
    let oldest='',loading=false,hasMore=false,firstLoad=true;const known=new Set();
    function render(m,prepend=false){if(known.has(m.id))return;known.add(m.id);const row=document.createElement('article');row.className=`mb-3 flex ${m.sender_role==='admin'?'justify-end':'justify-start'}`;const b=document.createElement('div');b.className=`max-w-[88%] rounded-2xl px-3 py-2.5 text-sm ${m.sender_role==='admin'?'bg-gray-900 text-white rounded-br-sm':'bg-gray-100 text-gray-900 rounded-bl-sm'}`;const l=document.createElement('p');l.className='mb-1 text-[11px] font-semibold opacity-70';l.textContent=m.sender_role==='admin'?'Administración':'Alumno';const body=document.createElement('p');body.className='whitespace-pre-wrap break-words';body.textContent=m.body;const d=document.createElement('p');d.className='mt-1 text-[10px] opacity-70';d.textContent=new Date(m.created_at).toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'});b.append(l,body,d);row.append(b);prepend?box.prepend(row):box.append(row);if(!oldest||m.created_at<oldest)oldest=m.created_at;}
    async function load(before='',prepend=false){if(loading)return;loading=true;const h=box.scrollHeight;try{const r=await fetch(api+(before?'?before='+encodeURIComponent(before):''),{cache:'no-store'}),data=await r.json();if(!r.ok)throw Error(data.error||'Error');if(!known.size && (data.messages||[]).length)box.innerHTML='';if(data.cursor&&!oldest)oldest=data.cursor;const incoming=data.messages||[];for(const m of (prepend?[...incoming].reverse():incoming))render(m,prepend);hasMore=!!data.hasMore;if(prepend)box.scrollTop=box.scrollHeight-h;else if(!before&&firstLoad){box.scrollTop=box.scrollHeight;firstLoad=false;}status.textContent=hasMore?'Desplázate hacia arriba para cargar mensajes anteriores.':'Historial conservado.';olderButton.hidden=!hasMore;if(!known.size)box.innerHTML='<p class="py-12 text-center text-sm text-gray-500">No hay mensajes. Puedes iniciar la conversación.</p>';}catch(e){status.textContent=e instanceof Error?e.message:'Error de conexión';}finally{loading=false;}}
    box.addEventListener('scroll',()=>{if(box.scrollTop<50&&hasMore&&!loading&&oldest)load(oldest,true)});olderButton.addEventListener('click',()=>{if(hasMore&&oldest)load(oldest,true)});form.addEventListener('submit',async e=>{e.preventDefault();const body=input.value.trim();if(!body)return;
    const btn = form.querySelector('button');
    if (!(btn instanceof HTMLButtonElement)) {
        return;
    }

    btn.disabled=true;
    try{
        const r=await fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({body})}),data=await r.json();
        if(!r.ok)throw Error(data.error||'No se pudo enviar');
        if(!known.size)box.innerHTML='';
        render(data.message);
        input.value='';
        box.scrollTop=box.scrollHeight;status.textContent='Respuesta enviada.';}catch(e){status.textContent=e instanceof Error?e.message:'Error al enviar';}finally{btn.disabled=false;input.focus();}});load();setInterval(()=>load(),12000);
</script></AdminLayout>
