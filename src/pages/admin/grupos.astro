---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isForbiddenFormOrigin } from '../../features/auth/formOrigin';
import { getStorage } from '../../features/storage';
import { uploadMedia, validateUpload } from '../../features/media/upload';
import { optimizeUpload } from '../../features/products/imageOptimize';
let error='';
if(Astro.request.method==='POST'){
 if(isForbiddenFormOrigin(Astro.request,Astro.url))return new Response('Origen no permitido',{status:403});const f=await Astro.request.formData(),action=String(f.get('action')||'save'),id=String(f.get('id')||crypto.randomUUID()),title=String(f.get('title')||'').trim().slice(0,120),description=String(f.get('description')||'').trim().slice(0,1000);let image=String(f.get('image_url')||'').trim().slice(0,500);const file=f.get('group_image');if(file instanceof File&&file.size){const invalid=validateUpload(file);if(invalid)error=invalid;else image=`/images/${(await uploadMedia(env.DB,getStorage(),await optimizeUpload(file),file.name)).image_key}`;}const slug=(String(f.get('slug')||title).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')).slice(0,100);
 try{if(error)throw new Error(error);if(action==='delete')await env.DB.prepare("UPDATE social_groups SET status='archived',updated_at=datetime('now') WHERE id=?").bind(id).run();else{if(!title||!slug)throw new Error('Agrega nombre y dirección del grupo.');if(f.get('id'))await env.DB.prepare("UPDATE social_groups SET slug=?,title=?,description=?,image_url=?,updated_at=datetime('now') WHERE id=?").bind(slug,title,description,image,id).run();else await env.DB.prepare('INSERT INTO social_groups(id,slug,title,description,image_url) VALUES(?,?,?,?,?)').bind(id,slug,title,description,image).run()}return Astro.redirect('/admin/grupos?saved=1',303)}catch(e){error=e instanceof Error?e.message:'No se pudo guardar.'}
}
const groups=(await env.DB.prepare("SELECT g.*,(SELECT COUNT(*) FROM social_group_members m WHERE m.group_id=g.id) AS members FROM social_groups g WHERE status='active' ORDER BY title").all<any>()).results??[];const editId=Astro.url.searchParams.get('edit'),edit=groups.find(g=>g.id===editId);
---
<AdminLayout title="Grupos sociales" active="social-groups"><main class="mx-auto max-w-5xl p-6"><h1 class="text-3xl font-semibold">Grupos de la comunidad</h1><p class="mt-2 text-sm text-muted">Crea los espacios en los que las personas pueden reunirse y publicar.</p>{error&&<p class="mt-4 rounded bg-red-50 p-3 text-red-800">{error}</p>}<form method="post" enctype="multipart/form-data" class="my-6 grid gap-3 rounded-xl border border-line bg-surface p-5 sm:grid-cols-2"><input type="hidden" name="id" value={edit?.id||''}/><label class="grid gap-1 text-sm">Nombre<input required name="title" value={edit?.title||''} class="rounded border border-line bg-background p-2"/></label><label class="grid gap-1 text-sm">Dirección (slug)<input name="slug" value={edit?.slug||''} placeholder="se-genera-del-nombre" class="rounded border border-line bg-background p-2"/></label><label class="grid gap-1 text-sm sm:col-span-2">Descripción<textarea name="description" rows="3" class="rounded border border-line bg-background p-2">{edit?.description||''}</textarea></label><label class="grid gap-1 text-sm sm:col-span-2">Imagen de portada<input name="group_image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="rounded border border-line bg-background p-2"/>{edit?.image_url&&<input type="hidden" name="image_url" value={edit.image_url}/>}<span class="text-xs text-muted">JPEG, PNG, WebP o GIF; hasta 5 MB.</span></label><button class="w-fit rounded bg-brand px-4 py-2 font-semibold text-white">{edit?'Guardar cambios':'Crear grupo'}</button></form><div class="grid gap-3">{groups.map(g=><article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-4"> <div class="flex items-center gap-3">{g.image_url&&<img src={g.image_url} alt="" class="h-14 w-14 rounded object-cover"/>}<div><h2 class="font-semibold">{g.title}</h2><p class="text-sm text-muted">/grupos/{g.slug} · {g.members} miembros</p></div></div><div class="flex gap-2"><a class="rounded border border-line px-3 py-2 text-sm" href={`/admin/grupos?edit=${g.id}`}>Editar</a><form method="post"><input type="hidden" name="action" value="delete"/><input type="hidden" name="id" value={g.id}/><button class="rounded border border-line px-3 py-2 text-sm text-red-700">Archivar</button></form></div></article>)}</div></main></AdminLayout>
