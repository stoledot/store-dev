---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
const rows=(await env.DB.prepare('SELECT * FROM advertising_inquiries ORDER BY created_at DESC LIMIT 200').all<any>()).results??[];
const format=(v:string)=>v==='views'?'Visualizaciones mensuales':v==='budget'?'Presupuesto mensual':'Patrocinio / otro';
---
<AdminLayout title="Propuestas publicitarias" active="advertising"><main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><a class="text-sm underline" href="/admin">← Administración</a><header class="my-5"><p class="text-xs font-semibold uppercase tracking-widest text-muted">Contacto comercial</p><h1 class="mt-2 font-serif text-3xl">Propuestas publicitarias</h1><p class="mt-2 text-sm text-muted">Las nuevas solicitudes también se envían al correo de notificaciones configurado en Ajustes.</p></header>{rows.length?<div class="space-y-3">{rows.map((r:any)=><article class="rounded-2xl border border-line bg-surface p-5"><div class="flex flex-wrap justify-between gap-3"><div><h2 class="text-lg font-semibold">{r.company_name}</h2><p class="text-sm">{r.contact_name} · <a class="underline" href={`mailto:${r.email}`}>{r.email}</a>{r.phone?` · ${r.phone}`:''}</p>{r.website&&<a class="text-sm underline" href={r.website} target="_blank" rel="noopener noreferrer">{r.website}</a>}</div><time class="text-xs text-muted">{r.created_at}</time></div><p class="mt-3 text-sm font-medium">{format(r.format_preference)}{r.monthly_views?` · ${r.monthly_views.toLocaleString()} vistas/mes`:''}{r.monthly_budget_minor?` · $${(r.monthly_budget_minor/100).toFixed(2)} MXN/mes`:''}</p>{r.message&&<p class="mt-2 whitespace-pre-wrap text-sm text-muted">{r.message}</p>}</article>)}</div>:<p class="rounded-xl border border-dashed p-8 text-sm text-muted">Todavía no hay propuestas.</p>}</main></AdminLayout>
