---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const courseId = String(Astro.url.searchParams.get('course') ?? '').trim();
const courses = (await env.DB.prepare("SELECT id,title,slug,status FROM school_courses WHERE source_format='xml' ORDER BY title COLLATE NOCASE").all<{id:string;title:string;slug:string;status:string}>()).results ?? [];
const selected = courses.find((course) => course.id === courseId);
const assets = selected ? ((await env.DB.prepare('SELECT asset_ref,file_name,content_type,byte_size,updated_at FROM school_course_download_assets WHERE course_id=? ORDER BY asset_ref').bind(courseId).all<{asset_ref:string;file_name:string;content_type:string;byte_size:number;updated_at:string}>()).results ?? []) : [];
const ok = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Archivos descargables" active="school">
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <header class="mb-6">
      <p class="text-xs uppercase tracking-widest text-gray-400">Material privado en R2</p>
      <h1 class="mt-2 text-3xl font-semibold">Archivos descargables</h1>
      <p class="mt-2 max-w-3xl text-sm text-gray-600">Carga un archivo y asígnale una referencia. El mismo valor debe aparecer en el atributo <code>ref</code> de un bloque XML <code>&lt;download&gt;</code>.</p>
      <nav class="mt-3 flex gap-4 text-sm"><a class="underline" href="/admin/escuela">Escuela</a><a class="underline" href="/admin/escuela/xml">Cursos XML</a><a class="underline" href={`/admin/escuela/geogebra${courseId?`?course=${encodeURIComponent(courseId)}`:''}`}>Construcciones GeoGebra</a></nav>
    </header>
    {Astro.url.searchParams.get('error') && <p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{Astro.url.searchParams.get('error')}</p>}
    {ok === 'subido' && <p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Archivo guardado en R2 y asociado a la referencia.</p>}
    {ok === 'retirado' && <p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Archivo retirado.</p>}
    <section class="rounded-xl border border-line p-5">
      <form method="GET" class="flex flex-wrap items-end gap-3">
        <label class="min-w-64 flex-1 text-sm">Curso XML<select name="course" required class="mt-1 block w-full rounded border p-2"><option value="">Selecciona un curso</option>{courses.map((course)=><option value={course.id} selected={course.id===courseId}>{course.title} · {course.status}</option>)}</select></label>
        <button class="rounded-lg border px-4 py-2">Ver archivos</button>
      </form>
    </section>
    {selected && <>
      <section class="mt-5 rounded-xl border border-line p-5">
        <h2 class="text-lg font-semibold">Cargar o reemplazar archivo</h2>
        <form method="POST" action="/api/admin/escuela/descargas" enctype="multipart/form-data" class="mt-4 grid gap-4 md:grid-cols-2">
          <input type="hidden" name="course_id" value={selected.id}/><input type="hidden" name="action" value="upload"/>
          <label class="text-sm">Referencia XML (<code>ref</code>)<input required name="ref" maxlength="80" pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,79}" class="mt-1 block w-full rounded border p-2" placeholder="guia-unidad-1"/></label>
          <p class="text-sm text-gray-600">El título que verá el alumno se define en <code>title</code> dentro del XML. El nombre del archivo se conserva aquí para identificarlo en administración.</p>
          <label class="text-sm md:col-span-2">Archivo (máximo 25 MB)<input required type="file" name="file" accept=".pdf,.txt,.zip,.png,.jpg,.jpeg,.webp,.docx,.xlsx,.pptx" class="mt-1 block w-full rounded border p-2"/></label>
          <div class="md:col-span-2"><button class="rounded-lg bg-brand px-5 py-3 font-semibold text-white">Guardar archivo en R2</button></div>
        </form>
        <p class="mt-3 text-xs text-gray-500">Al usar una referencia que ya existe, reemplaza el archivo y conserva todos los enlaces del curso.</p>
      </section>
      <section class="mt-5 rounded-xl border border-line p-5">
        <h2 class="text-lg font-semibold">Archivos asociados a {selected.title}</h2>
        {assets.length ? <div class="mt-3 divide-y">{assets.map((asset)=><article class="flex flex-wrap items-center justify-between gap-4 py-4"><div><p class="font-semibold">{asset.asset_ref}</p><p class="text-sm text-gray-600">{asset.file_name} · {(asset.byte_size/1024/1024).toFixed(2)} MB</p><p class="text-xs text-gray-500">{asset.content_type} · actualizado {asset.updated_at}</p></div><form method="POST" action="/api/admin/escuela/descargas"><input type="hidden" name="course_id" value={selected.id}/><input type="hidden" name="action" value="delete"/><input type="hidden" name="ref" value={asset.asset_ref}/><button class="rounded-lg border border-red-200 px-3 py-2 text-sm text-red-700">Retirar</button></form></article>)}</div> : <p class="mt-3 text-sm text-gray-600">Todavía no hay archivos asociados.</p>}
      </section>
      <section class="mt-5 rounded-xl bg-gray-50 p-5"><h2 class="font-semibold">Ejemplo de uso en el XML</h2><pre class="mt-2 overflow-x-auto text-sm">{`<download ref="guia-unidad-1" title="Descargar guía">PDF con ejercicios de la unidad</download>`}</pre></section>
    </>}
  </main>
</AdminLayout>
