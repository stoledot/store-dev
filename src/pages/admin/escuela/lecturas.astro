---
import { env } from 'cloudflare:workers';
import { getAllLecturas, getLecturaById } from '../../../features/lecturas/db';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {validateLecturaXml, lecturaXmlToHtml} from '../../../features/lecturas/lectura_xml_to_html';

export const prerender = false;

let xml = "";
let html = "";
let errors: string[] = [];
let message = "";
let titulo = "";
let id = "";

function validId(value: string): boolean {
  return /^[1-9]\d*$/.test(value) && Number.isSafeInteger(Number(value));
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  xml = String(form.get("xml") ?? "");
  titulo = String(form.get("titulo") ?? "");
  id = String(form.get("id") ?? "");
  const action = String(form.get("action") ?? "validate");
  try {
    const validation = validateLecturaXml(xml);
    errors = validation.errors;
    if (validation.valid) html = lecturaXmlToHtml(xml);
  } catch (e: unknown) {
    errors = [e instanceof Error ? e.message : String(e)];
  }

  if (action === "save") {
    if (errors.length) {
      message = "No se guardó: corrige los errores de validación.";
    } else if (!titulo.trim()) {
      message = "No se guardó: falta el título.";
    } else if (id && !validId(id)) {
      message = "No se guardó: el ID de la lectura no es válido.";
    } else {
      try {
        const result = id
          ? await env.DB.prepare(
              'UPDATE school_lecturas SET title = ?, content_xml = ?, content_html = ?, updated_at = ? WHERE id = ? RETURNING id'
            ).bind(titulo, xml, html, new Date().toISOString(), Number(id)).first<{ id: number }>()
          : await env.DB.prepare(
              "INSERT INTO school_lecturas (title, id_from_xml, content_xml, content_html) VALUES (?, '', ?, ?) RETURNING id"
            ).bind(titulo, xml, html).first<{ id: number }>();
        if (!result) {
          message = id ? "No se guardó: la lectura ya no existe." : "No se pudo crear la lectura.";
        } else {
          return Astro.redirect(`${Astro.url.pathname}?id=${result.id}&guardado=1`, 303);
        }
      } catch (e: unknown) {
        message = "Error al guardar: " + (e instanceof Error ? e.message : String(e));
      }
    }
  } else if (action !== "validate") {
    message = "Acción no reconocida.";
  }
} else {
  id = Astro.url.searchParams.get("id") ?? "";
  if (id && !validId(id)) {
    message = "El ID de la lectura no es válido.";
  } else if (id) {
    const lectura = await getLecturaById(env.DB, Number(id));
    if (!lectura) {
      message = "La lectura seleccionada ya no existe.";
    } else {
      titulo = lectura.title;
      xml = lectura.content_xml;
      if (Astro.url.searchParams.get("guardado") === "1") message = "Guardado correctamente.";
    }
  }
  if (xml) {
    try {
      const validation = validateLecturaXml(xml);
      errors = validation.errors;
      if (validation.valid) html = lecturaXmlToHtml(xml);
    } catch (e: unknown) {
      errors = [e instanceof Error ? e.message : String(e)];
    }
  }
}

const lecturas = await getAllLecturas(env.DB);
---

<AdminLayout title="Lecturas XML" active="readings">
    <h1>Gestión de Lecturas XML</h1>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 text-zinc-800">
  <form method="post" class="space-y-6">
    <input type="hidden" name="id" value={id} />

    <!-- BARRA SUPERIOR DE ACCIONES -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-5 border-b border-zinc-200">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-teal-600">Gestión de contenido</span>
        <h1 class="text-xl sm:text-2xl font-bold text-zinc-900 tracking-tight">Editor de Lecturas XML</h1>
        <p class="text-sm text-zinc-500 mt-1">{id ? `Editando lectura ID: ${id}` : "Nueva lectura"}</p>
      </div>

      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        <a
          href={Astro.url.pathname}
          class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium text-teal-700 bg-white border border-teal-300 rounded-lg hover:bg-teal-50"
        >Nueva lectura</a>
        <button
          type="submit"
          name="action"
          value="validate"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 hover:border-zinc-400 active:bg-zinc-100 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Validar</span>
        </button>

        <button
          type="submit"
          name="action"
          value="save"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-zinc-900 rounded-lg hover:bg-zinc-800 active:bg-zinc-950 shadow-sm transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{id ? "Guardar cambios" : "Crear lectura"}</span>
        </button>
      </div>
    </header>

    <!-- MENSAJE DE ESTADO GLOBAL -->
    {message && (
      <div
        role="alert"
        class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium border ${
          message.startsWith("Guardado")
            ? "bg-teal-50/80 border-teal-200 text-teal-900"
            : "bg-red-50/80 border-red-200 text-red-900"
        }`}
      >
        <span
          class={`w-2 h-2 rounded-full shrink-0 ${
            message.startsWith("Guardado") ? "bg-teal-500" : "bg-red-500"
          }`}
        />
        <p>{message}</p>
      </div>
    )}

    <!-- ESPACIO DE TRABAJO PRINCIPAL -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- PANEL IZQUIERDO: EDITOR (7 columnas en desktop) -->
      <section class="lg:col-span-7 bg-white rounded-2xl border border-zinc-200/90 shadow-xs overflow-hidden">
        
        <!-- Título estilo documento -->
        <div class="p-5 sm:p-6 border-b border-zinc-100">
          <label for="titulo" class="sr-only">Título de la lectura</label>
          <input
            id="titulo"
            type="text"
            name="titulo"
            placeholder="Escribe el título de la lectura aquí..."
            value={titulo}
            class="w-full text-lg sm:text-xl font-bold text-zinc-900 placeholder-zinc-300 bg-transparent border-none focus:outline-none focus:ring-0 p-0"
          />
        </div>

        <!-- Barra de herramientas del código -->
        <div class="px-5 py-3 bg-zinc-50 border-b border-zinc-200/80 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-zinc-200/70 text-zinc-700">
              XML
            </span>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Código fuente</h2>
          </div>

          <label
            for="lectura-xml-file"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-teal-700 bg-teal-50 hover:bg-teal-100/80 border border-teal-200/80 rounded-lg cursor-pointer transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <span>Importar .xml</span>
            <input
              id="lectura-xml-file"
              type="file"
              accept=".xml,application/xml,text/xml"
              class="sr-only"
            />
          </label>
        </div>

        <!-- Textarea del editor -->
        <div class="relative bg-zinc-950">
          <textarea
            id="lectura-xml-editor"
            name="xml"
            spellcheck="false"
            placeholder="<!-- Pega tu código XML o importa un archivo desde tu equipo -->"
            class="w-full h-[48vh] lg:h-[60vh] p-5 font-mono text-xs sm:text-sm leading-relaxed text-zinc-100 bg-transparent placeholder-zinc-600 focus:outline-none resize-y selection:bg-teal-500/30"
          >{xml}</textarea>
        </div>
      </section>

      <!-- PANEL DERECHO: VALIDACIÓN Y VISTA PREVIA (5 columnas en desktop) -->
      <aside class="lg:col-span-5 space-y-5 lg:sticky lg:top-6">
        
        <!-- Bloque de Validación -->
        <div id="lectura-diagnostico" class="bg-white rounded-2xl border border-zinc-200/90 shadow-xs p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Diagnóstico XML</h2>
            {errors.length ? (
              <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-red-100 text-red-700">
                {errors.length} {errors.length === 1 ? "error" : "errores"}
              </span>
            ) : xml ? (
              <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-teal-100 text-teal-700">
                Válido
              </span>
            ) : (
              <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-zinc-100 text-zinc-500">
                En espera
              </span>
            )}
          </div>

          {errors.length ? (
            <div class="bg-red-50 border border-red-200/80 rounded-xl p-3.5 text-red-800">
              <ul class="space-y-1.5 text-xs sm:text-sm list-disc list-inside">
                {errors.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          ) : xml ? (
            <p class="text-sm text-teal-800 bg-teal-50/70 border border-teal-200/70 rounded-xl px-3.5 py-2.5 flex items-center gap-2">
              <svg class="w-4 h-4 text-teal-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>La sintaxis del XML es correcta.</span>
            </p>
          ) : (
            <p class="text-sm text-zinc-500 bg-zinc-50 border border-zinc-200/60 rounded-xl px-3.5 py-2.5">
              Sin contenido para analizar.
            </p>
          )}
        </div>

        <!-- Bloque de Vista Previa -->
        <p id="lectura-pendiente" class="hidden text-sm text-zinc-500">El XML cambió. Presiona Validar para actualizar el diagnóstico y la vista previa.</p>
        <div id="lectura-vista-previa" class="bg-white rounded-2xl border border-zinc-200/90 shadow-xs overflow-hidden">
          <div class="px-5 py-3.5 border-b border-zinc-100 flex items-center justify-between bg-zinc-50/50">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Vista previa del lector</h2>
            <span class="flex gap-1">
              <span class="w-2 h-2 rounded-full bg-zinc-300"></span>
              <span class="w-2 h-2 rounded-full bg-zinc-300"></span>
              <span class="w-2 h-2 rounded-full bg-zinc-300"></span>
            </span>
          </div>

          <div class="p-5 sm:p-6 min-h-[280px] max-h-[54vh] overflow-y-auto">
            {html ? (
              <article class="prose prose-zinc prose-sm sm:prose-base max-w-none" set:html={html} />
            ) : (
              <div class="h-56 flex flex-col items-center justify-center text-center px-4">
                <div class="w-10 h-10 rounded-full bg-zinc-100 flex items-center justify-center text-zinc-400 mb-3">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <p class="text-sm font-medium text-zinc-600">Vista previa vacía</p>
                <p class="text-xs text-zinc-400 mt-1">Presiona <strong class="font-medium text-zinc-600">Validar</strong> para generar la lectura.</p>
              </div>
            )}
          </div>
        </div>

      </aside>
    </div>
  </form>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-zinc-800">
  
  <!-- Cabecera de la sección con contador y buscador -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-6 border-b border-zinc-200">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 tracking-tight">
          Lista de Lecturas
        </h2>
        <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-zinc-100 text-zinc-600 border border-zinc-200/80">
          {lecturas.length}
        </span>
      </div>
      <p class="text-sm text-zinc-500 mt-1">
        Selecciona una lectura para cargar su contenido en el editor.
      </p>
    </div>

    <!-- Buscador rápido (opcional, funciona con el script de abajo) -->
    {lecturas.length > 0 && (
      <div class="relative w-full sm:w-64">
        <svg class="w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="filtro-lecturas"
          type="search"
          placeholder="Filtrar por título..."
          class="w-full pl-9 pr-3.5 py-2 text-sm bg-white border border-zinc-300 rounded-xl placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 transition-all"
        />
      </div>
    )}
  </div>

  {lecturas.length > 0 ? (
    <ul
      id="lista-lecturas"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4"
    >
      {lecturas.map((lectura) => (
        <li class="item-lectura">
          <a
            href={`${Astro.url.pathname}?id=${lectura.id}`}
            aria-current={id === String(lectura.id) ? "true" : undefined}
            class="group w-full text-left p-4 bg-white rounded-xl border border-zinc-200/90 hover:border-teal-500/60 hover:shadow-md hover:shadow-zinc-900/5 active:scale-[0.99] transition-all duration-200 flex items-center justify-between gap-3 cursor-pointer"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <!-- Ícono de documento -->
              <div class="w-10 h-10 rounded-lg bg-zinc-100 text-zinc-500 group-hover:bg-teal-50 group-hover:text-teal-600 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>

              <!-- Título e ID -->
              <div class="min-w-0">
                <p class="text-sm font-semibold text-zinc-900 group-hover:text-teal-700 truncate transition-colors">
                  {lectura.title || "Lectura sin título"}
                </p>
                <span class="text-xs font-mono text-zinc-400 block mt-0.5">
                  ID: {lectura.id}
                </span>
              </div>
            </div>

            <!-- Flecha indicadora -->
            <svg class="w-4 h-4 text-zinc-300 group-hover:text-teal-600 group-hover:translate-x-0.5 shrink-0 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    
    <div id="lista-lecturas" class="bg-zinc-50/70 border border-dashed border-zinc-300 rounded-2xl p-8 sm:p-12 text-center">
      <div class="w-12 h-12 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 mx-auto mb-3 shadow-2xs">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-zinc-900">Aún no hay lecturas guardadas</h3>
      <p class="text-xs text-zinc-500 mt-1 max-w-sm mx-auto">
        Crea una nueva lectura usando el editor superior y aparecerá listada aquí automáticamente.
      </p>
    </div>
  )}
</section>


</main>


<!-- Script ligero para el buscador en tiempo real -->
<script>
  const searchInput = document.querySelector("#filtro-lecturas") as HTMLInputElement | null;
  const items = document.querySelectorAll(".item-lectura");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.toLowerCase().trim();
    items.forEach((item) => {
      const text = item.textContent?.toLowerCase() || "";
      (item as HTMLElement).style.display = text.includes(query) ? "" : "none";
    });
  });

  const fileInput = document.querySelector("#lectura-xml-file") as HTMLInputElement | null;
  const xmlEditor = document.querySelector("#lectura-xml-editor") as HTMLTextAreaElement | null;

  function markPreviewStale() {
    document.getElementById("lectura-diagnostico")?.classList.add("hidden");
    document.getElementById("lectura-vista-previa")?.classList.add("hidden");
    document.getElementById("lectura-pendiente")?.classList.remove("hidden");
  }

  xmlEditor?.addEventListener("input", markPreviewStale);
  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files?.[0];
    if (!file || !xmlEditor) return;
    try {
      xmlEditor.value = await file.text();
      markPreviewStale();
    } catch (error) {
      alert("No se pudo leer el archivo XML: " + (error instanceof Error ? error.message : String(error)));
    }
    fileInput.value = "";
  });
</script>  
</AdminLayout>


