---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { parseReadingXml, validateReadingXml } from '../../../features/mathTexts/xmlReading';
const clean=(v:unknown,n=200)=>String(v??'').trim().slice(0,n);
const slugify=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,80)||'lectura';
let error=Astro.url.searchParams.get('error');
const editId=Astro.url.searchParams.get('edit')||'';const editing=editId?await env.DB.prepare("SELECT id,title,slug,status,xml_source_key,xml_filename FROM school_courses WHERE id=? AND source_format='xml' AND content_kind='reading'").bind(editId).first<any>():null;let editingSource='';if(editing?.xml_source_key&&env.FILES){const old=await env.FILES.get(editing.xml_source_key);if(old)editingSource=await old.text();}
if(Astro.request.method==='POST'){
 try{
  const form=await Astro.request.formData();if(form.get('_action')==='status'){const id=clean(form.get('id'),100),status=form.get('status')==='published'?'published':'draft',now=new Date().toISOString();await env.DB.batch([env.DB.prepare("UPDATE school_courses SET status=?,updated_at=? WHERE id=? AND source_format='xml' AND content_kind='reading'").bind(status,now,id),env.DB.prepare("UPDATE school_lessons SET status=?,updated_at=? WHERE course_id=? AND activity_kind='reading' AND required_to_complete=0 AND EXISTS(SELECT 1 FROM school_courses c WHERE c.id=school_lessons.course_id AND c.source_format='xml' AND c.content_kind='reading')").bind(status,now,id)]);return Astro.redirect('/admin/escuela/lecturas?ok=status',303);}let source=String(form.get('xml_source')??'');const file=form.get('xml_file');let filename=clean(form.get('xml_filename'),200)||'lectura.xml';
  if(file instanceof File&&file.size){if(file.size>1_000_000)throw new Error('El XML no puede superar 1 MB.');if(!file.name.toLowerCase().endsWith('.xml'))throw new Error('El archivo debe tener extensión .xml.');source=await file.text();filename=file.name.replace(/[\r\n"\\]/g,'_').slice(0,200);}
  if(!source.trim())throw new Error('Carga un XML o pega el texto de la lectura.');const issues=validateReadingXml(source);if(issues.length)throw new Error(issues.slice(0,6).map(i=>`Línea ${i.line}, columna ${i.column}: ${i.message}`).join(' '));const reading=parseReadingXml(source);
  if(!env.FILES)throw new Error('El almacenamiento privado FILES no está configurado.');const id=clean(form.get('id'),100)||crypto.randomUUID();if(!/^[A-Za-z0-9_-]{1,100}$/.test(id))throw new Error('El id interno de lectura no es válido.');const existing=await env.DB.prepare("SELECT id FROM school_courses WHERE id=? AND content_kind='reading'").bind(id).first();const existingSlug=await env.DB.prepare('SELECT id FROM school_courses WHERE slug=? AND id<>?').bind(slugify(clean(form.get('slug'),100)||reading.title),id).first();if(existingSlug)throw new Error('Ya hay una lectura o curso con ese slug.');
  const now=new Date().toISOString(),slug=slugify(clean(form.get('slug'),100)||reading.title),key=`school-xml/readings/${id}/${Date.now()}-${filename}`;await env.FILES.put(key,source,{httpMetadata:{contentType:'application/xml; charset=utf-8'},customMetadata:{readingId:id}});
  if(existing){await env.DB.prepare("UPDATE school_courses SET slug=?,title=?,summary=?,status=?,source_format='xml',xml_source_key=?,xml_filename=?,xml_author=?,xml_date=?,content_version=content_version+1,updated_at=? WHERE id=?").bind(slug,reading.title,reading.summary,form.get('status')==='published'?'published':'draft',key,filename,reading.author,reading.date,now,id).run();await env.DB.prepare("UPDATE school_lessons SET status='archived',sequence_no=sequence_no+1000000,updated_at=? WHERE course_id=? AND status<>'archived'").bind(now,id).run();}
  else{const seq=await env.DB.prepare('SELECT COALESCE(MAX(sequence_no),0)+1 AS n FROM school_courses').first<{n:number}>();await env.DB.prepare("INSERT INTO school_courses(id,slug,title,summary,description_md,sequence_no,status,content_version,source_format,xml_source_key,xml_filename,xml_author,xml_date,content_kind,created_at,updated_at) VALUES(?,?,?,?,?,? ,?,1,'xml',?,?,?,?,'reading',?,?)").bind(id,slug,reading.title,reading.summary,'',Number(seq?.n??1),form.get('status')==='published'?'published':'draft',key,filename,reading.author,reading.date,now,now).run();}
  for(let i=0;i<reading.cards.length;i++){const card=reading.cards[i],lessonId=crypto.randomUUID(),lessonSlug=`lectura-${slugify(card.id)}-${lessonId.slice(0,8)}`,refs=[...card.html.matchAll(/data-reading-geogebra="([^"]+)"/g)].map(m=>m[1]),assessment=JSON.stringify({version:2,questions:[],blocks:refs.map(ref=>({type:'geogebragraphics',ref}))});await env.DB.prepare("INSERT INTO school_lessons(id,course_id,slug,title,summary,content_md,content_html,sequence_no,lesson_type,status,required_to_complete,content_version,assessment_json,tex_node_id,activity_kind,xml_section_id,xml_section_title,xml_section_slug,xml_lesson_id,xml_lesson_title,created_at,updated_at) VALUES(?,?,?,?,?,'',?,?, 'reading',?,0,1,?,?,'reading',?,?,?,?,?,?,?)").bind(lessonId,id,lessonSlug,card.title,`Apartado de nivel ${card.level}`,card.html,i+1,form.get('status')==='published'?'published':'draft',assessment,card.id,card.id,card.title,slugify(card.id),card.id,card.title,now,now).run();}
  return Astro.redirect(`/admin/escuela/lecturas?ok=guardada`,303);
 }catch(e){error=e instanceof Error?e.message:'No se pudo guardar la lectura.';}
}
const readings=(await env.DB.prepare("SELECT id,title,slug,status,xml_author,xml_date,xml_filename,updated_at FROM school_courses WHERE content_kind='reading' AND source_format='xml' ORDER BY updated_at DESC LIMIT 100").all<any>()).results??[];
const ok=Astro.url.searchParams.get('ok');
---
<AdminLayout title="Lecturas XML" active="readings">
 <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6"><a href="/admin/escuela" class="text-sm underline">← Cursos y lecciones</a><header class="my-5"><p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Biblioteca editorial</p><h1 class="mt-2 font-serif text-3xl">Lecturas XML</h1><p class="mt-2 max-w-3xl text-sm text-gray-600">Carga lecturas con secciones anidadas, ambientes matemáticos, HTML seguro, LaTeX y referencias a GeoGebra. La navegación se construye a partir de tus section, subsection y subsubsection.</p></header>
 {error&&<p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}{ok&&<p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Lectura guardada y lista en el catálogo de lectura.</p>}
 <section class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><h2 class="text-lg font-semibold">{editing?'Editar lectura':'Subir lectura'}</h2><form method="POST" enctype="multipart/form-data" class="mt-4 space-y-4">{editing&&<input type="hidden" name="id" value={editing.id}/>}<label class="block text-sm">Archivo XML<input class="mt-1 block w-full" type="file" name="xml_file" accept=".xml,text/xml"/>{editing&&<span class="mt-1 block text-xs text-muted">Actual: {editing.xml_filename}. Si no eliges archivo, pega la fuente actual y guárdala.</span>}</label><label class="block text-sm">O pega el XML<textarea id="reading-xml" name="xml_source" rows="18" class="mt-1 block w-full rounded-lg border border-line p-3 font-mono text-xs" placeholder="<?xml version=\"1.0\" encoding=\"UTF-8\"?>&#10;&lt;lectura&gt;...&lt;/lectura&gt;">{editingSource}</textarea></label><div class="flex flex-wrap items-center gap-3"><label class="text-sm">Estado<select name="status" class="ml-2 rounded border border-line p-2"><option value="draft" selected={editing?.status==='draft'}>Borrador</option><option value="published" selected={editing?.status==='published'}>Publicada</option></select></label><button type="button" id="validate-reading" class="rounded-lg border border-line px-4 py-2 text-sm">Validar y previsualizar</button><button class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white">Guardar lectura</button>{editing&&<a class="rounded-lg border border-line px-4 py-2 text-sm" href="/admin/escuela/lecturas">Cancelar</a>}</div></form><div id="reading-errors" class="mt-4 hidden rounded-lg bg-red-50 p-3 text-sm text-red-800"></div><div id="reading-preview" class="mt-4 hidden space-y-3"></div></section>
 <section class="mt-7"><h2 class="mb-3 text-lg font-semibold">Lecturas cargadas</h2><div class="overflow-x-auto rounded-xl border border-line"><table class="w-full text-left text-sm"><thead><tr class="bg-gray-50"><th class="p-3">Lectura</th><th class="p-3">Autor / archivo</th><th class="p-3">Estado</th><th class="p-3">Acciones</th></tr></thead><tbody>{readings.map(r=><tr class="border-t border-line"><td class="p-3 font-medium">{r.title}<div class="text-xs text-gray-500">/lecturas/{r.slug}</div></td><td class="p-3">{r.xml_author}<div class="text-xs text-gray-500">{r.xml_filename}</div></td><td class="p-3">{r.status}</td><td class="p-3"><div class="flex flex-wrap gap-3"><a class="underline" href={`/admin/escuela/lecturas?edit=${encodeURIComponent(r.id)}`}>Editar XML</a>{r.status==='published'&&<a class="underline" href={`/lecturas/${r.slug}`} target="_blank">Abrir</a>}<form method="POST" class="flex items-center gap-2"><input type="hidden" name="_action" value="status"/><input type="hidden" name="id" value={r.id}/><input type="hidden" name="status" value={r.status==='published'?'draft':'published'}/><button class="underline">{r.status==='published'?'Pasar a borrador':'Publicar'}</button></form></div></td></tr>)}{!readings.length&&<tr><td colspan="4" class="p-5 text-center text-gray-500">Aún no hay lecturas XML.</td></tr>}</tbody></table></div></section></main>
 <script>
 const button=document.querySelector<HTMLButtonElement>('#validate-reading'),input=document.querySelector<HTMLTextAreaElement>('#reading-xml'),errors=document.querySelector<HTMLDivElement>('#reading-errors'),preview=document.querySelector<HTMLDivElement>('#reading-preview');
 const fileInput=document.querySelector<HTMLInputElement>('input[name="xml_file"]');fileInput?.addEventListener('change',async()=>{const file=fileInput.files?.[0];if(file&&input)input.value=await file.text();});
 button?.addEventListener('click',async()=>{if(!input||!errors||!preview)return;errors.classList.add('hidden');preview.classList.add('hidden');try{const response=await fetch('/api/admin/escuela/lecturas/validar',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({source:input.value})});const data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo validar.');const head=document.createElement('article');head.className='rounded-xl border border-line bg-white p-4';const title=document.createElement('strong');title.textContent=data.title;const byline=document.createElement('p');byline.className='text-sm';byline.textContent=`${data.author} · ${data.date||'Sin fecha'}`;const summary=document.createElement('p');summary.className='mt-2 text-sm';summary.textContent=data.summary;head.append(title,byline,summary);preview.replaceChildren(head);for(const cardData of data.cards){const card=document.createElement('article');card.className='rounded-xl border border-line bg-white p-4';const h=document.createElement('h3');h.className='font-semibold';h.textContent=cardData.title;const body=document.createElement('div');body.className='math-content mt-3';body.innerHTML=cardData.html;card.append(h,body);preview.append(card);}preview.classList.remove('hidden');window.renderLatexContent?.(preview);}catch(e){errors.textContent=e instanceof Error?e.message:'XML no válido.';errors.classList.remove('hidden');}});
 </script>
</AdminLayout>
