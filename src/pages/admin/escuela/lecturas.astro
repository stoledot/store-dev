---
import { env } from 'cloudflare:workers';
import {createLectura, updateLectura, getLecturaByIdFromXml} from '../../../features/lecturas/db';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {validateLecturaXml, lecturaXmlToHtml} from '../../../features/lecturas/lectura_xml_to_html';

const lecturasModules = import.meta.glob("/src/**/lecturas_xml_to_html.*", { eager: true });

export const prerender = false;

let xml = "";
let html = "";
let errors: string[] = [];
let message = "";
let titulo = "";
let id = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  xml = String(form.get("xml") ?? "");
  titulo = String(form.get("titulo") ?? "");
  id = String(form.get("id") ?? "");
  const action = String(form.get("action") ?? "validate");

  try {
    html = lecturaXmlToHtml(xml);
  } catch (e: any) {
    errors = [e?.message ?? String(e)];
  }

  if (action === "save") {
    if (errors.length) {
      message = "No se guardó: corrige los errores de validación.";
    } else if (!titulo.trim()) {
      message = "No se guardó: falta el título.";
    } else {
      try {
        const row = { title: titulo, id_from_xml: id, content_xml: xml, content_html: html };
        const result: any = id
          ? await updateLectura(env.DB, Number(id), row)
          : await createLectura(env.DB, row);
        if (result?.error) {
          message = "Error al guardar: " + (result.error.message ?? result.error);
        } else {
          message = "Guardado correctamente.";
          const createdId = result?.id;
          if (!id && createdId) id = String(createdId);
        }
      } catch (e: any) {
        message = "Error al guardar: " + (e?.message ?? e);
      }
    }
  }
  else if (action === "validate") {
    try {
      validateLecturaXml(xml);
    } catch (e: any) {
      errors = [e?.message ?? String(e)];
    }
  }

}
---

<AdminLayout title="Lecturas XML" active="readings">
    <main>

    {message && <p class={message.startsWith("Guardado") ? "ok" : "errors"}>{message}</p>}
    <form method="post">
      <input type="hidden" name="id" value={id} />
      <div class="grid">
        <div class="panel">
          <label for="lectura-xml-file">Cargar XML desde el equipo</label>
          <input id="lectura-xml-file" type="file" accept=".xml,application/xml,text/xml" />
          <h2>Editor XML</h2>
          <input type="text" name="titulo" placeholder="Título" value={titulo} />
          <textarea id="lectura-xml-editor" name="xml" spellcheck="false">{xml}</textarea>
          <div style="margin-top:.5rem">
            <button type="submit" name="action" value="validate">Validar / Previsualizar</button>
            <button type="submit" name="action" value="save">Guardar</button>
          </div>
        </div>
        <div class="panel">
          <h2>Validación</h2>
          {errors.length ? (
            <div class="errors"><ul>{errors.map((e) => <li>{e}</li>)}</ul></div>
          ) : xml ? (
            <p class="ok">XML válido</p>
          ) : (
            <p>Sin contenido.</p>
          )}
          <h2>Vista previa</h2>
          <div set:html={html} />
        </div>
      </div>
    </form>

    </main>

</AdminLayout>

<script>
  const fileInput = document.querySelector("#lectura-xml-file") as HTMLInputElement | null;
  const xmlEditor = document.querySelector("#lectura-xml-editor") as HTMLTextAreaElement | null;

  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files?.[0];
    if (file && xmlEditor) xmlEditor.value = await file.text();
  });
</script>

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Lecturas - Admin Escuela</title>
    <style>
      body { font-family: sans-serif; margin: 0; padding: 1rem; background: #f5f5f5; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      textarea { width: 100%; height: 60vh; font-family: monospace; font-size: 13px; }
      input[type="text"] { width: 100%; padding: .4rem; margin-bottom: .5rem; box-sizing: border-box; }
      .panel { background: #fff; padding: 1rem; border-radius: 8px; }
      .errors { background: #fee; color: #900; padding: .5rem 1rem; border-radius: 6px; }
      .ok { background: #efe; color: #060; padding: .5rem 1rem; border-radius: 6px; }
      button { padding: .5rem 1rem; margin-right: .5rem; cursor: pointer; }
    </style>
  </head>
  <body>
    
  </body>
</html>
