---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
const submissions=(await env.DB.prepare(`SELECT p.id AS progress_id,p.student_email,p.student_response,p.submission_at,p.grade,p.feedback,p.graded_at,p.submission_file_key,p.submission_file_name,l.title AS lesson_title,l.slug AS lesson_slug,l.lesson_type,l.grading_weight,l.assessment_json,l.tex_node_id,c.title AS course_title,c.slug AS course_slug FROM school_lesson_progress p JOIN school_lessons l ON l.id=p.lesson_id JOIN school_courses c ON c.id=l.course_id WHERE p.submission_at IS NOT NULL ORDER BY CASE WHEN p.grade IS NULL THEN 0 ELSE 1 END,p.submission_at DESC LIMIT 250`).all<{progress_id:string;student_email:string;student_response:string;submission_at:string;grade:number|null;feedback:string;graded_at:string|null;submission_file_key:string|null;submission_file_name:string|null;lesson_title:string;lesson_slug:string;lesson_type:string;grading_weight:number;assessment_json:string;tex_node_id:string|null;course_title:string;course_slug:string}>()).results ?? [];
const parseAnswers=(raw:string, assessmentRaw:string):[string,string][]=>{let value:Record<string,string>;try{const parsed=JSON.parse(raw);value=parsed&&typeof parsed==='object'?parsed:{general:raw};}catch{value={general:raw};}let labels:Record<string,string>={};try{const parsed=JSON.parse(assessmentRaw);for(const q of (Array.isArray(parsed.questions)?parsed.questions:[]))if(q&&typeof q.id==='string'&&typeof q.prompt==='string')labels[q.id]=q.prompt;}catch{}return Object.entries(value).map(([key,answer])=>[labels[key]||(key==='general'?'Respuesta':key),String(answer??'')]);};
---
<AdminLayout title="Calificar entregas" active="school">
  <main class="mx-auto max-w-5xl px-4 py-8"><p class="text-xs uppercase tracking-widest text-gray-500">Escuela de Matemáticas</p><h1 class="mt-2 text-3xl font-semibold">Entregas y calificaciones</h1><p class="mt-2 text-sm text-gray-600">Revisa respuestas, descarga archivos, asigna una nota de 0 a 10 en unidades TeX (y conserva 0 a 100 en las lecciones antiguas) y deja retroalimentación. El peso se configura por lección en <a class="underline" href="/admin/escuela/evaluaciones">Evaluaciones</a>. <a class="ml-2 underline" href="/admin/escuela/orden-lecciones">Ordenar lecciones</a>.</p>
    {submissions.length ? <div class="space-y-5">{submissions.map((s)=>{const answers=parseAnswers(s.student_response,s.assessment_json);return <section class="rounded-xl border border-line p-5" data-grade-card data-progress-id={s.progress_id} data-scale={s.tex_node_id ? '10' : '100'}>
      <div class="flex flex-wrap justify-between gap-3"><div><h2 class="font-semibold">{s.lesson_title}</h2><p class="mt-1 text-sm text-gray-500">{s.student_email} · {s.course_title}</p><p class="text-xs text-gray-500">Entregada: {s.submission_at} · Peso: {s.grading_weight} · {s.lesson_type}</p></div><span class="rounded border border-line px-3 py-1 text-sm">{s.grade===null?'Pendiente de calificar':s.tex_node_id?`${(s.grade/10).toFixed(1)}/10`:`${s.grade}/100`}</span></div>
      <div class="mt-4 space-y-3">{answers.map(([label,value])=><div class="rounded bg-gray-50 p-3"><p class="text-xs font-semibold uppercase text-gray-500">{label}</p><p class="mt-1 whitespace-pre-wrap break-words text-sm">{value}</p></div>)}</div>
      {s.submission_file_key && <p class="mt-3 text-sm">Archivo: <a class="underline" href={`/api/admin/escuela/entregas/${s.progress_id}/archivo`}>{s.submission_file_name||'Descargar entrega'}</a></p>}
      <form class="grade-form mt-4 grid gap-3"><label class="text-sm">Calificación ({s.tex_node_id?'0–10':'0–100'})<input class="grade-input mt-1 block w-full max-w-xs rounded border border-line p-2" type="number" min="0" max={s.tex_node_id?'10':'100'} step="0.1" required value={s.grade===null?'':s.tex_node_id?s.grade/10:s.grade}/></label><label class="text-sm">Retroalimentación<textarea class="feedback-input mt-1 block w-full rounded border border-line p-2" rows="4" maxlength="10000">{s.feedback||''}</textarea></label><p class="text-xs text-gray-500">{s.graded_at?`Última revisión: ${s.graded_at}`:'Aún no calificada'}</p><div><button class="rounded bg-brand px-4 py-2 text-sm text-white" type="submit">Guardar calificación y retroalimentación</button><span class="grade-message ml-3 text-sm" aria-live="polite"></span></div></form>
    </section>})}</div> : <p class="rounded-xl border border-line p-6 text-sm">Todavía no hay entregas. Aparecerán aquí cuando los alumnos envíen actividades.</p>}
  </main>
  <script>
    document.querySelectorAll<HTMLFormElement>('.grade-form').forEach((form)=>form.addEventListener('submit',async(event)=>{
      event.preventDefault();const card=form.closest<HTMLElement>('[data-grade-card]');const message=form.querySelector<HTMLElement>('.grade-message');const grade=Number(form.querySelector<HTMLInputElement>('.grade-input')?.value);const feedback=form.querySelector<HTMLTextAreaElement>('.feedback-input')?.value||'';
      const scale=card?.dataset.scale==='10'?10:100; if(!Number.isFinite(grade)||grade<0||grade>scale){if(message)message.textContent=scale===10?'Usa una nota de 0 a 10.':'Usa una nota de 0 a 100.';return;}
      const button=form.querySelector<HTMLButtonElement>('button');if(button)button.disabled=true;
      try{const response=await fetch('/api/admin/escuela/calificar-entrega',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({progressId:card?.dataset.progressId,grade,feedback,scale})});const result=await response.json().catch(()=>({})) as {error?:string};if(!response.ok)throw new Error(result.error||'No se pudo guardar.');if(message)message.textContent='Guardado.';const badge=card?.querySelector<HTMLElement>('.rounded.border.border-line.px-3');if(badge)badge.textContent=scale===10?`${grade}/10`:`${grade}/100`;}catch(error){if(message)message.textContent=error instanceof Error?error.message:'Error al guardar.';}finally{if(button)button.disabled=false;}
    }));
  </script>
</AdminLayout>
