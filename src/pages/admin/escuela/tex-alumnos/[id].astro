---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
const courseId=Astro.params.id??''; const email=(Astro.url.searchParams.get('email')??'').trim().toLowerCase();
const course=await env.DB.prepare('SELECT id,title,slug,content_kind FROM school_courses WHERE id=?').bind(courseId).first<{id:string;title:string;slug:string;content_kind:string}>();
if(!course||!email) return Astro.redirect('/admin/escuela/tex-alumnos',303);
const purchased=await env.DB.prepare(`SELECT 1 AS yes FROM school_courses c JOIN order_items oi ON oi.school_course_id=c.id JOIN orders o ON o.id=oi.order_id WHERE c.id=? AND lower(trim(o.email))=lower(trim(?)) AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents LIMIT 1`).bind(courseId,email).first();
if(!purchased) return Astro.redirect('/admin/escuela/tex-alumnos',303);
const lessons=(await env.DB.prepare(`SELECT l.id,p.id AS progress_id,l.title,l.slug,l.sequence_no,l.lesson_type,l.activity_kind,l.due_at,l.grading_weight,l.status,p.status AS progress_status,p.submission_at,p.grade,p.feedback,p.student_response,p.submission_file_key,p.submission_file_name,p.last_activity_at,p.graded_at FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' ORDER BY l.sequence_no`).bind(email,courseId).all<{id:string;progress_id:string|null;title:string;slug:string;sequence_no:number;lesson_type:string;activity_kind:string;due_at:string|null;grading_weight:number;status:string;progress_status:string|null;submission_at:string|null;grade:number|null;feedback:string|null;student_response:string|null;submission_file_key:string|null;submission_file_name:string|null;last_activity_at:string|null;graded_at:string|null}>()).results??[];
const gradeableLessons = lessons.filter(
  l => l.activity_kind !== 'reading'
);
const earned=gradeableLessons.reduce((sum,l)=>sum+(l.grade!==null?l.grade:(l.lesson_type==='reading'&&l.progress_status==='completed'?100:0))*l.grading_weight,0);const totalWeight=gradeableLessons.reduce((sum,l)=>sum+l.grading_weight,0);const grade10=totalWeight?earned/totalWeight/10:null;
const prettyResponse=(raw:string|null)=>{if(!raw)return '';try{const parsed=JSON.parse(raw);if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed))return Object.entries(parsed).map(([k,v])=>`${k}: ${String(v??'')}`).join('\n');}catch{}return raw;};
---
<AdminLayout title="Expediente de alumno" active="school">
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6"><a href="/admin/escuela/tex-alumnos" class="text-sm underline">← Alumnos por curso</a><header class="mt-4 rounded-xl border border-line p-5"><p class="text-xs uppercase tracking-wider text-gray-500">Expediente individual</p><h1 class="mt-2 text-2xl font-semibold">{email}</h1><p class="mt-1 text-sm text-gray-500">{course.title}</p><p class="mt-4 text-lg font-semibold">Calificación ponderada provisional: {grade10===null?'Sin actividades calificables':grade10.toFixed(2)+'/10'}</p><p class="mt-1 text-sm text-gray-500">Las actividades pendientes cuentan como cero provisional; el resultado cambia cuando se califican.</p><a class="mt-3 inline-block underline" href="/admin/escuela/calificaciones">Ir a calificar entregas</a></header>
    <div class="mt-6 space-y-4">{lessons.map(l=><section class="rounded-xl border border-line p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs uppercase text-gray-500">Unidad {l.sequence_no} · {l.activity_kind}</p><h2 class="mt-1 text-lg font-semibold">{l.title}</h2><p class="mt-1 text-xs text-gray-500">Estado: {l.progress_status??'Sin iniciar'} · Peso: {l.grading_weight}{l.due_at?` · Fecha límite: ${l.due_at}`:''}</p></div><span class="rounded-lg border border-line px-3 py-1 text-sm">{l.grade===null?'Sin calificar':l.activity_kind!=='reading'?`${(l.grade/10).toFixed(1)}/10`:`${l.grade}/100`}</span></div>{l.student_response&&<div class="mt-4 rounded-lg bg-gray-50 p-3"><p class="text-xs font-semibold uppercase text-gray-500">Respuesta enviada</p><pre class="mt-2 whitespace-pre-wrap break-words text-sm">{prettyResponse(l.student_response)}</pre></div>}{l.submission_file_key&&<p class="mt-3 text-sm">Archivo: <a class="underline" href={`/api/admin/escuela/entregas/${l.progress_id}/archivo`}>{l.submission_file_name??'Descargar'}</a></p>}{l.feedback&&<div class="mt-3 rounded-lg border border-line p-3"><p class="text-xs font-semibold uppercase text-gray-500">Retroalimentación enviada</p><p class="mt-2 whitespace-pre-wrap text-sm">{l.feedback}</p></div>}</section>)}</div>
  </main>
</AdminLayout>
