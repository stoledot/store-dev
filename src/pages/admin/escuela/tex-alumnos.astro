---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
const rows=(await env.DB.prepare(`SELECT c.id AS course_id,c.title AS course_title,c.slug,c.content_kind,lower(trim(o.email)) AS student_email,MAX(o.created_at) AS purchased_at,COUNT(DISTINCT CASE WHEN l.status='published' THEN l.id END) AS total_lessons,COUNT(DISTINCT CASE WHEN l.status='published' AND lp.status='completed' THEN l.id END) AS completed_lessons,MAX(lp.last_activity_at) AS last_activity FROM school_courses c JOIN order_items oi ON oi.school_course_id=c.id JOIN orders o ON o.id=oi.order_id LEFT JOIN school_lessons l ON l.course_id=c.id LEFT JOIN school_lesson_progress lp ON lp.lesson_id=l.id AND lower(trim(lp.student_email))=lower(trim(o.email)) WHERE c.status='published' AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents AND trim(COALESCE(o.email,''))<>'' GROUP BY c.id,lower(trim(o.email)) ORDER BY c.title,MAX(o.created_at) DESC LIMIT 500`).all<{course_id:string;course_title:string;slug:string;content_kind:string;student_email:string;purchased_at:string;total_lessons:number;completed_lessons:number;last_activity:string|null}>()).results??[];
const courses=(await env.DB.prepare(`SELECT c.id,c.title,c.content_kind,COUNT(DISTINCT lower(trim(o.email))) AS students FROM school_courses c LEFT JOIN order_items oi ON oi.school_course_id=c.id LEFT JOIN orders o ON o.id=oi.order_id AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents WHERE c.status<>'archived' GROUP BY c.id ORDER BY c.title`).all<{id:string;title:string;content_kind:string;students:number}>()).results??[];
---
<AdminLayout title="Alumnos de cursos TeX" active="school">
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><header class="mb-7"><p class="text-xs uppercase tracking-widest text-gray-500">Seguimiento académico</p><h1 class="mt-2 text-3xl font-semibold">Alumnos por curso</h1><p class="mt-2 text-sm text-gray-500">Compras pagadas, avance, última actividad y acceso al expediente individual.</p><nav class="mt-4 flex flex-wrap gap-3 text-sm"><a class="underline" href="/admin/escuela/tex">Administrar archivos TeX</a><a class="underline" href="/admin/escuela/calificaciones">Revisar entregas</a></nav></header>
    <section class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{courses.map(c=><article class="rounded-xl border border-line p-4"><p class="text-xs uppercase text-gray-500">{c.content_kind==='reading'?'Lectura':'Curso'}</p><h2 class="mt-1 font-semibold">{c.title}</h2><p class="mt-2 text-sm text-gray-500">{c.students} compradores con pedidos pagados</p></article>)}</section>
    <section class="rounded-xl border border-line p-4"><h2 class="mb-4 text-xl font-semibold">Expedientes de alumnos</h2>{rows.length===0?<p class="p-4 text-sm text-gray-500">Todavía no hay compras pagadas vinculadas a cursos o lecturas.</p>:<div class="overflow-x-auto"><table class="w-full min-w-[58rem] text-left text-sm"><thead><tr class="border-b border-line text-xs uppercase text-gray-500"><th class="py-3 pr-3">Alumno</th><th class="py-3 pr-3">Curso / lectura</th><th class="py-3 pr-3">Avance</th><th class="py-3 pr-3">Última actividad</th><th class="py-3">Expediente</th></tr></thead><tbody>{rows.map(r=><tr class="border-b border-line"><td class="py-3 pr-3">{r.student_email}</td><td class="py-3 pr-3">{r.course_title}<div class="text-xs text-gray-500">{r.content_kind==='reading'?'Lectura':'Curso'}</div></td><td class="py-3 pr-3">{r.completed_lessons}/{r.total_lessons} unidades <div class="mt-1 h-1.5 w-32 rounded bg-gray-100"><div class="h-1.5 rounded bg-brand" style={`width:${r.total_lessons?Math.round(100*r.completed_lessons/r.total_lessons):0}%`}></div></div></td><td class="py-3 pr-3">{r.last_activity??'Sin actividad'}</td><td class="py-3"><a class="underline" href={`/admin/escuela/tex-alumnos/${encodeURIComponent(r.course_id)}?email=${encodeURIComponent(r.student_email)}`}>Ver alumno →</a></td></tr>)}</tbody></table></div>}</section>
  </main>
</AdminLayout>
