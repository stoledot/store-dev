---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { domanGithubConfig,domanGithubReady,vaultReady } from '../../../features/school/domanGithub';
const cfg=await domanGithubConfig(),connected=await domanGithubReady(),vault=vaultReady(),r2Ready=Boolean(env.FILES);
const rows=(await env.DB.prepare("SELECT id,text_value,category,audio_type,level,mime_type,byte_size,duration_seconds,updated_at,object_key,github_path FROM school_doman_audio_assets WHERE status='active' ORDER BY updated_at DESC").all<{id:string;text_value:string;category:string;audio_type:string;level:string;mime_type:string;byte_size:number;duration_seconds:number;updated_at:string;object_key:string|null;github_path:string}>()).results??[];
const legacyRows=rows.filter(row=>!row.object_key),legacyCopies=rows.filter(row=>row.object_key&&!row.github_path.startsWith('r2://'));
const labels=(await env.DB.prepare('SELECT id,label_kind,label_value FROM school_doman_audio_labels ORDER BY label_kind,label_value COLLATE NOCASE').all<{id:string;label_kind:string;label_value:string}>()).results??[];
const cats=labels.filter(x=>x.label_kind==='category'),types=labels.filter(x=>x.label_kind==='type'),levels=labels.filter(x=>x.label_kind==='level');
const ok=Astro.url.searchParams.get('ok'),error=Astro.url.searchParams.get('error');
---
<AdminLayout title="Audios Doman" active="school">
 <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <header class="mb-6"><a href="/admin/escuela" class="text-sm underline">← Escuela</a><p class="mt-4 text-xs uppercase tracking-widest text-gray-400">Biblioteca de aprendizaje</p><h1 class="mt-2 text-3xl font-semibold">Audios para slides Doman</h1><p class="mt-2 max-w-3xl text-sm text-gray-600">Graba audios en serie y clasifícalos con texto, categoría, tipo y nivel. Los archivos quedan en el bucket privado R2 FILES; la base de datos conserva sus metadatos.</p></header>
  {error&&<p class="mb-4 rounded bg-red-50 p-3 text-sm text-red-800">{error}</p>}{ok&&<p class="mb-4 rounded bg-green-50 p-3 text-sm text-green-800">Cambios guardados: {ok}.</p>}
  <section class="rounded-xl border border-line p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-lg font-semibold">Almacenamiento privado R2</h2><p class="mt-1 text-sm text-gray-600">Las nuevas grabaciones se guardan en FILES y se sirven solo después de validar acceso a la lección.</p></div><span class={`rounded-full px-3 py-1 text-xs ${r2Ready?'bg-green-100 text-green-800':'bg-red-100 text-red-800'}`}>{r2Ready?'Bucket FILES conectado':'Falta el bucket FILES'}</span></div>
   {!r2Ready&&<p class="mt-3 rounded bg-red-50 p-3 text-sm text-red-800">El Worker necesita el binding R2 <code>FILES</code>. Este proyecto ya usa FILES para descargas y GeoGebra; revisa su binding antes de grabar.</p>}
   {legacyRows.length>0&&<div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4"><h3 class="font-semibold text-amber-950">Transferir audios anteriores desde GitHub ({legacyRows.length})</h3><p class="mt-1 text-sm text-amber-900">Los registros actuales seguirán reproduciéndose desde GitHub hasta que los transfieras. Configura la conexión anterior una sola vez y luego usa el botón para pasarlos a R2.</p>{connected?<button id="doman-migrate-all" type="button" class="mt-3 rounded-lg bg-amber-800 px-4 py-2 text-sm font-semibold text-white">Transferir todos a R2</button>:<form method="POST" action="/api/admin/escuela/doman-audio" class="mt-3 grid gap-3 sm:grid-cols-2"><input type="hidden" name="action" value="config"/><label class="text-sm">Propietario<input required name="owner" value={cfg.owner} class="mt-1 block w-full rounded border p-2"/></label><label class="text-sm">Repositorio<input required name="repo" value={cfg.repo} class="mt-1 block w-full rounded border p-2"/></label><label class="text-sm">Rama<input name="branch" value={cfg.branch} class="mt-1 block w-full rounded border p-2"/></label><label class="text-sm">Carpeta de audios<input name="base_path" value={cfg.basePath} class="mt-1 block w-full rounded border p-2"/></label><label class="text-sm sm:col-span-2">Token anterior de GitHub<input name="token" type="password" autocomplete="new-password" required maxlength="500" class="mt-1 block w-full rounded border p-2" placeholder="Solo se usa para transferir archivos antiguos"/></label><div class="sm:col-span-2"><button class="rounded-lg border border-amber-900 px-4 py-2 text-sm font-semibold" disabled={!vault}>Conectar temporalmente para transferir</button></div></form>}</div>}
   {legacyRows.length===0&&connected&&<form method="POST" action="/api/admin/escuela/doman-audio" class="mt-4"><input type="hidden" name="action" value="disconnect-github"/><button class="rounded-lg border px-4 py-2 text-sm">Retirar credencial de GitHub</button><p class="mt-1 text-xs text-gray-500">Esto borra el token cifrado de la aplicación; no elimina archivos ni commits del repositorio.</p></form>}
   {legacyCopies.length>0&&<p class="mt-3 text-xs text-gray-600">{legacyCopies.length} audio(s) ya transferidos aún conservan su archivo en la rama actual de GitHub. Puedes retirar cada copia desde la biblioteca; Git seguirá conservando su historial de commits.</p>}
  </section>
  <section class="mt-5 rounded-xl border border-line p-5"><h2 class="text-lg font-semibold">Definir categorías, tipos y niveles</h2><p class="mt-1 text-sm text-gray-600">Crea los valores de clasificación una vez; después podrás reutilizarlos al grabar.</p><form method="POST" action="/api/admin/escuela/doman-audio" class="mt-4 flex flex-wrap items-end gap-3"><input type="hidden" name="action" value="taxonomy-add"/><label class="text-sm">Atributo<select name="kind" class="mt-1 block rounded border p-2"><option value="category">Categoría</option><option value="type">Tipo</option><option value="level">Nivel</option></select></label><label class="min-w-48 flex-1 text-sm">Nuevo valor<input required name="value" maxlength="80" class="mt-1 block w-full rounded border p-2"/></label><button class="rounded-lg border px-4 py-2">Agregar</button></form><div class="mt-4 grid gap-3 md:grid-cols-3">{[['Categorías',cats],['Tipos',types],['Niveles',levels]].map(([title,values])=><div class="rounded-lg bg-gray-50 p-3"><h3 class="text-sm font-semibold">{title as string}</h3><div class="mt-2 flex flex-wrap gap-2">{(values as typeof labels).map(v=><form method="POST" action="/api/admin/escuela/doman-audio" class="inline-flex items-center gap-1 rounded-full border bg-white px-2 py-1 text-xs"><input type="hidden" name="action" value="taxonomy-delete"/><input type="hidden" name="id" value={v.id}/><span>{v.label_value}</span><button aria-label={`Retirar ${v.label_value}`}>×</button></form>)}</div></div>)}</div></section>
  <section class="mt-5 rounded-xl border border-line p-5"><h2 class="text-lg font-semibold">Grabar y guardar audios</h2><p class="mt-1 text-sm text-gray-600">Al guardar se conserva el texto y los atributos del formulario, para que puedas continuar con la siguiente grabación.</p>
   <form id="doman-audio-form" method="POST" action="/api/admin/escuela/doman-audio" enctype="multipart/form-data" class="mt-4 grid gap-4 md:grid-cols-2"><input type="hidden" name="action" value="upload"/><input id="audio-duration" type="hidden" name="duration_seconds" value="0"/>
    <label class="text-sm md:col-span-2">Texto que aparecerá en la diapositiva<input required name="text_value" maxlength="300" class="mt-1 block w-full rounded border p-2" placeholder="manzana"/></label>
    <label class="text-sm">Categoría<select required name="category" class="mt-1 block w-full rounded border p-2"><option value="">Elige categoría</option>{cats.map(x=><option value={x.label_value}>{x.label_value}</option>)}</select></label><label class="text-sm">Tipo<select required name="audio_type" class="mt-1 block w-full rounded border p-2"><option value="">Elige tipo</option>{types.map(x=><option value={x.label_value}>{x.label_value}</option>)}</select></label><label class="text-sm">Nivel<select required name="level" class="mt-1 block w-full rounded border p-2"><option value="">Elige nivel</option>{levels.map(x=><option value={x.label_value}>{x.label_value}</option>)}</select></label>
    <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm md:col-span-2"><div class="flex flex-wrap items-center gap-2"><button id="record-start" type="button" class="rounded-lg bg-red-700 px-4 py-2.5 font-semibold text-white disabled:opacity-50" disabled={!r2Ready}>● Grabar</button><button id="record-stop" type="button" class="rounded-lg border px-4 py-2.5 disabled:opacity-50" disabled>■ Detener</button><button id="record-again" type="button" class="rounded-lg border px-4 py-2.5" hidden>↻ Repetir grabación</button><button id="record-cancel" type="button" class="rounded-lg border px-4 py-2.5" hidden>Cancelar cuenta regresiva</button><span id="record-status" role="status" aria-live="polite" class="text-gray-700">Listo para grabar</span></div><div id="record-countdown" class="mt-4 hidden rounded-xl bg-white py-5 text-center text-5xl font-bold text-sky-700" aria-live="assertive"></div><div id="recording-indicator" class="mt-4 hidden items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 font-semibold text-red-800"><span class="h-3 w-3 animate-pulse rounded-full bg-red-600"></span><span>Grabando</span><span id="record-elapsed" class="ml-auto font-mono text-sm">00:00</span></div><label class="mt-4 block">O selecciona un archivo de audio<input id="audio-file" required type="file" name="audio" accept="audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav" class="mt-1 block w-full text-sm"/></label><audio id="audio-preview" controls class="mt-3 hidden w-full"></audio><section id="trim-panel" class="mt-4 hidden rounded-xl border border-indigo-200 bg-white p-4"><div class="flex flex-wrap items-start justify-between gap-2"><div><h3 class="font-semibold text-gray-900">Recortar audio</h3><p class="mt-1 text-xs text-gray-600">Ajusta el inicio y el final. Puedes escuchar el fragmento antes de aplicarlo.</p></div><span id="trim-duration" class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-800"></span></div><label class="mt-4 block text-xs font-medium">Quitar desde el inicio: <output id="trim-start-value">0.00 s</output><input id="trim-start" type="range" min="0" max="0" step="0.05" value="0" class="mt-2 block w-full accent-indigo-700"/></label><label class="mt-3 block text-xs font-medium">Quitar desde el final: <output id="trim-end-value">0.00 s</output><input id="trim-end" type="range" min="0" max="0" step="0.05" value="0" class="mt-2 block w-full accent-indigo-700"/></label><div class="mt-4 flex flex-wrap gap-2"><button id="trim-listen" type="button" class="rounded-lg border px-3 py-2 text-sm">▶ Escuchar selección</button><button id="trim-apply" type="button" class="rounded-lg bg-indigo-700 px-3 py-2 text-sm font-semibold text-white">Aplicar recorte</button><button id="trim-reset" type="button" class="rounded-lg border px-3 py-2 text-sm">Restablecer</button></div><p id="trim-status" class="mt-2 text-xs text-gray-600" role="status"></p></section></div>
    <div class="md:col-span-2"><button id="audio-save" class="rounded-lg bg-brand px-5 py-3 font-semibold text-white" disabled={!r2Ready}>Guardar audio en R2</button><p id="audio-result" class="mt-2 text-sm" role="status"></p></div>
   </form>
  </section>
  <section class="mt-5 rounded-xl border border-line p-5"><h2 class="text-lg font-semibold">Biblioteca ({rows.length})</h2>{rows.length?<div class="mt-3 space-y-3">{rows.map(row=><article class="rounded-lg border p-3" data-doman-audio-row data-id={row.id} data-legacy={!row.object_key}><div class="grid gap-3 md:grid-cols-[1fr_1.5fr] md:items-center"><div><p class="font-semibold">{row.text_value}</p><p class={`text-xs font-medium ${row.object_key?'text-green-700':'text-amber-700'}`}>{row.object_key?'Guardado en R2':'Pendiente de transferir desde GitHub'}</p><p class="text-xs text-gray-500">{row.mime_type} · {(row.byte_size/1024).toFixed(0)} KB · {row.duration_seconds.toFixed(1)} s</p><audio controls preload="none" class="mt-2 w-full" src={`/api/admin/escuela/doman-audio?id=${encodeURIComponent(row.id)}`}></audio></div><form method="POST" action="/api/admin/escuela/doman-audio" class="grid gap-2 sm:grid-cols-2"><input type="hidden" name="action" value="update"/><input type="hidden" name="id" value={row.id}/><label class="text-xs">Texto<input name="text_value" required maxlength="300" value={row.text_value} class="mt-1 block w-full rounded border p-2 text-sm"/></label><label class="text-xs">Categoría<input name="category" required maxlength="80" value={row.category} class="mt-1 block w-full rounded border p-2 text-sm"/></label><label class="text-xs">Tipo<input name="audio_type" required maxlength="80" value={row.audio_type} class="mt-1 block w-full rounded border p-2 text-sm"/></label><label class="text-xs">Nivel<input name="level" required maxlength="80" value={row.level} class="mt-1 block w-full rounded border p-2 text-sm"/></label><div class="flex items-end gap-2 sm:col-span-2"><button class="rounded border px-3 py-2 text-sm">Guardar atributos</button></div></form></div>{!row.object_key&&<form method="POST" action="/api/admin/escuela/doman-audio" class="mt-3"><input type="hidden" name="action" value="migrate"/><input type="hidden" name="id" value={row.id}/><button class="rounded border border-amber-300 px-3 py-2 text-sm text-amber-900">Transferir este audio a R2</button></form>}{row.object_key&&!row.github_path.startsWith('r2://')&&connected&&<form method="POST" action="/api/admin/escuela/doman-audio" class="mt-3"><input type="hidden" name="action" value="delete-github-copy"/><input type="hidden" name="id" value={row.id}/><button class="rounded border border-amber-300 px-3 py-2 text-sm text-amber-900" onclick="return confirm('El audio ya está en R2. ¿Retirar su copia actual de GitHub? El historial anterior del repositorio seguirá existiendo.')">Retirar copia actual de GitHub</button></form>}<form method="POST" action="/api/admin/escuela/doman-audio" class="mt-2 text-right"><input type="hidden" name="action" value="delete"/><input type="hidden" name="id" value={row.id}/><button class="rounded border border-red-200 px-3 py-1.5 text-xs text-red-700" onclick="return confirm('¿Retirar este audio de R2?')">Retirar audio</button></form></article>)}</div>:<p class="mt-3 text-sm text-gray-600">Aún no se han guardado audios.</p>}</section>
 </main>
 <script is:inline>
  const form=document.querySelector('#doman-audio-form'),file=document.querySelector('#audio-file'),startButton=document.querySelector('#record-start'),stopButton=document.querySelector('#record-stop'),againButton=document.querySelector('#record-again'),cancelButton=document.querySelector('#record-cancel'),status=document.querySelector('#record-status'),preview=document.querySelector('#audio-preview'),durationField=document.querySelector('#audio-duration'),result=document.querySelector('#audio-result'),countdown=document.querySelector('#record-countdown'),recordingIndicator=document.querySelector('#recording-indicator'),elapsedLabel=document.querySelector('#record-elapsed'),trimPanel=document.querySelector('#trim-panel'),trimStart=document.querySelector('#trim-start'),trimEnd=document.querySelector('#trim-end'),trimStartValue=document.querySelector('#trim-start-value'),trimEndValue=document.querySelector('#trim-end-value'),trimDuration=document.querySelector('#trim-duration'),trimStatus=document.querySelector('#trim-status');
  let recorder=null,micStream=null,parts=[],recordingStarted=0,recordingTimer=null,countdownTimer=null,blobUrl='',originalFile=null,decodedBuffer=null,trimPlaybackTimer=null;
  const saved=['category','audio_type','level'];for(const key of saved){const input=form?.elements.namedItem(key),value=localStorage.getItem('doman:'+key);if(input&&value&&Array.from(input.options||[]).some(o=>o.value===value))input.value=value;input?.addEventListener('change',()=>localStorage.setItem('doman:'+key,input.value));}
  function setPreview(blob){if(blobUrl)URL.revokeObjectURL(blobUrl);blobUrl=URL.createObjectURL(blob);preview.src=blobUrl;preview.classList.remove('hidden');}
  function formatTime(seconds){const value=Math.max(0,Math.floor(seconds));return `${String(Math.floor(value/60)).padStart(2,'0')}:${String(value%60).padStart(2,'0')}`;}
  function updateTrimLabels(){const a=Number(trimStart.value),b=Number(trimEnd.value);trimStartValue.value=`${a.toFixed(2)} s`;trimEndValue.value=`${(decodedBuffer.duration-b).toFixed(2)} s`;trimDuration.textContent=`Fragmento: ${Math.max(0,decodedBuffer.duration-a-b).toFixed(2)} s`;}
  async function loadAudioForTrim(selected){originalFile=selected;decodedBuffer=null;trimStatus.textContent='Preparando vista previa del recorte…';trimPanel.classList.remove('hidden');try{const AudioContextClass=window.AudioContext||window.webkitAudioContext;if(!AudioContextClass)throw new Error('Este navegador no permite previsualizar el recorte.');const context=new AudioContextClass();decodedBuffer=await context.decodeAudioData(await selected.arrayBuffer());await context.close();const max=Math.max(0,decodedBuffer.duration);durationField.value=String(max);trimStart.min='0';trimStart.max=String(Math.max(0,max-0.05));trimStart.value='0';trimEnd.min='0';trimEnd.max=String(Math.max(0,max-0.05));trimEnd.value='0';trimStart.disabled=trimEnd.disabled=max<=0.05;updateTrimLabels();trimStatus.textContent='Puedes recortar el inicio o el final y escuchar el fragmento.';}catch(error){trimPanel.classList.add('hidden');trimStatus.textContent='No se pudo preparar el recorte: '+(error.message||'formato no compatible');}}
  file?.addEventListener('change',()=>{const selected=file.files?.[0];if(!selected)return;durationField.value='0';setPreview(selected);preview.onloadedmetadata=()=>{if(Number.isFinite(preview.duration))durationField.value=String(preview.duration)};status.textContent='Audio cargado. Escúchalo y ajusta el recorte si lo necesitas.';againButton.hidden=false;loadAudioForTrim(selected);});
  startButton?.addEventListener('click',async()=>{try{if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder)throw new Error('Este navegador no admite grabación de audio.');micStream=await navigator.mediaDevices.getUserMedia({audio:true});const stream=micStream;const mime=['audio/webm;codecs=opus','audio/ogg;codecs=opus','audio/mp4'].find(x=>MediaRecorder.isTypeSupported(x));recorder=new MediaRecorder(stream,mime?{mimeType:mime}:undefined);parts=[];countdown.classList.remove('hidden');cancelButton.hidden=false;startButton.disabled=true;status.textContent='Prepárate…';let count=3;countdown.textContent=String(count);countdownTimer=setInterval(()=>{count-=1;if(count>0){countdown.textContent=String(count);return;}clearInterval(countdownTimer);countdownTimer=null;countdown.classList.add('hidden');cancelButton.hidden=true;recordingStarted=Date.now();recorder.ondataavailable=e=>{if(e.data.size)parts.push(e.data)};recorder.onstop=()=>{clearInterval(recordingTimer);recordingTimer=null;stream.getTracks().forEach(t=>t.stop());recordingIndicator.classList.add('hidden');recordingIndicator.classList.remove('flex');stopButton.disabled=true;startButton.disabled=false;againButton.hidden=false;const audioBlob=new Blob(parts,{type:recorder.mimeType||'audio/webm'});const ext=audioBlob.type.includes('ogg')?'ogg':audioBlob.type.includes('mp4')?'m4a':'webm';const audioFile=new File([audioBlob],`grabacion.${ext}`,{type:audioBlob.type});const transfer=new DataTransfer();transfer.items.add(audioFile);file.files=transfer.files;durationField.value=String(audioBlob.duration||((Date.now()-recordingStarted)/1000));setPreview(audioBlob);preview.onloadedmetadata=()=>{if(Number.isFinite(preview.duration))durationField.value=String(preview.duration)};status.textContent='Grabación lista. Escúchala, repítela o recórtala.';loadAudioForTrim(audioFile);};recorder.start();recordingIndicator.classList.remove('hidden');recordingIndicator.classList.add('flex');stopButton.disabled=false;status.textContent='Grabando audio…';recordingTimer=setInterval(()=>{elapsedLabel.textContent=formatTime((Date.now()-recordingStarted)/1000)},250);},1000);}catch(error){clearInterval(countdownTimer);countdownTimer=null;micStream?.getTracks().forEach(t=>t.stop());micStream=null;countdown.classList.add('hidden');cancelButton.hidden=true;startButton.disabled=false;status.textContent=error.message||'No se pudo acceder al micrófono. Revisa los permisos del navegador.';}}
  );
  cancelButton?.addEventListener('click',()=>{clearInterval(countdownTimer);countdownTimer=null;micStream?.getTracks().forEach(t=>t.stop());micStream=null;countdown.classList.add('hidden');cancelButton.hidden=true;startButton.disabled=false;status.textContent='Cuenta regresiva cancelada.';});
  stopButton?.addEventListener('click',()=>{if(recorder?.state==='recording'){recorder.stop();stopButton.disabled=true;status.textContent='Procesando grabación…';}});
  againButton?.addEventListener('click',()=>{if(recorder?.state==='recording')recorder.stop();if(blobUrl)URL.revokeObjectURL(blobUrl);blobUrl='';preview.pause();preview.removeAttribute('src');preview.classList.add('hidden');file.value='';originalFile=null;decodedBuffer=null;trimPanel.classList.add('hidden');durationField.value='0';againButton.hidden=true;startButton.disabled=false;status.textContent='Listo para grabar de nuevo o seleccionar un archivo.';trimStatus.textContent='';});
  trimStart?.addEventListener('input',()=>{const minEnd=Math.max(0,Number(trimStart.value)+0.05);trimEnd.min=String(minEnd);if(Number(trimEnd.value)+Number(trimStart.value)>decodedBuffer.duration-0.05)trimEnd.value=String(Math.max(0,decodedBuffer.duration-Number(trimStart.value)-0.05));updateTrimLabels();});trimEnd?.addEventListener('input',()=>{const minStart=Math.max(0,Number(trimEnd.value)+0.05-decodedBuffer.duration);trimStart.max=String(Math.max(0,decodedBuffer.duration-Number(trimEnd.value)-0.05));if(Number(trimStart.value)>Number(trimStart.max))trimStart.value=trimStart.max;updateTrimLabels();});
  document.querySelector('#trim-listen')?.addEventListener('click',()=>{const from=Number(trimStart.value),to=decodedBuffer.duration-Number(trimEnd.value);preview.pause();preview.currentTime=from;preview.play().catch(()=>{});clearInterval(trimPlaybackTimer);trimPlaybackTimer=setInterval(()=>{if(preview.currentTime>=to){preview.pause();clearInterval(trimPlaybackTimer);trimPlaybackTimer=null;}},40);});
  function encodeWav(buffer,from,to){const sampleRate=buffer.sampleRate,channels=buffer.numberOfChannels,frames=Math.floor((to-from)*sampleRate),dataBytes=frames*channels*2;if(dataBytes+44>20_000_000)throw new Error('El WAV recortado supera el límite de 20 MB. Haz un recorte más corto.');const out=new ArrayBuffer(44+dataBytes),view=new DataView(out);const write=(offset,text)=>{for(let i=0;i<text.length;i++)view.setUint8(offset+i,text.charCodeAt(i));};write(0,'RIFF');view.setUint32(4,36+dataBytes,true);write(8,'WAVE');write(12,'fmt ');view.setUint32(16,16,true);view.setUint16(20,1,true);view.setUint16(22,channels,true);view.setUint32(24,sampleRate,true);view.setUint32(28,sampleRate*channels*2,true);view.setUint16(32,channels*2,true);view.setUint16(34,16,true);write(36,'data');view.setUint32(40,dataBytes,true);let offset=44;for(let i=0;i<frames;i++){for(let c=0;c<channels;c++){const sample=Math.max(-1,Math.min(1,buffer.getChannelData(c)[Math.floor(from*sampleRate)+i]||0));view.setInt16(offset,sample<0?sample*0x8000:sample*0x7fff,true);offset+=2;}}return new Blob([out],{type:'audio/wav'});}
  document.querySelector('#trim-apply')?.addEventListener('click',()=>{if(!decodedBuffer||!originalFile)return;const from=Number(trimStart.value),to=decodedBuffer.duration-Number(trimEnd.value);if(to-from<0.05){trimStatus.textContent='Deja al menos 0.05 segundos de audio.';return;}try{const changed=from>0.001||Number(trimEnd.value)>0.001;if(!changed){trimStatus.textContent='No hay recorte pendiente.';return;}const wav=encodeWav(decodedBuffer,from,to),trimmed=new File([wav],`${originalFile.name.replace(/\.[^.]+$/,'')}-recortado.wav`,{type:'audio/wav'}),transfer=new DataTransfer();transfer.items.add(trimmed);file.files=transfer.files;originalFile=trimmed;setPreview(trimmed);preview.onloadedmetadata=()=>{durationField.value=String(preview.duration||to-from);};trimPanel.classList.add('hidden');status.textContent='Recorte aplicado. Ya puedes guardarlo o repetir la grabación.';againButton.hidden=false;}catch(error){trimStatus.textContent=error.message||'No se pudo aplicar el recorte.';}});
  document.querySelector('#trim-reset')?.addEventListener('click',()=>{if(!originalFile)return;trimPanel.classList.add('hidden');setPreview(originalFile);status.textContent='Audio original restaurado.';loadAudioForTrim(originalFile);});
  form?.addEventListener('submit',async e=>{e.preventDefault();result.textContent='Subiendo audio…';const button=document.querySelector('#audio-save');button.disabled=true;try{const response=await fetch(form.getAttribute('action')||'/api/admin/escuela/doman-audio',{method:'POST',body:new FormData(form),redirect:'follow'});const target=new URL(response.url);if(target.searchParams.has('error'))throw new Error(target.searchParams.get('error'));if(!response.ok)throw new Error('No se pudo guardar el audio.');result.textContent='Audio guardado en R2. Ya puedes iniciar la siguiente grabación.';file.value='';preview.pause();preview.removeAttribute('src');preview.classList.add('hidden');durationField.value='0';status.textContent='Listo para grabar';setTimeout(()=>location.reload(),700);}catch(error){result.textContent=error.message||'Error al guardar';result.className='mt-2 text-sm text-red-700';}finally{button.disabled=false;}});
 </script>
</AdminLayout>
