export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { parseCourseXml, validateCourseXml } from '../../../features/mathTexts/xmlCourse';

const clean=(v:unknown,max=500)=>String(v??'').trim().slice(0,max);
const slugify=(v:string)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,100);
const sha256=async(v:string)=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(v)))).map(b=>b.toString(16).padStart(2,'0')).join('');
const editingId=clean(Astro.url.searchParams.get('id'),100), notice=Astro.url.searchParams.get('ok'), error=Astro.url.searchParams.get('error');
const editing=editingId?await env.DB.prepare('SELECT * FROM school_courses WHERE id=?').bind(editingId).first<any>():null;
let editingSource='';if(editing?.source_format==='xml'&&editing.xml_source_key&&env.FILES){const file=await env.FILES.get(editing.xml_source_key);if(file)editingSource=await file.text();}
if(Astro.request.method==='POST'){
  const form=await Astro.request.formData();
  try{
    let source=String(form.get('xml_source')??''),filename=clean(form.get('xml_filename'),200)||'contenido.xml';const file=form.get('xml_file');
    if(file instanceof File&&file.size){if(file.size>1_000_000)throw new Error('El XML no puede superar 1 MB.');if(!file.name.toLowerCase().endsWith('.xml'))throw new Error('El archivo debe tener extensión .xml.');source=await file.text();filename=file.name.replace(/[\r\n"\\]/g,'_').slice(0,200);}
    if(!source.trim())throw new Error('Carga un archivo XML o pega el contenido en el editor.');if(new TextEncoder().encode(source).byteLength>1_000_000)throw new Error('El XML supera el límite de 1 MB.');
    const issues=validateCourseXml(source);if(issues.length)throw new Error(issues.slice(0,5).map(i=>`Línea ${i.line}, columna ${i.column}: ${i.message} ${i.suggestion}`).join(' '));const parsed=parseCourseXml(source);
    const id=clean(form.get('id'),100)||parsed.id||crypto.randomUUID();if(!/^[A-Za-z0-9_-]{1,100}$/.test(id))throw new Error('El id del curso solo puede usar letras, números, guion y guion bajo.');
    const title=clean(parsed.title,160),slug=slugify(parsed.slug||clean(form.get('slug'),100)||title),summary=clean(parsed.summary,500),author=clean(parsed.author,200);const areaId=clean(form.get('area_id'),100)||null,level=clean(form.get('level_code'),5).toUpperCase()||'N0';const omitted=Number(form.get('omitted_activities_allowed')??0),status=['published','archived'].includes(String(form.get('status')))?String(form.get('status')):'draft',productRaw=clean(form.get('product_id'),20),productId=productRaw&&/^\d+$/.test(productRaw)?Number(productRaw):null;
    if(!title||!slug||!/^N\d{1,2}$/.test(level)||!Number.isSafeInteger(omitted)||omitted<0||omitted>1000)throw new Error('Verifica título, slug, nivel y límite de omisiones.');
    if(parsed.id&&editingId&&parsed.id!==editingId)throw new Error(`El id del XML (${parsed.id}) no coincide con el curso que estás editando (${editingId}).`);
    const existing=await env.DB.prepare('SELECT id,xml_source_key,tex_source_key,tex_filename,xml_filename,content_version,source_format FROM school_courses WHERE id=?').bind(id).first<any>();let previousSource='';if(existing?.xml_source_key&&env.FILES){const prev=await env.FILES.get(existing.xml_source_key);if(prev)previousSource=await prev.text();}
    const duplicate=await env.DB.prepare('SELECT id FROM school_courses WHERE slug=? AND id<>?').bind(slug,id).first();if(duplicate)throw new Error('Ya existe un curso con ese slug.');if(productId!==null){if(!await env.DB.prepare('SELECT id FROM products WHERE id=?').bind(productId).first())throw new Error('El producto asociado no existe.');const used=await env.DB.prepare('SELECT title FROM school_courses WHERE product_id=? AND id<>?').bind(productId,id).first<any>();if(used)throw new Error(`El producto ya está asociado a “${used.title}”.`);}
    if(!env.FILES)throw new Error('El almacenamiento privado FILES no está configurado.');const now=new Date().toISOString(),changed=!existing||previousSource!==source,version=existing?Number(existing.content_version)+(changed?1:0):1;const key=changed||!existing?.xml_source_key?`school-xml/${id}/versions/${version}/source.xml`:existing.xml_source_key;
    if(changed||!existing?.xml_source_key)await env.FILES.put(key,source,{httpMetadata:{contentType:'application/xml; charset=utf-8'},customMetadata:{courseId:id,version:String(version)}});
    const hash=await sha256(source),oldHash=previousSource?await sha256(previousSource):'',writes:any[]=[];const activeStatus=status;
    // Leer las unidades activas antes de sincronizar permite reutilizar sus IDs D1 y dejar intacto el progreso asociado.
    const old=(await env.DB.prepare(`SELECT id,slug,title,content_version,content_hash,tex_node_id,xml_lesson_id,activity_kind,assessment_json,content_html,content_md,xml_policy_json,required_to_complete,due_at,grading_weight,status,sequence_no FROM school_lessons WHERE course_id=? ORDER BY sequence_no,id`).bind(id).all<any>()).results??[];
    if(existing?.xml_source_key)writes.push(env.DB.prepare(`INSERT OR IGNORE INTO school_course_revisions(id,course_id,version,source_key,source_filename,source_hash,change_summary,created_at) VALUES(?,?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),id,Number(existing.content_version),existing.xml_source_key,existing.xml_filename||'contenido.xml',oldHash||await sha256(previousSource),'Versión XML anterior conservada',now));
    else if(existing?.tex_source_key){const oldObject=env.FILES?await env.FILES.get(existing.tex_source_key):null;const legacyHash=oldObject?await sha256(await oldObject.text()):await sha256(existing.tex_source_key);writes.push(env.DB.prepare(`INSERT OR IGNORE INTO school_course_revisions(id,course_id,version,source_key,source_filename,source_hash,change_summary,created_at) VALUES(?,?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),id,Number(existing.content_version),existing.tex_source_key,existing.tex_filename||'contenido.tex',legacyHash,'Fuente TeX original conservada al migrar a XML',now));}
    if(existing)writes.push(env.DB.prepare(`UPDATE school_courses SET slug=?,title=?,summary=?,area_id=?,level_code=?,status=?,omitted_activities_allowed=?,product_id=?,content_kind='course',source_format='xml',xml_source_key=?,xml_filename=?,xml_author=?,content_version=?,xml_policy_json=?,updated_at=? WHERE id=?`).bind(slug,title,summary,areaId,level,status,omitted,productId,key,filename,author,version,JSON.stringify(parsed.policy),now,id));
    else{const seq=await env.DB.prepare('SELECT COALESCE(MAX(sequence_no),0)+1 AS n FROM school_courses').first<any>();writes.push(env.DB.prepare(`INSERT INTO school_courses(id,slug,title,summary,description_md,sequence_no,status,area_id,level_code,omitted_activities_allowed,product_id,content_kind,source_format,xml_source_key,xml_filename,xml_author,content_version,xml_policy_json,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,'course','xml',?,?,?,?,?,?,?)`).bind(id,slug,title,summary,'',Number(seq?.n??1),status,areaId,level,omitted,productId,key,filename,author,version,JSON.stringify(parsed.policy),now,now));}
    writes.push(env.DB.prepare(`INSERT OR IGNORE INTO school_course_revisions(id,course_id,version,source_key,source_filename,source_hash,change_summary,created_at) VALUES(?,?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),id,version,key,filename,hash,changed?'Actualización del contenido XML':'Guardado del curso XML',now));if(productId!==null)writes.push(env.DB.prepare('UPDATE order_items SET school_course_id=? WHERE product_id=? AND school_course_id IS NULL').bind(id,productId));
    writes.push(env.DB.prepare('UPDATE school_lessons SET sequence_no=sequence_no+100000 WHERE course_id=?').bind(id));const claimed=new Set<string>(),seen=new Set<string>();
    // La evaluación JSON guarda preguntas calificables y bloques en orden para que contenido y actividades vuelvan juntos al alumno.
    for(let i=0;i<parsed.units.length;i++){const unit=parsed.units[i],stable=unit.id,unitSlug=`xml-${slugify(stable).slice(0,70)}-${(await sha256(stable)).slice(0,10)}`;const questions=unit.questions.map(question=>({...question,correct:question.type==='multiple_choice'?question.correct[0]??null:question.correct}));const assessment=JSON.stringify({version:2,questions,blocks:unit.blocks});const activityKind=questions.length?'xml_mixed':'reading';const lessonType=questions.length?'exercise':'reading';const weight=unit.weight;const xmlPolicy=JSON.stringify({sectionPolicy:unit.sectionPolicy,excludeFromNumberMaxLessons:unit.excludeFromNumberMaxLessons}),snapshot=JSON.stringify({stableNodeId:stable,title:unit.title,kind:activityKind,html:unit.html,assessment,xmlPolicy,weight:unit.weight,required:unit.required,sectionId:unit.sectionId,sectionTitle:unit.sectionTitle,sectionSlug:unit.sectionSlug,lessonId:unit.lessonId,lessonTitle:unit.lessonTitle});const contentHash=await sha256(snapshot);
      // Cada ID XML estable vuelve a la misma fila de school_lessons; nuevas unidades reciben fila propia para tener progreso independiente.
      const legacyId=unit.lessonId;let prev=old.find((x:any)=>!claimed.has(x.id)&&x.tex_node_id===stable)||old.find((x:any)=>!claimed.has(x.id)&&x.slug===unitSlug)||old.find((x:any)=>!claimed.has(x.id)&&x.xml_lesson_id===legacyId&&x.activity_kind==='reading')||old.find((x:any)=>!claimed.has(x.id)&&x.tex_node_id===legacyId);
      if(prev){claimed.add(prev.id);seen.add(prev.id);const nextVersion=Number(prev.content_version||1)+(prev.content_hash===contentHash?0:1);const previousSnapshot=JSON.stringify({stableNodeId:prev.tex_node_id||prev.slug,title:prev.title,kind:prev.activity_kind,html:prev.content_html,assessment:prev.assessment_json,xmlPolicy:prev.xml_policy_json,weight:prev.grading_weight});const previousContentHash=prev.content_hash||await sha256(previousSnapshot);writes.push(env.DB.prepare(`INSERT OR IGNORE INTO school_lesson_revisions(id,lesson_id,content_version,stable_node_id,content_hash,snapshot_json,created_at) VALUES(?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),prev.id,Number(prev.content_version||1),prev.tex_node_id||prev.slug,previousContentHash,previousSnapshot,now));writes.push(env.DB.prepare(`UPDATE school_lessons SET slug=?,title=?,summary=?,content_md='',content_html=?,sequence_no=?,lesson_type=?,status=?,required_to_complete=?,content_version=?,assessment_json=?,grading_weight=?,tex_node_id=?,activity_kind=?,due_at=NULL,content_hash=?,xml_section_id=?,xml_section_title=?,xml_section_slug=?,xml_lesson_id=?,xml_lesson_title=?,inputlatex_instruction=?,xml_policy_json=?,updated_at=? WHERE id=?`).bind(unitSlug,unit.title,unit.lessonTitle,unit.html,i+1,lessonType,activeStatus,unit.required?1:0,nextVersion,assessment,weight,stable,activityKind,contentHash,unit.sectionId,unit.sectionTitle,unit.sectionSlug??null,unit.lessonId,unit.lessonTitle,unit.inputLatexInstruction??'',xmlPolicy,now,prev.id));writes.push(env.DB.prepare(`INSERT OR IGNORE INTO school_lesson_revisions(id,lesson_id,content_version,stable_node_id,content_hash,snapshot_json,created_at) VALUES(?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),prev.id,nextVersion,stable,contentHash,snapshot,now));}
      else{const lessonId=crypto.randomUUID();seen.add(lessonId);writes.push(env.DB.prepare(`INSERT INTO school_lessons(id,course_id,slug,title,summary,content_md,content_html,sequence_no,lesson_type,status,required_to_complete,content_version,assessment_json,grading_weight,tex_node_id,activity_kind,content_hash,xml_section_id,xml_section_title,xml_section_slug,xml_lesson_id,xml_lesson_title,inputlatex_instruction,xml_policy_json,created_at,updated_at) VALUES(?,?,?,?,?,'',?,?,?,?,?,1,?,?,?,?,?,?,?,?,?,?,?,?, ?,?)`).bind(lessonId,id,unitSlug,unit.title,unit.lessonTitle,unit.html,i+1,lessonType,activeStatus,unit.required?1:0,assessment,weight,stable,activityKind,contentHash,unit.sectionId,unit.sectionTitle,unit.sectionSlug??null,unit.lessonId,unit.lessonTitle,unit.inputLatexInstruction??'',xmlPolicy,now,now));writes.push(env.DB.prepare(`INSERT INTO school_lesson_revisions(id,lesson_id,content_version,stable_node_id,content_hash,snapshot_json,created_at) VALUES(?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),lessonId,1,stable,contentHash,snapshot,now));}
    }
    // Las unidades quitadas se archivan; no se borran entregas, revisiones ni controles de reenvío.
    old.forEach((item:any,i:number)=>{if(!seen.has(item.id))writes.push(env.DB.prepare("UPDATE school_lessons SET status='archived',sequence_no=?,updated_at=? WHERE id=?").bind(1000000+i,now,item.id));});
    writes.push(env.DB.prepare(`UPDATE school_course_progress SET status=CASE WHEN EXISTS(SELECT 1 FROM school_lessons l WHERE l.course_id=? AND l.status='published' AND l.required_to_complete=1) AND NOT EXISTS(SELECT 1 FROM school_lessons l WHERE l.course_id=? AND l.status='published' AND l.required_to_complete=1 AND NOT EXISTS(SELECT 1 FROM school_lesson_progress p WHERE p.lesson_id=l.id AND lower(p.student_email)=lower(school_course_progress.student_email) AND p.status='completed')) THEN 'completed' WHEN EXISTS(SELECT 1 FROM school_lesson_progress p JOIN school_lessons l ON l.id=p.lesson_id WHERE l.course_id=? AND lower(p.student_email)=lower(school_course_progress.student_email)) THEN 'in_progress' ELSE 'not_started' END,completed_at=CASE WHEN NOT EXISTS(SELECT 1 FROM school_lessons l WHERE l.course_id=? AND l.status='published' AND l.required_to_complete=1 AND NOT EXISTS(SELECT 1 FROM school_lesson_progress p WHERE p.lesson_id=l.id AND lower(p.student_email)=lower(school_course_progress.student_email) AND p.status='completed')) THEN COALESCE(completed_at,?) ELSE NULL END,content_version=?,updated_at=? WHERE course_id=?`).bind(id,id,id,id,now,version,now,id));
    // D1 aplica juntas las escrituras de catálogo, revisiones y lecciones para que el curso no quede a medio sincronizar.
    await env.DB.batch(writes);return Astro.redirect(`/admin/escuela/xml?id=${encodeURIComponent(id)}&ok=guardado`,303);
  }catch(e){const msg=e instanceof Error?e.message:'No se pudo guardar el XML.';
  return Astro.redirect(`/admin/escuela/xml${editingId?`?id=${encodeURIComponent(editingId)}&`:'?'}error=${encodeURIComponent(msg.slice(0,1000))}`,303);}
}
const areas=(await env.DB.prepare("SELECT a.id,a.title,p.title AS program_title FROM school_areas a JOIN school_programs p ON p.slug=a.program_slug WHERE a.status='active' AND p.status='active' ORDER BY p.title,a.title").all<any>()).results??[];
const products=(await env.DB.prepare('SELECT p.id,p.name,p.active FROM products p WHERE NOT EXISTS(SELECT 1 FROM school_courses c WHERE c.product_id=p.id AND c.id<>?) ORDER BY p.name COLLATE NOCASE LIMIT 500').bind(editingId).all<any>()).results??[];
const courses=(await env.DB.prepare(`SELECT c.id,c.title,c.slug,c.status,c.product_id,c.xml_filename,p.name AS product_name,(SELECT COUNT(*) FROM school_lessons l WHERE l.course_id=c.id AND l.status='published') AS lesson_count FROM school_courses c LEFT JOIN products p ON p.id=c.product_id WHERE c.source_format='xml' ORDER BY c.updated_at DESC LIMIT 200`).all<any>()).results??[];
---
<AdminLayout title="Cursos XML" active="school">
<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><header class="mb-6"><p class="text-xs uppercase tracking-widest text-gray-400">Autoría de cursos XML</p><h1 class="mt-2 text-3xl font-semibold">Cargar o actualizar cursos</h1><p class="mt-2 max-w-3xl text-sm text-gray-600">XML define secciones, lecciones, contenido y actividades. Los IDs estables conservan el avance al actualizar.</p><nav class="mt-3 flex gap-4 text-sm"><a class="underline" href="/admin/escuela">Escuela</a><a class="underline" href="/admin/escuela/tex">Cursos TeX existentes</a><a class="underline" href={`/admin/escuela/descargas${editingId?`?course=${encodeURIComponent(editingId)}`:''}`}>Archivos descargables en R2</a><a class="underline" href={`/admin/escuela/geogebra${editingId?`?course=${encodeURIComponent(editingId)}`:''}`}>Construcciones GeoGebra</a><a class="underline" href={`/admin/escuela/videos${editingId?`?course=${encodeURIComponent(editingId)}`:''}`}>Videos R2</a></nav></header>
{notice==='guardado'&&<p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">XML guardado; las unidades y el progreso se sincronizaron.</p>}{error&&<p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}
<section class="rounded-xl border border-line p-5"><form method="POST" enctype="multipart/form-data" class="grid gap-4 md:grid-cols-2">
<label class="text-sm">ID del curso<input name="id" maxlength="100" value={editing?.id??''} class="mt-1 block w-full rounded border p-2" placeholder="Se toma de &lt;meta&gt;&lt;id&gt; o se genera"/></label><label class="text-sm">Slug<input name="slug" value={editing?.slug??''} class="mt-1 block w-full rounded border p-2" placeholder="El slug del XML tiene preferencia"/></label>
<label class="text-sm">Área<select name="area_id" class="mt-1 block w-full rounded border p-2"><option value="">Sin área</option>{areas.map((a:any)=><option value={a.id} selected={editing?.area_id===a.id}>{a.program_title} · {a.title}</option>)}</select></label><label class="text-sm">Nivel<select name="level_code" class="mt-1 block w-full rounded border p-2">{['N0','N1','N2','N3','N4','N5'].map(n=><option value={n} selected={(editing?.level_code??'N0')===n}>{n}</option>)}</select></label>
<label class="text-sm">Producto asociado<select name="product_id" class="mt-1 block w-full rounded border p-2"><option value="">Sin producto</option>{products.map((p:any)=><option value={p.id} selected={editing?.product_id===p.id}>#{p.id} · {p.name}</option>)}</select></label><label class="text-sm">Omisiones permitidas<input type="number" min="0" max="1000" name="omitted_activities_allowed" value={editing?.omitted_activities_allowed??0} class="mt-1 block w-full rounded border p-2"/></label>
<label class="text-sm">
  Estado
  <select name="status" class="mt-1 block w-full rounded border p-2">
    <option value="draft" selected={(editing?.status??'draft')==='draft'}>Borrador</option>
    <option value="published" selected={editing?.status==='published'}>Publicado</option>
    <option value="archived" selected={editing?.status==='archived'}>Archivado</option>
  </select>
</label>
<label class="text-sm md:col-span-2">
  Archivo XML
  <input type="file" name="xml_file" accept=".xml,application/xml,text/xml" class="mt-1 block w-full rounded border p-2"/>
  <span class="text-xs text-gray-500">Máximo 1 MB.</span>
</label>
<label class="text-sm md:col-span-2">Nombre del archivo<input name="xml_filename" maxlength="200" value={editing?.xml_filename??'contenido.xml'} class="mt-1 block w-full rounded border p-2"/></label>
<label class="text-sm md:col-span-2">
    Archivo XML actual o para pegar
  <textarea id="xml-source" name="xml_source" rows="22" spellcheck="false" 
  class="mt-1 block w-full rounded border p-3 font-mono text-xs leading-5" 
  placeholder="&lt;?xml version=\'1.0\' encoding=\'UTF-8\'?&gt;">
    {editingSource}
  </textarea>
</label>

<div class="md:col-span-2 flex flex-wrap gap-3"><button class="rounded-lg bg-brand px-5 py-3 font-semibold text-white">Validar y guardar XML</button><button id="preview-xml" type="button" class="rounded-lg border px-5 py-3">Validar y previsualizar</button><a href="/admin/escuela/xml" class="rounded-lg border px-5 py-3">Nuevo</a></div></form>
<div id="xml-errors" class="mt-4 hidden rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert"></div><section id="xml-preview" class="mt-5 hidden"><h2 class="mb-3 text-xl font-semibold">Vista previa del alumno</h2><div id="xml-preview-overview" class="mb-4"></div><div id="xml-preview-items" class="space-y-4"></div></section>
<details class="mt-5 rounded-lg bg-gray-50 p-4"><summary class="cursor-pointer font-semibold">Ver plantilla XML y reglas</summary><pre class="mt-3 whitespace-pre-wrap text-xs leading-5">{`<?xml version="1.0" encoding="UTF-8"?>
<curso>
  <meta><title>Curso ejemplo</title><summary>Resumen</summary><author>Autor</author><id>curso-id</id><slug>curso-ejemplo</slug></meta>
  <section id="unidad-1" title="Unidad 1" weight="1">
    <lesson id="leccion-1" title="Introducción" weight="1" required="true">
      <content><p>Texto con $x^2$ y $$\\frac{a}{b}$$.</p><ul><li>Contenido</li></ul></content>
      <activity id="pregunta-1" type="multiple-choise" weight="2"><question><p>Elige todas: $2+2$</p></question><options><option id="a">Cuatro</option><option id="b">Cinco</option><option id="c">Par</option></options><correct><id>a</id><id>c</id></correct><explanation>Explicación opcional</explanation></activity>
      <download ref="guia-unidad-1" title="Descargar guía">PDF con ejercicios de la unidad</download>
      <geogebragraphics ref="grafica-conjuntos" title="Diagrama de conjuntos">Mueve los puntos para explorar la intersección.</geogebragraphics>
    </lesson>
  </section>
</curso>`}</pre><p class="mt-2 text-xs text-gray-600">Tipos: short, long, choise/choice, multiple-choise/multiple-choice. En el tipo múltiple, el alumno puede elegir hasta la cantidad de claves correctas. Para descargas, administra primero el archivo desde “Archivos descargables en R2”; para gráficas, carga el XML de GeoGebra desde “Construcciones GeoGebra” y usa el mismo ref. XML requiere etiquetas bien formadas: usa &lt;br/&gt; (no &lt;\br&gt;) y cierra elementos. Los nombres de atributos de sección usan title; se acepta tittle por compatibilidad.</p></details></section>
<section class="mt-8 rounded-xl border border-line p-5"><h2 class="mb-4 text-xl font-semibold">Cursos XML existentes</h2><div class="overflow-x-auto"><table class="w-full min-w-[42rem] text-left text-sm"><thead><tr class="border-b"><th class="py-2">Curso</th><th>Producto</th><th>Unidades</th><th>Estado</th><th></th></tr></thead><tbody>{courses.map((c:any)=><tr class="border-b"><td class="py-3"><strong>{c.title}</strong><div class="text-xs text-gray-500">/{c.slug}</div></td><td>{c.product_name??'—'}</td><td>{c.lesson_count}</td><td>{c.status}</td><td><a class="underline" href={`/admin/escuela/xml?id=${encodeURIComponent(c.id)}`}>Editar</a></td></tr>)}</tbody></table></div></section>
</main>
<script is:inline>
const b=document.getElementById('preview-xml'),src=document.getElementById('xml-source'),err=document.getElementById('xml-errors'),wrap=document.getElementById('xml-preview'),items=document.getElementById('xml-preview-items'),overview=document.getElementById('xml-preview-overview');
b?.addEventListener('click',async()=>{err.classList.add('hidden');wrap.classList.add('hidden');try{const r=await fetch('/api/admin/escuela/preview-xml',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({source:src.value})});const data=await r.json();if(!r.ok)throw new Error(data.error||'No se pudo validar.');items.replaceChildren();overview.replaceChildren();const summary=document.createElement('article');summary.className='rounded-2xl border border-gray-200 bg-white p-5';const heading=document.createElement('h3');heading.className='text-lg font-semibold';heading.textContent=data.title;const byline=document.createElement('p');byline.className='mt-1 text-xs text-gray-500';byline.textContent=data.author;const summaryText=document.createElement('p');summaryText.className='mt-2 text-sm text-gray-600';summaryText.textContent=data.summary;const list=document.createElement('ul');list.className='mt-3 space-y-1 text-sm';for(const u of data.units.filter((unit,index,array)=>array.findIndex(other=>other.sectionTitle===unit.sectionTitle)===index)){const group=document.createElement('li');group.textContent=`${u.sectionTitle} · ${data.units.filter(other=>other.sectionTitle===u.sectionTitle).length} lecciones`;list.append(group);}summary.append(heading,byline,summaryText,list);overview.append(summary);for(const u of data.units){const card=document.createElement('article');card.className='rounded-2xl border border-gray-200 bg-white p-5';const context=document.createElement('p');context.className='text-xs text-gray-500';context.textContent=`${u.sectionTitle} · ${u.lessonTitle}`;const title=document.createElement('h3');title.className='mt-1 text-lg font-semibold';title.textContent=u.title;card.append(context,title);for(const block of (u.blocks||[])){if(block.type==='content'||block.type==='inputlatex'){const content=document.createElement('div');content.className=block.type==='inputlatex'?'prose mt-4 max-w-none rounded-lg bg-violet-50 p-3':'prose mt-4 max-w-none';content.innerHTML=block.html;card.append(content);}else if(block.type==='download'){const preview=document.createElement('p');preview.className='mt-4 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900';preview.textContent=`↓ ${block.title} · ref: ${block.ref}${block.description?` · ${block.description}`:''}`;card.append(preview);}else if(block.type==='activity'){const fieldset=document.createElement('fieldset');fieldset.className='mt-4 rounded-xl border p-4';const legend=document.createElement('legend');legend.className='px-1';legend.innerHTML=block.question.prompt;fieldset.append(legend);for(const option of block.question.options||[]){const label=document.createElement('label');label.className='flex gap-2 p-2';const input=document.createElement('input');input.type=block.question.type==='multiple_choice_multi'?'checkbox':'radio';input.disabled=true;const text=document.createElement('span');text.innerHTML=option.label;label.append(input,text);fieldset.append(label);}card.append(fieldset);}}items.append(card);}wrap.classList.remove('hidden');window.renderLatexContent?.(overview);window.renderLatexContent?.(items);}catch(e){err.textContent=e.message;err.classList.remove('hidden');}});
</script>

</AdminLayout>
