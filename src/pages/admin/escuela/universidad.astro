---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const clean=(v:unknown,max=300)=>String(v??'').trim().slice(0,max);
const slugify=(v:string)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,100);
const notice=Astro.url.searchParams.get('ok'),errorParam=Astro.url.searchParams.get('error');let error=errorParam?decodeURIComponent(errorParam):'';
const issueNumber=async(kind:'student'|'teacher')=>{const row=await env.DB.prepare('UPDATE school_number_sequences SET next_value=next_value+1 WHERE sequence_name=? RETURNING next_value-1 AS value').bind(kind).first<{value:number}>();if(!row)throw new Error('No está configurada la secuencia de identificadores.');return `${kind==='student'?'ALU':'DOC'}-${new Date().getUTCFullYear()}-${String(row.value).padStart(6,'0')}`;};
if(Astro.request.method==='POST'){
  if(Astro.request.headers.get('origin')&&Astro.request.headers.get('origin')!==Astro.url.origin)return new Response('Origen no permitido',{status:403});
  const form=await Astro.request.formData(),action=clean(form.get('action'),40),by=clean(Astro.locals.adminEmail,254)||'admin';
  try{
    if(action==='career'){
      const title=clean(form.get('title'),140),slug=slugify(clean(form.get('slug'),100)||title);if(!title||!slug)throw new Error('Escribe el nombre de la carrera.');
      await env.DB.prepare('INSERT INTO school_careers(id,slug,title,description) VALUES(?,?,?,?)').bind(crypto.randomUUID(),slug,title,clean(form.get('description'),1000)).run();
    }else if(action==='cycle'){
      const name=clean(form.get('name'),100),start=clean(form.get('starts_on'),10),end=clean(form.get('ends_on'),10);if(!name||!/^\d{4}-\d{2}-\d{2}$/.test(start)||!/^\d{4}-\d{2}-\d{2}$/.test(end)||start>end)throw new Error('Indica nombre y fechas válidas del ciclo.');
      await env.DB.prepare('INSERT INTO school_academic_cycles(id,name,starts_on,ends_on,status) VALUES(?,?,?,?,?)').bind(crypto.randomUUID(),name,start,end,clean(form.get('status'),12)==='active'?'active':'planned').run();
    }else if(action==='cycle-status'){
      const cycleId=clean(form.get('cycle_id'),100),status=clean(form.get('status'),20);if(!['planned','active','closed','archived'].includes(status))throw new Error('Estado de ciclo inválido.');await env.DB.prepare('UPDATE school_academic_cycles SET status=?,updated_at=? WHERE id=?').bind(status,new Date().toISOString(),cycleId).run();
    }else if(action==='classroom'){
      const code=clean(form.get('classroom_code'),50),name=clean(form.get('name'),120),course=clean(form.get('course_id'),100),cycle=clean(form.get('cycle_id'),100),start=clean(form.get('starts_on'),10),end=clean(form.get('ends_on'),10),capacityRaw=clean(form.get('capacity'),8),capacity=capacityRaw?Number(capacityRaw):null;
      const cycleRow=await env.DB.prepare('SELECT starts_on,ends_on FROM school_academic_cycles WHERE id=?').bind(cycle).first<{starts_on:string;ends_on:string}>();if(!code||!name||!course||!cycleRow||!/^\d{4}-\d{2}-\d{2}$/.test(start)||!/^\d{4}-\d{2}-\d{2}$/.test(end)||start>end||start<cycleRow.starts_on||end>cycleRow.ends_on||(capacity!==null&&(!Number.isInteger(capacity)||capacity<1||capacity>10000)))throw new Error('Verifica curso, ciclo, fechas dentro del ciclo y cupo.');
      await env.DB.prepare(`INSERT INTO school_classrooms(id,classroom_code,name,course_id,cycle_id,starts_on,ends_on,capacity,status,created_by) VALUES(?,?,?,?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),code,name,course,cycle,start,end,capacity,'planned',by).run();
    }else if(action==='teacher'){
      const client=clean(form.get('client_number'),10),display=clean(form.get('display_name'),160),career=clean(form.get('career_id'),100)||null;if(!/^\d{10}$/.test(client)||!display)throw new Error('Usa un número de cliente verificado de 10 dígitos y el nombre del maestro.');if(!await env.DB.prepare('SELECT client_number FROM customer_accounts WHERE client_number=?').bind(client).first())throw new Error('No existe ese número de cliente; pide al maestro que inicie sesión con su correo primero.');
      if(!await env.DB.prepare('SELECT client_number FROM school_teachers WHERE client_number=?').bind(client).first()){const number=await issueNumber('teacher');await env.DB.prepare('INSERT INTO school_teachers(teacher_number,client_number,display_name,specialty,career_id,assigned_by) VALUES(?,?,?,?,?,?)').bind(number,client,display,clean(form.get('specialty'),160),career,by).run();}
      else await env.DB.prepare('UPDATE school_teachers SET display_name=?,specialty=?,career_id=? WHERE client_number=?').bind(display,clean(form.get('specialty'),160),career,client).run();
    }else if(action==='career-course'){
      const career=clean(form.get('career_id'),100),course=clean(form.get('course_id'),100),role=clean(form.get('course_role'),20)==='preparatory'?'preparatory':'regular';if(!career||!course)throw new Error('Selecciona carrera y curso.');await env.DB.prepare('INSERT INTO school_career_courses(career_id,course_id,course_role,sequence_no) VALUES(?,?,?,COALESCE((SELECT MAX(sequence_no)+1 FROM school_career_courses WHERE career_id=?),1)) ON CONFLICT(career_id,course_id) DO UPDATE SET course_role=excluded.course_role').bind(career,course,role,career).run();
    }else if(action==='prerequisite'){
      const course=clean(form.get('course_id'),100),prereq=clean(form.get('prerequisite_course_id'),100);if(!course||!prereq||course===prereq)throw new Error('Selecciona cursos distintos.');await env.DB.prepare('INSERT OR IGNORE INTO school_course_prerequisites(course_id,prerequisite_course_id) VALUES(?,?)').bind(course,prereq).run();
    }else if(action==='teacher-course'){
      const teacher=clean(form.get('teacher_number'),40),course=clean(form.get('course_id'),100);if(!await env.DB.prepare("SELECT teacher_number FROM school_teachers WHERE teacher_number=? AND status='active'").bind(teacher).first())throw new Error('Maestro no encontrado o inactivo.');await env.DB.prepare('INSERT OR IGNORE INTO school_teacher_courses(teacher_number,course_id,assigned_by) VALUES(?,?,?)').bind(teacher,course,by).run();
    }else if(action==='room-teacher'){
      const room=clean(form.get('classroom_id'),100),teacher=clean(form.get('teacher_number'),40);const row=await env.DB.prepare(`SELECT r.course_id,t.teacher_number FROM school_classrooms r JOIN school_teachers t ON t.teacher_number=? AND t.status='active' WHERE r.id=?`).bind(teacher,room).first<{course_id:string;teacher_number:string}>();if(!row)throw new Error('No se encontró el aula o el maestro.');if(!await env.DB.prepare('SELECT 1 AS ok FROM school_teacher_courses WHERE teacher_number=? AND course_id=?').bind(teacher,row.course_id).first())throw new Error('Asigna primero al maestro al curso.');await env.DB.prepare('INSERT OR IGNORE INTO school_classroom_teachers(classroom_id,teacher_number,assigned_by) VALUES(?,?,?)').bind(room,teacher,by).run();
    }else if(action==='cycle-roster'||action==='room-roster'){
      const room=action==='room-roster'?clean(form.get('classroom_id'),100):'',cycleId=action==='cycle-roster'?clean(form.get('cycle_id'),100):'';const cycle=action==='room-roster'?await env.DB.prepare('SELECT cycle_id,status FROM school_classrooms WHERE id=?').bind(room).first<{cycle_id:string;status:string}>():{cycle_id:cycleId,status:'planned'};if(!cycle?.cycle_id)throw new Error('Selecciona un aula o ciclo válido.');if(action==='room-roster'&&!['planned','active'].includes(cycle.status))throw new Error('No se pueden asignar alumnos a un aula cerrada o archivada.');const numbers=[...new Set(String(form.get('student_numbers')??'').split(/[\s,;]+/).map(x=>x.trim()).filter(Boolean))];if(!numbers.length||numbers.length>100||numbers.some(x=>!/^ALU-\d{4}-\d{6}$/.test(x)))throw new Error('Escribe de 1 a 100 números de alumno válidos, separados por espacio o salto de línea.');const students=await env.DB.prepare(`SELECT student_number FROM school_students WHERE status='active' AND student_number IN (${numbers.map(()=>'?').join(',')})`).bind(...numbers).all<{student_number:string}>();const valid=new Set((students.results??[]).map(x=>x.student_number));if(numbers.some(x=>!valid.has(x)))throw new Error('Uno o más números de alumno no están activos.');if(action==='room-roster'){const roomData=await env.DB.prepare('SELECT capacity,(SELECT COUNT(*) FROM school_classroom_students cs WHERE cs.classroom_id=school_classrooms.id AND cs.status=\'active\') AS n FROM school_classrooms WHERE id=?').bind(room).first<{capacity:number|null;n:number}>();const existing=await env.DB.prepare(`SELECT student_number FROM school_classroom_students WHERE classroom_id=? AND status='active' AND student_number IN (${numbers.map(()=>'?').join(',')})`).bind(room,...numbers).all<{student_number:string}>();const newCount=numbers.length-(existing.results??[]).length;if(roomData?.capacity!=null&&Number(roomData.n??0)+newCount>roomData.capacity)throw new Error('El aula superaría el cupo definido.');}
      const writes:any[]=[];for(const student of new Set(numbers)){writes.push(env.DB.prepare('INSERT OR IGNORE INTO school_cycle_students(cycle_id,student_number,assigned_by) VALUES(?,?,?)').bind(cycle.cycle_id,student,by));if(action==='room-roster')writes.push(env.DB.prepare('INSERT OR IGNORE INTO school_classroom_students(classroom_id,student_number,assigned_by) VALUES(?,?,?)').bind(room,student,by));}await env.DB.batch(writes);
    }else if(action==='review-enrollment'){
      const client=clean(form.get('client_number'),10),decision=clean(form.get('decision'),30),message=clean(form.get('correction_request'),1500),notes=clean(form.get('admin_notes'),2000);const app=await env.DB.prepare('SELECT requested_career_id,status FROM school_enrollment_applications WHERE client_number=?').bind(client).first<{requested_career_id:string|null;status:string}>();if(!app||!['pending','correction_requested'].includes(app.status))throw new Error('La solicitud no está pendiente de revisión.');const now=new Date().toISOString();
      if(decision==='approve'){let student=await env.DB.prepare('SELECT student_number FROM school_students WHERE client_number=?').bind(client).first<{student_number:string}>();const studentNumber=student?.student_number??await issueNumber('student');const statements:any[]=[];if(!student)statements.push(env.DB.prepare('INSERT INTO school_students(student_number,client_number,career_id,created_by) VALUES(?,?,?,?)').bind(studentNumber,client,app.requested_career_id,by));statements.push(env.DB.prepare(`UPDATE school_enrollment_applications SET status='approved',correction_request='',admin_notes=?,reviewed_at=?,updated_at=? WHERE client_number=?`).bind(notes,now,now,client));await env.DB.batch(statements);}
      else if(decision==='correction'){if(!message)throw new Error('Escribe qué información debe corregir.');await env.DB.prepare(`UPDATE school_enrollment_applications SET status='correction_requested',correction_request=?,admin_notes=?,reviewed_at=?,updated_at=? WHERE client_number=?`).bind(message,notes,now,now,client).run();}
      else if(decision==='reject')await env.DB.prepare(`UPDATE school_enrollment_applications SET status='rejected',correction_request='',admin_notes=?,reviewed_at=?,updated_at=? WHERE client_number=?`).bind(notes||message,now,now,client).run();else throw new Error('Selecciona aprobar, solicitar corrección o rechazar.');
    }else if(action==='classroom-status'){
      const id=clean(form.get('classroom_id'),100),status=clean(form.get('status'),20);if(!['planned','active','closed','archived'].includes(status))throw new Error('Estado de aula inválido.');await env.DB.prepare('UPDATE school_classrooms SET status=?,updated_at=? WHERE id=?').bind(status,new Date().toISOString(),id).run();
    }else throw new Error('Acción administrativa no reconocida.');
    return Astro.redirect('/admin/escuela/universidad?ok=guardado',303);
  }catch(e){error=e instanceof Error?e.message:'No se pudo guardar el cambio.';}
}
const careers=(await env.DB.prepare('SELECT * FROM school_careers ORDER BY title COLLATE NOCASE').all<any>()).results??[];
const courses=(await env.DB.prepare("SELECT id,title,slug,status FROM school_courses WHERE status<>'archived' ORDER BY title COLLATE NOCASE").all<any>()).results??[];
const cycles=(await env.DB.prepare('SELECT * FROM school_academic_cycles ORDER BY starts_on DESC').all<any>()).results??[];
const teachers=(await env.DB.prepare('SELECT * FROM school_teachers ORDER BY teacher_number DESC LIMIT 300').all<any>()).results??[];
const classrooms=(await env.DB.prepare(`SELECT r.*,c.title AS course_title,y.name AS cycle_name,(SELECT COUNT(*) FROM school_classroom_students s WHERE s.classroom_id=r.id AND s.status='active') AS student_count,(SELECT COUNT(*) FROM school_classroom_teachers t WHERE t.classroom_id=r.id AND t.status='active') AS teacher_count FROM school_classrooms r JOIN school_courses c ON c.id=r.course_id JOIN school_academic_cycles y ON y.id=r.cycle_id ORDER BY y.starts_on DESC,r.classroom_code`).all<any>()).results??[];
const applications=(await env.DB.prepare(`SELECT a.*,c.title AS career_title,s.student_number FROM school_enrollment_applications a LEFT JOIN school_careers c ON c.id=a.requested_career_id LEFT JOIN school_students s ON s.client_number=a.client_number WHERE a.status IN ('pending','correction_requested') ORDER BY a.submitted_at LIMIT 250`).all<any>()).results??[];
const careerCourses=(await env.DB.prepare(`SELECT cc.*,c.title AS career_title,k.title AS course_title FROM school_career_courses cc JOIN school_careers c ON c.id=cc.career_id JOIN school_courses k ON k.id=cc.course_id ORDER BY c.title,cc.sequence_no`).all<any>()).results??[];
const prerequisites=(await env.DB.prepare(`SELECT p.course_id,p.prerequisite_course_id,c.title AS course_title,pre.title AS prerequisite_title FROM school_course_prerequisites p JOIN school_courses c ON c.id=p.course_id JOIN school_courses pre ON pre.id=p.prerequisite_course_id ORDER BY c.title`).all<any>()).results??[];
---
<AdminLayout title="Administración universitaria" active="school-admin"><main class="mx-auto max-w-7xl px-4 py-8 sm:px-6"><header class="mb-6"><p class="text-xs uppercase tracking-widest text-gray-500">Control escolar</p><h1 class="mt-2 text-3xl font-semibold">Administración universitaria</h1><p class="mt-2 text-sm text-gray-600">Carreras, cursos propedéuticos, docentes, ciclos, aulas e inscripciones. Los registros académicos se identifican con números de cliente, alumno y maestro.</p><nav class="mt-3 flex gap-4 text-sm"><a class="underline" href="/admin/escuela">Cursos</a><a class="underline" href="/admin/escuela/administracion">Administración escolar anterior</a></nav></header>
{notice&&<p class="mb-4 rounded-xl bg-green-50 p-3 text-sm text-green-800">Cambio guardado.</p>}{error&&<p class="mb-4 rounded-xl bg-red-50 p-3 text-sm text-red-800">{error}</p>}
<section class="mb-7 rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Inscripciones por revisar</h2>{applications.length?applications.map((a:any)=><article class="mt-4 rounded-xl bg-surface p-4"><div class="flex flex-wrap justify-between gap-3"><div><h3 class="font-semibold">{a.applicant_name}</h3><p class="text-sm text-muted">Cliente {a.client_number} · {a.date_of_birth} · {a.phone} · {a.career_title??'Carrera por definir'}</p><p class="text-sm">{a.address}</p>{a.guardian_name&&<p class="mt-1 text-sm">Tutor: {a.guardian_name} ({a.guardian_relationship}) · {a.guardian_phone}</p>}{a.correction_request&&<p class="mt-2 rounded bg-amber-50 p-2 text-sm">Corrección previa: {a.correction_request}</p>}<div class="mt-2 flex gap-3 text-sm">{a.applicant_id_document_key&&<a class="underline" href={`/api/admin/escuela/inscripciones/${encodeURIComponent(a.client_number)}/identificacion?tipo=applicant`}>Ver identificación oficial</a>}{a.guardian_id_document_key&&<a class="underline" href={`/api/admin/escuela/inscripciones/${encodeURIComponent(a.client_number)}/identificacion?tipo=guardian`}>Ver documento de tutor</a>}</div></div><span class="h-fit rounded-full bg-amber-100 px-3 py-1 text-xs">{a.status}</span></div><form method="POST" class="mt-4 grid gap-3 md:grid-cols-3"><input type="hidden" name="action" value="review-enrollment"/><input type="hidden" name="client_number" value={a.client_number}/><label class="grid gap-1 text-sm">Decisión<select name="decision" class="rounded-lg border p-2"><option value="approve">Aprobar y asignar número</option><option value="correction">Solicitar corrección</option><option value="reject">Rechazar</option></select></label><label class="grid gap-1 text-sm md:col-span-2">Qué debe corregir<textarea name="correction_request" rows="2" class="rounded-lg border p-2" placeholder="Indica claramente el dato faltante o incorrecto"></textarea></label><label class="grid gap-1 text-sm md:col-span-3">Nota interna<textarea name="admin_notes" rows="2" class="rounded-lg border p-2"></textarea></label><button class="w-fit rounded-lg bg-brand px-4 py-2.5 font-semibold text-white">Guardar decisión</button></form></article>):<p class="mt-3 text-sm text-muted">No hay solicitudes pendientes.</p>}</section>
<div class="grid gap-6 lg:grid-cols-2"><section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Carreras</h2><form method="POST" class="mt-4 grid gap-3"><input type="hidden" name="action" value="career"/><label class="grid gap-1 text-sm">Nombre<input name="title" required maxlength="140" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Slug opcional<input name="slug" maxlength="100" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Descripción<textarea name="description" rows="2" maxlength="1000" class="rounded border p-2"></textarea></label><button class="w-fit rounded-lg bg-brand px-4 py-2 text-white">Crear carrera</button></form><ul class="mt-4 space-y-2 text-sm">{careers.map((c:any)=><li>{c.title} · {c.status}</li>)}</ul></section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Ciclos escolares</h2><form method="POST" class="mt-4 grid gap-3 sm:grid-cols-2"><input type="hidden" name="action" value="cycle"/><label class="grid gap-1 text-sm sm:col-span-2">Nombre del ciclo<input name="name" required placeholder="2026–2027" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Inicio<input name="starts_on" type="date" required class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Término<input name="ends_on" type="date" required class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Estado<select name="status" class="rounded border p-2"><option value="planned">Planeado</option><option value="active">Activo</option></select></label><button class="w-fit self-end rounded-lg bg-brand px-4 py-2 text-white">Crear ciclo</button></form><ul class="mt-4 space-y-3 text-sm">{cycles.map((c:any)=><li class="rounded bg-surface p-3"><strong>{c.name}</strong> · {c.starts_on} a {c.ends_on}<form method="POST" class="mt-2 flex gap-2"><input type="hidden" name="action" value="cycle-status"/><input type="hidden" name="cycle_id" value={c.id}/><select name="status" class="rounded border p-1"><option value="planned" selected={c.status==='planned'}>Planeado</option><option value="active" selected={c.status==='active'}>Activo</option><option value="closed" selected={c.status==='closed'}>Cerrado</option><option value="archived" selected={c.status==='archived'}>Archivado</option></select><button class="underline">Actualizar estado</button></form></li>)}</ul></section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Registrar maestro</h2><p class="mt-1 text-xs text-muted">El maestro debe entrar una vez por enlace mágico para obtener su número de cliente.</p><form method="POST" class="mt-4 grid gap-3"><input type="hidden" name="action" value="teacher"/><label class="grid gap-1 text-sm">Número de cliente verificado<input name="client_number" required pattern="[0-9]{10}" maxlength="10" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Nombre para mostrar<input name="display_name" required maxlength="160" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Especialidad<input name="specialty" maxlength="160" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Carrera principal<select name="career_id" class="rounded border p-2"><option value="">Sin asignar</option>{careers.map((c:any)=><option value={c.id}>{c.title}</option>)}</select></label><button class="w-fit rounded-lg bg-brand px-4 py-2 text-white">Asignar número de maestro</button></form><div class="mt-4 space-y-2 text-sm">{teachers.map((t:any)=><p class="rounded bg-surface p-2"><strong>{t.teacher_number}</strong> · {t.display_name} · cliente {t.client_number} · {t.status}</p>)}</div></section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Cursos de carreras</h2><form method="POST" class="mt-4 grid gap-3"><input type="hidden" name="action" value="career-course"/><label class="grid gap-1 text-sm">Carrera<select name="career_id" required class="rounded border p-2">{careers.map((c:any)=><option value={c.id}>{c.title}</option>)}</select></label><label class="grid gap-1 text-sm">Curso existente<select name="course_id" required class="rounded border p-2">{courses.map((c:any)=><option value={c.id}>{c.title} · {c.status}</option>)}</select></label><label class="grid gap-1 text-sm">Tipo<select name="course_role" class="rounded border p-2"><option value="regular">Curso regular</option><option value="preparatory">Propedéutico</option></select></label><button class="w-fit rounded-lg bg-brand px-4 py-2 text-white">Vincular curso</button></form><ul class="mt-4 space-y-1 text-sm">{careerCourses.map((r:any)=><li>{r.career_title} · {r.course_title} · {r.course_role}</li>)}</ul><h3 class="mt-5 font-semibold">Prerrequisitos</h3><form method="POST" class="mt-2 grid gap-2"><input type="hidden" name="action" value="prerequisite"/><select name="course_id" required class="rounded border p-2">{courses.map((c:any)=><option value={c.id}>{c.title}</option>)}</select><select name="prerequisite_course_id" required class="rounded border p-2">{courses.map((c:any)=><option value={c.id}>{c.title}</option>)}</select><button class="w-fit underline">Agregar prerrequisito</button></form>{prerequisites.map((p:any)=><p class="mt-1 text-xs">{p.course_title} requiere {p.prerequisite_title}</p>)}</section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Crear aula</h2><p class="mt-1 text-xs text-muted">Cada aula tiene un solo curso y pertenece a un ciclo.</p><form method="POST" class="mt-4 grid gap-3 sm:grid-cols-2"><input type="hidden" name="action" value="classroom"/><label class="grid gap-1 text-sm">Código<input name="classroom_code" required maxlength="50" class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Nombre<input name="name" required maxlength="120" placeholder="Grupo A" class="rounded border p-2"/></label><label class="grid gap-1 text-sm sm:col-span-2">Curso<select name="course_id" required class="rounded border p-2">{courses.map((c:any)=><option value={c.id}>{c.title}</option>)}</select></label><label class="grid gap-1 text-sm sm:col-span-2">Ciclo<select name="cycle_id" required class="rounded border p-2">{cycles.map((c:any)=><option value={c.id}>{c.name} ({c.starts_on}–{c.ends_on})</option>)}</select></label><label class="grid gap-1 text-sm">Inicio del aula<input name="starts_on" type="date" required class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Término del aula<input name="ends_on" type="date" required class="rounded border p-2"/></label><label class="grid gap-1 text-sm">Cupo opcional<input name="capacity" type="number" min="1" max="10000" class="rounded border p-2"/></label><button class="w-fit self-end rounded-lg bg-brand px-4 py-2 text-white">Crear aula</button></form></section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Asignar maestro y curso</h2><form method="POST" class="mt-4 grid gap-2"><input type="hidden" name="action" value="teacher-course"/><select name="teacher_number" required class="rounded border p-2">{teachers.map((t:any)=><option value={t.teacher_number}>{t.teacher_number} · {t.display_name}</option>)}</select><select name="course_id" required class="rounded border p-2">{courses.map((c:any)=><option value={c.id}>{c.title}</option>)}</select><button class="w-fit underline">Asignar curso al maestro</button></form><h3 class="mt-5 font-semibold">Vincular docente a aula</h3><form method="POST" class="mt-2 grid gap-2"><input type="hidden" name="action" value="room-teacher"/><select name="classroom_id" required class="rounded border p-2">{classrooms.map((r:any)=><option value={r.id}>{r.classroom_code} · {r.course_title}</option>)}</select><select name="teacher_number" required class="rounded border p-2">{teachers.map((t:any)=><option value={t.teacher_number}>{t.teacher_number} · {t.display_name}</option>)}</select><button class="w-fit underline">Vincular maestro</button></form></section>
<section class="rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Asignar alumnos a ciclo y aula</h2><p class="mt-1 text-xs text-muted">Pega varios números de alumno separados por líneas, comas o espacios. Al asignarlos a un aula, también quedan inscritos al ciclo del aula.</p><form method="POST" class="mt-4 grid gap-3"><input type="hidden" name="action" value="cycle-roster"/><select name="cycle_id" required class="rounded border p-2">{cycles.map((c:any)=><option value={c.id}>{c.name}</option>)}</select><textarea name="student_numbers" required rows="3" placeholder="ALU-2026-000001" class="rounded border p-2 font-mono text-sm"></textarea><button class="w-fit rounded-lg bg-brand px-4 py-2 text-white">Inscribir alumnos al ciclo</button></form><form method="POST" class="mt-5 grid gap-3 border-t border-line pt-4"><input type="hidden" name="action" value="room-roster"/><select name="classroom_id" required class="rounded border p-2">{classrooms.map((r:any)=><option value={r.id}>{r.classroom_code} · {r.course_title} · {r.cycle_name}</option>)}</select><textarea name="student_numbers" required rows="3" placeholder="ALU-2026-000001" class="rounded border p-2 font-mono text-sm"></textarea><button class="w-fit rounded-lg bg-brand px-4 py-2 text-white">Asignar alumnos al aula</button></form></section>
</div><section class="mt-7 rounded-2xl border border-line p-5"><h2 class="text-xl font-semibold">Aulas</h2><div class="mt-4 grid gap-3 md:grid-cols-2">{classrooms.map((r:any)=><article class="rounded-xl bg-surface p-4"><h3 class="font-semibold">{r.classroom_code} · {r.name}</h3><p class="mt-1 text-sm">{r.course_title} · {r.cycle_name}</p><p class="text-xs text-muted">{r.starts_on} a {r.ends_on} · {r.student_count} alumnos · {r.teacher_count} maestros · {r.status}</p><form method="POST" class="mt-2 flex gap-2"><input type="hidden" name="action" value="classroom-status"/><input type="hidden" name="classroom_id" value={r.id}/><select name="status" class="rounded border p-1"><option value="planned" selected={r.status==='planned'}>Planeada</option><option value="active" selected={r.status==='active'}>Activa</option><option value="closed" selected={r.status==='closed'}>Cerrada</option><option value="archived" selected={r.status==='archived'}>Archivada</option></select><button class="underline">Actualizar</button></form></article>)}</div></section>
</main></AdminLayout>
