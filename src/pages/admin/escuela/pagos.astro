---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
const cleanEmail=(v:unknown)=>String(v??'').trim().toLowerCase().slice(0,254);
const validEmail=(v:string)=>/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
const validDate=(v:string)=>/^\d{4}-\d{2}-\d{2}$/.test(v);
const notice=Astro.url.searchParams.get('ok');const error=Astro.url.searchParams.get('error');
if(Astro.request.method==='POST'){
  const form=await Astro.request.formData();const action=String(form.get('action')??'');
  try{
    if(action==='create-product'){
      const title=String(form.get('title')??'').trim().slice(0,160);const description=String(form.get('description')??'').trim().slice(0,1000);
      const amount=Number(form.get('amount')??'');const currency=String(form.get('currency')??'mxn').trim().toLowerCase();
      const feeType=String(form.get('fee_type')??'other');const validityMonths=Number(form.get('validity_months')??'0');
      if(!title||!Number.isFinite(amount)||amount<=0||amount>10000000||!/^([a-z]{3})$/.test(currency)||!['other','enrollment','monthly'].includes(feeType)||!Number.isSafeInteger(validityMonths)||validityMonths<0||validityMonths>36)throw new Error('Revisa nombre, importe, moneda y tipo de cargo.');
      if(feeType==='enrollment'&&validityMonths===0)throw new Error('La inscripción necesita meses de vigencia.');
      if(feeType==='monthly'&&validityMonths===0)throw new Error('La mensualidad necesita al menos un mes de vigencia.');
      await env.DB.prepare(`INSERT INTO school_payment_products(id,title,description,amount_cents,currency,fee_type,validity_months) VALUES(?,?,?,?,?,?,?)`).bind(crypto.randomUUID(),title,description,Math.round(amount*100),currency,feeType,validityMonths).run();
      return Astro.redirect('/admin/escuela/pagos?ok=producto',303);
    }
    if(action==='assign'){
      const productId=String(form.get('product_id')??'').trim();const email=cleanEmail(form.get('student_email'));
      const due=String(form.get('due_at')??'').trim();const available=String(form.get('available_at')??'').trim();const notes=String(form.get('notes')??'').trim().slice(0,500);
      if(!validEmail(email)||!validDate(due)|| (available&&!validDate(available)))throw new Error('Escribe un correo válido y fechas con formato correcto.');
      if(available&&available>due)throw new Error('La disponibilidad para pagar no puede ser posterior al vencimiento.');
      const product=await env.DB.prepare(`SELECT id,title,description,amount_cents,currency,fee_type,validity_months FROM school_payment_products WHERE id=? AND active=1`).bind(productId).first<{id:string;title:string;description:string;amount_cents:number;currency:string;fee_type:string;validity_months:number}>();
      if(!product)throw new Error('El producto de pago no existe o está inactivo.');
      const dueCheck=await env.DB.prepare('SELECT date(?) AS d').bind(due).first<{d:string|null}>();if(dueCheck?.d!==due)throw new Error('La fecha de vencimiento no es válida.');
      if(available){const av=await env.DB.prepare('SELECT date(?) AS d').bind(available).first<{d:string|null}>();if(av?.d!==available)throw new Error('La fecha de disponibilidad no es válida.');}
      const id=crypto.randomUUID();
      await env.DB.prepare(`INSERT INTO school_payment_obligations(id,payment_product_id,student_email,title_snapshot,description_snapshot,amount_cents,currency,fee_type,validity_months,due_at,available_at,notes) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)`).bind(id,product.id,email,product.title,product.description,product.amount_cents,product.currency,product.fee_type,product.validity_months,due,available?available:null,notes).run();
      try{await env.DB.prepare(`INSERT INTO school_notifications(id,student_email,title,body,href) VALUES(?,?,?,?,?)`).bind(crypto.randomUUID(),email,'Tienes un pago escolar asignado',`${product.title} · vence ${due}`,'/account/payments').run();}catch{}
      return Astro.redirect('/admin/escuela/pagos?ok=asignacion',303);
    }
    if(action==='cancel'){
      const id=String(form.get('obligation_id')??'').trim();
      await env.DB.prepare(`UPDATE school_payment_obligations SET status='cancelled',updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE id=? AND status='pending' AND checkout_session_id IS NULL AND checkout_lock_token IS NULL`).bind(id).run();
      return Astro.redirect('/admin/escuela/pagos?ok=cancelado',303);
    }
    throw new Error('Acción no reconocida.');
  }catch(e){const msg=e instanceof Error?e.message:'No se pudo guardar.';return Astro.redirect(`/admin/escuela/pagos?error=${encodeURIComponent(msg.slice(0,180))}`,303);}
}
const {results:products=[]}=await env.DB.prepare(`SELECT id,title,description,amount_cents,currency,fee_type,validity_months,active,created_at FROM school_payment_products ORDER BY active DESC,title COLLATE NOCASE`).all<{id:string;title:string;description:string;amount_cents:number;currency:string;fee_type:string;validity_months:number;active:number;created_at:string}>();
const {results:obligations=[]}=await env.DB.prepare(`SELECT o.id,o.student_email,o.title_snapshot,o.amount_cents,o.currency,o.due_at,o.available_at,o.status,o.paid_at,o.order_id,o.checkout_session_id,o.checkout_lock_token,p.title AS product_title FROM school_payment_obligations o LEFT JOIN school_payment_products p ON p.id=o.payment_product_id ORDER BY CASE o.status WHEN 'pending' THEN 0 WHEN 'paid' THEN 1 ELSE 2 END,o.due_at DESC LIMIT 200`).all<{id:string;student_email:string;title_snapshot:string;amount_cents:number;currency:string;due_at:string;available_at:string|null;status:string;paid_at:string|null;order_id:number|null;checkout_session_id:string|null;checkout_lock_token:string|null;product_title:string|null}>();
const money=(c:number,cur:string)=>new Intl.NumberFormat('es-MX',{style:'currency',currency:cur.toUpperCase()}).format(c/100);
const fmt=(s:string|null)=>s?new Intl.DateTimeFormat('es-MX',{dateStyle:'medium'}).format(new Date(`${s.slice(0,10)}T12:00:00`)):'—';
---
<AdminLayout title="Pagos escolares" active="school">
  <header class="mb-7"><a href="/admin/escuela" class="text-sm text-muted hover:text-ink">← Administración de escuela</a><p class="mt-5 text-xs uppercase tracking-widest text-muted">Administración financiera</p><h1 class="mt-2 text-3xl font-semibold">Productos de pago y asignaciones</h1><p class="mt-2 max-w-3xl text-sm text-muted">Crea conceptos privados de cobro y asígnalos a un alumno con fecha de disponibilidad y vencimiento. No aparecen en el catálogo público.</p></header>
  {notice==='producto'&&<p class="mb-4 rounded-xl bg-green-50 p-3 text-sm text-green-800">Producto de pago creado.</p>}{notice==='asignacion'&&<p class="mb-4 rounded-xl bg-green-50 p-3 text-sm text-green-800">Pago asignado al alumno.</p>}{notice==='cancelado'&&<p class="mb-4 rounded-xl bg-green-50 p-3 text-sm text-green-800">Asignación cancelada.</p>}{error&&<p class="mb-4 rounded-xl bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-line p-5"><h2 class="mb-4 text-xl font-semibold">Crear producto de pago</h2><form method="POST" class="space-y-3"><input type="hidden" name="action" value="create-product"/><label class="block text-sm">Nombre del concepto<input required name="title" maxlength="160" placeholder="Mensualidad escolar" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/></label><label class="block text-sm">Descripción<textarea name="description" rows="2" maxlength="1000" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"></textarea></label><div class="grid grid-cols-2 gap-3"><label class="block text-sm">Importe (pesos)<input required type="number" name="amount" min="0.01" step="0.01" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/></label><label class="block text-sm">Tipo de cargo<select name="fee_type" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"><option value="other">Otro pago</option><option value="enrollment">Inscripción</option><option value="monthly">Mensualidad</option></select></label><label class="block text-sm">Meses de vigencia<input type="number" name="validity_months" min="0" max="36" value="0" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/><span class="text-xs text-muted">Ej.: inscripción 6, mensualidad 1; otros pagos 0.</span></label><label class="block text-sm">Moneda<select name="currency" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"><option value="mxn">MXN</option><option value="usd">USD</option></select></label></div><button class="rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand">Crear producto</button></form><div class="mt-6 border-t border-line pt-4"><h3 class="mb-2 font-semibold">Conceptos creados</h3>{products.length===0&&<p class="text-sm text-muted">Aún no hay conceptos.</p>}<ul class="space-y-2">{products.map(p=><li class="flex items-start justify-between gap-3 text-sm"><div><strong>{p.title}</strong><p class="text-xs text-muted">{p.description}</p><p class="text-xs text-muted">{p.fee_type==='enrollment'?'Inscripción':p.fee_type==='monthly'?'Mensualidad':'Otro pago'} · Vigencia {p.validity_months} meses</p></div><span class="shrink-0 font-semibold">{money(p.amount_cents,p.currency)}</span></li>)}</ul></div></section>
    <section class="rounded-2xl border border-line p-5"><h2 class="mb-4 text-xl font-semibold">Asignar un pago a un alumno</h2><form method="POST" class="space-y-3"><input type="hidden" name="action" value="assign"/><label class="block text-sm">Producto<select name="product_id" required class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2">{products.filter(p=>p.active).map(p=><option value={p.id}>{p.title} · {money(p.amount_cents,p.currency)}</option>)}</select></label><label class="block text-sm">Correo del alumno<input required type="email" name="student_email" placeholder="alumno@correo.com" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/></label><div class="grid grid-cols-2 gap-3"><label class="block text-sm">Fecha de vencimiento<input required type="date" name="due_at" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/></label><label class="block text-sm">Disponible para pagar desde<input type="date" name="available_at" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"/></label></div><label class="block text-sm">Nota para el alumno<textarea name="notes" rows="2" maxlength="500" class="mt-1 block w-full rounded-lg border border-line bg-background px-3 py-2"></textarea></label><button class="rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand" disabled={products.filter(p=>p.active).length===0}>Asignar pago</button></form><p class="mt-3 text-xs text-muted">La disponibilidad controla cuándo aparece el botón de pago. La fecha de vencimiento se muestra en el panel y calendario.</p></section>
  </div>
  <section class="mt-8 rounded-2xl border border-line p-5"><h2 class="mb-4 text-xl font-semibold">Pagos asignados a alumnos</h2><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead><tr class="border-b border-line text-xs uppercase tracking-wider text-muted"><th class="py-2 pr-3">Alumno</th><th class="py-2 pr-3">Concepto</th><th class="py-2 pr-3">Importe</th><th class="py-2 pr-3">Vence</th><th class="py-2 pr-3">Estado</th><th class="py-2">Acción</th></tr></thead><tbody>{obligations.map(o=><tr class="border-b border-line"><td class="py-3 pr-3">{o.student_email}</td><td class="py-3 pr-3">{o.title_snapshot}</td><td class="py-3 pr-3">{money(o.amount_cents,o.currency)}</td><td class="py-3 pr-3">{fmt(o.due_at)}</td><td class="py-3 pr-3">{o.status==='paid'?'Pagado':o.status==='cancelled'?'Cancelado':'Pendiente'}{o.paid_at&&<div class="text-xs text-muted">{fmt(o.paid_at)}</div>}</td><td class="py-3">{o.status==='pending'&&!o.checkout_session_id&&!o.checkout_lock_token&&<form method="POST"><input type="hidden" name="action" value="cancel"/><input type="hidden" name="obligation_id" value={o.id}/><button class="text-xs font-semibold text-red-700 underline">Cancelar</button></form>}{o.status==='pending'&&(o.checkout_session_id||o.checkout_lock_token)&&<span class="text-xs text-muted">Checkout en curso</span>}{o.order_id&&<span class="text-xs text-muted">Pedido #{o.order_id}</span>}</td></tr>)}{obligations.length===0&&<tr><td colspan="6" class="py-5 text-center text-muted">Aún no hay pagos asignados.</td></tr>}</tbody></table></div></section>
</AdminLayout>
