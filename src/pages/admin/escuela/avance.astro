---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
const rows = (await env.DB.prepare(`SELECT x.student_email,x.status AS assignment_status,x.assigned_at,x.previous_course_score,c.title AS course_title,c.level_code,a.title AS area_title,i.status AS diagnostic_status,COALESCE(cp.status,'not_started') AS course_progress,COUNT(DISTINCT CASE WHEN l.status='published' AND l.required_to_complete=1 THEN l.id END) AS required_lessons,COUNT(DISTINCT CASE WHEN l.status='published' AND l.required_to_complete=1 AND lp.status='completed' THEN l.id END) AS completed_lessons,MAX(lp.last_activity_at) AS last_activity FROM school_course_assignments x JOIN school_courses c ON c.id=x.course_id LEFT JOIN school_areas a ON a.id=c.area_id LEFT JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE LEFT JOIN school_course_progress cp ON cp.student_email=x.student_email COLLATE NOCASE AND cp.course_id=c.id LEFT JOIN school_lessons l ON l.course_id=c.id LEFT JOIN school_lesson_progress lp ON lp.lesson_id=l.id AND lp.student_email=x.student_email COLLATE NOCASE GROUP BY x.id ORDER BY CASE x.status WHEN 'active' THEN 0 ELSE 1 END,x.assigned_at DESC LIMIT 250`).all<{student_email:string;assignment_status:string;assigned_at:string;previous_course_score:number|null;course_title:string;level_code:string;area_title:string|null;diagnostic_status:string|null;course_progress:string;required_lessons:number;completed_lessons:number;last_activity:string|null}>()).results ?? [];
const intakeWithoutAssignment = (await env.DB.prepare(`SELECT i.student_email,i.status,i.approved_level,a.title AS area_title FROM school_student_intake i LEFT JOIN school_areas a ON a.id=i.selected_area_id WHERE NOT EXISTS(SELECT 1 FROM school_course_assignments x WHERE x.student_email=i.student_email COLLATE NOCASE AND x.status='active') ORDER BY i.submitted_at DESC LIMIT 100`).all<{student_email:string;status:string;approved_level:string|null;area_title:string|null}>()).results ?? [];
---
<AdminLayout title="Avance de alumnos" active="school-admin">
  <header class="mb-7"><p class="text-xs uppercase tracking-widest text-gray-400">Seguimiento académico</p><h1 class="mt-2 font-serif text-3xl">Avance de alumnos</h1><p class="mt-2 text-sm text-gray-500">Vista administrativa del avance por curso. Los alumnos solo ven su propio expediente.</p><nav class="mt-4 flex flex-wrap gap-4 text-sm"><a class="underline" href="/admin/escuela/editar">Editar contenido y estatus</a><a class="underline" href="/admin/escuela/administracion">Pagos y asignaciones</a></nav></header>
  <section class="rounded-lg border border-line p-4"><h2 class="mb-4 font-serif text-xl">Cursos asignados</h2><div class="overflow-x-auto"><table class="w-full min-w-[56rem] text-left text-sm"><thead><tr class="border-b border-line text-xs uppercase tracking-wider text-gray-400"><th class="py-3 pr-3">Alumno</th><th class="py-3 pr-3">Área / curso</th><th class="py-3 pr-3">Asignación</th><th class="py-3 pr-3">Diagnóstico</th><th class="py-3 pr-3">Avance</th><th class="py-3 pr-3">Calificación previa</th><th class="py-3">Última actividad</th></tr></thead><tbody>{rows.map(r=>{const pct=r.required_lessons?Math.round(r.completed_lessons/r.required_lessons*100):0;return <tr class="border-b border-line align-top"><td class="py-3 pr-3">{r.student_email}</td><td class="py-3 pr-3">{r.area_title ?? '—'}<div class="font-medium">{r.course_title}</div><div class="text-xs text-gray-500">{r.level_code}</div></td><td class="py-3 pr-3">{r.assignment_status}</td><td class="py-3 pr-3">{r.diagnostic_status ?? 'sin diagnóstico'}</td><td class="py-3 pr-3"><div>{r.completed_lessons}/{r.required_lessons} ({pct}%)</div><div class="mt-1 h-2 w-32 overflow-hidden rounded bg-gray-200"><div class="h-full bg-brand" style={`width:${pct}%`}></div></div><div class="mt-1 text-xs text-gray-500">{r.course_progress}</div></td><td class="py-3 pr-3">{r.previous_course_score ?? '—'}</td><td class="py-3">{r.last_activity ?? '—'}</td></tr>})}{rows.length===0&&<tr><td colspan="7" class="py-6 text-gray-500">Todavía no hay asignaciones.</td></tr>}</tbody></table></div></section>
  <section class="mt-8 rounded-lg border border-line p-4"><h2 class="mb-4 font-serif text-xl">Alumnos sin curso activo</h2><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b border-line text-xs uppercase tracking-wider text-gray-400"><th class="py-3 pr-3">Alumno</th><th class="py-3 pr-3">Área</th><th class="py-3 pr-3">Diagnóstico</th><th class="py-3">Nivel aprobado</th></tr></thead><tbody>{intakeWithoutAssignment.map(s=><tr class="border-b border-line"><td class="py-3 pr-3">{s.student_email}</td><td class="py-3 pr-3">{s.area_title ?? '—'}</td><td class="py-3 pr-3">{s.status}</td><td class="py-3">{s.approved_level ?? '—'}</td></tr>)}{intakeWithoutAssignment.length===0&&<tr><td colspan="4" class="py-6 text-gray-500">Todos los alumnos registrados tienen una asignación activa o no hay alumnos pendientes.</td></tr>}</tbody></table></div></section>
</AdminLayout>
