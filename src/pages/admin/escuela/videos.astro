---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const courseId=(Astro.url.searchParams.get('course')??'').trim();
const courses=(await env.DB
  .prepare("SELECT id,title,slug,status FROM school_courses WHERE source_format='xml' ORDER BY title COLLATE NOCASE")
  .all<{id:string;title:string;slug:string;status:string}>()).results??[];
const selected=courses.find((course)=>course.id===courseId);
const assets=selected?((await env.DB.prepare('SELECT asset_ref,file_name,asset_title,description,content_type,byte_size,created_at,updated_at FROM school_course_video_assets WHERE course_id=? ORDER BY asset_ref').bind(courseId).all<{asset_ref:string;file_name:string;asset_title:string;description:string;content_type:string;byte_size:number;created_at:string;updated_at:string}>()).results??[]):[];
const totalBytes=assets.reduce((sum,asset)=>sum+asset.byte_size,0),ok=Astro.url.searchParams.get('ok'),error=Astro.url.searchParams.get('error');
const formatBytes=(n:number)=>n>=1024*1024?`${(n/1024/1024).toFixed(2)} MB`:`${(n/1024).toFixed(1)} KB`;
---
<AdminLayout title="Videos de cursos" active="school">
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <header class="mb-6"><p class="text-xs uppercase tracking-widest text-gray-400">Biblioteca privada en R2</p><h1 class="mt-2 text-3xl font-semibold">Videos de cursos</h1><p class="mt-2 max-w-3xl text-sm text-gray-600">Carga videos MP4, WebM u Ogg y asígnales una referencia para insertarlos en lecciones XML. Los archivos se sirven de forma privada a alumnos con acceso al curso.</p><nav class="mt-3 flex flex-wrap gap-4 text-sm"><a class="underline" href="/admin/escuela">Cursos y lecciones</a><a class="underline" href="/admin/escuela/xml">Cursos XML</a><a class="underline" href="/admin/escuela/descargas">Archivos descargables</a><a class="underline" href="/admin/escuela/geogebra">Construcciones GeoGebra</a></nav></header>
    {error&&<p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}{ok==='subido'&&<p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Video guardado en R2.</p>}{ok==='retirado'&&<p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Video eliminado.</p>}
    <section class="rounded-xl border border-line p-5"><form method="GET" class="flex flex-wrap items-end gap-3"><label class="min-w-64 flex-1 text-sm">Curso XML<select name="course" required class="mt-1 block w-full rounded border p-2"><option value="">Selecciona un curso</option>{courses.map((course)=><option value={course.id} selected={course.id===courseId}>{course.title} · {course.status}</option>)}</select></label><button class="rounded-lg border px-4 py-2">Ver biblioteca</button></form></section>
    {selected&&<>
      <section class="mt-5 rounded-xl border border-line p-5"><h2 class="text-lg font-semibold">Cargar video para {selected.title}</h2><form method="POST" action="/api/admin/escuela/videos" enctype="multipart/form-data" class="mt-4 grid gap-4 md:grid-cols-2"><input type="hidden" name="course_id" value={selected.id}/><input type="hidden" name="action" value="upload"/>
        <label class="text-sm">Referencia XML (<code>ref</code>)<input required name="ref" maxlength="80" pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,79}" class="mt-1 block w-full rounded border p-2" placeholder="introduccion-unidad-1"/></label>
        <label class="text-sm">Título del video<input required name="title" maxlength="160" class="mt-1 block w-full rounded border p-2" placeholder="Introducción a la unidad"/></label>
        <label class="text-sm md:col-span-2">Descripción administrativa<textarea name="description" maxlength="500" rows="2" class="mt-1 block w-full rounded border p-2" placeholder="Notas para identificar el material"></textarea></label>
        <label class="text-sm md:col-span-2">Archivo de video (máximo 100 MB)<input required type="file" name="file" accept=".mp4,.webm,.ogv,.ogg,video/mp4,video/webm,video/ogg" class="mt-1 block w-full rounded border p-2"/></label>
        <div class="md:col-span-2"><button class="rounded-lg bg-brand px-5 py-3 font-semibold text-white">Subir a R2</button></div>
      </form><p class="mt-3 text-xs text-gray-500">Si reutilizas una referencia, el archivo anterior se reemplaza y el XML que ya la usa sigue funcionando.</p></section>
      <section class="mt-5 rounded-xl border border-line p-5"><div class="flex flex-wrap items-end justify-between gap-2"><div><h2 class="text-lg font-semibold">Biblioteca · {selected.title}</h2><p class="mt-1 text-sm text-gray-600">{assets.length} video{assets.length===1?'':'s'} · {formatBytes(totalBytes)} en total</p></div></div>
        {assets.length?<div class="mt-3 divide-y">{assets.map((asset)=><article class="flex flex-wrap items-start justify-between gap-4 py-4"><div class="min-w-0"><p class="font-semibold">{asset.asset_title} <span class="ml-1 rounded bg-gray-100 px-2 py-0.5 font-mono text-xs">{asset.asset_ref}</span></p>{asset.description&&<p class="mt-1 text-sm text-gray-600">{asset.description}</p>}<p class="mt-1 break-all text-sm text-gray-600">{asset.file_name}</p><p class="mt-1 text-xs text-gray-500">{asset.content_type} · {formatBytes(asset.byte_size)} · actualizado {asset.updated_at}</p></div><form method="POST" action="/api/admin/escuela/videos"><input type="hidden" name="course_id" value={selected.id}/><input type="hidden" name="action" value="delete"/><input type="hidden" name="ref" value={asset.asset_ref}/><button class="rounded-lg border border-red-200 px-3 py-2 text-sm text-red-700">Eliminar</button></form></article>)}</div>:<p class="mt-4 text-sm text-gray-600">Este curso todavía no tiene videos subidos.</p>}
      </section>
      <section class="mt-5 rounded-xl bg-gray-50 p-5"><h2 class="font-semibold">Insertar un video en el XML</h2><pre class="mt-2 overflow-x-auto text-sm">{`<lesson id="unidad-1-video" title="Ver la explicación">
  <content>Revisa este video antes de continuar.</content>
  <video ref="introduccion-unidad-1" title="Introducción a la unidad"/>
</lesson>`}</pre><p class="mt-2 text-xs text-gray-600">El <code>ref</code> debe coincidir con la referencia de la biblioteca del mismo curso. También puedes insertar enlaces de YouTube con <code>&lt;videoyoutube&gt;</code>.</p></section>
    </>}
  </main>
</AdminLayout>
