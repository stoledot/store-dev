---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

type Course = {
  id: string;
  title: string;
  slug: string;
};

type Lesson = {
  id: string;
  title: string;
  slug: string;
  lesson_type: string;
  grading_weight: number | null;
  assessment_json: string | null;
  course_title: string;
};

type AssessmentQuestion = {
  id: string;
  type: 'multiple_choice' | 'short_answer' | 'long_answer' | 'file_upload';
  prompt: string;
  options?: string[];
  required: boolean;
};

type Assessment = {
  version: 1;
  questions: AssessmentQuestion[];
};

const redirectWithMessage = (key: 'ok' | 'error', message: string) =>
  Astro.redirect(
    `/admin/escuela/evaluaciones?${key}=${encodeURIComponent(message)}`,
    303,
  );

const parseAssessment = (raw: string | null | undefined): Assessment => {
  if (!raw) {
    return { version: 1, questions: [] };
  }

  try {
    const parsed: unknown = JSON.parse(raw);

    if (!parsed || typeof parsed !== 'object') {
      return { version: 1, questions: [] };
    }

    const candidate = parsed as { questions?: unknown };

    if (!Array.isArray(candidate.questions)) {
      return { version: 1, questions: [] };
    }

    return {
      version: 1,
      questions: candidate.questions as AssessmentQuestion[],
    };
  } catch {
    return { version: 1, questions: [] };
  }
};

const notice = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const lessonId = String(form.get('lesson_id') ?? '').trim();
    const rawWeight = String(form.get('grading_weight') ?? '');
    const weight = Number(rawWeight);
    const rawAssessment = String(form.get('assessment_json') ?? '');

    if (!lessonId) {
      throw new Error('No se indicó la lección que se quiere configurar.');
    }

    if (
      !rawWeight.trim() ||
      !Number.isFinite(weight) ||
      weight <= 0 ||
      weight > 1000
    ) {
      throw new Error('El peso debe ser mayor que 0 y no superar 1000.');
    }

    let parsedAssessment: unknown;

    try {
      parsedAssessment = JSON.parse(rawAssessment);
    } catch {
      throw new Error('La configuración de preguntas no es JSON válido.');
    }

    if (!parsedAssessment || typeof parsedAssessment !== 'object') {
      throw new Error('La configuración de preguntas no tiene un formato válido.');
    }

    const questionsValue = (parsedAssessment as { questions?: unknown }).questions;

    if (!Array.isArray(questionsValue) || questionsValue.length > 100) {
      throw new Error('La evaluación debe contener una lista de hasta 100 preguntas.');
    }

    const cleanQuestions: AssessmentQuestion[] = questionsValue.map(
      (question: unknown, index: number) => {
        const item =
          question && typeof question === 'object'
            ? (question as Record<string, unknown>)
            : {};
        const type = String(item.type ?? '') as AssessmentQuestion['type'];
        const prompt = String(item.prompt ?? '').trim().slice(0, 2000);
        const fallbackId = `q${index + 1}`;
        const id =
          String(item.id ?? fallbackId)
            .replace(/[^a-zA-Z0-9_-]/g, '')
            .slice(0, 80) || fallbackId;

        if (
          ![
            'multiple_choice',
            'short_answer',
            'long_answer',
            'file_upload',
          ].includes(type) ||
          !prompt
        ) {
          throw new Error(`Revisa el enunciado y el tipo de la pregunta ${index + 1}.`);
        }

        const required = item.required !== false;

        if (type === 'multiple_choice') {
          const options = Array.isArray(item.options)
            ? item.options
                .map((option: unknown) => String(option).trim().slice(0, 500))
                .filter(Boolean)
                .slice(0, 20)
            : [];

          if (options.length < 2) {
            throw new Error(
              `La pregunta ${index + 1} de opción múltiple necesita al menos dos opciones.`,
            );
          }

          return {
            id,
            type,
            prompt,
            options,
            required,
          };
        }

        return {
          id,
          type,
          prompt,
          required,
        };
      },
    );

    const questionIds = cleanQuestions.map((question) => question.id);

    if (new Set(questionIds).size !== questionIds.length) {
      throw new Error('Cada pregunta debe tener un identificador único.');
    }

    const lesson = await env.DB.prepare(
      'SELECT id FROM school_lessons WHERE id = ? LIMIT 1',
    )
      .bind(lessonId)
      .first<{ id: string }>();

    if (!lesson) {
      throw new Error('La lección ya no existe.');
    }

    const assessmentJson = JSON.stringify({
      version: 1,
      questions: cleanQuestions,
    });

    await env.DB.prepare(
      `UPDATE school_lessons
       SET assessment_json = ?,
           grading_weight = ?,
           updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
       WHERE id = ?`,
    )
      .bind(assessmentJson, weight, lessonId)
      .run();

    return redirectWithMessage('ok', 'Configuración guardada.');
  } catch (error) {
    const message =
      error instanceof Error ? error.message : 'No se pudo guardar la configuración.';

    return redirectWithMessage('error', message);
  }
}

const coursesResult = await env.DB.prepare(
  'SELECT id, title, slug FROM school_courses ORDER BY title',
).all<Course>();
const courses = coursesResult.results ?? [];

const requestedCourse = Astro.url.searchParams.get('curso');
const selectedCourse =
  requestedCourse && courses.some((course) => course.id === requestedCourse)
    ? requestedCourse
    : (courses[0]?.id ?? '');

const lessonsResult = selectedCourse
  ? await env.DB.prepare(
      `SELECT
         lesson.id,
         lesson.title,
         lesson.slug,
         lesson.lesson_type,
         lesson.grading_weight,
         lesson.assessment_json,
         course.title AS course_title
       FROM school_lessons AS lesson
       JOIN school_courses AS course ON course.id = lesson.course_id
       WHERE lesson.course_id = ?
       ORDER BY lesson.sequence_no, lesson.title`,
    )
      .bind(selectedCourse)
      .all<Lesson>()
  : { results: [] as Lesson[] };

const lessons = lessonsResult.results ?? [];
const selectedCourseSlug =
  courses.find((course) => course.id === selectedCourse)?.slug ?? '';
---

<AdminLayout title="Configurar evaluaciones">
  <main class="mx-auto max-w-5xl px-4 py-8">
    <p class="text-xs uppercase tracking-widest text-gray-500">Escuela de Matemáticas</p>
    <h1 class="mt-2 text-3xl font-semibold">Evaluaciones y peso de calificación</h1>
    <p class="mt-2 max-w-3xl text-sm text-gray-600">
      Configura preguntas para cuestionarios, ejercicios y tareas. La calificación y la
      retroalimentación se registran desde la bandeja de entregas.
    </p>

    {notice && (
      <p class="my-4 rounded border border-green-200 bg-green-50 p-3 text-sm" role="status">
        {notice}
      </p>
    )}
    {errorMessage && (
      <p class="my-4 rounded border border-red-200 bg-red-50 p-3 text-sm" role="alert">
        {errorMessage}
      </p>
    )}

    <div class="my-5 flex flex-wrap gap-3">
      <a class="rounded border border-line px-4 py-2 text-sm" href="/admin/escuela/calificaciones">
        Revisar entregas y calificar
      </a>
      <a class="rounded border border-line px-4 py-2 text-sm" href="/admin/escuela/orden-lecciones">
        Ordenar lecciones
      </a>
    </div>

    <form method="get" class="my-6 flex flex-wrap items-end gap-3">
      <label class="text-sm">
        Curso
        <select name="curso" class="mt-1 block rounded border border-line p-2">
          {courses.map((course) => (
            <option value={course.id} selected={course.id === selectedCourse}>
              {course.title}
            </option>
          ))}
        </select>
      </label>
      <button class="rounded border border-line px-4 py-2 text-sm" type="submit">
        Mostrar lecciones
      </button>
      {selectedCourse && (
        <a
          class="rounded border border-line px-4 py-2 text-sm"
          href={`/admin/escuela/orden-lecciones?curso=${encodeURIComponent(selectedCourse)}`}
        >
          Ordenar lecciones de este curso
        </a>
      )}
    </form>

    {lessons.length > 0 ? (
      <div class="space-y-5">
        {lessons.map((lesson) => {
          const assessment = parseAssessment(lesson.assessment_json);

          return (
            <section
              class="rounded-xl border border-line p-5"
              data-assessment-form
              data-assessment={JSON.stringify(assessment)}
            >
              <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h2 class="text-lg font-semibold">{lesson.title}</h2>
                  <p class="text-xs text-gray-500">
                    {lesson.course_title} · {lesson.lesson_type} · {lesson.slug}
                  </p>
                </div>
                <a
                  class="text-sm underline"
                  href={`/escuela/cursos/${encodeURIComponent(selectedCourseSlug)}/${encodeURIComponent(lesson.slug)}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  Vista previa del alumno
                </a>
              </div>

              <form method="post" class="assessment-save-form space-y-4">
                <input type="hidden" name="lesson_id" value={lesson.id} />
                <input
                  type="hidden"
                  name="assessment_json"
                  class="assessment-json"
                  value={JSON.stringify(assessment)}
                />

                <label class="block text-sm">
                  Peso de calificación
                  <input
                    name="grading_weight"
                    type="number"
                    min="0.01"
                    max="1000"
                    step="0.01"
                    required
                    value={lesson.grading_weight ?? 1}
                    class="ml-2 w-32 rounded border border-line p-2"
                  />
                  <span class="ml-2 text-xs text-gray-500">
                    1 = normal; 2 = doble peso; 0.5 = medio peso.
                  </span>
                </label>

                <div class="question-list space-y-3"></div>

                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    data-add-question="multiple_choice"
                    class="rounded border border-line px-3 py-2 text-sm"
                  >
                    + Opción múltiple
                  </button>
                  <button
                    type="button"
                    data-add-question="short_answer"
                    class="rounded border border-line px-3 py-2 text-sm"
                  >
                    + Respuesta corta
                  </button>
                  <button
                    type="button"
                    data-add-question="long_answer"
                    class="rounded border border-line px-3 py-2 text-sm"
                  >
                    + Respuesta larga
                  </button>
                  <button
                    type="button"
                    data-add-question="file_upload"
                    class="rounded border border-line px-3 py-2 text-sm"
                  >
                    + Envío de archivo
                  </button>
                </div>

                <p class="text-xs text-gray-500">
                  En opción múltiple, escribe una opción por línea. En esta versión, las
                  respuestas se revisan manualmente; no se califican automáticamente.
                </p>

                <button class="rounded bg-brand px-4 py-2 text-sm text-white" type="submit">
                  Guardar evaluación
                </button>
              </form>
            </section>
          );
        })}
      </div>
    ) : (
      <p class="rounded border border-line p-5 text-sm">
        {courses.length === 0
          ? 'Todavía no hay cursos registrados.'
          : 'No hay lecciones en este curso.'}
      </p>
    )}
  </main>

  <script>
    type Question = {
      id: string;
      type: string;
      prompt: string;
      options?: string[];
      required?: boolean;
    };

    const questionTypeLabels: Record<string, string> = {
      multiple_choice: 'Opción múltiple',
      short_answer: 'Respuesta corta',
      long_answer: 'Respuesta larga',
      file_upload: 'Envío de archivo',
    };

    document.querySelectorAll<HTMLElement>('[data-assessment-form]').forEach((section) => {
      const form = section.querySelector<HTMLFormElement>('.assessment-save-form');
      const questionList = section.querySelector<HTMLElement>('.question-list');
      const hiddenInput = section.querySelector<HTMLInputElement>('.assessment-json');

      let questions: Question[] = [];

      try {
        const parsed = JSON.parse(section.dataset.assessment ?? '{}') as {
          questions?: Question[];
        };
        questions = Array.isArray(parsed.questions) ? parsed.questions : [];
      } catch {
        questions = [];
      }

      const syncHiddenInput = () => {
        if (hiddenInput) {
          hiddenInput.value = JSON.stringify({ version: 1, questions });
        }
      };

      const renderQuestions = () => {
        if (!questionList) return;

        questionList.replaceChildren();

        questions.forEach((question, index) => {
          const card = document.createElement('div');
          card.className = 'rounded-lg border border-line p-4';

          const heading = document.createElement('div');
          heading.className = 'mb-3 flex items-center justify-between gap-3';

          const title = document.createElement('strong');
          title.textContent = `Pregunta ${index + 1} · ${questionTypeLabels[question.type] ?? question.type}`;

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'text-sm underline';
          removeButton.textContent = 'Eliminar';
          removeButton.addEventListener('click', () => {
            questions = questions.filter((_, questionIndex) => questionIndex !== index);
            renderQuestions();
          });

          heading.appendChild(title);
          heading.appendChild(removeButton);
          card.appendChild(heading);

          const promptLabel = document.createElement('label');
          promptLabel.className = 'block text-sm';
          promptLabel.textContent = 'Enunciado';

          const promptInput = document.createElement('textarea');
          promptInput.required = true;
          promptInput.rows = 2;
          promptInput.maxLength = 2000;
          promptInput.className = 'mt-1 block w-full rounded border border-line p-2';
          promptInput.value = question.prompt ?? '';
          promptInput.addEventListener('input', () => {
            question.prompt = promptInput.value;
            syncHiddenInput();
          });

          promptLabel.appendChild(promptInput);
          card.appendChild(promptLabel);

          if (question.type === 'multiple_choice') {
            const optionsLabel = document.createElement('label');
            optionsLabel.className = 'mt-3 block text-sm';
            optionsLabel.textContent = 'Opciones (una por línea)';

            const optionsInput = document.createElement('textarea');
            optionsInput.rows = 4;
            optionsInput.className = 'mt-1 block w-full rounded border border-line p-2';
            optionsInput.value = (question.options ?? []).join('\n');
            optionsInput.addEventListener('input', () => {
              question.options = optionsInput.value
                .split('\n')
                .map((option) => option.trim())
                .filter(Boolean);
              syncHiddenInput();
            });

            optionsLabel.appendChild(optionsInput);
            card.appendChild(optionsLabel);
          }

          const requiredLabel = document.createElement('label');
          requiredLabel.className = 'mt-3 flex items-center gap-2 text-sm';

          const requiredInput = document.createElement('input');
          requiredInput.type = 'checkbox';
          requiredInput.checked = question.required !== false;
          requiredInput.addEventListener('change', () => {
            question.required = requiredInput.checked;
            syncHiddenInput();
          });

          requiredLabel.appendChild(requiredInput);
          requiredLabel.appendChild(document.createTextNode('Respuesta obligatoria'));
          card.appendChild(requiredLabel);
          questionList.appendChild(card);
        });

        syncHiddenInput();
      };

      section.querySelectorAll<HTMLButtonElement>('[data-add-question]').forEach((button) => {
        button.addEventListener('click', () => {
          const type = button.dataset.addQuestion ?? 'short_answer';
          const id =
            typeof crypto !== 'undefined' && 'randomUUID' in crypto
              ? crypto.randomUUID()
              : `q_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;

          questions.push({
            id,
            type,
            prompt: '',
            options: type === 'multiple_choice' ? ['Opción 1', 'Opción 2'] : undefined,
            required: true,
          });

          renderQuestions();
        });
      });

      form?.addEventListener('submit', syncHiddenInput);
      renderQuestions();
    });
  </script>
</AdminLayout>
