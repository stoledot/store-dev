---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { reviewSubprogramDiagnostic } from '../../../features/school/subprogramBilling';
import type { DiagnosticAnswer } from '../../../features/school/subprogramDiagnostics';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const diagnosticId = String(form.get('diagnostic_id') ?? '').trim();
  const decision = String(form.get('decision') ?? '');
  const modalityId = String(form.get('modality_id') ?? '').trim();
  const notes = String(form.get('notes') ?? '').trim();
  const entryPeriod = String(form.get('entry_period') ?? '');
  try {
    if (!diagnosticId || (decision !== 'approved' && decision !== 'rejected')) throw new Error('Selecciona una decisión válida.');
    if (decision === 'approved' && entryPeriod !== 'current' && entryPeriod !== 'next') throw new Error('Selecciona el período de ingreso.');
    await reviewSubprogramDiagnostic(env.DB, diagnosticId, decision, modalityId, notes, new Date(), entryPeriod === 'next' ? 'next' : 'current');
    return Astro.redirect('/admin/escuela/diagnosticos-subprogramas?guardado=1', 303);
  } catch (cause) {
    console.error('No se pudo revisar el diagnóstico:', cause);
    error = cause instanceof Error && !/D1_ERROR|SQLITE_|constraint failed/i.test(cause.message)
      ? cause.message : 'No se pudo guardar la revisión. Comprueba los datos e inténtalo de nuevo.';
    Astro.response.status = 400;
  }
}
const diagnostics = (await env.DB.prepare(`
  SELECT d.id,d.subprogram_id,d.answers_json,d.submitted_at,c.email,c.client_number,s.title
    FROM school_subprogram_diagnostics d
    JOIN customer_accounts c ON c.client_number=d.client_number
    JOIN school_subprograms s ON s.id=d.subprogram_id
   WHERE d.status='pending' ORDER BY d.submitted_at LIMIT 200
`).all<{id:string;subprogram_id:string;answers_json:string;submitted_at:string;email:string;client_number:string;title:string}>()).results;
const modalities = (await env.DB.prepare(`
  SELECT m.id,m.subprogram_id,m.title,p.amount_cents,p.currency
    FROM school_payment_modalities m JOIN school_payment_products p ON p.id=m.payment_product_id
   WHERE m.status='active' AND m.payment_type<>'enrollment' AND p.active=1 ORDER BY m.title
`).all<{id:string;subprogram_id:string;title:string;amount_cents:number;currency:string}>()).results;
import { formatPrice } from '../../../config';
---
<AdminLayout title="Diagnósticos de subprogramas" active="school-programs">
  <header class="mb-6">
    <a href="/admin/programas" class="text-sm text-brand underline">← Programas</a>
    <h1 class="mt-4 font-serif text-3xl">Diagnósticos de subprogramas</h1>
    <p class="mt-2 text-sm text-gray-600">Revisa las respuestas y asigna una modalidad activa al aprobar. El correo se envía mediante la cola de notificaciones configurada.</p>
  </header>
  {error && <p role="alert" class="mb-4 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</p>}
  {Astro.url.searchParams.has('guardado') && <p role="status" class="mb-4 rounded border border-green-200 bg-green-50 p-3 text-sm text-green-700">Revisión guardada.</p>}
  {diagnostics.length === 0 ? <p class="rounded border border-line p-5 text-sm text-gray-600">No hay diagnósticos pendientes.</p> : (
    <div class="space-y-5">
      {diagnostics.map((diagnostic) => {
        const answers = JSON.parse(diagnostic.answers_json) as DiagnosticAnswer[];
        const options = modalities.filter((modality) => modality.subprogram_id === diagnostic.subprogram_id);
        return (
          <article class="rounded-xl border border-line p-5">
            <h2 class="text-xl font-semibold">{diagnostic.title}</h2>
            <p class="mt-1 text-sm text-gray-600">{diagnostic.email} · Cliente {diagnostic.client_number} · {diagnostic.submitted_at}</p>
            <dl class="mt-4 space-y-3">
              {answers.map((answer) => <div>
                {answer.section && <p class="text-xs font-medium text-gray-500">{answer.section}</p>}
                <dt class="text-sm font-semibold">{answer.question}</dt>
                <dd class="mt-1 whitespace-pre-wrap text-sm text-gray-700">{answer.answer || 'Sin respuesta'}</dd>
                {answer.correct === true && <p class="mt-1 text-sm font-semibold text-green-700">Correcta</p>}
                {answer.correct === false && <p class="mt-1 text-sm font-semibold text-red-700">Incorrecta</p>}
                {answer.correct === false && answer.correctAnswers && <p class="mt-1 whitespace-pre-wrap text-sm text-gray-600">Respuesta(s) correcta(s): {answer.correctAnswers.join(' · ')}</p>}
                {answer.correct === null && <p class="mt-1 text-sm text-gray-600">Sin respuesta</p>}
              </div>)}
            </dl>
            <form method="POST" class="mt-5 space-y-3 border-t border-line pt-4">
              <input type="hidden" name="diagnostic_id" value={diagnostic.id} />
              <label class="block text-sm">Modalidad para aprobar
                <select name="modality_id" class="mt-1 block w-full rounded border border-line bg-white px-3 py-2">
                  <option value="">Selecciona una modalidad</option>
                  {options.map((modality) => <option value={modality.id}>{modality.title} · {formatPrice(modality.amount_cents, modality.currency)}</option>)}
                </select>
              </label>
              {options.length === 0 && <p class="text-sm text-gray-600">Configura primero una modalidad de pago activa para este subprograma.</p>}
              <label class="block text-sm">Período de ingreso
                <select name="entry_period" class="mt-1 block w-full rounded border border-line bg-white px-3 py-2">
                  <option value="current">Período actual (prorrateado si ya comenzó)</option>
                  <option value="next">Siguiente período completo</option>
                </select>
              </label>
              <label class="block text-sm">Nota administrativa<textarea name="notes" maxlength="2000" rows="2" class="mt-1 block w-full rounded border border-line bg-white px-3 py-2"></textarea></label>
              <div class="flex flex-wrap gap-3">
                <button name="decision" value="approved" disabled={options.length === 0} class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">Aprobar y asignar pagos</button>
                <button name="decision" value="rejected" class="rounded border border-line px-4 py-2 text-sm font-semibold">Solicitar nuevo diagnóstico</button>
              </div>
            </form>
          </article>
        );
      })}
    </div>
  )}
</AdminLayout>
