---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStorage } from '../../features/storage';
import { optimizeUpload } from '../../features/products/imageOptimize';
import { uploadMedia, validateUpload } from '../../features/media/upload';
import { mediaUrl } from '../../features/media/url';
import { getConfig } from '../../config';
const slugify=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,100)||'revista';
const clean=(v:unknown,n=3000)=>String(v??'').trim().slice(0,n);
let error='';
if(Astro.request.method==='POST')try{const f=await Astro.request.formData(),action=String(f.get('_action')||'save'),id=clean(f.get('id'),100);if(action==='status'){await env.DB.prepare('UPDATE math_magazines SET status=?,updated_at=? WHERE id=?').bind(f.get('status')==='published'?'published':'draft',new Date().toISOString(),id).run();return Astro.redirect('/admin/revistas?ok=status',303);}const title=clean(f.get('title'),180),slug=slugify(clean(f.get('slug'),120)||title),description=clean(f.get('description'),6000),publisher=clean(f.get('publisher'),240),editor=clean(f.get('editor'),240),issnPrint=clean(f.get('issn_print'),20),issnOnline=clean(f.get('issn_online'),20),website=clean(f.get('website_url'),500),contact=clean(f.get('contact_email'),254),copyright=clean(f.get('copyright_notice'),1000),language=clean(f.get('language'),12)||'es',frequency=clean(f.get('frequency'),120),status=['published','archived'].includes(String(f.get('status')))?String(f.get('status')):'draft';if(!title)throw new Error('El título de la revista es obligatorio.');if(website&&!/^https:\/\//i.test(website))throw new Error('El sitio web debe comenzar con https://.');if(contact&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact))throw new Error('Revisa el correo de contacto.');const duplicate=await env.DB.prepare('SELECT id FROM math_magazines WHERE slug=? AND id<>?').bind(slug,id||'').first();if(duplicate)throw new Error('Ese slug ya pertenece a otra revista.');let cover=clean(f.get('existing_cover_key'),300)||null;const file=f.get('cover');if(file instanceof File&&file.size){const invalid=validateUpload(file);if(invalid)throw new Error(invalid);const media=await uploadMedia(env.DB,getStorage(),await optimizeUpload(file),file.name);cover=media.image_key;}const now=new Date().toISOString(),magazineId=id||crypto.randomUUID();if(id)await env.DB.prepare('UPDATE math_magazines SET slug=?,title=?,description=?,publisher=?,editor=?,issn_print=?,issn_online=?,website_url=?,contact_email=?,copyright_notice=?,language=?,frequency=?,cover_image_key=?,status=?,updated_at=? WHERE id=?').bind(slug,title,description,publisher,editor,issnPrint,issnOnline,website,contact,copyright,language,frequency,cover,status,now,id).run();else await env.DB.prepare('INSERT INTO math_magazines(id,slug,title,description,publisher,editor,issn_print,issn_online,website_url,contact_email,copyright_notice,language,frequency,cover_image_key,status,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)').bind(magazineId,slug,title,description,publisher,editor,issnPrint,issnOnline,website,contact,copyright,language,frequency,cover,status,now,now).run();return Astro.redirect(`/admin/revistas?edit=${encodeURIComponent(magazineId)}&ok=saved`,303);}catch(e){error=e instanceof Error?e.message:'No se pudo guardar la revista.';}
const editId=Astro.url.searchParams.get('edit')||'',editing=editId?await env.DB.prepare('SELECT * FROM math_magazines WHERE id=?').bind(editId).first<any>():null;
const magazines=(await env.DB.prepare(`SELECT m.*,(SELECT COUNT(*) FROM math_magazine_issues i WHERE i.magazine_id=m.id AND i.status='published') AS issue_count,(SELECT COUNT(*) FROM content_subscriptions s WHERE s.magazine_id=m.id) AS plan_count FROM math_magazines m ORDER BY m.updated_at DESC LIMIT 100`).all<any>()).results??[];
const imageBase=getConfig().images.baseUrl;const ok=Astro.url.searchParams.get('ok');
---
<AdminLayout title="Revistas matemáticas" active="magazines"><main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><a href="/admin" class="text-sm underline">← Administración</a><header class="my-5"><p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Publicaciones periódicas</p><h1 class="mt-2 font-serif text-3xl">Revistas matemáticas</h1><p class="mt-2 max-w-3xl text-sm text-gray-600">Crea la ficha editorial, administra su portada y después agrega las ediciones XML. Las suscripciones y sus productos se vinculan desde Administración → Suscripciones.</p></header>{error&&<p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}{ok&&<p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">Cambios guardados.</p>}
<section class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><h2 class="text-lg font-semibold">{editing?'Editar revista':'Crear revista'}</h2><form method="POST" enctype="multipart/form-data" class="mt-4 grid gap-4 md:grid-cols-2"><input type="hidden" name="id" value={editing?.id??''}/><input type="hidden" name="existing_cover_key" value={editing?.cover_image_key??''}/><label class="text-sm">Título<input name="title" required maxlength="180" value={editing?.title??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Slug público<input name="slug" value={editing?.slug??''} placeholder="se-genera-del-titulo" class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm md:col-span-2">Presentación / descripción<textarea name="description" rows="4" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.description??''}</textarea></label><label class="text-sm">Editorial / institución<input name="publisher" value={editing?.publisher??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Editor(a) responsable<input name="editor" value={editing?.editor??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">ISSN impreso<input name="issn_print" value={editing?.issn_print??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">ISSN digital<input name="issn_online" value={editing?.issn_online??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Sitio web<input name="website_url" type="url" value={editing?.website_url??''} placeholder="https://…" class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Correo editorial<input name="contact_email" type="email" value={editing?.contact_email??''} class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm md:col-span-2">Derechos de autor<textarea name="copyright_notice" rows="2" class="mt-1 block w-full rounded-lg border border-line p-2">{editing?.copyright_notice??''}</textarea></label><label class="text-sm">Idioma<input name="language" value={editing?.language??'es'} maxlength="12" class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm">Periodicidad editorial<input name="frequency" value={editing?.frequency??''} placeholder="Trimestral, semestral…" class="mt-1 block w-full rounded-lg border border-line p-2"/></label><label class="text-sm md:col-span-2">Imagen de portada<input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="mt-1 block w-full rounded-lg border border-line p-2"/><span class="text-xs text-muted">JPEG, PNG, WebP o GIF, máximo 5 MB. {editing?.cover_image_key?'Sube otra imagen para reemplazar la portada.':''}</span>{editing?.cover_image_key&&<img class="mt-3 h-40 w-32 rounded-lg border border-line object-cover" src={mediaUrl(editing.cover_image_key,imageBase)} alt={`Portada ${editing.title}`}/>}</label><label class="text-sm">Estado<select name="status" class="mt-1 block w-full rounded-lg border border-line p-2"><option value="draft" selected={!editing||editing.status==='draft'}>Borrador</option><option value="published" selected={editing?.status==='published'}>Publicada</option><option value="archived" selected={editing?.status==='archived'}>Archivada</option></select></label><div class="flex items-end gap-3"><button class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white">Guardar revista</button>{editing&&<a class="rounded-lg border border-line px-4 py-2.5" href="/admin/revistas">Nueva revista</a>}</div></form></section>
<section class="mt-8"><h2 class="mb-3 text-lg font-semibold">Revistas registradas</h2><div class="grid gap-4 md:grid-cols-2">{magazines.map(m=><article class="overflow-hidden rounded-2xl border border-line bg-surface sm:flex">{m.cover_image_key&&<img src={mediaUrl(m.cover_image_key,imageBase)} alt={`Portada ${m.title}`} class="h-48 w-full object-cover sm:h-auto sm:w-36"/>}<div class="flex-1 p-4"><p class="text-xs uppercase tracking-wider text-muted">{m.status} · {m.issue_count} ediciones · {m.plan_count} suscripciones</p><h3 class="mt-1 text-lg font-semibold">{m.title}</h3><p class="text-sm text-muted">{m.publisher}{m.editor?` · Ed. ${m.editor}`:''}</p><p class="mt-2 line-clamp-3 text-sm">{m.description}</p><div class="mt-4 flex flex-wrap gap-3 text-sm"><a class="underline" href={`/admin/revistas/ediciones?revista=${encodeURIComponent(m.slug)}`}>Administrar ediciones</a><a class="underline" href={`/admin/revistas?edit=${encodeURIComponent(m.id)}`}>Editar ficha</a>{m.status==='published'&&<a class="underline" href={`/revistas/${m.slug}`} target="_blank">Vista pública</a>}</div></div></article>)}</div>{!magazines.length&&<p class="rounded-xl border border-dashed p-6 text-sm text-muted">Todavía no has creado una revista.</p>}</section></main></AdminLayout>
