---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SubprogramForm from '../../features/school/SubprogramForm.astro';
import ModalityForm from '../../features/school/ModalityForm.astro';
import { saveProgramAction, type Course, type Modality, type PaymentProduct, type Program, type Subprogram } from '../../features/school/programs';
import type { DiagnosticQuestion } from '../../features/school/subprogramDiagnostics';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    await saveProgramAction(env.DB, form);
    const subprogramId = String(form.get('subprogram_id') ?? form.get('id') ?? '');
    const anchor = /^[a-f0-9-]+$/i.test(subprogramId) ? `#subprograma-${subprogramId}` : '';
    return Astro.redirect(`/admin/programas?guardado=1${anchor}`, 303);
  } catch (cause) {
    console.error('No se pudo guardar la configuración de programas:', cause);
    const message = cause instanceof Error ? cause.message : '';
    if (/FOREIGN KEY constraint failed/i.test(message)) {
      error = 'No se pudo completar la operación: revisa que el programa, producto y curso existan. Un curso usado por una modalidad no se puede desvincular.';
    } else if (/UNIQUE constraint failed/i.test(message)) {
      error = 'Ya existe un registro con ese identificador o vínculo.';
    } else if (/D1_ERROR|SQLITE_|constraint failed/i.test(message)) {
      error = 'No se pudo guardar la configuración. Revisa los datos e inténtalo de nuevo.';
    } else {
      error = message || 'No se pudo guardar la configuración.';
    }
    Astro.response.status = 400;
  }
}

const programs = (await env.DB.prepare('SELECT slug, title, description, image_url, status FROM school_programs ORDER BY title').all<Program>()).results;
const subprograms = (await env.DB.prepare('SELECT * FROM school_subprograms ORDER BY title').all<Subprogram>()).results;
const courses = (await env.DB.prepare('SELECT id, title, status FROM school_courses ORDER BY title').all<Course>()).results;
const links = (await env.DB.prepare('SELECT subprogram_id, course_id FROM school_subprogram_courses').all<{subprogram_id: string; course_id: string}>()).results;
const modalities = (await env.DB.prepare('SELECT * FROM school_payment_modalities ORDER BY title').all<Modality>()).results;
const products = (await env.DB.prepare('SELECT id, title, amount_cents, currency, active FROM school_payment_products ORDER BY title').all<PaymentProduct>()).results;
const questions = (await env.DB.prepare('SELECT * FROM school_subprogram_questions ORDER BY position, id').all<DiagnosticQuestion>()).results;
const input = 'mt-1 block w-full rounded border border-line bg-white px-3 py-2';
---
<AdminLayout title="Programas" active="school-programs">
  <header class="mb-6">
    <h1 class="font-serif text-3xl">Programas y subprogramas</h1>
    <p class="mt-2 text-sm text-gray-600">Configura los programas existentes, sus subprogramas, cursos y modalidades de pago.</p>
    <p class="mt-2 text-sm text-gray-600">Las modalidades se asignan al revisar los diagnósticos; su aprobación genera los pagos programados.</p>
    <a href="/admin/escuela/diagnosticos-subprogramas" class="mt-3 inline-block text-sm font-semibold text-brand underline">Revisar diagnósticos de subprogramas</a>
    <a href="/admin/escuela/grupos" class="ml-4 mt-3 inline-block text-sm font-semibold text-brand underline">Administrar grupos escolares</a>
  </header>
  {error && <p role="alert" class="mb-4 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</p>}
  {Astro.url.searchParams.has('guardado') && <p role="status" class="mb-4 rounded border border-green-200 bg-green-50 p-3 text-sm text-green-700">Cambios guardados.</p>}

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-semibold">Programas existentes</h2>
    <p class="mb-3 text-sm text-gray-600">El esquema actual admite únicamente Matemáticas y Lectura; sus identificadores no se pueden cambiar.</p>
    <div class="space-y-3">
      {programs.map((program) => (
        <details class="rounded border border-line p-4">
          <summary class="cursor-pointer font-semibold">{program.title} · {program.slug} · {program.status === 'active' ? 'Activo' : 'Archivado'}</summary>
          <form method="POST" class="mt-4 space-y-3">
            <input type="hidden" name="action" value="save-program" />
            <input type="hidden" name="program_slug" value={program.slug} />
            <label class="block text-sm">Nombre<input name="title" required value={program.title} class={input} /></label>
            <label class="block text-sm">Descripción<textarea name="description" rows="3" class={input}>{program.description}</textarea></label>
            <label class="block text-sm">URL de imagen<input name="image_url" value={program.image_url} class={input} /></label>
            <label class="block text-sm">Estado<select name="status" class={input}><option value="active" selected={program.status === 'active'}>Activo</option><option value="archived" selected={program.status === 'archived'}>Archivado</option></select></label>
            <button class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white">Guardar programa</button>
          </form>
        </details>
      ))}
    </div>
  </section>

  <section class="mb-8 rounded border border-line p-5">
    <h2 class="mb-4 text-xl font-semibold">Crear subprograma</h2>
    {programs.length ? <SubprogramForm programs={programs} /> : <p class="text-sm text-gray-600">No hay programas disponibles.</p>}
  </section>

  <section>
    <h2 class="mb-3 text-xl font-semibold">Subprogramas existentes</h2>
    {subprograms.length === 0 && <p class="text-sm text-gray-600">Aún no hay subprogramas.</p>}
    <div class="space-y-4">
      {subprograms.map((subprogram) => {
        const linkedCourses = courses.filter((course) => links.some((link) => link.subprogram_id === subprogram.id && link.course_id === course.id));
        const availableCourses = courses.filter((course) => !linkedCourses.some((linked) => linked.id === course.id));
        const subModalities = modalities.filter((modality) => modality.subprogram_id === subprogram.id);
        return (
          <details id={`subprograma-${subprogram.id}`} class="rounded border border-line p-5">
            <summary class="cursor-pointer text-lg font-semibold">{subprogram.title} · {programs.find((program) => program.slug === subprogram.program_slug)?.title} · {subprogram.status}</summary>
            <div class="mt-5 space-y-6">
              <section>
                <h3 class="mb-3 font-semibold">Datos del subprograma</h3>
                <SubprogramForm programs={programs} subprogram={subprogram} />
              </section>
              <section class="border-t border-line pt-5">
                <h3 class="mb-2 font-semibold">Preguntas del diagnóstico</h3>
                <p class="mb-3 text-sm text-gray-600">Las respuestas enviadas conservan el texto de la pregunta aunque se elimine después.</p>
                <ul class="space-y-2">
                  {questions.filter((question) => question.subprogram_id === subprogram.id).map((question) => (
                    <li class="flex items-start justify-between gap-3 rounded border border-line p-3 text-sm">
                      <span>{question.prompt} · {question.answer_type === 'choice' ? 'Opción múltiple' : 'Texto libre'}{question.required ? ' · Obligatoria' : ''}</span>
                      <form method="POST">
                        <input type="hidden" name="action" value="remove-diagnostic-question" />
                        <input type="hidden" name="subprogram_id" value={subprogram.id} />
                        <input type="hidden" name="question_id" value={question.id} />
                        <button class="text-red-700 underline">Eliminar</button>
                      </form>
                    </li>
                  ))}
                </ul>
                <form method="POST" class="mt-4 space-y-3">
                  <input type="hidden" name="action" value="add-diagnostic-question" />
                  <input type="hidden" name="subprogram_id" value={subprogram.id} />
                  <label class="block text-sm">Pregunta<textarea name="prompt" required maxlength="1000" rows="2" class={input}></textarea></label>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class="block text-sm">Tipo<select name="answer_type" class={input}><option value="text">Texto libre</option><option value="choice">Opción múltiple</option></select></label>
                    <label class="block text-sm">Orden<input type="number" name="position" min="0" max="10000" value="0" class={input} /></label>
                  </div>
                  <label class="block text-sm">Opciones para opción múltiple (una por línea)<textarea name="options" rows="3" class={input}></textarea></label>
                  <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="required" value="1" checked /> Obligatoria</label>
                  <button class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white">Agregar pregunta</button>
                </form>
              </section>
              <section class="border-t border-line pt-5">
                <h3 class="mb-2 font-semibold">Cursos vinculados</h3>
                <p class="mb-3 text-sm text-gray-600">Un curso puede pertenecer a varios subprogramas. Para desvincularlo, primero cambia las modalidades que lo utilizan.</p>
                <ul class="mb-4 space-y-2">
                  {linkedCourses.map((course) => (
                    <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                      <span>{course.title} ({course.status})</span>
                      <form method="POST">
                        <input type="hidden" name="action" value="remove-course" />
                        <input type="hidden" name="subprogram_id" value={subprogram.id} />
                        <input type="hidden" name="course_id" value={course.id} />
                        <button class="text-red-700 underline">Desvincular</button>
                      </form>
                    </li>
                  ))}
                </ul>
                {linkedCourses.length === 0 && <p class="mb-3 text-sm text-gray-600">No hay cursos vinculados.</p>}
                <form method="POST" class="flex flex-wrap items-end gap-3">
                  <input type="hidden" name="action" value="add-course" />
                  <input type="hidden" name="subprogram_id" value={subprogram.id} />
                  <label class="block min-w-48 flex-1 text-sm">Curso
                    <select name="course_id" required class={input}>
                      <option value="">Selecciona un curso</option>
                      {availableCourses.map((course) => <option value={course.id}>{course.title} ({course.status})</option>)}
                    </select>
                  </label>
                  <button disabled={availableCourses.length === 0} class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">Vincular curso</button>
                </form>
              </section>
              <section class="border-t border-line pt-5">
                <h3 class="mb-2 font-semibold">Modalidades de pago</h3>
                <p class="mb-3 text-sm text-gray-600">Los importes y monedas provienen de los <a href="/admin/escuela/pagos" class="text-brand underline">productos de pago escolares</a>.</p>
                <form method="POST" class="mb-4 rounded border border-line p-4">
                  <input type="hidden" name="action" value="set-enrollment-modality" />
                  <input type="hidden" name="subprogram_id" value={subprogram.id} />
                  <label class="block text-sm">Inscripción obligatoria
                    <select name="enrollment_modality_id" class={input}>
                      <option value="">No obligatoria</option>
                      {subModalities.filter((item) => item.payment_type === 'enrollment' && (item.status === 'active' || item.id === subprogram.enrollment_modality_id)).map((item) => <option value={item.id} selected={item.id === subprogram.enrollment_modality_id}>{item.title}{item.status !== 'active' ? ' (inactiva)' : ''}</option>)}
                    </select>
                  </label>
                  <p class="mt-2 text-xs text-gray-600">Selecciona una modalidad de inscripción para asignar su pago además de la modalidad elegida al aprobar.</p>
                  <button class="mt-3 rounded bg-brand px-4 py-2 text-sm font-semibold text-white">Guardar inscripción</button>
                </form>
                <div class="space-y-3">
                  {subModalities.map((modality) => (
                    <details class="rounded border border-line p-4">
                      <summary class="cursor-pointer font-medium">{modality.title} · {modality.status}</summary>
                      <div class="mt-4"><ModalityForm subprogramId={subprogram.id} courses={linkedCourses} products={products} modality={modality} /></div>
                    </details>
                  ))}
                  {subModalities.length === 0 && <p class="text-sm text-gray-600">No hay modalidades.</p>}
                </div>
                <details class="mt-4 rounded border border-line p-4">
                  <summary class="cursor-pointer font-medium">Crear modalidad de pago</summary>
                  <div class="mt-4"><ModalityForm subprogramId={subprogram.id} courses={linkedCourses} products={products} /></div>
                  {products.length === 0 && <p class="mt-3 text-sm text-gray-600">Primero crea un producto de pago escolar.</p>}
                </details>
              </section>
            </div>
          </details>
        );
      })}
    </div>
  </section>
</AdminLayout>
