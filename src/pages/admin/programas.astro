---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SubprogramForm from '../../features/school/SubprogramForm.astro';
import ModalityForm from '../../features/school/ModalityForm.astro';
import DiagnosticQuestionForm from '../../features/school/DiagnosticQuestionForm.astro';
import { migrateLegacyPaymentPeriods } from '../../features/school/paymentPeriodMigration';
import { saveProgramAction, type Course, type Modality, type PaymentProduct, type Program, type Subprogram, type SubprogramFaq } from '../../features/school/programs';
import type { DiagnosticQuestion, DiagnosticSection } from '../../features/school/subprogramDiagnostics';

await migrateLegacyPaymentPeriods(env.DB);
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    await saveProgramAction(env.DB, form);
    const subprogramId = String(form.get('subprogram_id') ?? form.get('id') ?? '');
    const anchor = /^[a-f0-9-]+$/i.test(subprogramId) ? `#subprograma-${subprogramId}` : '';
    return Astro.redirect(`/admin/programas?guardado=1${anchor}`, 303);
  } catch (cause) {
    console.error('No se pudo guardar la configuración de programas:', cause);
    const message = cause instanceof Error ? cause.message : '';
    if (/FOREIGN KEY constraint failed/i.test(message)) {
      error = 'No se pudo completar la operación: revisa que el programa, producto y curso existan. Un curso usado por un esquema de pago no se puede desvincular.';
    } else if (/UNIQUE constraint failed/i.test(message)) {
      error = 'Ya existe un registro con ese identificador o vínculo.';
    } else if (/D1_ERROR|SQLITE_|constraint failed/i.test(message)) {
      error = 'No se pudo guardar la configuración. Revisa los datos e inténtalo de nuevo.';
    } else {
      error = message || 'No se pudo guardar la configuración.';
    }
    Astro.response.status = 400;
  }
}

const programs = (await env.DB.prepare('SELECT slug, title, description, image_url, status FROM school_programs ORDER BY title').all<Program>()).results;
const subprograms = (await env.DB.prepare('SELECT * FROM school_subprograms ORDER BY title').all<Subprogram>()).results;
const courses = (await env.DB.prepare('SELECT id, title, status FROM school_courses ORDER BY title').all<Course>()).results;
const links = (await env.DB.prepare('SELECT subprogram_id, course_id FROM school_subprogram_courses').all<{subprogram_id: string; course_id: string}>()).results;
const modalities = (await env.DB.prepare('SELECT * FROM school_payment_modalities ORDER BY title').all<Modality>()).results;
const products = (await env.DB.prepare('SELECT id, title, amount_cents, currency, active FROM school_payment_products ORDER BY title').all<PaymentProduct>()).results;
const questions = (await env.DB.prepare('SELECT * FROM school_subprogram_questions ORDER BY position, id').all<DiagnosticQuestion>()).results;
const sections = (await env.DB.prepare('SELECT * FROM school_subprogram_diagnostic_sections ORDER BY position,id').all<DiagnosticSection>()).results;
const faqs = (await env.DB.prepare('SELECT * FROM school_subprogram_faqs ORDER BY position,id').all<SubprogramFaq>()).results;
const input = 'mt-1 block w-full min-w-0 rounded-lg border border-line bg-white px-3 py-2.5 text-sm shadow-sm transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20';
---
<AdminLayout title="Programas" active="school-programs">
  <header class="mb-8 rounded-2xl border border-line bg-gradient-to-br from-surface to-surface/60 p-5 sm:p-7 shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">
    <h1 class="font-serif text-3xl sm:text-4xl tracking-tight">Programas y subprogramas</h1>
    <p class="mt-3 max-w-3xl text-sm sm:text-base text-gray-600">Configura programas, subprogramas, cursos, diagnósticos y esquemas de pago desde un solo lugar.</p>
    <p class="mt-2 text-sm text-gray-600">Los esquemas de pago se asignan al revisar los diagnósticos; su aprobación genera los pagos programados.</p>
    <a href="/admin/escuela/diagnosticos-subprogramas" class="mt-4 inline-flex min-h-10 items-center text-sm font-semibold text-brand underline underline-offset-4">Revisar diagnósticos de subprogramas</a>
    <a href="/admin/escuela/grupos" class="ml-0 sm:ml-4 mt-2 sm:mt-3 inline-flex min-h-10 items-center text-sm font-semibold text-brand underline underline-offset-4">Administrar grupos escolares</a>
  </header>
  {error && <p role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">{error}</p>}
  {Astro.url.searchParams.has('guardado') && <p role="status" class="mb-5 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-700">Cambios guardados.</p>}

  <section class="mb-8 rounded-2xl border border-line bg-surface p-4 sm:p-6 shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">
    <h2 class="mb-3 text-xl sm:text-2xl font-semibold tracking-tight">Programas existentes</h2>
    <p class="mb-3 text-sm text-gray-600">El esquema actual admite únicamente Matemáticas y Lectura; sus identificadores no se pueden cambiar.</p>
    <div class="grid gap-3 sm:grid-cols-2">
      {programs.map((program) => (
        <details class="admin-card rounded-xl border border-line bg-surface p-4 sm:p-5">
          <summary class="flex list-none cursor-pointer items-start gap-3 font-semibold [&::-webkit-details-marker]:hidden">{program.title} · {program.slug} · {program.status === 'active' ? 'Activo' : 'Archivado'}</summary>
          <form method="POST" class="mt-4 grid gap-4">
            <input type="hidden" name="action" value="save-program" />
            <input type="hidden" name="program_slug" value={program.slug} />
            <label class="block text-sm font-medium space-y-1.5">Nombre<input name="title" required value={program.title} class={input} /></label>
            <label class="block text-sm font-medium space-y-1.5">Descripción<textarea name="description" rows="3" class={input}>{program.description}</textarea></label>
            <label class="block text-sm font-medium space-y-1.5">URL de imagen<input name="image_url" value={program.image_url} class={input} /></label>
            <label class="block text-sm font-medium space-y-1.5">Estado<select name="status" class={input}><option value="active" selected={program.status === 'active'}>Activo</option><option value="archived" selected={program.status === 'archived'}>Archivado</option></select></label>
            <button class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">Guardar programa</button>
          </form>
        </details>
      ))}
    </div>
  </section>

  <section class="mb-8 rounded-2xl border border-line bg-surface p-4 sm:p-6 shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">
    <details class="group">
      <summary class="flex list-none cursor-pointer items-center justify-between gap-3 rounded-xl bg-brand/5 p-3 sm:p-4 font-semibold hover:bg-brand/10 [&::-webkit-details-marker]:hidden">
        <span class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand text-white text-xl">+</span><span><span class="block text-lg">Crear subprograma</span><span class="block text-xs sm:text-sm font-normal text-gray-600">Despliega el formulario solo cuando lo necesites</span></span></span>
        <span class="text-xl transition-transform group-open:rotate-45">＋</span>
      </summary>
      <div class="mt-4 rounded-xl border border-line p-3 sm:p-5">
        {programs.length ? <SubprogramForm programs={programs} /> : <p class="text-sm text-gray-600">No hay programas disponibles.</p>}
      </div>
    </details>
  </section>

  <section>
    <h2 class="mb-3 text-xl font-semibold">Subprogramas existentes</h2>
    {subprograms.length === 0 && <p class="text-sm text-gray-600">Aún no hay subprogramas.</p>}
    <div class="space-y-4 sm:space-y-5">
      {subprograms.map((subprogram) => {
        const linkedCourses = courses.filter((course) => links.some((link) => link.subprogram_id === subprogram.id && link.course_id === course.id));
        const availableCourses = courses.filter((course) => !linkedCourses.some((linked) => linked.id === course.id));
        const subModalities = modalities.filter((modality) => modality.subprogram_id === subprogram.id);
        const subSections = sections.filter(section => section.subprogram_id === subprogram.id);
        return (
          <details id={`subprograma-${subprogram.id}`} class="admin-card scroll-mt-24 rounded-2xl border border-line bg-surface p-4 sm:p-6 shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">
            <summary class="flex list-none cursor-pointer items-start gap-3 text-base sm:text-lg font-semibold [&::-webkit-details-marker]:hidden">{subprogram.title} · {programs.find((program) => program.slug === subprogram.program_slug)?.title} · {subprogram.status}</summary>
            <div class="mt-5 space-y-7">
              <section>
                <h3 class="mb-3 text-base sm:text-lg font-semibold">Datos del subprograma</h3>
                <SubprogramForm programs={programs} subprogram={subprogram} />
              </section>
              <section class="rounded-xl border border-line bg-surface/50 p-4 sm:p-5">
                <h3 class="mb-2 text-base sm:text-lg font-semibold">Secciones y preguntas del diagnóstico</h3>
                <p class="mb-3 text-sm text-gray-600">Una sección puede contener solo instrucciones. Las respuestas y su evaluación se conservan aunque cambien las preguntas.</p>
                {subSections.map(section => <details class="admin-card mb-3 rounded-xl border border-line bg-surface p-3 sm:p-4">
                  <summary class="cursor-pointer font-medium">{section.position} · {section.title}</summary>
                  <form method="POST" class="mt-3 space-y-3">
                    <input type="hidden" name="action" value="save-diagnostic-section" /><input type="hidden" name="subprogram_id" value={subprogram.id} /><input type="hidden" name="section_id" value={section.id} />
                    <label class="block text-sm font-medium space-y-1.5">Título<input name="title" value={section.title} required maxlength="200" class={input} /></label>
                    <label class="block text-sm font-medium space-y-1.5">Instrucciones<textarea name="description" rows="3" maxlength="10000" class={input}>{section.description}</textarea></label>
                    <label class="block text-sm font-medium space-y-1.5">Orden<input type="number" name="position" min="0" max="10000" value={section.position} class={input} /></label>
                    <button class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">Guardar sección</button>
                  </form>
                  <form method="POST" class="mt-2"><input type="hidden" name="action" value="remove-diagnostic-section" /><input type="hidden" name="subprogram_id" value={subprogram.id} /><input type="hidden" name="section_id" value={section.id} /><button class="text-sm text-red-700 underline">Eliminar sección vacía</button></form>
                </details>)}
                <details class="admin-card mb-4 rounded-xl border border-line bg-surface p-3 sm:p-4">
                  <summary class="cursor-pointer font-medium">Agregar sección</summary>
                  <form method="POST" class="mt-3 space-y-3">
                    <input type="hidden" name="action" value="save-diagnostic-section" /><input type="hidden" name="subprogram_id" value={subprogram.id} />
                    <label class="block text-sm font-medium space-y-1.5">Título<input name="title" required maxlength="200" class={input} /></label>
                    <label class="block text-sm font-medium space-y-1.5">Instrucciones<textarea name="description" rows="3" maxlength="10000" class={input}></textarea></label>
                    <label class="block text-sm font-medium space-y-1.5">Orden<input type="number" name="position" min="0" max="10000" value="0" class={input} /></label>
                    <button class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">Agregar sección</button>
                  </form>
                </details>
                <ul class="space-y-2">
                  {questions.filter((question) => question.subprogram_id === subprogram.id).map((question) => (
                    <li class="admin-card rounded-xl border border-line bg-surface p-3 sm:p-4 text-sm">
                      <details><summary class="cursor-pointer">{question.prompt} · {subSections.find(section => section.id===question.section_id)?.title ?? 'Sin sección'} · {question.answer_type === 'choice' ? 'Opción múltiple' : 'Texto libre'}{question.required ? ' · Obligatoria' : ''}</summary>
                        <div class="mt-3"><DiagnosticQuestionForm subprogramId={subprogram.id} sections={subSections} question={question} /></div>
                      </details>
                      <form method="POST">
                        <input type="hidden" name="action" value="remove-diagnostic-question" />
                        <input type="hidden" name="subprogram_id" value={subprogram.id} />
                        <input type="hidden" name="question_id" value={question.id} />
                        <button class="mt-2 text-red-700 underline">Eliminar</button>
                      </form>
                    </li>
                  ))}
                </ul>
                <details class="admin-card mt-4 rounded-xl border border-line bg-surface p-3 sm:p-4"><summary class="cursor-pointer font-medium">Agregar pregunta</summary><div class="mt-3"><DiagnosticQuestionForm subprogramId={subprogram.id} sections={subSections} /></div></details>
              </section>
              <section class="rounded-xl border border-line bg-surface/50 p-4 sm:p-5">
                <h3 class="mb-3 text-base sm:text-lg font-semibold">Preguntas frecuentes</h3>
                {faqs.filter(faq => faq.subprogram_id===subprogram.id).map(faq => <details class="admin-card mb-3 rounded-xl border border-line bg-surface p-3 sm:p-4">
                  <summary class="cursor-pointer font-medium">{faq.question}</summary>
                  <form method="POST" class="mt-3 space-y-3">
                    <input type="hidden" name="action" value="save-subprogram-faq" /><input type="hidden" name="subprogram_id" value={subprogram.id} /><input type="hidden" name="faq_id" value={faq.id} />
                    <label class="block text-sm font-medium space-y-1.5">Pregunta<input name="question" required maxlength="1000" value={faq.question} class={input} /></label>
                    <label class="block text-sm font-medium space-y-1.5">Respuesta<textarea name="answer" required maxlength="10000" rows="3" class={input}>{faq.answer}</textarea></label>
                    <label class="block text-sm font-medium space-y-1.5">Orden<input type="number" name="position" min="0" max="10000" value={faq.position} class={input} /></label>
                    <button class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">Guardar</button>
                  </form>
                  <form method="POST" class="mt-2"><input type="hidden" name="action" value="remove-subprogram-faq" /><input type="hidden" name="subprogram_id" value={subprogram.id} /><input type="hidden" name="faq_id" value={faq.id} /><button class="text-sm text-red-700 underline">Eliminar</button></form>
                </details>)}
                <details class="rounded-xl border border-line bg-surface p-3 sm:p-4 shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"><summary class="cursor-pointer font-medium">Agregar pregunta frecuente</summary>
                  <form method="POST" class="mt-3 space-y-3">
                    <input type="hidden" name="action" value="save-subprogram-faq" /><input type="hidden" name="subprogram_id" value={subprogram.id} />
                    <label class="block text-sm font-medium space-y-1.5">Pregunta<input name="question" required maxlength="1000" class={input} /></label>
                    <label class="block text-sm font-medium space-y-1.5">Respuesta<textarea name="answer" required maxlength="10000" rows="3" class={input}></textarea></label>
                    <label class="block text-sm font-medium space-y-1.5">Orden<input type="number" name="position" min="0" max="10000" value="0" class={input} /></label>
                    <button class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40">Agregar</button>
                  </form>
                </details>
              </section>
              <section class="rounded-xl border border-line bg-surface/50 p-4 sm:p-5">
                <h3 class="mb-2 text-base sm:text-lg font-semibold">Cursos vinculados</h3>
                <p class="mb-3 text-sm text-gray-600">Un curso puede pertenecer a varios subprogramas. Para desvincularlo, primero cambia los esquemas de pago que lo utilizan.</p>
                <ul class="mb-4 space-y-2">
                  {linkedCourses.map((course) => (
                    <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                      <span>{course.title} ({course.status})</span>
                      <form method="POST">
                        <input type="hidden" name="action" value="remove-course" />
                        <input type="hidden" name="subprogram_id" value={subprogram.id} />
                        <input type="hidden" name="course_id" value={course.id} />
                        <button class="text-red-700 underline">Desvincular</button>
                      </form>
                    </li>
                  ))}
                </ul>
                {linkedCourses.length === 0 && <p class="mb-3 text-sm text-gray-600">No hay cursos vinculados.</p>}
                <form method="POST" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-3">
                  <input type="hidden" name="action" value="add-course" />
                  <input type="hidden" name="subprogram_id" value={subprogram.id} />
                  <label class="block w-full sm:min-w-48 sm:flex-1 text-sm font-medium space-y-1.5">Curso
                    <select name="course_id" required class={input}>
                      <option value="">Selecciona un curso</option>
                      {availableCourses.map((course) => <option value={course.id}>{course.title} ({course.status})</option>)}
                    </select>
                  </label>
                  <button disabled={availableCourses.length === 0} class="admin-button rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm disabled:opacity-50">Vincular curso</button>
                </form>
              </section>
              <section class="rounded-xl border border-line bg-surface/50 p-4 sm:p-5">
                <h3 class="mb-2 text-base sm:text-lg font-semibold">Esquemas de pago</h3>
                <p class="mb-3 text-sm text-gray-600">Los importes y monedas provienen de los <a href="/admin/escuela/pagos" class="text-brand underline">productos de pago escolares</a>.</p>
                <form method="POST" class="mb-4 rounded-xl border border-line bg-surface p-4 sm:p-5">
                  <input type="hidden" name="action" value="set-enrollment-modality" />
                  <input type="hidden" name="subprogram_id" value={subprogram.id} />
                  <label class="block text-sm font-medium space-y-1.5">Inscripción obligatoria
                    <select name="enrollment_modality_id" class={input}>
                      <option value="">No obligatoria</option>
                      {subModalities.filter((item) => item.payment_type === 'enrollment' && (item.status === 'active' || item.id === subprogram.enrollment_modality_id)).map((item) => <option value={item.id} selected={item.id === subprogram.enrollment_modality_id}>{item.title}{item.status !== 'active' ? ' (inactiva)' : ''}</option>)}
                    </select>
                  </label>
                  <p class="mt-2 text-xs text-gray-600">Selecciona un esquema de inscripción para asignar su pago además del esquema elegido al aprobar.</p>
                  <button class="mt-3 rounded bg-brand px-4 py-2 text-sm font-semibold text-white">Guardar inscripción</button>
                </form>
                <div class="grid gap-3 sm:grid-cols-2">
                  {subModalities.map((modality) => (
                    <details class="admin-card rounded-xl border border-line bg-surface p-4 sm:p-5">
                      <summary class="cursor-pointer font-medium">{modality.title} · {modality.status}{modality.test_mode === 1 && ' · Prueba (solo demo)'}</summary>
                      {modality.concept_mode === 1 && <p class="mt-3 text-sm text-muted">Este esquema utiliza los importes y fechas de sus conceptos; la frecuencia y el producto anteriores no generan cobros.</p>}
                      <div class="mt-4"><ModalityForm subprogramId={subprogram.id} courses={linkedCourses} products={products} modality={modality} /></div>
                      <a href={`/admin/escuela/esquemas/${encodeURIComponent(modality.id)}`} class="mt-4 inline-flex min-h-10 items-center text-sm font-semibold text-brand underline underline-offset-4">Configurar conceptos de pago</a>
                    </details>
                  ))}
                  {subModalities.length === 0 && <p class="text-sm text-gray-600">No hay esquemas de pago.</p>}
                </div>
                <details class="mt-4 rounded border border-line p-4">
                  <summary class="cursor-pointer font-medium">Crear esquema de pago</summary>
                  <div class="mt-4"><ModalityForm subprogramId={subprogram.id} courses={linkedCourses} products={products} /></div>
                  {products.length === 0 && <p class="mt-3 text-sm text-gray-600">Primero crea un producto de pago escolar.</p>}
                </details>
              </section>
            </div>
          </details>
        );
      })}
    </div>
  </section>
<script>
  // Keep the edited subprogram expanded after the server redirect.
  const fragment = window.location.hash;
  if (fragment.startsWith('#subprograma-')) {
    const target = document.querySelector(fragment);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>
</AdminLayout>


