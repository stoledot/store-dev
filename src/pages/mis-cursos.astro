---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getAllLecturasWithoutXmlHtml } from '../features/lecturas/db';

const lecturas = await getAllLecturasWithoutXmlHtml(env.DB);

// Helper para formatear fechas en español
const formatDate = (dateString?: string) => {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('es-MX', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---
<Layout title="Biblioteca de Lecturas" description="Panel del estudiante">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 border-b border-slate-200 pb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Materiales de estudio
        </h1>
        <p class="mt-2 text-base text-slate-600">
          Explora los materiales y lecturas disponibles en la plataforma.
        </p>
      </div>
      <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20 self-start sm:self-auto">
        {lecturas.length} {lecturas.length === 1 ? 'material' : 'materiales'}
      </span>
    </header>

    {lecturas.length === 0 ? (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        <h3 class="mt-3 text-base font-semibold text-slate-900">No hay lecturas disponibles</h3>
        <p class="mt-1 text-sm text-slate-500">Aún no se han agregado lecturas a la base de datos.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {lecturas.map((lectura) => (
          <article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
            <div class="relative aspect-square w-full overflow-hidden bg-slate-100">
              {lectura.image_url ? (
                <img
                  src={lectura.image_url}
                  alt={lectura.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-50 to-slate-100 text-indigo-300">
                  <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                </div>
              )}

              {lectura.type && (
                <span class="absolute top-3 left-3 inline-flex items-center rounded-md bg-white/90 backdrop-blur-sm px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-slate-800 shadow-sm">
                  {lectura.type}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col justify-between p-5">
              <div>
                <h2 class="text-lg font-bold text-slate-900 line-clamp-2 group-hover:text-indigo-600 transition-colors">
                  <a href={`/lecturas/${lectura.id}`}>
                    <span class="absolute inset-0" aria-hidden="true"></span>
                    {lectura.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-3">
                  {lectura.description || 'Sin descripción disponible.'}
                </p>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <time datetime={lectura.created_at}>
                  {formatDate(lectura.created_at)}
                </time>
                <span class="font-medium text-indigo-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                  Leer más
                  <span aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>
