---
export const prerender=false;
import { env } from 'cloudflare:workers';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import Layout from '../../layouts/Layout.astro';
import SocialFeed from '../../components/social/SocialFeed.astro';
const email=await getCustomerEmail(Astro.cookies);if(!(await accountsEnabled())||!email)return Astro.redirect('/account/login?next=%2Fgrupos');const group=await env.DB.prepare("SELECT g.*,EXISTS(SELECT 1 FROM social_group_members m WHERE m.group_id=g.id AND m.email=? COLLATE NOCASE) AS joined FROM social_groups g WHERE slug=? AND status='active'").bind(email,Astro.params.slug).first<any>();if(!group)return new Response('Grupo no encontrado',{status:404});
---
<Layout title={group.title}><main class="mx-auto max-w-4xl px-4 py-8 sm:px-6" data-social-page><a class="text-sm underline" href="/grupos">← Grupos</a>{group.image_url&&<img class="mt-5 h-56 w-full rounded-2xl object-cover" src={group.image_url} alt=""/>}<header class="my-6"><p class="text-xs font-bold uppercase tracking-widest text-brand">Grupo</p><h1 class="mt-2 font-serif text-4xl">{group.title}</h1><p class="mt-3 whitespace-pre-wrap text-muted">{group.description}</p><button data-join={group.id} data-joined={group.joined?'1':'0'} class="mt-4 rounded-lg border border-line px-4 py-2 text-sm">{group.joined?'Salir del grupo':'Unirme al grupo'}</button></header>{group.joined&&<form data-post-form data-group={group.id} class="mb-8 rounded-2xl border border-line bg-surface p-4"><label class="grid gap-2 font-semibold">Crear publicación<textarea name="body" required maxlength="5000" rows="4" placeholder="Comparte una idea. También puedes escribir fórmulas con $...$ o $$...$$." class="rounded-xl border border-line bg-background p-3 font-normal"></textarea></label><div class="mt-3 flex items-center justify-between"><p data-status class="text-sm text-red-700"></p><button class="rounded-lg bg-brand px-4 py-2 font-semibold text-white">Publicar</button></div></form>}<SocialFeed groupId={group.id}/><button data-notification-optin class="mt-6 rounded-lg border border-line px-4 py-2 text-sm">Activar avisos del navegador</button></main></Layout>
