export const prerender=false;
import Layout from '../layouts/Layout.astro';
const sent=Astro.url.searchParams.get('sent')==='1';
const error=Astro.url.searchParams.get('error');
---
<Layout title="Anúnciate" description="Cuéntanos cómo te gustaría anunciar tu proyecto en nuestros contenidos matemáticos."><main class="mx-auto max-w-3xl px-4 py-10 sm:px-6"><a class="text-sm underline" href="/">← Inicio</a><header class="my-6"><p class="text-xs font-semibold uppercase tracking-[.18em] text-brand">Colabora con nosotros</p><h1 class="mt-2 font-serif text-4xl">Anúnciate aquí</h1><p class="mt-3 leading-7 text-muted">Cuéntanos sobre tu empresa y el tipo de colaboración que imaginas. Podemos conversar sobre paquetes por visualizaciones, espacios patrocinados o una inversión mensual.</p></header>{sent&&<p class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">Gracias. Recibimos tu propuesta y nos pondremos en contacto contigo.</p>}{error&&<p class="mb-5 rounded-xl bg-red-50 p-4 text-red-900">No pudimos enviar tu propuesta. Revisa los datos e inténtalo de nuevo.</p>}<form method="POST" action="/api/advertising-inquiries" class="grid gap-4 rounded-2xl border border-line bg-surface p-5 sm:grid-cols-2 sm:p-7"><label class="text-sm">Empresa o proyecto<input name="company_name" required maxlength="180" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" autocomplete="organization"/></label><label class="text-sm">Nombre de contacto<input name="contact_name" required maxlength="160" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" autocomplete="name"/></label><label class="text-sm">Correo de contacto<input name="email" type="email" required maxlength="254" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" autocomplete="email"/></label><label class="text-sm">Teléfono (opcional)<input name="phone" type="tel" maxlength="40" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" autocomplete="tel"/></label><label class="text-sm sm:col-span-2">Sitio web o redes<input name="website" type="url" maxlength="500" placeholder="https://…" class="mt-1 block w-full rounded-lg border border-line bg-white p-3"/></label><fieldset class="sm:col-span-2"><legend class="mb-2 text-sm font-medium">¿Cómo te gustaría pautar?</legend><div class="grid gap-2 sm:grid-cols-3">{[['views','Por visualizaciones'],['budget','Por presupuesto'],['sponsorship','Patrocinio / otro']].map(([value,label])=><label class="flex items-center gap-2 rounded-lg border border-line bg-white p-3 text-sm"><input type="radio" name="format_preference" value={value} required/>{label}</label>)}</div></fieldset><label class="text-sm">Visualizaciones deseadas al mes<input name="monthly_views" type="number" min="1" max="100000000" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" placeholder="Opcional"/></label><label class="text-sm">Presupuesto mensual (MXN)<input name="monthly_budget" type="number" min="1" step="0.01" class="mt-1 block w-full rounded-lg border border-line bg-white p-3" placeholder="Opcional"/></label><label class="text-sm sm:col-span-2">Cuéntanos qué quieres promover y qué resultados buscas<textarea name="message" rows="5" maxlength="3000" class="mt-1 block w-full rounded-lg border border-line bg-white p-3"></textarea></label><label class="hidden" aria-hidden="true">No completar<input name="website_confirm" tabindex="-1" autocomplete="off"/></label><button class="rounded-full bg-brand px-6 py-3 font-semibold text-white sm:col-span-2 sm:justify-self-start">Enviar propuesta</button><p class="text-xs text-muted sm:col-span-2">Usaremos tus datos únicamente para responder esta solicitud. Enviar el formulario no implica la contratación de publicidad.</p></form></main></Layout>
