---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  accountsEnabled,
  requestLogin,
  isValidEmail,
  getCustomerEmail,
  setCustomerSession,
} from '../../features/auth/customer';
import { verifyClientPassword } from '../../features/auth/customerIdentity';
import { customerReturnTo } from '../../features/auth/returnTo';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
// Already signed in → account.
const returnTo = customerReturnTo(Astro.url.searchParams.get('next'));
if (await getCustomerEmail(Astro.cookies)) return Astro.redirect(returnTo, 303);

let sent = false;
let error = Astro.url.searchParams.get('error') === 'expired' ? 'Ese enlace ha caducado. Solicita uno nuevo.' : Astro.url.searchParams.get('error') === 'email-moved' ? 'Este correo ya no es el principal de la cuenta. Inicia sesión con el correo nuevo.' : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action=String(form.get('action')??'magic');
  // Bot challenge (if enabled in Settings → Bot protection): verify with the vault secret.
  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );
  if (!tsOk) error='No se pudo validar el formulario. Inténtalo de nuevo.';
  else if(action==='password'){
    const clientNumber=String(form.get('client_number')??'').trim(),password=String(form.get('password')??'');
    const email=await verifyClientPassword(env.DB,clientNumber,password);
    if(!email)error='Número de cliente o contraseña incorrectos.';
    else{await setCustomerSession(Astro.cookies,email,Astro.url.protocol==='https:');return Astro.redirect(returnTo,303);}
  }else{
    const email=String(form.get('email')??'');
    if(!isValidEmail(email))error='Escribe un correo electrónico válido.';
    else{await requestLogin(email,Astro.url.origin,returnTo);sent=true;}
  }
}
---

<Layout title="Iniciar sesión">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">Iniciar sesión</h1>

    {
      sent ? (
        <p class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
          Revisa tu correo: te enviamos un enlace de acceso de un solo uso. Caduca en 15 minutos.
        </p>
      ) : (
        <Fragment>
          <h2>Únete a los grupos gratuitos de ayuda comunitaria en matemáticas.</h2>
          <p class="mb-5 text-sm text-muted">Entra con tu número de cliente y contraseña, o solicita un enlace de acceso a tu correo.</p>
          {error && (
            <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
              {error}
            </p>
          )}
          <form method="POST" class="space-y-3 rounded-2xl border border-line p-4">
            <input type="hidden" name="action" value="password" />
            <input type="hidden" name="next" value={returnTo} />
            <label class="grid gap-1 text-sm font-medium">Número de cliente<input name="client_number" type="text" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" required placeholder="10 dígitos" autocomplete="username" class="rounded-lg border border-line px-3 py-2 font-normal" /></label>
            <label class="grid gap-1 text-sm font-medium">Contraseña<input name="password" type="password" required maxlength="200" autocomplete="current-password" class="rounded-lg border border-line px-3 py-2 font-normal" /></label>
            <div class="flex justify-center"><Turnstile /></div>
            <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand">Entrar con contraseña</button>
          </form>
          <div class="my-5 text-center text-xs uppercase tracking-widest text-muted">o usa un enlace seguro</div>
          <form method="POST" class="space-y-3 rounded-2xl border border-line p-4">
            <input type="hidden" name="action" value="magic" />
            <input type="hidden" name="next" value={returnTo} />
            <input
              type="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder="tu@correo.com"
              class="w-full rounded-md border border-line px-3 py-2"
            />
            <div class="flex justify-center">
              <Turnstile />
            </div>
            <button
              type="submit"
              class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
            >
              Enviarme enlace de acceso
            </button>
          </form>
        </Fragment>
      )
    }
  </div>
</Layout>
