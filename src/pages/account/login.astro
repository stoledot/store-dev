---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  accountsEnabled,
  requestLogin,
  isValidEmail,
  getCustomerEmail,
} from '../../features/auth/customer';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
// Already signed in → account.
const returnTo = ['/account/profile', '/escuela/diagnostico'].includes(Astro.url.searchParams.get('next') ?? '') ? Astro.url.searchParams.get('next')! : '/account';
if (await getCustomerEmail(Astro.cookies)) return Astro.redirect(returnTo, 303);

let sent = false;
let error = Astro.url.searchParams.get('error') === 'expired' ? 'Ese enlace ha caducado. Solicita uno nuevo.' : Astro.url.searchParams.get('error') === 'email-moved' ? 'Este correo ya no es el principal de la cuenta. Inicia sesión con el correo nuevo.' : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  // Bot challenge (if enabled in Settings → Bot protection): verify with the vault secret.
  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );
  if (!tsOk) {
    error = 'Verification failed — please try again.';
  } else if (!isValidEmail(email)) {
    error = 'Enter a valid email address.';
  } else {
    await requestLogin(email, Astro.url.origin, returnTo);
    sent = true;
  }
}
---

<Layout title="Iniciar sesión">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">Iniciar sesión</h1>

    {
      sent ? (
        <p class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
          Revisa tu correo: te enviamos un enlace de acceso de un solo uso. Caduca en 15 minutos.
        </p>
      ) : (
        <Fragment>
          <p class="mb-5 text-sm text-muted">
            Introduce tu correo y te enviaremos un enlace de acceso; no necesitas contraseña. Utiliza la dirección
            que usaste al comprar para consultar tu historial de pedidos.
          </p>
          {error && (
            <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
              {error}
            </p>
          )}
          <form method="POST" class="space-y-3">
            <input type="hidden" name="next" value={returnTo} />
            <input
              type="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder="tu@correo.com"
              class="w-full rounded-md border border-line px-3 py-2"
            />
            <div class="flex justify-center">
              <Turnstile />
            </div>
            <button
              type="submit"
              class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
            >
              Enviar enlace de acceso
            </button>
          </form>
        </Fragment>
      )
    }
  </div>
</Layout>
