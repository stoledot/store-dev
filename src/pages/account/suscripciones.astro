---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { formatMoney } from '../../money';
if(!(await accountsEnabled()))return Astro.redirect('/',303);const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);
const rows=(await env.DB.prepare(`SELECT ss.id,ss.status,ss.current_period_start,ss.current_period_end,ss.last_payment_at,ss.cancel_at_period_end,ss.created_at,s.title AS plan_title,s.interval_unit,s.interval_count,s.currency,ss.unit_amount_minor,co.accepted_policy_json,co.accepted_at FROM school_subscriptions ss LEFT JOIN content_subscriptions s ON s.id=ss.content_subscription_id LEFT JOIN subscription_consents co ON co.stripe_subscription_id=ss.stripe_subscription_id WHERE lower(trim(ss.student_email))=lower(trim(?)) ORDER BY ss.created_at DESC`).bind(email).all<any>()).results??[];
const notice=Astro.url.searchParams.get('checkout'),cancelled=Astro.url.searchParams.get('cancelled');const date=(v:string|null)=>v?new Date(v).toLocaleDateString('es-MX',{year:'numeric',month:'long',day:'numeric',timeZone:'America/Mexico_City'}):'Aún no registrado';const labels:Record<string,string>={incomplete:'Pendiente de activación',trialing:'Prueba activa',active:'Activa',past_due:'Pago pendiente',unpaid:'Pago vencido',canceled:'Cancelada',incomplete_expired:'No completada',paused:'Pausada'};const accepted=(raw:string|null)=>{try{return raw?JSON.parse(raw):null;}catch{return null;}};
---
<Layout title="Mis suscripciones"><main class="mx-auto max-w-4xl px-4 py-8 sm:px-6"><a href="/account" class="text-sm underline">← Mi cuenta</a><header class="my-5"><p class="text-xs font-semibold uppercase tracking-widest text-muted">Planes recurrentes</p><h1 class="mt-2 font-serif text-3xl">Mis suscripciones</h1><p class="mt-2 text-sm text-muted">Consulta estado, pagos, próxima renovación y las condiciones vigentes al contratar.</p></header>{notice==='processing'&&<p class="mb-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900">Estamos sincronizando con Stripe el estado de tu suscripción.</p>}{cancelled==='scheduled'&&<p class="mb-4 rounded-xl bg-green-50 p-4 text-sm text-green-900">La cancelación quedó programada y detendrá las próximas renovaciones.</p>}{rows.length?<div class="space-y-4">{rows.map(s=>{const a=accepted(s.accepted_policy_json);return <article class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs uppercase tracking-wider text-muted">{s.plan_title??'Plan archivado'}</p><h2 class="mt-1 text-xl font-semibold">{labels[s.status]??s.status}{s.cancel_at_period_end?' · Cancelará al final del periodo':''}</h2><p class="mt-1 text-sm text-muted">{formatMoney(s.unit_amount_minor,s.currency)} cada {s.interval_count===1?'':`${s.interval_count} `}{s.interval_unit==='year'?'año':'mes'}</p></div><span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold">{labels[s.status]??s.status}</span></div><dl class="mt-5 grid gap-3 border-t border-line pt-4 sm:grid-cols-2"><div><dt class="text-xs text-muted">Último pago</dt><dd class="mt-1 text-sm font-medium">{date(s.last_payment_at)}</dd></div><div><dt class="text-xs text-muted">Próximo pago / fin del periodo</dt><dd class="mt-1 text-sm font-medium">{date(s.current_period_end)}</dd></div></dl>{a&&<details class="mt-4 rounded-xl border border-line p-4"><summary class="cursor-pointer text-sm font-semibold">Condiciones aceptadas el {date(s.accepted_at)}</summary><p class="mt-3 text-sm">{a.recurringDisclosure}</p><h3 class="mt-4 font-semibold">Condiciones y autorización</h3><p class="mt-1 whitespace-pre-wrap text-sm leading-6">{a.subscriptionTerms}</p><h3 class="mt-4 font-semibold">Política de reembolso</h3><p class="mt-1 whitespace-pre-wrap text-sm leading-6">{a.refundPolicy}</p><h3 class="mt-4 font-semibold">Aviso de privacidad</h3><p class="mt-1 whitespace-pre-wrap text-sm leading-6">{a.privacyNotice}</p>{a.privacyNoticeUrl&&<a class="mt-2 inline-block text-sm underline" href={a.privacyNoticeUrl} target="_blank" rel="noopener noreferrer">Abrir aviso integral</a>}</details>}{['active','trialing','past_due'].includes(s.status)&&!s.cancel_at_period_end&&<form method="POST" action="/api/subscriptions/cancel" class="mt-5"><input type="hidden" name="id" value={s.id}/><button class="rounded-lg border border-red-200 px-4 py-2 text-sm font-semibold text-red-700">Cancelar renovación</button><p class="mt-2 text-xs text-muted">La solicitud se procesa de inmediato y detiene la siguiente renovación; el acceso pagado continúa hasta el fin del periodo.</p></form>}</article>})}</div>:<section class="rounded-2xl border border-dashed border-line p-8 text-center"><h2 class="text-lg font-semibold">Todavía no tienes suscripciones</h2><p class="mt-2 text-sm text-muted">Cuando contrates un plan, aquí podrás consultar tus renovaciones.</p><a href="/products" class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white">Ver productos</a></section>}</main></Layout>
