---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { mediaUrl } from '../../features/media/url';
import { getConfig } from '../../config';
if(!(await accountsEnabled()))return Astro.redirect('/',303);const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);
const magazines=(await env.DB.prepare(`SELECT m.id,m.slug,m.title,m.description,m.cover_image_key,CASE WHEN MAX(CASE WHEN cs.magazine_access='all' THEN 1 ELSE 0 END)=1 THEN 'all' ELSE 'latest' END AS access_mode,(SELECT i.title FROM math_magazine_issues i WHERE i.magazine_id=m.id AND i.status='published' ORDER BY i.issue_date DESC,i.updated_at DESC LIMIT 1) AS latest_title,(SELECT i.slug FROM math_magazine_issues i WHERE i.magazine_id=m.id AND i.status='published' ORDER BY i.issue_date DESC,i.updated_at DESC LIMIT 1) AS latest_slug FROM math_magazines m JOIN content_subscriptions cs ON cs.magazine_id=m.id JOIN school_subscriptions ss ON ss.content_subscription_id=cs.id WHERE m.status='published' AND cs.status='active' AND lower(trim(ss.student_email))=lower(trim(?)) AND ss.status IN ('active','trialing') AND (ss.current_period_end IS NULL OR ss.current_period_end>strftime('%Y-%m-%dT%H:%M:%fZ','now')) GROUP BY m.id ORDER BY m.title COLLATE NOCASE`).bind(email).all<any>()).results??[];const imageBase=getConfig().images.baseUrl;
---
<Layout title="Mis revistas"><main class="mx-auto max-w-5xl px-4 py-8 sm:px-6"><a href="/account" class="text-sm underline">← Mi cuenta</a><header class="my-6"><p class="text-xs font-semibold uppercase tracking-widest text-muted">Biblioteca editorial</p><h1 class="mt-2 font-serif text-3xl">Mis revistas</h1><p class="mt-2 text-sm text-muted">Tus ediciones disponibles según el plan activo.</p></header>{magazines.length?<div class="grid gap-4 sm:grid-cols-2">{magazines.map(m=><article class="overflow-hidden rounded-2xl border border-line bg-surface sm:flex">{m.cover_image_key&&<img class="h-56 w-full object-cover sm:h-auto sm:w-40" src={mediaUrl(m.cover_image_key,imageBase)} alt={`Portada ${m.title}`}/>}<div class="flex-1 p-5"><p class="text-xs font-semibold uppercase tracking-wider text-green-700">{m.access_mode==='all'?'Acceso a todas las ediciones':'Acceso a la edición vigente'}</p><h2 class="mt-1 font-serif text-2xl">{m.title}</h2>{m.latest_title&&<p class="mt-3 text-sm text-muted">Edición más reciente: {m.latest_title}</p>}{m.description&&<p class="mt-3 line-clamp-3 text-sm text-muted">{m.description}</p>}<a class="mt-5 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href={`/revistas/${m.slug}`}>{m.access_mode==='all'?'Explorar revista':'Leer edición vigente'} →</a></div></article>)}</div>:<section class="rounded-2xl border border-dashed border-line p-8 text-center"><h2 class="text-lg font-semibold">Aún no tienes una revista suscrita</h2><p class="mt-2 text-sm text-muted">Explora las revistas matemáticas disponibles y sus opciones de acceso.</p><a class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href="/">Ver revistas →</a></section>}</main></Layout>
