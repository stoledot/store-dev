---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, formatDate, getConfig } from '../../config';
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';
import { countOrdersByEmail, listOrdersByEmail } from '../../features/orders/db';
import { orderReference } from '../../features/orders/number';
import { guestOrderUrl } from '../../features/orders/guestAccess.ts';
import { paginate, queryHref } from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import { catalogPath } from '../../features/settings/home';
import { ensureProfile, getProfile } from '../../features/customers/profiles';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);
await ensureProfile(env.DB,email);
const profile=await getProfile(env.DB,email);
const unreadMessages=await env.DB.prepare("SELECT COUNT(*) AS n FROM customer_messages WHERE customer_email=? COLLATE NOCASE AND sender_role='admin' AND read_at IS NULL").bind(email).first<{n:number}>();
const schoolContent = (await env.DB.prepare(`SELECT c.id,c.title,c.slug,c.summary,c.content_kind,c.updated_at,(SELECT l.slug FROM school_lessons l WHERE l.course_id=c.id AND l.status='published' ORDER BY l.sequence_no LIMIT 1) AS first_lesson FROM school_courses c JOIN order_items oi ON oi.school_course_id=c.id JOIN orders so ON so.id=oi.order_id WHERE lower(trim(so.email))=lower(trim(?)) AND so.status='paid' AND COALESCE(so.refunded_cents,0)<so.amount_total_cents AND c.status='published' GROUP BY c.id ORDER BY c.content_kind,c.title COLLATE NOCASE`).bind(email).all<{id:string;title:string;slug:string;summary:string;content_kind:string;updated_at:string;first_lesson:string|null}>()).results ?? [];

const PAGE_SIZE = 20;
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  await countOrdersByEmail(env.DB, email),
  PAGE_SIZE,
);
const orders = await listOrdersByEmail(env.DB, email, PAGE_SIZE, offset);
// Tokenized guest links for the customer's OWN orders — the authenticated
// account view is an allowlisted token position, same as their emails. Orders
// with no resolvable link render as plain text rather than a dead bare-id URL.
const orderLinks = new Map(
  await Promise.all(
    orders.map(async (o) => [o.id, await guestOrderUrl(env.DB, o.public_id, '')] as const),
  ),
);
const hrefFor = (p: number) => queryHref('/account', { page: p > 1 ? p : undefined });
const orderCfg = getConfig().orderNumber;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="Mi cuenta">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Mi cuenta</h1>
      <a href="/account/logout" class="text-sm font-medium text-accent">Cerrar sesión</a>
    </div>
    <p class="mb-6 text-sm text-muted">Hola{profile?.full_name ? `, ${profile.full_name}` : ''}. Tu correo asociado es <strong class="break-all">{email}</strong>.</p>
    <section class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/account/profile" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">👤</span><h2 class="mt-2 font-semibold">Mi perfil</h2><p class="mt-1 text-xs text-muted">Datos personales y académicos</p></a>
      <a href="/account/courses" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">🎓</span><h2 class="mt-2 font-semibold">Mis cursos</h2><p class="mt-1 text-xs text-muted">Inscripciones y avance</p></a>
      <a href="/account/readings" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">📚</span><h2 class="mt-2 font-semibold">Mis lecturas</h2><p class="mt-1 text-xs text-muted">Textos matemáticos comprados</p></a>
      <a href="/account/payments" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">💳</span><h2 class="mt-2 font-semibold">Pagos</h2><p class="mt-1 text-xs text-muted">Pendientes, realizados y próximas fechas</p></a>
      <a href="/account/calendar" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">🗓️</span><h2 class="mt-2 font-semibold">Calendario</h2><p class="mt-1 text-xs text-muted">Cursos, actividades y fechas de pago</p></a>
      <a href="/account/messages" class="relative rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">✉️</span><h2 class="mt-2 font-semibold">Buzón</h2><p class="mt-1 text-xs text-muted">Mensajes de la escuela</p>{(unreadMessages?.n ?? 0)>0 && <span class="absolute right-3 top-3 rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-white">{unreadMessages?.n}</span>}</a>
      <a href="/account/notificaciones" class="rounded-xl border border-line bg-surface p-4 transition hover:border-accent"><span class="text-xl">🔔</span><h2 class="mt-2 font-semibold">Notificaciones</h2><p class="mt-1 text-xs text-muted">Avisos académicos y retroalimentación</p></a>
    </section>

    <div class="mb-5 flex flex-wrap gap-3 text-sm"><a class="rounded-lg border border-line px-3 py-2 underline" href="/account/profile">Mi perfil</a><a class="rounded-lg border border-line px-3 py-2 underline" href="/account/messages">Buzón</a><a class="rounded-lg border border-line px-3 py-2 underline" href="/escuela/mi-escuela">Mi escuela</a></div>
    {schoolContent.length > 0 && <section class="mb-8"><h2 class="mb-3 text-xl font-semibold">Tus cursos y lecturas</h2><div class="grid gap-3 sm:grid-cols-2">{schoolContent.map((item)=><article class="rounded-xl border border-line bg-surface p-4"><p class="text-xs uppercase tracking-wider text-muted">{item.content_kind==='reading'?'Lectura matemática':'Curso'}</p><h3 class="mt-1 font-semibold">{item.title}</h3>{item.summary&&<p class="mt-1 text-sm text-muted">{item.summary}</p>}<a class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href={item.content_kind==='reading'?`/lecturas/${item.slug}`:`/escuela/cursos/${item.slug}/${item.first_lesson ?? ''}`}>{item.content_kind==='reading'?'Abrir lectura':'Continuar curso'} →</a></article>)}</div></section>}
    <!-- School access: keep this link visible from the customer account page. -->
    <section class="mb-8 rounded-xl border border-line bg-surface p-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <div>
        <h2 class="text-lg font-semibold tracking-tight text-ink">Tu espacio académico</h2>
        <p class="mt-1 text-sm text-muted">Consulta tu curso asignado, avance académico y lecciones disponibles.</p>
      </div>
      <a
        href="/escuela/mi-escuela"
        class="mt-4 inline-flex shrink-0 items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 sm:mt-0"
      >
        Abrir mi escuela <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </section>

    {
      orders.length === 0 ? (
        <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted">
          Todavía no tienes pedidos. <a href={shopHref} class="font-medium text-accent">Explorar materiales →</a>
        </p>
      ) : (
        <ul class="divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface">
          {orders.map((o) => (
            <li class="flex items-center justify-between gap-4 px-4 py-4 text-sm">
              <div>
                {orderLinks.get(o.id) ? (
                  <a href={orderLinks.get(o.id)} class="font-medium text-ink hover:text-accent">
                    Pedido n.º {orderReference(o.public_id, o.id, orderCfg)}
                  </a>
                ) : (
                  <span class="font-medium text-ink">
                    Pedido n.º {orderReference(o.public_id, o.id, orderCfg)}
                  </span>
                )}
                <div class="text-xs text-faint">{formatDate(o.created_at, undefined, timeZone)}</div>
              </div>
              <div class="text-right">
                <div class="tabular-nums">{formatPrice(o.amount_total_cents, o.currency)}</div>
                <div class="text-xs capitalize text-faint">
                  {o.refunded_cents > 0 && o.refunded_cents < o.amount_total_cents
                    ? 'Reembolso parcial'
                    : o.status}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </div>
</Layout>
