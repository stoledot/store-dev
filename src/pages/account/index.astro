---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, formatDate, getConfig } from '../../config';
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';
import { countOrdersByEmail, listOrdersByEmail } from '../../features/orders/db';
import { orderReference } from '../../features/orders/number';
import { guestOrderUrl } from '../../features/orders/guestAccess.ts';
import { paginate, queryHref } from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import { catalogPath } from '../../features/settings/home';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);

const PAGE_SIZE = 20;
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  await countOrdersByEmail(env.DB, email),
  PAGE_SIZE,
);
const orders = await listOrdersByEmail(env.DB, email, PAGE_SIZE, offset);
// Tokenized guest links for the customer's OWN orders — the authenticated
// account view is an allowlisted token position, same as their emails. Orders
// with no resolvable link render as plain text rather than a dead bare-id URL.
const orderLinks = new Map(
  await Promise.all(
    orders.map(async (o) => [o.id, await guestOrderUrl(env.DB, o.public_id, '')] as const),
  ),
);
const hrefFor = (p: number) => queryHref('/account', { page: p > 1 ? p : undefined });
const orderCfg = getConfig().orderNumber;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="Your account">
  <div class="mx-auto max-w-2xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Your orders</h1>
      <a href="/account/logout" class="text-sm font-medium text-accent">Sign out</a>
    </div>
    <p class="mb-6 text-sm text-muted">Signed in as {email}</p>

    <!-- School access: keep this link visible from the customer account page. -->
    <section class="mb-8 rounded-xl border border-line bg-surface p-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <div>
        <h2 class="text-lg font-semibold tracking-tight text-ink">Escuela de Matemáticas</h2>
        <p class="mt-1 text-sm text-muted">Accede a tu panel académico, consulta tu curso asignado y continúa tus lecciones.</p>
      </div>
      <a
        href="/escuela/mi-escuela"
        class="mt-4 inline-flex shrink-0 items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 sm:mt-0"
      >
        Ir a mi escuela <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </section>

    {
      orders.length === 0 ? (
        <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted">
          No orders yet. <a href={shopHref} class="font-medium text-accent">Start shopping →</a>
        </p>
      ) : (
        <ul class="divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface">
          {orders.map((o) => (
            <li class="flex items-center justify-between gap-4 px-4 py-4 text-sm">
              <div>
                {orderLinks.get(o.id) ? (
                  <a href={orderLinks.get(o.id)} class="font-medium text-ink hover:text-accent">
                    Order #{orderReference(o.public_id, o.id, orderCfg)}
                  </a>
                ) : (
                  <span class="font-medium text-ink">
                    Order #{orderReference(o.public_id, o.id, orderCfg)}
                  </span>
                )}
                <div class="text-xs text-faint">{formatDate(o.created_at, undefined, timeZone)}</div>
              </div>
              <div class="text-right">
                <div class="tabular-nums">{formatPrice(o.amount_total_cents, o.currency)}</div>
                <div class="text-xs capitalize text-faint">
                  {o.refunded_cents > 0 && o.refunded_cents < o.amount_total_cents
                    ? 'Partially refunded'
                    : o.status}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </div>
</Layout>
