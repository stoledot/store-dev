---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getUserConferences, getUserConferencesSessions } from '../../features/conferences/db';
export const prerender = false;
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';
import { ensureProfile } from '../../features/customers/profiles';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);
await ensureProfile(env.DB,email);

const userEmail = email;

const [conferences, sessions] = await Promise.all([
  getUserConferences(env.DB, userEmail),
  getUserConferencesSessions(env.DB, userEmail),
]);

const sortedSessions = [...sessions].sort(
  (a, b) => new Date(a.starts_at).getTime() - new Date(b.starts_at).getTime()
);

function formatSessionDate(dateString: string, timeZone?: string) {
  try {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('es-MX', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: timeZone || 'UTC',
    }).format(date);
  } catch {
    return dateString;
  }
}

const conferenceMap = new Map(conferences.map((c) => [c.id, c.title]));
---

<Layout title="Mis Conferencias">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-32 space-y-10">
    
    <!-- Encabezado -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
          Mis Conferencias
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Gestiona tus eventos inscritos y accede a tus sesiones en vivo.
        </p>
      </div>
      <span class="inline-flex items-center self-start sm:self-auto gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
        <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
        {userEmail}
      </span>
    </header>

    <!-- Sección 1: Tarjetas de Resumen (KPIs) -->
    <section aria-label="Resumen de actividad" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Total Conferencias -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Conferencias</p>
          <p class="text-2xl font-bold text-slate-900">{conferences.length}</p>
        </div>
      </div>

      <!-- Total Sesiones -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Sesiones Totales</p>
          <p class="text-2xl font-bold text-slate-900">{sessions.length}</p>
        </div>
      </div>

      <!-- Próxima Sesión -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Próxima Sesión</p>
          <p class="text-sm font-semibold text-slate-900 truncate">
            {sortedSessions.length > 0 
              ? formatSessionDate(sortedSessions[0].starts_at, sortedSessions[0].time_zone) 
              : 'Sin programar'}
          </p>
        </div>
      </div>
    </section>

    <!-- Sección 2: Agenda de Sesiones -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>Agenda de Sesiones</span>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">
            {sessions.length}
          </span>
        </h2>
      </div>

      {sortedSessions.length === 0 ? (
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center">
          <p class="text-slate-500 text-sm">Aún no tienes sesiones asignadas en tus conferencias.</p>
        </div>
      ) : (
        <div class="space-y-3">
          {sortedSessions.map((session) => (
            <div class="group bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:border-indigo-300 hover:shadow-md transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
              
              <!-- Info principal de la sesión -->
              <div class="space-y-1.5">
                {session.conference_id && conferenceMap.get(session.conference_id) && (
                  <span class="inline-block text-[11px] font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md">
                    {conferenceMap.get(session.conference_id)}
                  </span>
                )}
                
                <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                  {session.title}
                </h3>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
                  <span class="flex items-center gap-1.5 font-medium text-slate-700">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {formatSessionDate(session.starts_at, session.time_zone)} ({session.time_zone})
                  </span>

                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {session.duration_minutes} min
                  </span>

                  {session.zoom_meeting_id && (
                    <span class="text-slate-400">
                      ID: <strong class="font-mono text-slate-600">{session.zoom_meeting_id}</strong>
                    </span>
                  )}

                  {session.passcode && (
                    <span class="text-slate-400">
                      Código: <strong class="font-mono text-slate-600">{session.passcode}</strong>
                    </span>
                  )}
                </div>
              </div>

              <!-- Botón de acción (Unirse a Zoom) -->
              <div class="flex items-center shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100">
                {session.join_url ? (
                  <a
                    href={session.join_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm shadow-indigo-600/20 transition-all"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Unirse a la sesión
                  </a>
                ) : (
                  <span class="w-full md:w-auto text-center px-4 py-2 rounded-xl text-xs font-medium bg-slate-100 text-slate-500">
                    Enlace pendiente
                  </span>
                )}
              </div>

            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Sección 3: Conferencias Inscritas -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>Conferencias Inscritas</span>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">
            {conferences.length}
          </span>
        </h2>
      </div>

      {conferences.length === 0 ? (
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center">
          <p class="text-slate-500 text-sm">No estás inscrito en ninguna conferencia por el momento.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {conferences.map((conference) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-4 flex flex-col gap-2">
              <h3 class="text-sm font-bold text-slate-900">{conference.title}</h3>

<span
class:list={[
'shrink-0 px-2.5 py-0.5 rounded-full text-[11px] font-semibold capitalize',
conference.status === 'active' || conference.status === 'published'
? 'bg-emerald-50 text-emerald-700 border border-emerald-200/60'
: 'bg-slate-100 text-slate-600',
]}
>
{conference.status}
{conference.description || 'Sin descripción disponible.'}

Ref: {conference.public_id}

{sessions.filter((s) => s.conference_id === conference.id).length} sesiones



            </span>
          </div>
          ))}

        </div>
      )}
    </section>
</div>
</Layout>