---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { ensureProfile,getProfile } from '../../features/customers/profiles';
import SocialFeed from '../../components/social/SocialFeed.astro';
const email=await getCustomerEmail(Astro.cookies);if(!(await accountsEnabled())||!email)return Astro.redirect('/account/login?next=%2Faccount%2Fsocial');await ensureProfile(env.DB,email);const profile=await getProfile(env.DB,email);const view=Astro.url.searchParams.get('view')||'overview';
const groups=(await env.DB.prepare('SELECT g.id,g.slug,g.title,g.image_url FROM social_groups g JOIN social_group_members m ON m.group_id=g.id WHERE m.email=? COLLATE NOCASE ORDER BY g.title').bind(email).all<any>()).results??[];
---
<Layout title="Cuenta social"><main class="mx-auto max-w-5xl px-4 py-8 sm:px-6" data-social-page><div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-widest text-brand">Comunidad</p><h1 class="mt-2 font-serif text-4xl">Cuenta social</h1></div><button data-notification-optin class="rounded-lg border border-line px-4 py-2 text-sm">Activar avisos del navegador</button></div><section class="mb-7 flex flex-wrap items-center gap-4 rounded-2xl border border-line bg-surface p-5">{profile?.social_avatar_image_key?<img src={`/images/${profile.social_avatar_image_key}`} alt="Foto de perfil" class="h-20 w-20 rounded-full object-cover"/>:<span class="grid h-20 w-20 place-items-center rounded-full bg-brand/10 text-3xl">◎</span>}<div><h2 class="text-xl font-semibold">{profile?.full_name||email}</h2><p class="text-sm text-muted">Tu actividad, grupos y publicaciones guardadas.</p><a class="mt-2 inline-block text-sm font-semibold underline" href="/account/profile#social-photo">Cambiar foto en cuenta académica</a></div></section><nav class="mb-6 flex flex-wrap gap-2"><a class="rounded-lg border border-line px-3 py-2 text-sm" href="/account/social">Resumen</a><a class="rounded-lg border border-line px-3 py-2 text-sm" href="/account/social?view=groups">Tus grupos</a><a class="rounded-lg border border-line px-3 py-2 text-sm" href="/account/social?view=posts">Tus publicaciones</a><a class="rounded-lg border border-line px-3 py-2 text-sm" href="/account/social?view=saved">Guardadas</a><a class="rounded-lg border border-line px-3 py-2 text-sm" href="/account">Cuenta académica</a></nav>{view==='groups'?<section class="grid gap-3 sm:grid-cols-2">{groups.map(g=><a class="rounded-xl border border-line bg-surface p-4 font-semibold" href={`/grupos/${g.slug}`}>{g.title} →</a>)}{groups.length===0&&<p class="text-sm text-muted">Todavía no perteneces a un grupo. <a href="/grupos" class="underline">Explorar grupos</a></p>}</section>:view==='posts'?<SocialFeed mine={true}/>:view==='saved'?<SocialFeed saved={true}/>:<><section class="mb-8 rounded-xl border border-line p-5"><h2 class="font-semibold">Tus grupos</h2><div class="mt-3 flex flex-wrap gap-2">{groups.slice(0,8).map(g=><a class="rounded-full bg-background px-3 py-2 text-sm" href={`/grupos/${g.slug}`}>{g.title}</a>)}<a href="/grupos" class="rounded-full bg-brand px-3 py-2 text-sm font-semibold text-white">Explorar grupos</a></div></section><SocialFeed mine={true}/></>}</main></Layout>
