---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { renderMarkdown } from '../../features/pages/markdown';
import type { Subprogram } from '../../features/school/programs';
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';
import { ensureCustomerAccount } from '../../features/auth/customerIdentity';
import { listDiagnosticQuestions, questionOptions, submitSubprogramDiagnostic } from '../../features/school/subprogramDiagnostics';
import { formatPrice } from '../../config';

const { id } = Astro.params;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const subprogram = await env.DB.prepare(`
  SELECT s.*, p.title AS program_title FROM school_subprograms s
  JOIN school_programs p ON p.slug = s.program_slug
  WHERE s.id = ? AND s.status = 'active' AND p.status = 'active'
`).bind(id ?? '').first<Subprogram & { program_title: string }>();
if (!subprogram) return new Response('Not found', { status: 404, headers: { 'cache-control': 'no-store' } });

const accounts = await accountsEnabled();
const email = accounts ? await getCustomerEmail(Astro.cookies) : null;
const clientNumber = email ? await ensureCustomerAccount(env.DB, email) : null;
let diagnosticError = '';
if (Astro.request.method === 'POST') {
  if (!clientNumber) return Astro.redirect(`/account/login?next=${encodeURIComponent(`/subprogramas/${subprogram.id}`)}`, 303);
  try {
    await submitSubprogramDiagnostic(env.DB, clientNumber, subprogram.id, await Astro.request.formData());
    return Astro.redirect(`/subprogramas/${encodeURIComponent(subprogram.id)}?enviado=1#diagnostico`, 303);
  } catch (error) {
    console.error('No se pudo enviar el diagnóstico de subprograma:', error);
    diagnosticError = error instanceof Error ? error.message : 'No se pudo enviar el diagnóstico.';
    Astro.response.status = 400;
  }
}
const questions = await listDiagnosticQuestions(env.DB, subprogram.id);
const diagnostic = clientNumber ? await env.DB.prepare(`
  SELECT status FROM school_subprogram_diagnostics WHERE client_number=? AND subprogram_id=?
  ORDER BY submitted_at DESC, rowid DESC LIMIT 1
`).bind(clientNumber, subprogram.id).first<{ status: string }>() : null;
const courses = (await env.DB.prepare(`
  SELECT c.title FROM school_subprogram_courses sc
  JOIN school_courses c ON c.id = sc.course_id
  WHERE sc.subprogram_id = ? AND c.status = 'published'
  ORDER BY c.title COLLATE NOCASE
`).bind(subprogram.id).all<{ title: string }>()).results;
const modalities = (await env.DB.prepare(`
  SELECT m.title,m.payment_type,m.frequency_unit,m.frequency_count,m.classes_per_payment,
         m.validity_count,m.validity_unit,p.amount_cents,p.currency
    FROM school_payment_modalities m JOIN school_payment_products p ON p.id=m.payment_product_id
   WHERE m.subprogram_id=? AND m.status='active' AND p.active=1 ORDER BY m.title COLLATE NOCASE
`).bind(subprogram.id).all<{
  title:string;payment_type:string;frequency_unit:string;frequency_count:number;
  classes_per_payment:number|null;validity_count:number|null;validity_unit:string|null;
  amount_cents:number;currency:string;
}>()).results;
const units: Record<string, string> = { week: 'semana(s)', month: 'mes(es)', year: 'año(s)' };
const validityUnits: Record<string, string> = { day: 'día(s)', ...units };
---

<Layout title={subprogram.title} description={subprogram.description}>
  <main class="mx-auto max-w-4xl py-8 sm:py-12">
    <a href={`/programas/${subprogram.program_slug}`} class="text-sm font-medium text-brand hover:underline">← {subprogram.program_title}</a>
    <header class="mt-6 overflow-hidden rounded-3xl border border-line bg-surface">
      {subprogram.image_url && <img src={subprogram.image_url} alt="" class="aspect-[16/7] w-full object-cover" />}
      <div class="p-6 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">{subprogram.program_title}{subprogram.education_level && ` · ${subprogram.education_level}`}</p>
        <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{subprogram.title}</h1>
        {subprogram.description && <p class="mt-5 whitespace-pre-line text-lg leading-8 text-muted">{subprogram.description}</p>}
        {subprogram.duration_description && <p class="mt-5 text-sm font-medium">Duración: {subprogram.duration_description}</p>}
      </div>
    </header>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {subprogram.objectives && <section class="rounded-2xl border border-line p-6"><h2 class="font-serif text-2xl">Objetivos</h2><p class="mt-3 whitespace-pre-line text-sm leading-6 text-muted">{subprogram.objectives}</p></section>}
      {subprogram.methodology && <section class="rounded-2xl border border-line p-6"><h2 class="font-serif text-2xl">Metodología</h2><p class="mt-3 whitespace-pre-line text-sm leading-6 text-muted">{subprogram.methodology}</p></section>}
    </div>
    {courses.length > 0 && <section class="mt-8"><h2 class="font-serif text-2xl">Cursos incluidos</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-muted">{courses.map((course) => <li>{course.title}</li>)}</ul></section>}
    {modalities.length > 0 && <section class="mt-8"><h2 class="font-serif text-2xl">Modalidades de pago</h2><p class="mt-2 text-sm text-muted">La escuela asignará la modalidad correspondiente al aprobar tu diagnóstico.</p><div class="mt-4 grid gap-3 sm:grid-cols-2">{modalities.map((modality) => <article class="rounded-2xl border border-line p-5"><h3 class="font-semibold">{modality.title}</h3><p class="mt-2 text-xl font-semibold">{formatPrice(modality.amount_cents, modality.currency)}</p><p class="mt-2 text-sm text-muted">{modality.frequency_unit === 'once' ? 'Pago único' : `Cada ${modality.frequency_count} ${units[modality.frequency_unit]}`}</p>{modality.classes_per_payment && <p class="mt-1 text-sm text-muted">{modality.classes_per_payment} clases por pago</p>}{modality.validity_count && modality.validity_unit && <p class="mt-1 text-sm text-muted">Vigencia: {modality.validity_count} {validityUnits[modality.validity_unit]}</p>}</article>)}</div></section>}
    {subprogram.terms_md && <section class="mt-8"><h2 class="font-serif text-2xl">Términos</h2><div class="prose mt-3 max-w-none" set:html={renderMarkdown(subprogram.terms_md)} /></section>}
    {subprogram.policies_md && <section class="mt-8"><h2 class="font-serif text-2xl">Políticas</h2><div class="prose mt-3 max-w-none" set:html={renderMarkdown(subprogram.policies_md)} /></section>}
    <section id="diagnostico" class="mt-10 rounded-3xl border border-line bg-surface p-6 sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">Tu siguiente paso</p>
      <h2 class="mt-3 font-serif text-3xl">Diagnóstico del subprograma</h2>
      {diagnosticError && <p role="alert" class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700">{diagnosticError}</p>}
      {diagnostic?.status === 'pending' ? (
        <p class="mt-4 text-sm text-muted">Tu diagnóstico fue enviado y está en revisión.</p>
      ) : diagnostic?.status === 'approved' ? (
        <p class="mt-4 text-sm text-muted">Tu diagnóstico fue aprobado. Consulta tus pagos en <a class="text-brand underline" href="/account/payments">Mi cuenta</a>.</p>
      ) : !questions.length ? (
        <p class="mt-4 text-sm text-muted">El diagnóstico todavía no está disponible.</p>
      ) : !accounts ? (
        <p class="mt-4 text-sm text-muted">El acceso a cuentas no está disponible por el momento.</p>
      ) : !email ? (
        <p class="mt-4 text-sm text-muted">Inicia sesión para responder el diagnóstico. <a class="font-semibold text-brand underline" href={`/account/login?next=${encodeURIComponent(`/subprogramas/${subprogram.id}`)}`}>Iniciar sesión</a></p>
      ) : (
        <form method="POST" class="mt-5 space-y-5">
          {questions.map((question) => (
            <label class="block text-sm font-medium">
              {question.prompt}{question.required === 1 && <span aria-hidden="true"> *</span>}
              {question.answer_type === 'choice' ? (
                <select name={`question_${question.id}`} required={question.required === 1} class="mt-2 block w-full rounded-xl border border-line bg-background p-3">
                  <option value="">Selecciona una opción</option>
                  {questionOptions(question).map((option) => <option value={option}>{option}</option>)}
                </select>
              ) : (
                <textarea name={`question_${question.id}`} required={question.required === 1} maxlength="5000" rows="4" class="mt-2 block w-full rounded-xl border border-line bg-background p-3"></textarea>
              )}
            </label>
          ))}
          <button class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-on-brand">Enviar diagnóstico</button>
        </form>
      )}
    </section>
  </main>
</Layout>
