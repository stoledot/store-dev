---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getCustomerEmail } from '../features/auth/customer';
import ProductList from '../features/products/ProductList.astro';
import SocialFeed from '../components/social/SocialFeed.astro';
import { getConfig } from '../config';
import { mediaUrl } from '../features/media/url';

const config = getConfig();
const configuredName = Astro.locals.settings?.storeName ?? config.storeName;
const schoolName = !configuredName || configuredName === 'My Shop' ? 'Escuela de Matemáticas' : configuredName;
const studentEmail = await getCustomerEmail(Astro.cookies);
const socialGroups=studentEmail?((await env.DB.prepare('SELECT g.id,g.title FROM social_groups g JOIN social_group_members m ON m.group_id=g.id WHERE m.email=? COLLATE NOCASE AND g.status=\'active\' ORDER BY g.title').bind(studentEmail).all<any>()).results??[]):[];
const subscriptionContent=studentEmail?((await env.DB.prepare(`SELECT DISTINCT c.title,c.slug,c.summary,c.content_kind,(SELECT l.slug FROM school_lessons l WHERE l.course_id=c.id AND l.status='published' ORDER BY l.sequence_no LIMIT 1) AS first_lesson FROM school_courses c JOIN content_subscription_courses sc ON sc.course_id=c.id JOIN school_subscriptions ss ON ss.content_subscription_id=sc.subscription_id WHERE c.status='published' AND lower(trim(ss.student_email))=lower(trim(?)) AND ss.status IN ('active','trialing') AND (ss.current_period_end IS NULL OR ss.current_period_end>strftime('%Y-%m-%dT%H:%M:%fZ','now')) ORDER BY c.content_kind,c.title COLLATE NOCASE`).bind(studentEmail).all<any>()).results??[]):[];
const mathMagazines=(await env.DB.prepare(`SELECT m.id,m.slug,m.title,m.description,m.cover_image_key,(SELECT i.title FROM math_magazine_issues i WHERE i.magazine_id=m.id AND i.status='published' ORDER BY i.issue_date DESC,i.updated_at DESC LIMIT 1) AS latest_title,(SELECT i.slug FROM math_magazine_issues i WHERE i.magazine_id=m.id AND i.status='published' ORDER BY i.issue_date DESC,i.updated_at DESC LIMIT 1) AS latest_slug,(SELECT CASE WHEN MAX(CASE WHEN cs.magazine_access='all' THEN 1 ELSE 0 END)=1 THEN 'all' WHEN COUNT(*)>0 THEN 'latest' ELSE '' END FROM school_subscriptions ss JOIN content_subscriptions cs ON cs.id=ss.content_subscription_id WHERE cs.magazine_id=m.id AND cs.status='active' AND lower(trim(ss.student_email))=lower(trim(?)) AND ss.status IN ('active','trialing') AND (ss.current_period_end IS NULL OR ss.current_period_end>strftime('%Y-%m-%dT%H:%M:%fZ','now'))) AS access_mode FROM math_magazines m WHERE m.status='published' ORDER BY m.title COLLATE NOCASE LIMIT 12`).bind(studentEmail??'').all<any>()).results??[];
---

<Layout title="Aprende matemáticas y lectura" description="Programas de matemáticas y lectura con una ruta clara, contenidos accesibles y acompañamiento para aprender a tu ritmo.">
  <section aria-labelledby="home-hero-title" 
    class="relative isolate my-5 overflow-hidden rounded-[2rem] border border-line bg-brand sm:my-8">
    <!--<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-brand/15 via-paper to-surface"></div>-->
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 -z-10 h-64 w-64 rounded-full border-[32px] border-brand/10 sm:h-80 sm:w-80"></div>
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-12 sm:px-10 sm:py-16 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:px-14 lg:py-20">
      <div class="max-w-3xl">
        <h1 id="home-hero-title" class="mt-3 max-w-3xl text-white font-serif text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">Escuela de Matemáticas</h1>
        <!--<p class="inline-flex items-center gap-2 rounded-full border border-line bg-paper/80 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-muted"><span class="h-2 w-2 rounded-full bg-brand"></span> Escuela de Matemáticas</p>-->
        <p class="mt-6 text-sm font-semibold tracking-wide text-white sm:text-base">{schoolName}</p>
        <h3  class="mt-3 max-w-2xl text-white font-serif text-3xl leading-[1.08] tracking-tight sm:text-4xl lg:text-5xl">Las matemáticas y la lectura, a tu ritmo y con sentido.</h3>
        <p class="mt-5 max-w-2xl leading-7 text-white sm:text-lg sm:leading-8">Aprende paso a paso, comprende las ideas de fondo y construye confianza con programas pensados para acompañarte desde donde estás.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/account/profile"
            class="inline-flex min-h-14 items-center justify-center rounded-full bg-red-600 px-8 py-4 text-lg font-bold text-white shadow-md transition-all duration-200 hover:bg-red-700 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
              Iniciar proceso de Inscripción
              <span aria-hidden="true" class="ml-2">↗</span>
          </a>
          <a href="#programas" 
            class="inline-flex min-h-12 
              items-center justify-center 
              rounded-full border border-line 
              bg-azul-cielo-eri px-6 py-3 text-sm font-semibold transition hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">Conocer los programas</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4 ">
        <a href="/programas/matematicas" 
            class="group flex min-h-44 flex-col justify-between 
            rounded-2xl border 
            border-line bg-azul-cielo-eri p-5 shadow-sm transition 
            hover:-translate-y-1 hover:border-brand sm:min-h-52 sm:p-6">
          <span 
            class="flex h-11 w-11 items-center 
              justify-center rounded-xl 
              bg-brand/10 
              text-xl text-black" aria-hidden="true">
            ∑
          </span>
          <span>
            <span class="block text-lg text-black font-semibold tracking-tight">Matemáticas</span>
            <span class="mt-1 block text-sm leading-5 text-black text-muted">Comprende conceptos y resuelve problemas.</span>
            <span class="mt-4 inline-flex text-sm font-semibold text-black text-brand">Ver programa →</span>
          </span>
        </a>
        <a href="/programas/lectura" class="group mt-7 flex min-h-44 flex-col justify-between rounded-2xl border border-line bg-azul-cielo-eri p-5 shadow-sm transition hover:-translate-y-1 hover:border-brand sm:mt-10 sm:min-h-52 sm:p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand/10 text-xl text-black" aria-hidden="true">Aa</span>
          <span><span class="block text-lg text-black font-semibold tracking-tight">Lectura</span><span class="mt-1 block text-sm leading-5 text-black text-muted">Lee con atención, interpreta y comunica.</span><span class="mt-4 inline-flex text-sm font-semibold text-black text-brand">Ver programa →</span></span>
        </a>
      </div>
    </div>
  </section>


  {subscriptionContent.length>0&&<section class="my-8 rounded-2xl border border-line bg-surface p-5 sm:p-7"><div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-widest text-brand">Tu biblioteca</p><h2 class="mt-1 font-serif text-2xl">Incluido en tus suscripciones</h2></div><a href="/account/suscripciones" class="text-sm underline">Administrar suscripciones</a></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{subscriptionContent.map(item=><article class="rounded-xl border border-line bg-white p-4"><p class="text-xs uppercase tracking-wider text-muted">{item.content_kind==='reading'?'Lectura':'Curso'}</p><h3 class="mt-1 font-semibold">{item.title}</h3>{item.summary&&<p class="mt-2 text-sm text-muted">{item.summary}</p>}<a class="mt-4 inline-flex rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-white" href={item.content_kind==='reading'?`/lecturas/${item.slug}`:`/escuela/cursos/${item.slug}/${item.first_lesson??''}`}>Abrir contenido →</a></article>)}</div></section>}

  {mathMagazines.length>0&&<section class="my-8 rounded-2xl border border-line bg-surface p-5 sm:p-7"><div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-widest text-brand">Publicaciones</p><h2 class="mt-1 font-serif text-2xl">Revistas matemáticas</h2></div>{studentEmail&&<a href="/account/revistas" class="text-sm underline">Mis revistas</a>}</div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{mathMagazines.map(m=><article class="overflow-hidden rounded-xl border border-line bg-white">{m.cover_image_key&&<img src={mediaUrl(m.cover_image_key,config.images.baseUrl)} alt={`Portada ${m.title}`} class="h-48 w-full object-cover" loading="lazy"/>}<div class="p-4"><p class="text-xs font-semibold uppercase tracking-wider text-muted">{m.access_mode?'Tu suscripción':m.latest_title?'Edición disponible':'Nueva revista'}</p><h3 class="mt-1 font-semibold">{m.title}</h3>{m.latest_title&&<p class="mt-2 text-sm text-muted">Última edición: {m.latest_title}</p>}{m.description&&<p class="mt-2 line-clamp-3 text-sm text-muted">{m.description}</p>}<a href={`/revistas/${m.slug}`} class="mt-4 inline-flex rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-white">{m.access_mode?'Abrir revista':'Ver revista y suscripciones'} →</a></div></article>)}</div></section>}

  <section class="my-8 rounded-2xl border border-line bg-surface p-5 sm:my-10 sm:flex sm:items-center sm:justify-between sm:gap-6 sm:p-7">
    <div class="max-w-2xl"><p class="text-xs font-bold uppercase tracking-[.16em] text-brand">Escuela en línea</p><h2 class="mt-2 font-serif text-2xl tracking-tight sm:text-3xl">Estudia con una ruta hecha para ti</h2><p class="mt-2 text-sm leading-6 text-muted">Inscríbete, realiza un diagnóstico y recibe un curso de acuerdo con tu nivel. Consulta tus actividades y fechas desde tu espacio académico.</p></div>
    <div class="mt-4 flex shrink-0 flex-col gap-2 sm:mt-0 sm:min-w-44"><a href="/escuela" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-on-brand">Conocer la escuela →</a><a href="/escuela/mi-escuela" class="text-center text-sm font-medium text-brand underline underline-offset-4">Ya soy alumno</a></div>
  </section>

  <section id="programas" class="my-12 sm:my-16">
    <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-muted">Explora y aprende</p><h2 class="mt-2 font-serif text-3xl tracking-tight sm:text-4xl">Encuentra tu siguiente paso</h2></div>
      <a href="/preguntas-frecuentes" class="text-sm font-semibold text-brand hover:underline">¿Tienes dudas? Consulta las preguntas frecuentes →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/programas/matematicas" 
        class="rounded-2xl border border-line 
        bg-azul-cielo-eri p-6 transition 
        hover:border-brand">
        <h3 class="text-xl text-black font-semibold">
          Programa de matemáticas</h3><p class="mt-2 text-sm leading-6 text-muted">Una ruta para desarrollar comprensión, razonamiento y seguridad al resolver problemas.</p></a>
      <a href="/programas/lectura" 
        class="rounded-2xl border 
          border-line bg-azul-cielo-eri p-6 
          transition hover:border-brand">
          <h3 class="text-xl text-black font-semibold">Programa de lectura</h3><p class="mt-2 text-sm leading-6 text-muted">Estrategias para comprender textos, identificar ideas y expresarte con claridad.</p></a>
    </div>
  </section>

  <section class="my-10 rounded-2xl border border-line bg-brand p-6 text-white sm:flex sm:items-center sm:justify-between"><div><h2 class="font-serif text-2xl">Ir a la tienda</h2><p class="mt-2 text-sm text-white/80">Explora cursos, lecturas y materiales disponibles.</p></div><a href="/shop" class="mt-4 rounded-full bg-white px-5 py-3 text-sm font-semibold text-brand sm:mt-0">Visitar tienda →</a></section>
  <section class="mb-6 rounded-2xl border border-line bg-surface p-5 sm:flex sm:items-center sm:justify-between sm:gap-5 sm:p-6"><div><p class="text-xs font-bold uppercase tracking-widest text-brand">Comunidad</p><h2 class="mt-1 font-serif text-2xl">Encuentra tus grupos</h2><p class="mt-2 text-sm text-muted">Únete a grupos para compartir ideas y conversar sobre matemáticas y lectura.</p></div><a href="/grupos" class="mt-4 inline-flex rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white sm:mt-0">Explorar grupos →</a></section>
  {studentEmail ? <div class="my-10" data-social-page>{socialGroups.length>0&&<form data-post-form data-group={socialGroups[0].id} class="mb-6 rounded-2xl border border-line bg-surface p-4"><label class="grid gap-2 font-semibold">Publicar en uno de tus grupos<select name="groupSelect" class="rounded-lg border border-line bg-background p-2">{socialGroups.map(g=><option value={g.id}>{g.title}</option>)}</select><textarea name="body" required maxlength="5000" rows="3" placeholder="Comparte una idea con tu grupo…" class="rounded-xl border border-line bg-background p-3 font-normal"></textarea></label><div class="mt-3 flex justify-end"><button class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white">Publicar</button></div><p data-status class="mt-2 text-sm text-red-700"></p></form>}<SocialFeed/><button data-notification-optin class="mt-5 rounded-lg border border-line px-4 py-2 text-sm">Activar avisos del navegador</button></div> : <section class="my-10 rounded-2xl border border-line bg-surface p-6 text-center"><h2 class="font-serif text-2xl">Comparte con la comunidad</h2><p class="mt-2 text-sm text-muted">Inicia sesión para unirte a grupos y participar en las conversaciones.</p><a href="/account/login?next=%2F" class="mt-4 inline-flex rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white">Iniciar sesión</a></section>}
</Layout>
