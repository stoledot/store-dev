---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '#theme/ProductDetail.astro';
import { loadProductDetail } from '../../features/storefront/productDetail';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';

const loaded = await loadProductDetail(env.DB, {
  slug: Astro.params.slug,
  searchParams: Astro.url.searchParams,
  settings: Astro.locals.settings,
  imageBaseUrl: getConfig().images.baseUrl,
  delivery: Astro.locals.settings?.imageDelivery,
  currency: getConfig().currency,
  origin: publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN),
  pathname: Astro.url.pathname,
});

// Status, metadata, JSON-LD, and cache tagging stay with the route: none of
// them is a presentation decision, and all of them are easy to break silently.
if (loaded.status === 'not_found') {
  return new Response('Not found', { status: 404 });
}

const { model, purchase, seo } = loaded;
addCacheTags(Astro.response.headers, productCacheTags(loaded.cacheTagIds));
if (loaded.backfillRelated) {
  // After the response is sent, so the shopper never waits on it.
  Astro.locals.cfContext?.waitUntil(loaded.backfillRelated());
}
---

<Layout title={seo.title} description={seo.description ?? undefined} image={seo.imagePath}>
  <ProductDetail model={model} purchase={purchase} />

  {model.subscriptionPlans.length>0&&<section class="mx-auto my-8 max-w-6xl px-4 sm:px-6"><div class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><p class="text-xs font-semibold uppercase tracking-widest text-brand">Acceso recurrente</p><h2 class="mt-2 font-serif text-2xl">Elige una suscripción</h2><div class="mt-4 grid gap-3 sm:grid-cols-2">{model.subscriptionPlans.map(plan=><article class="rounded-xl border border-line bg-white p-4"><h3 class="font-semibold">{plan.title}</h3>{plan.description&&<p class="mt-2 text-sm text-muted">{plan.description}</p>}<p class="mt-3 text-lg font-semibold">{plan.formattedPrice} <span class="text-sm font-normal text-muted">{plan.intervalLabel}</span></p><p class="mt-1 text-xs text-muted">Primer cargo al confirmar el pago; siguientes cargos en cada renovación según las fechas que mostrará Stripe.</p><p class="mt-1 text-xs text-muted">Cargo automático recurrente {plan.intervalLabel}, hasta cancelar. Consulta <a class="underline" href={`/suscripciones/${encodeURIComponent(plan.slug)}/politicas`} target="_blank" rel="noopener noreferrer">política de reembolso, aviso de privacidad y condiciones</a>.</p><form class="mt-4" method="POST" action="/api/subscriptions/checkout"><input type="hidden" name="product_id" value={model.id}/><input type="hidden" name="subscription_slug" value={plan.slug}/><label class="flex items-start gap-2 text-sm"><input class="mt-1" type="checkbox" name="accept_subscription_terms" value="yes" required/><span>Acepto las condiciones de suscripción y reembolso, declaro haber podido consultar el aviso de privacidad y <strong>autorizo expresamente los cargos recurrentes</strong> de {plan.formattedPrice} {plan.intervalLabel}. La renovación continúa hasta que cancele.</span></label><button class="mt-3 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white">Continuar a pago seguro de Stripe →</button></form></article>)}</div><p class="mt-3 text-xs text-muted">Puedes cancelar en Mi cuenta → Suscripciones; la solicitud se procesa de inmediato y detiene renovaciones futuras.</p></div></section>}
  {model.contentSections.length>0&&<section class="mx-auto my-10 max-w-6xl space-y-4 px-4 sm:px-6">{model.contentSections.map(section=><article class="rounded-2xl border border-line bg-surface p-5 sm:p-7"><h2 class="font-serif text-2xl">{section.title}</h2><div class="markdown-content mt-4 max-w-none text-muted" set:html={section.html}></div></article>)}</section>}
  {model.videoSections.length>0&&<section class="mx-auto my-10 max-w-6xl space-y-4 px-4 sm:px-6"><h2 class="font-serif text-2xl">Videos</h2>{model.videoSections.map(video=><article class="rounded-2xl border border-line bg-surface p-4 sm:p-6"><h3 class="mb-3 font-semibold">{video.title}</h3>{video.type==='youtube'?<div class="aspect-video overflow-hidden rounded-xl"><iframe class="h-full w-full" src={`https://www.youtube-nocookie.com/embed/${video.videoId}`} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>:<video class="aspect-video w-full rounded-xl bg-black" controls preload="none" src={video.src}><track kind="captions"/><p>Inicia sesión con una cuenta que tenga acceso al curso para reproducir este video.</p></video>}</article>)}</section>}

  <script is:inline type="application/ld+json" set:html={seo.jsonLd} />

  {/* Live price + hero image: reflect the chosen variant + checked add-ons. No-JS
      still works — the server computes the real price in cart/checkout, and the
      gallery's primary image shows by default. */}
  <script>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const form = document.querySelector('[data-options-form]');
    const out = document.querySelector('[data-price-display]');
    const track = document.querySelector('[data-hero-track]');
    if (form instanceof HTMLFormElement && out instanceof HTMLElement) {
      const currency = (out.dataset.currency || 'usd').toUpperCase();
      const base = Number(out.dataset.base || '0');
      const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency });
      const divisor = 10 ** (fmt.resolvedOptions().maximumFractionDigits ?? 2);

      // Scroll the gallery carousel to the variant's linked image (if any). The
      // track is position:relative, so each image's offsetLeft is measured from the
      // track's content box — exactly the scrollLeft needed to bring it flush left.
      // data-image-id carries the gallery anchor (pimg_ public ID), never a row id.
      const showImage = (imageId) => {
        if (!(track instanceof HTMLElement) || !imageId) return;
        const img = document.getElementById(`pi-${imageId}`);
        if (img instanceof HTMLElement && track.contains(img)) {
          track.scrollLeft = img.offsetLeft;
        }
      };

      const update = (scroll) => {
        const v = form.querySelector('input[name="variant_id"]:checked');
        let cents = v ? Number(v.getAttribute('data-price')) : base;
        for (const e of form.querySelectorAll('input[name="extra"]:checked')) {
          cents += Number(e.getAttribute('data-price')) || 0;
        }
        out.textContent = fmt.format(cents / divisor);
        if (scroll && v) showImage(v.getAttribute('data-image-id') || '');
      };
      // Sync price + carousel to the default-selected variant on load, and on every
      // change. Setting track.scrollLeft only moves the carousel, never the page.
      form.addEventListener('change', () => update(true));
      update(true);
    }
  </script>

  <script>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const btn = document.querySelector('[data-share]');
    if (btn instanceof HTMLElement) {
      const canShare = typeof navigator.share === 'function';
      const canCopy = !!navigator.clipboard?.writeText;
      if (canShare || canCopy) {
        btn.classList.remove('hidden');
        btn.classList.add('inline-flex');
        const label = btn.querySelector('[data-share-label]');
        btn.addEventListener('click', async () => {
          const url = location.href;
          const title = btn.dataset.shareTitle || document.title;
          if (canShare) {
            // Rejects when the user dismisses the share sheet — that's expected.
            try {
              await navigator.share({ title, url });
            } catch {
              /* user cancelled */
            }
            return;
          }
          await navigator.clipboard.writeText(url);
          if (label) {
            const prev = label.textContent;
            label.textContent = 'Link copied';
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      }
    }
  </script>
</Layout>
