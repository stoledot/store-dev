---
import Layout from '../layouts/Layout.astro';
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
---
<Layout title="Buscar" description="Busca productos, lecturas y recursos disponibles en la escuela.">
  <section class="mx-auto max-w-3xl py-10 sm:py-16"><p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">Explora los recursos</p><h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">¿Qué te gustaría aprender?</h1><p class="mt-4 leading-7 text-muted">Busca materiales y productos disponibles en la escuela.</p><form action="/search" method="get" role="search" class="mt-8 flex flex-col gap-3 sm:flex-row"><label for="q" class="sr-only">Término de búsqueda</label><input id="q" name="q" value={q} type="search" placeholder="Ej. álgebra, comprensión lectora…" class="min-h-12 min-w-0 flex-1 rounded-xl border border-line bg-paper px-4 py-3 text-base focus:border-brand focus:outline-none"/><button class="min-h-12 rounded-xl bg-brand px-6 py-3 text-sm font-semibold text-on-brand transition hover:opacity-90" type="submit">Buscar</button></form><div class="mt-8 flex flex-wrap gap-3"><a href="/programas/matematicas" class="rounded-full border border-line px-4 py-2 text-sm hover:border-brand">Programa de matemáticas</a><a href="/programas/lectura" class="rounded-full border border-line px-4 py-2 text-sm hover:border-brand">Programa de lectura</a></div></section>
</Layout>
