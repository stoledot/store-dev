---
//src/pages/lecturas/[id].astro
import { env } from 'cloudflare:workers';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail} from '../../features/auth/customer';
import { renderCourseTex } from '../../features/mathTexts/render';
import { parseReadingXml } from '../../features/mathTexts/xmlReading';
import { parseXml } from '../../features/lecturas/lectura_xml_to_html';
import { getCustomerByEmail } from '../../features/customers_new/db';
import { getLecturasByCustomerId, getLecturasCustomerByCustomerId, getLecturaById } from '../../features/lecturas/db';
import { parsearXML, extractOnly } from '../../features/xml/xmlParser';
import RenderLecturaXml from '../../components/xml/RenderLecturaXml.astro';
import RenderIndiceTemario from '../../components/xml/RenderIndiceTemario.astro';
import { extractMetaXml } from '../../features/lecturas/utils';
import FlipbookReader from '../../components/xml/FlipbookReader.astro';
import PlanesLecturas from './PlanesLecturas.astro';

if (!(await accountsEnabled())) return Astro.redirect('/',303);

const email=await getCustomerEmail(Astro.cookies); 
if(!email) return Astro.redirect('/account/login',303);
const customerId = (await getCustomerByEmail(env.DB, email))?.id;
if (!customerId) return Astro.redirect('/account/login',303);

const id = Astro.params.id;


const tieneAcceso = new Set(
  ((await getLecturasCustomerByCustomerId(env.DB, customerId)) ?? []).map(
    lectura => lectura.school_lectura_id,
  ),
).has(Number(id));
if (!tieneAcceso) return Astro.redirect('/account/lecturas', 303);

const lectura = await getLecturaById(env.DB, Number(id));

const readingXml = lectura?.content_xml ?? "";

const nodo = parsearXML(readingXml);

const metaXml = extractMetaXml(nodo);

interface Props {
  xml: string;
  backHref?: string;
}

const { xml = readingXml, backHref = '/account/readings' } = Astro.props;

const { doc, error } = parseXml(xml);
if (!doc) return Astro.redirect('/account/lecturas', 303);
if (error) return Astro.redirect('/account/lecturas', 303);




/**
 * Lógica para los planes
 */


---
<Layout title={metaXml.title ?? "Lectura"}>
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
    <a
      href="/account/lecturas"
      class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-muted transition hover:text-brand"
    >
      <span aria-hidden="true">←</span>
      Mis lecturas
    </a>

    <section class="overflow-hidden rounded-[2rem] border border-line bg-paper shadow-xl">
      <div class="grid lg:grid-cols-5">
        <!-- Portada -->
        {lectura?.image_url && (
          <div class="flex items-center justify-center bg-surface p-6 sm:p-10 lg:col-span-2">
            <div class="relative w-full max-w-sm overflow-hidden rounded-2xl shadow-2xl">
              <img
                src={lectura.image_url}
                alt={metaXml.title ?? "Portada de lectura"}
                class="aspect-square w-full object-cover"
              />
            </div>
          </div>
        )}

        <!-- Información -->
        <div class={lectura?.image_url
          ? "flex flex-col justify-center p-6 sm:p-10 lg:col-span-3"
          : "flex flex-col justify-center p-6 sm:p-10 lg:col-span-5"}>

          <div class="mb-5 inline-flex w-fit items-center gap-2 rounded-full border border-brand/20 bg-brand/10 px-4 py-2 text-xs font-bold uppercase tracking-wider text-brand">
            <span>📚</span>
            {lectura?.type === "book" ? "Libro" : "Lectura"}
          </div>

          <h1 class="font-serif text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
            {metaXml.title ?? "Lectura"}
          </h1>

          {metaXml.author && (
            <p class="mt-4 text-lg text-muted">
              <span class="font-medium">Por:</span> {metaXml.author}
            </p>
          )}

          {metaXml.date && (
            <p class="mt-2 text-sm text-muted">
              {metaXml.date}
            </p>
          )}

          {metaXml.summary && (
            <div class="mt-8">
              <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-muted">
                Acerca de esta lectura
              </h2>
              <p class="max-w-2xl text-base leading-8 text-muted sm:text-lg">
                {metaXml.summary}
              </p>
            </div>
          )}

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={`/lecturas/${id}/leer`}
              class="inline-flex min-h-14 items-center justify-center gap-3 rounded-2xl bg-brand px-8 py-4 font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl"
            >
              <span>📖</span>
              <span>Continuar leyendo</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="/account/lecturas"
              class="inline-flex min-h-14 items-center justify-center rounded-2xl border border-line bg-surface px-6 py-4 font-semibold transition hover:bg-paper"
            >
              Volver a la biblioteca
            </a>
          </div>

          <p class="mt-5 text-sm text-muted">
            Tu progreso de lectura se guardará automáticamente.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold">Planes de lectura</h2>
      <PlanesLecturas customerId={customerId} lecturaId={Number(id)} nodo={nodo} />
    </section>
  </main>
</Layout>
