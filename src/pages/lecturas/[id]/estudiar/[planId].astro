import { env } from 'cloudflare:workers';
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import VisorBlocNotas from '../../../../components/VisorBlocNotas.astro';
import { accountsEnabled, getCustomerEmail } from '../../../../features/auth/customer';
import { getCustomerByEmail } from '../../../../features/customers_new/db';
import { getLecturasCustomerByCustomerId, getLecturaById } from '../../../../features/lecturas/db';
import { obtenerPlan, filtraArbol } from '../../../../features/lecturas/planesEstudio';
import { parsearXML } from '../../../../features/xml/xmlParser';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);
const customerId = (await getCustomerByEmail(env.DB, email))?.id;
const readingId = Number(Astro.params.id), planId = Number(Astro.params.planId);
if (!customerId || !Number.isInteger(readingId) || !Number.isInteger(planId)) return Astro.redirect('/account/lecturas', 303);
const access = await getLecturasCustomerByCustomerId(env.DB, customerId);
if (!access?.some(row => row.school_lectura_id === readingId)) return Astro.redirect('/account/lecturas', 303);
const plan = await obtenerPlan(env.DB, planId, customerId);
if (!plan || plan.school_lectura_id !== readingId) return Astro.redirect(`/lecturas/${readingId}`, 303);
const lectura = await getLecturaById(env.DB, readingId);
if (!lectura) return Astro.redirect('/account/lecturas', 303);
const allowed = new Set(plan.temas.map(t => t.id_html_tema_lectura));
const nodo = filtraArbol(parsearXML(lectura.content_xml), allowed);
const done = plan.temas.filter(t => t.is_completed).length;
---
<Layout title={`Estudiar: ${plan.name}`}>
  <div class="mx-auto max-w-6xl px-4 py-4">
    <a href={`/lecturas/${readingId}`} class="text-sm underline">← Volver a la lectura</a>
    <div class="mt-3 rounded-xl border bg-white p-4 text-stone-900">
      <h1 class="text-xl font-bold">{plan.name}</h1>
      <p id="plan-progress" data-done={done} data-total={plan.temas.length} class="text-sm">Avance: <strong>{done} de {plan.temas.length} temas completados ({plan.temas.length ? Math.round(done * 100 / plan.temas.length) : 0}%)</strong></p>
    </div>
  </div>
  <VisorBlocNotas nodo={nodo} tituloLibro={lectura.title} planId={plan.id} completedTopicIds={plan.temas.filter(t => t.is_completed).map(t => t.id_html_tema_lectura)} />
  <script>
    document.addEventListener('plan-topic-completed', () => {
      const progress = document.querySelector<HTMLElement>('#plan-progress');
      if (!progress) return;
      const total = Number(progress.dataset.total || 0);
      const done = Math.min(total, Number(progress.dataset.done || 0) + 1);
      progress.dataset.done = String(done);
      const label = progress.querySelector('strong');
      if (label) label.textContent = `${done} de ${total} temas completados (${total ? Math.round(done * 100 / total) : 0}%)`;
    });
  </script>
</Layout>
