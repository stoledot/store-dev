---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import SubprogramList from '../../features/school/SubprogramList.astro';
import { getCustomerEmail } from '../../features/auth/customer';

const studentEmail = await getCustomerEmail(Astro.cookies);
if (studentEmail) {
  await env.DB.prepare(
    `INSERT INTO school_program_views (student_email, program_slug) VALUES (?, ?) ON CONFLICT(student_email, program_slug) DO UPDATE SET last_viewed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')`
  )
    .bind(studentEmail, 'matematicas')
    .run();
}

const schoolProgram =
  (await env.DB.prepare(
    `SELECT p.slug, p.title, p.description, p.image_url FROM school_programs p WHERE p.slug = 'matematicas'`
  ).first<any>()) ?? null;

const pageTitle = schoolProgram?.title || 'Programa de matemáticas';
const pageDescription =
  schoolProgram?.description ||
  'Programa de matemáticas para desarrollar comprensión, razonamiento y confianza al resolver problemas.';
const imageUrl = schoolProgram?.image_url;
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Cabecera Hero adaptada a imagen cuadrada -->
    <header class="grid items-center gap-8 md:grid-cols-12 md:gap-10">
      <div class={imageUrl ? 'md:col-span-7 lg:col-span-8' : 'md:col-span-12'}>
        <span class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium tracking-wide text-muted uppercase">
          Programa académico
        </span>
        <h1 class="mt-4 font-serif text-4xl tracking-tight sm:text-5xl">
          {pageTitle}
        </h1>
        <p class="mt-5 text-lg leading-8 text-muted">
          Aprende a comprender las ideas matemáticas, no solo a memorizar procedimientos. Avanza desde tus conocimientos actuales con explicaciones claras, práctica y actividades que fortalecen tu razonamiento.
        </p>
      </div>

      {imageUrl && (
        <div class="mx-auto w-full max-w-[280px] sm:max-w-[320px] md:col-span-5 md:max-w-none lg:col-span-4">
          <div class="group relative aspect-square w-full overflow-hidden rounded-3xl border border-line bg-surface shadow-sm">
            <img
              src={imageUrl}
              alt={pageTitle}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>
        </div>
      )}
    </header>

    <!-- Tarjetas de información -->
    <div class="mt-10 grid gap-5 sm:mt-12 sm:grid-cols-2">
      <section class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-brand/40">
        <h2 class="text-lg font-semibold">¿Qué puedes desarrollar?</h2>
        <ul class="mt-3 list-disc space-y-2.5 pl-5 text-sm leading-6 text-muted">
          <li>Comprensión de conceptos y lenguaje matemático.</li>
          <li>Estrategias para resolver problemas paso a paso.</li>
          <li>Confianza para explicar cómo llegaste a una respuesta.</li>
          <li>Hábitos de estudio y práctica autónoma.</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-brand/40">
        <h2 class="text-lg font-semibold">¿Cómo se aprende?</h2>
        <ul class="mt-3 list-disc space-y-2.5 pl-5 text-sm leading-6 text-muted">
          <li>Lecturas y ejemplos explicados.</li>
          <li>Ejercicios con dificultad progresiva.</li>
          <li>Actividades secuenciales con seguimiento.</li>
          <li>Retroalimentación cuando el programa la incluye.</li>
        </ul>
      </section>
    </div>

    <!-- Lista de subprogramas -->
    <div class="mt-10">
      <SubprogramList program="matematicas" />
    </div>

    <!--
    <section class="mt-8 rounded-2xl border border-line p-6 sm:p-8">
      <h2 class="font-serif text-2xl">Empieza desde donde estás</h2>
      <p class="mt-2 text-sm leading-6 text-muted">Revisa el programa y, cuando estés listo, inicia tu proceso de inscripción para elegir una ruta adecuada.</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href="/account/profile" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-on-brand">Iniciar proceso de Inscripción</a>
        <a href="/escuela/diagnostico" class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold hover:border-brand">Explorar diagnóstico</a>
      </div>
    </section>
    -->
  </article>
</Layout>
