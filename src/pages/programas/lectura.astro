---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import SubprogramList from '../../features/school/SubprogramList.astro';
import { getCustomerEmail } from '../../features/auth/customer';

const studentEmail = await getCustomerEmail(Astro.cookies);
if (studentEmail) {
  await env.DB.prepare(
    `INSERT INTO school_program_views (student_email, program_slug) VALUES (?, ?) ON CONFLICT(student_email, program_slug) DO UPDATE SET last_viewed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')`
  )
    .bind(studentEmail, 'lectura')
    .run();
}

const schoolProgram =
  (await env.DB.prepare(
    `SELECT p.slug, p.title, p.description, p.image_url FROM school_programs p WHERE p.slug = 'lectura'`
  ).first<any>()) ?? null;

const pageTitle = schoolProgram?.title || 'Programa de lectura';
const pageDescription =
  schoolProgram?.description ||
  'Programa de lectura para mejorar comprensión, interpretación y expresión escrita.';
const imageUrl = schoolProgram?.image_url;
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Cabecera Hero adaptada a imagen cuadrada -->
    <header class="grid items-center gap-8 md:grid-cols-12 md:gap-10">
      <div class={imageUrl ? 'md:col-span-7 lg:col-span-8' : 'md:col-span-12'}>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">
          Nuestros programas
        </p>
        <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
          {pageTitle}
        </h1>
        <p class="mt-5 text-lg leading-8 text-muted">
          Leer bien es mucho más que pronunciar palabras: es construir significado, reconocer ideas, hacer preguntas y relacionar lo que dice un texto con lo que ya sabes.
        </p>
      </div>

      {imageUrl && (
        <div class="mx-auto w-full max-w-[280px] sm:max-w-[320px] md:col-span-5 md:max-w-none lg:col-span-4">
          <div class="group relative aspect-square w-full overflow-hidden rounded-3xl border border-line bg-surface shadow-sm">
            <img
              src={imageUrl}
              alt={pageTitle}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>
        </div>
      )}
    </header>

    <!-- Tarjetas de información -->
    <div class="mt-10 grid gap-5 sm:mt-12 sm:grid-cols-2">
      <section class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-brand/40">
        <h2 class="text-lg font-semibold">Habilidades que practicarás</h2>
        <ul class="mt-3 list-disc space-y-2.5 pl-5 text-sm leading-6 text-muted">
          <li>Identificar la idea principal y los detalles relevantes.</li>
          <li>Distinguir hechos, opiniones e inferencias.</li>
          <li>Interpretar vocabulario y expresiones en contexto.</li>
          <li>Resumir, argumentar y explicar lo leído.</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-brand/40">
        <h2 class="text-lg font-semibold">Una ruta progresiva</h2>
        <ul class="mt-3 list-disc space-y-2.5 pl-5 text-sm leading-6 text-muted">
          <li>Lecturas breves con propósito claro.</li>
          <li>Preguntas para comprobar comprensión.</li>
          <li>Actividades de respuesta y reflexión.</li>
          <li>Seguimiento del avance y retroalimentación.</li>
        </ul>
      </section>
    </div>

    <!-- Lista de subprogramas -->
    <div class="mt-10">
      <SubprogramList program="lectura" />
    </div>

    <!--
    <section class="mt-8 rounded-2xl border border-line p-6 sm:p-8">
      <h2 class="font-serif text-2xl">Desarrolla una lectura más consciente</h2>
      <p class="mt-2 text-sm leading-6 text-muted">Conoce los materiales disponibles o inicia tu proceso de inscripción y define tus objetivos de lectura.</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href="/account/profile" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-on-brand">Iniciar proceso de Inscripción</a>
        <a href="/buscar" class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold hover:border-brand">Buscar lecturas</a>
      </div>
    </section>
    -->
  </article>
</Layout>
