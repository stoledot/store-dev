---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donar" description="Apoya la continuidad de este proyecto.">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="font-serif text-3xl sm:text-4xl">Donar</h1>
    <p class="mt-4 leading-7 text-muted">Tu apoyo ayuda a que este proyecto continúe. Gracias por querer formar parte.</p>
    <div class="mt-6 rounded-2xl border border-line bg-surface p-5">
      <h2 class="font-semibold">Donaciones próximamente</h2>
      <p class="mt-2 text-sm leading-6 text-muted">Estamos preparando esta opción. Por ahora no es posible realizar donaciones.</p>
    </div>
  </div>
</Layout>
