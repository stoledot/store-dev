---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { ensureCustomerAccount } from '../../features/auth/customerIdentity';
import { isForbiddenFormOrigin } from '../../features/auth/formOrigin';
import { cleanText } from '../../features/customers/profiles';

if(!(await accountsEnabled()))return Astro.redirect('/',303);
const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login?next=%2Fescuela%2Finscripcion',303);
const clientNumber=await ensureCustomerAccount(env.DB,email);
let application=await env.DB.prepare(`SELECT a.*,c.title AS career_title FROM school_enrollment_applications a LEFT JOIN school_careers c ON c.id=a.requested_career_id WHERE a.client_number=?`).bind(clientNumber).first<any>();
let error='';
if(Astro.request.method==='POST'){
  if(isForbiddenFormOrigin(Astro.request,Astro.url))return new Response('Origen no permitido',{status:403});
  const form=await Astro.request.formData();
  try{
    if(application?.status==='approved')throw new Error('Tu inscripción ya fue aprobada. Consulta tu número de alumno en el perfil.');
    if(application&&application.status!=='correction_requested')throw new Error('Tu solicitud está en revisión y no se puede editar por ahora.');
    const applicantName=cleanText(form.get('applicant_name'),160),dateOfBirth=String(form.get('date_of_birth')??'').trim(),phone=cleanText(form.get('phone'),30),address=cleanText(form.get('address'),300),careerId=cleanText(form.get('career_id'),100)||null;
    if(!applicantName||!/^\d{4}-\d{2}-\d{2}$/.test(dateOfBirth)||!phone||!address)throw new Error('Completa nombre, fecha de nacimiento, teléfono y domicilio.');
    const birth=new Date(`${dateOfBirth}T00:00:00Z`),today=new Date();if(Number.isNaN(birth.getTime())||birth.toISOString().slice(0,10)!==dateOfBirth||birth>today)throw new Error('La fecha de nacimiento no es válida.');
    let age=today.getUTCFullYear()-birth.getUTCFullYear();const month=today.getUTCMonth()-birth.getUTCMonth();if(month<0||(month===0&&today.getUTCDate()<birth.getUTCDate()))age--;
    const minor=age<18,guardianName=cleanText(form.get('guardian_name'),160),guardianRelationship=cleanText(form.get('guardian_relationship'),80),guardianPhone=cleanText(form.get('guardian_phone'),30),guardianEmail=cleanText(form.get('guardian_email'),254).toLowerCase();
    if(minor&&(!guardianName||!guardianRelationship||!guardianPhone))throw new Error('Como eres menor de edad, completa nombre, parentesco y teléfono de tu madre, padre o tutor.');
    const career=careerId?await env.DB.prepare("SELECT id FROM school_careers WHERE id=? AND status='active'").bind(careerId).first():null;if(careerId&&!career)throw new Error('Selecciona una carrera vigente.');
    const accepted=new Map([['application/pdf','pdf'],['image/jpeg','jpg'],['image/png','png']]);
    const saveDocument=async(field:string,kind:string,oldKey:string|null,required:boolean)=>{const entry=form.get(field);if(!(entry instanceof File)||entry.size===0){if(required&&!oldKey)throw new Error('Adjunta la identificación oficial solicitada.');return oldKey;}if(entry.size>10*1024*1024||!accepted.has(entry.type))throw new Error('La identificación debe ser PDF, JPG o PNG y pesar máximo 10 MB.');if(!env.FILES)throw new Error('El almacenamiento privado FILES no está configurado.');const key=`school-private-identification/${clientNumber}/${kind}/${crypto.randomUUID()}.${accepted.get(entry.type)}`;await env.FILES.put(key,await entry.arrayBuffer(),{httpMetadata:{contentType:entry.type},customMetadata:{clientNumber,documentKind:kind}});newKeys.push(key);return key;};
    const newKeys:string[]=[];const applicantDoc=await saveDocument('applicant_document','applicant',application?.applicant_id_document_key??null,!minor);const guardianDoc=await saveDocument('guardian_document','guardian',application?.guardian_id_document_key??null,false);
    const now=new Date().toISOString();
    try{await env.DB.prepare(`INSERT INTO school_enrollment_applications(client_number,applicant_name,date_of_birth,phone,address,requested_career_id,applicant_id_document_key,guardian_name,guardian_relationship,guardian_phone,guardian_email,guardian_id_document_key,status,correction_request,admin_notes,submitted_at,reviewed_at,updated_at)
      VALUES(?,?,?,?,?,?,?,?,?,?,?,?,'pending','','',?,NULL,?)
      ON CONFLICT(client_number) DO UPDATE SET applicant_name=excluded.applicant_name,date_of_birth=excluded.date_of_birth,phone=excluded.phone,address=excluded.address,requested_career_id=excluded.requested_career_id,applicant_id_document_key=excluded.applicant_id_document_key,guardian_name=excluded.guardian_name,guardian_relationship=excluded.guardian_relationship,guardian_phone=excluded.guardian_phone,guardian_email=excluded.guardian_email,guardian_id_document_key=excluded.guardian_id_document_key,status='pending',correction_request='',submitted_at=excluded.submitted_at,reviewed_at=NULL,updated_at=excluded.updated_at WHERE school_enrollment_applications.status='correction_requested'`)
      .bind(clientNumber,applicantName,dateOfBirth,phone,address,careerId,applicantDoc,minor?guardianName:'',minor?guardianRelationship:'',minor?guardianPhone:'',minor?guardianEmail:'',guardianDoc,now,now).run();}
    catch(e){if(env.FILES)for(const key of newKeys)await env.FILES.delete(key).catch(()=>undefined);throw e;}
    const replaced=[application?.applicant_id_document_key,application?.guardian_id_document_key].filter((key):key is string=>Boolean(key)&&!newKeys.includes(key));if(env.FILES)for(const key of replaced)await env.FILES.delete(key).catch(()=>undefined);
    return Astro.redirect('/escuela/inscripcion?sent=1',303);
  }catch(e){error=e instanceof Error?e.message:'No se pudo guardar la solicitud.';}
  application=await env.DB.prepare('SELECT a.*,c.title AS career_title FROM school_enrollment_applications a LEFT JOIN school_careers c ON c.id=a.requested_career_id WHERE a.client_number=?').bind(clientNumber).first<any>();
}
const careers=(await env.DB.prepare("SELECT id,title FROM school_careers WHERE status='active' ORDER BY title COLLATE NOCASE").all<{id:string;title:string}>()).results??[];
const existingStudent=await env.DB.prepare('SELECT student_number,status FROM school_students WHERE client_number=?').bind(clientNumber).first<{student_number:string;status:string}>();
const canEdit=!application||application.status==='correction_requested';
---
<Layout title="Inscripción escolar">
<main class="mx-auto max-w-3xl px-4 py-8 sm:px-6"><a href="/account/profile" class="text-sm underline">← Mi perfil</a><header class="my-5"><p class="text-xs font-semibold uppercase tracking-widest text-muted">Inscripción universitaria</p><h1 class="mt-2 text-3xl font-semibold">Solicitud de ingreso</h1><p class="mt-2 text-sm text-muted">Número de cliente: <strong>{clientNumber}</strong></p></header>
{Astro.url.searchParams.has('sent')&&<p class="mb-4 rounded-xl bg-green-50 p-4 text-sm text-green-800">Solicitud enviada. La administración revisará tus datos.</p>}{error&&<p class="mb-4 rounded-xl bg-red-50 p-4 text-sm text-red-800">{error}</p>}
{existingStudent&&<section class="mb-5 rounded-xl border border-green-200 bg-green-50 p-4"><strong>Inscripción aprobada</strong><p class="mt-1 text-sm">Tu número de alumno es {existingStudent.student_number}.</p><a href="/escuela/alumno" class="mt-3 inline-flex font-semibold underline">Ir a mis aulas</a></section>}
{application&&!existingStudent&&<section class="mb-5 rounded-xl border border-line bg-surface p-4"><p>Estado: <strong>{application.status==='correction_requested'?'Necesitamos una corrección':application.status==='rejected'?'No aprobada':'En revisión'}</strong></p>{application.correction_request&&<p class="mt-2 whitespace-pre-wrap text-sm">{application.correction_request}</p>}{application.admin_notes&&<p class="mt-2 whitespace-pre-wrap text-sm text-muted">{application.admin_notes}</p>}</section>}
{canEdit&&<form method="POST" enctype="multipart/form-data" class="grid gap-4 rounded-2xl border border-line bg-surface p-5 sm:grid-cols-2"><label class="grid gap-1 text-sm font-medium sm:col-span-2">Nombre completo<input name="applicant_name" required maxlength="160" value={application?.applicant_name??''} autocomplete="name" class="rounded-lg border border-line bg-background px-3 py-2.5 font-normal"/></label><label class="grid gap-1 text-sm font-medium">Fecha de nacimiento<input name="date_of_birth" type="date" required value={application?.date_of_birth??''} class="rounded-lg border border-line bg-background px-3 py-2.5 font-normal"/></label><label class="grid gap-1 text-sm font-medium">Teléfono<input name="phone" required maxlength="30" value={application?.phone??''} autocomplete="tel" class="rounded-lg border border-line bg-background px-3 py-2.5 font-normal"/></label><label class="grid gap-1 text-sm font-medium sm:col-span-2">Domicilio<input name="address" required maxlength="300" value={application?.address??''} autocomplete="street-address" class="rounded-lg border border-line bg-background px-3 py-2.5 font-normal"/></label><label class="grid gap-1 text-sm font-medium sm:col-span-2">Carrera solicitada<select name="career_id" class="rounded-lg border border-line bg-background px-3 py-2.5 font-normal"><option value="">Por definir</option>{careers.map(c=><option value={c.id} selected={application?.requested_career_id===c.id}>{c.title}</option>)}</select></label>
<div class="rounded-xl bg-background p-4 sm:col-span-2"><h2 class="font-semibold">Identificación</h2><p class="mt-1 text-xs text-muted">Si tienes 18 años o más, adjunta una identificación oficial. Para menores, completa los datos de madre, padre o tutor. Archivos PDF, JPG o PNG; máximo 10 MB.</p><label class="mt-3 grid gap-1 text-sm">Identificación oficial del solicitante<input type="file" name="applicant_document" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" class="rounded-lg border border-line p-2"/>{application?.applicant_id_document_key&&<span class="text-xs text-green-700">Documento recibido. Adjunta otro solo si deseas reemplazarlo.</span>}</label><div id="guardian-fields" class="mt-4 grid gap-3 sm:grid-cols-2"><label class="grid gap-1 text-sm">Nombre de madre, padre o tutor<input name="guardian_name" value={application?.guardian_name??''} maxlength="160" class="rounded-lg border border-line bg-surface px-3 py-2 font-normal"/></label><label class="grid gap-1 text-sm">Parentesco<input name="guardian_relationship" value={application?.guardian_relationship??''} maxlength="80" class="rounded-lg border border-line bg-surface px-3 py-2 font-normal"/></label><label class="grid gap-1 text-sm">Teléfono del tutor<input name="guardian_phone" value={application?.guardian_phone??''} maxlength="30" class="rounded-lg border border-line bg-surface px-3 py-2 font-normal"/></label><label class="grid gap-1 text-sm">Correo del tutor<input name="guardian_email" type="email" value={application?.guardian_email??''} maxlength="254" class="rounded-lg border border-line bg-surface px-3 py-2 font-normal"/></label><label class="grid gap-1 text-sm sm:col-span-2">Identificación del tutor (opcional)<input type="file" name="guardian_document" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" class="rounded-lg border border-line p-2"/></label></div></div>
<button class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white sm:col-span-2">{application?'Enviar correcciones':'Enviar solicitud'}</button></form>}
<script is:inline>const dob=document.querySelector('input[name="date_of_birth"]'),box=document.getElementById('guardian-fields');const sync=()=>{if(!dob||!box)return;const age=(date)=>{const now=new Date(),born=new Date(date+'T00:00:00');let years=now.getFullYear()-born.getFullYear();if(now.getMonth()<born.getMonth()||(now.getMonth()===born.getMonth()&&now.getDate()<born.getDate()))years--;return years;};const minor=dob.value&&age(dob.value)<18;box.hidden=!minor;box.querySelectorAll('input').forEach(input=>{input.required=minor&&['guardian_name','guardian_relationship','guardian_phone'].includes(input.name);});};dob?.addEventListener('change',sync);sync();</script>
</main></Layout>
