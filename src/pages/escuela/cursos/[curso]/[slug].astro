---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail } from '../../../../features/auth/customer';
import { renderMarkdown } from '../../../../features/pages/markdown';
import { renderCourseTex } from '../../../../features/mathTexts/render';
if (!(await accountsEnabled())) return Astro.redirect('/',303);
const email=await getCustomerEmail(Astro.cookies); if(!email) return Astro.redirect('/account/login',303);
const courseSlug=Astro.params.curso??''; const lessonSlug=Astro.params.slug??'';
const access=await env.DB.prepare(`SELECT c.id AS course_id,c.title AS course_title,c.slug AS course_slug,c.level_code,c.tex_source_key,a.title AS area_title FROM school_courses c LEFT JOIN school_areas a ON a.id=c.area_id WHERE c.slug=? AND c.status='published' AND c.content_kind='course' AND (EXISTS(SELECT 1 FROM order_items oi JOIN orders o ON o.id=oi.order_id WHERE oi.school_course_id=c.id AND lower(trim(o.email))=lower(trim(?)) AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents) OR EXISTS(SELECT 1 FROM school_course_assignments x JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE AND i.status='approved' AND i.selected_area_id=c.area_id AND i.approved_level=c.level_code WHERE x.course_id=c.id AND x.student_email=? COLLATE NOCASE AND x.status='active' AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='enrollment' AND p.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='monthly' AND p.valid_until>=date('now')))) LIMIT 1`).bind(courseSlug,email,email).first<{course_id:string;course_title:string;course_slug:string;level_code:string;tex_source_key:string|null;area_title:string|null}>();
if(!access) return Astro.redirect('/escuela/mi-escuela',303);
const lesson=await env.DB.prepare(`SELECT id,slug,title,summary,content_md,content_html,sequence_no,lesson_type,content_version,assessment_json,grading_weight,tex_node_id,due_at,activity_kind FROM school_lessons WHERE course_id=? AND slug=? AND status='published' LIMIT 1`).bind(access.course_id,lessonSlug).first<{id:string;slug:string;title:string;summary:string;content_md:string;content_html:string|null;sequence_no:number;lesson_type:'reading'|'quiz'|'exercise'|'assignment';content_version:number;assessment_json:string;grading_weight:number;tex_node_id:string|null;due_at:string|null;activity_kind:string}>();
if(!lesson) return Astro.redirect('/escuela/mi-escuela',303);
let lessonHtml=lesson.content_html||renderMarkdown(lesson.content_md);
if(lesson.tex_node_id && access.tex_source_key && env.FILES){const texObject=await env.FILES.get(access.tex_source_key);if(texObject){const nodes=renderCourseTex(await texObject.text());const current=nodes.find(n=>n.id===lesson.tex_node_id);if(current)lessonHtml=current.html;}}
let questions:{id:string;type:'multiple_choice'|'short_answer'|'long_answer'|'file_upload';prompt:string;options?:string[];required?:boolean}[]=[];
try { const parsed=JSON.parse(lesson.assessment_json||'{}'); questions=Array.isArray(parsed.questions)?parsed.questions:[]; } catch {}
const nav=(await env.DB.prepare(`SELECT l.slug,l.title,l.sequence_no,COALESCE(p.status,'not_started') AS progress_status FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' ORDER BY l.sequence_no`).bind(email,access.course_id).all<{slug:string;title:string;sequence_no:number;progress_status:string}>()).results??[];
const index=nav.findIndex((item)=>item.slug===lessonSlug); const firstIncompleteIndex=nav.findIndex((item)=>item.progress_status!=='completed'); const lastUnlockedIndex=firstIncompleteIndex<0?nav.length-1:firstIncompleteIndex; const previous=index>0?nav[index-1]:null; const next=index>=0&&index<nav.length-1?nav[index+1]:null;
if(index>0){const blocked=await env.DB.prepare(`SELECT l.slug FROM school_lessons l WHERE l.course_id=? AND l.status='published' AND l.sequence_no<(SELECT sequence_no FROM school_lessons WHERE course_id=? AND slug=? AND status='published') AND NOT EXISTS(SELECT 1 FROM school_lesson_progress p WHERE p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE AND p.status='completed') ORDER BY l.sequence_no LIMIT 1`).bind(access.course_id,access.course_id,lessonSlug,email).first<{slug:string}>();if(blocked)return Astro.redirect(`/escuela/cursos/${courseSlug}/${blocked.slug}`,303);}
// Registrar el inicio al abrir una lección autorizada del curso asignado.
const courseProgressId = `scp_${crypto.randomUUID()}`;
const startedAt = new Date().toISOString();
await env.DB.prepare(`INSERT INTO school_course_progress (id,student_email,course_id,status,started_at,content_version,updated_at) VALUES (?,?,?,'in_progress',?,1,?) ON CONFLICT(student_email,course_id) DO UPDATE SET status=CASE WHEN school_course_progress.status='completed' THEN 'completed' ELSE 'in_progress' END,started_at=COALESCE(school_course_progress.started_at,excluded.started_at),updated_at=excluded.updated_at`).bind(courseProgressId,email,access.course_id,startedAt,startedAt).run();
const progress=await env.DB.prepare(`SELECT status,completed_at,submission_at,grade,feedback,student_response,graded_at FROM school_lesson_progress WHERE student_email=? COLLATE NOCASE AND lesson_id=? LIMIT 1`).bind(email,lesson.id).first<{status:string;completed_at:string|null;submission_at:string|null;grade:number|null;feedback:string;student_response:string;graded_at:string|null}>();
const gradeSummary=await env.DB.prepare(`SELECT ROUND(SUM((CASE WHEN p.grade IS NOT NULL THEN p.grade WHEN l.lesson_type='reading' AND p.status='completed' THEN 100 ELSE 0 END)*l.grading_weight*CASE WHEN l.tex_node_id IS NOT NULL AND l.activity_kind='reading' THEN 0 ELSE 1 END)/NULLIF(SUM(l.grading_weight*CASE WHEN l.tex_node_id IS NOT NULL AND l.activity_kind='reading' THEN 0 ELSE 1 END),0)/10,2) AS grade10, ROUND(SUM((CASE WHEN p.grade IS NOT NULL THEN p.grade WHEN l.lesson_type='reading' AND p.status='completed' THEN 100 ELSE 0 END)*l.grading_weight*CASE WHEN l.tex_node_id IS NOT NULL AND l.activity_kind='reading' THEN 0 ELSE 1 END)/NULLIF(SUM(l.grading_weight*CASE WHEN l.tex_node_id IS NOT NULL AND l.activity_kind='reading' THEN 0 ELSE 1 END),0),2) AS grade100, SUM(CASE WHEN p.status='completed' THEN 1 ELSE 0 END) AS completed, COUNT(l.id) AS total FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published'`).bind(email,access.course_id).first<{grade10:number|null;grade100:number|null;completed:number|null;total:number}>();
const isReading=lesson.lesson_type==='reading'; const isComplete=progress?.status==='completed'; const apiUrl=`/api/escuela/cursos/${encodeURIComponent(courseSlug)}/${encodeURIComponent(lessonSlug)}`;
---

<Layout title={lesson.title} description={lesson.summary || lesson.title}>
  <main
    id="school-lesson"
    class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6 sm:py-8"
    data-course={courseSlug}
    data-slug={lessonSlug}
    data-api={apiUrl}
    data-type={lesson.lesson_type}
  >
    <nav aria-label="Ruta de navegación" class="mb-5 flex flex-wrap items-center gap-2 text-sm text-kumo-muted">
      <a href="/account/courses" class="transition hover:text-kumo-strong">Mis cursos</a>
      <span aria-hidden="true">/</span>
      <a href="/escuela/mi-escuela" class="transition hover:text-kumo-strong">Mi escuela</a>
      <span aria-hidden="true">/</span>
      <span class="max-w-full truncate font-medium text-kumo-strong">{access.course_title}</span>
    </nav>

    <header class="mb-6 rounded-3xl border border-kumo-line bg-white p-5 shadow-sm sm:p-7">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-kumo-muted">
            {access.area_title || 'Área de estudio'} · {access.level_code}
          </p>
          <h1 class="mt-2 break-words text-2xl font-bold tracking-tight sm:text-3xl">{lesson.title}</h1>
          {lesson.summary && <p class="mt-3 max-w-3xl text-sm leading-6 text-kumo-muted sm:text-base">{lesson.summary}</p>}
        </div>
        <span class={`shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold ${isComplete ? 'bg-emerald-50 text-emerald-800' : 'bg-sky-50 text-sky-800'}`}>
          {isComplete ? '✓ Completada' : isReading ? 'Lectura' : 'Actividad'}
        </span>
      </div>

      <div class="mt-6 border-t border-kumo-line pt-5">
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="text-kumo-muted">Tu avance en este curso</span>
          <strong class="tabular-nums">{gradeSummary?.completed ?? 0} de {gradeSummary?.total ?? nav.length} unidades</strong>
        </div>
        <div
          class="mt-2 h-2.5 overflow-hidden rounded-full bg-gray-100"
          role="progressbar"
          aria-label="Avance del curso"
          aria-valuemin="0"
          aria-valuemax={gradeSummary?.total ?? nav.length}
          aria-valuenow={gradeSummary?.completed ?? 0}
        >
          <div class="h-full rounded-full bg-kumo-inverted transition-all" style={`width: ${gradeSummary?.total ? Math.round(100 * (gradeSummary.completed ?? 0) / gradeSummary.total) : 0}%`}></div>
        </div>
        <p class="mt-2 text-xs leading-5 text-kumo-muted">
          {access.tex_source_key
            ? (gradeSummary?.grade10 != null ? `Calificación provisional: ${gradeSummary.grade10.toFixed(2)} / 10` : 'Las actividades calificables aparecerán en tu resumen cuando corresponda.')
            : (gradeSummary?.grade100 != null ? `Calificación provisional: ${gradeSummary.grade100.toFixed(2)} / 100` : 'Tu avance se guarda conforme completas las unidades.')}
        </p>
      </div>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]">
      <div class="min-w-0">
        <section class="rounded-3xl border border-kumo-line bg-white p-5 shadow-sm sm:p-7" aria-labelledby="lesson-content-title">
          <div class="flex items-center gap-3 border-b border-kumo-line pb-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gray-50 text-lg" aria-hidden="true">{isReading ? '📖' : '✎'}</span>
            <div>
              <h2 id="lesson-content-title" class="font-semibold">{isReading ? 'Lee con calma' : 'Revisa la actividad'}</h2>
              <p class="mt-0.5 text-xs text-kumo-muted">Puedes volver a esta unidad cuando lo necesites.</p>
            </div>
          </div>

          <div id="lesson-status" class="mt-5 rounded-2xl border border-kumo-line bg-gray-50 p-4" aria-live="polite">
            <p class="font-semibold">{isComplete ? (isReading ? 'Lectura completada' : 'Entrega registrada') : (isReading ? 'Aún estás leyendo' : 'Pendiente de completar')}</p>
            <p id="lesson-status-detail" class="mt-1 text-sm leading-6 text-kumo-muted">
              {isComplete
                ? (isReading ? 'Esta lectura ya está registrada en tu avance.' : progress?.grade !== null && progress?.grade !== undefined ? `Calificada: ${lesson.tex_node_id ? (progress.grade / 10).toFixed(1) + '/10' : progress.grade + '/100'}` : 'Tu entrega quedó registrada y está pendiente de revisión.')
                : (isReading ? 'Al abrir la lectura, el sistema registra tu avance automáticamente.' : 'Lee las indicaciones y envía tu respuesta cuando esté lista.')}
            </p>
          </div>

          <article id="lesson-content" class="prose mt-7 max-w-none" set:html={lessonHtml}></article>

          {(lesson.due_at || lesson.activity_kind !== 'reading') && (
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
              {lesson.due_at && <p class="rounded-xl bg-amber-50 px-3 py-2 text-amber-900">Fecha límite: {lesson.due_at}</p>}
              {lesson.activity_kind !== 'reading' && <p class="rounded-xl bg-gray-50 px-3 py-2 text-kumo-muted">Actividad evaluable · Peso {lesson.grading_weight}</p>}
            </div>
          )}
        </section>

        {isReading ? (
          <section class="mt-5 flex flex-col gap-3 rounded-2xl border border-kumo-line bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="font-semibold">¿Terminaste de leer?</h2>
              <p class="mt-1 text-sm leading-5 text-kumo-muted">Cuando se registre la lectura, podrás continuar con la siguiente unidad disponible.</p>
            </div>
            {next && <a class="inline-flex min-h-11 items-center justify-center rounded-xl bg-kumo-inverted px-4 py-2.5 text-sm font-semibold text-kumo-base" href={`/escuela/cursos/${courseSlug}/${next.slug}`}>Siguiente unidad →</a>}
          </section>
        ) : (
          <details class="mt-5 overflow-hidden rounded-3xl border border-kumo-line bg-white shadow-sm" open={!isComplete}>
            <summary class="cursor-pointer list-none p-5 sm:p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-kumo-muted">Tu trabajo</p>
                  <h2 class="mt-1 text-lg font-semibold">{isComplete ? 'Ver o actualizar tu entrega' : 'Enviar actividad'}</h2>
                  <p class="mt-1 text-sm text-kumo-muted">La administración revisará tu respuesta y añadirá comentarios si hace falta.</p>
                </div>
                <span class="text-xl text-kumo-muted" aria-hidden="true">⌄</span>
              </div>
            </summary>

            <div class="border-t border-kumo-line p-5 sm:p-6">
              <form id="lesson-submission" class="space-y-5" enctype="multipart/form-data">
                {questions.length ? questions.map((q, i) => (
                  <fieldset class="rounded-2xl border border-kumo-line p-4 sm:p-5">
                    <legend class="max-w-full px-1 font-medium leading-6">{i + 1}. {q.prompt}{q.required !== false ? ' *' : ''}</legend>
                    {q.type === 'multiple_choice' ? (
                      <div class="mt-3 space-y-2">
                        {(q.options ?? []).map((option) => (
                          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-kumo-line p-3 text-sm transition hover:bg-gray-50">
                            <input type="radio" name={`answer_${q.id}`} value={option} required={q.required !== false} class="mt-0.5" />
                            <span>{option}</span>
                          </label>
                        ))}
                      </div>
                    ) : q.type === 'short_answer' ? (
                      <input name={`answer_${q.id}`} maxlength="20000" required={q.required !== false} class="mt-3 block min-h-11 w-full rounded-xl border border-kumo-line p-3" placeholder="Escribe tu respuesta" />
                    ) : q.type === 'long_answer' ? (
                      <textarea name={`answer_${q.id}`} rows="6" maxlength="20000" required={q.required !== false} class="mt-3 block w-full rounded-xl border border-kumo-line p-3 leading-6" placeholder="Desarrolla tu respuesta"></textarea>
                    ) : (
                      <div class="mt-3 rounded-xl bg-gray-50 p-3">
                        <input type="file" name="submission_file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.docx" required={q.required !== false && !progress?.submission_at} class="block w-full text-sm" />
                        <p class="mt-2 text-xs leading-5 text-kumo-muted">PDF, PNG, JPG, WEBP, TXT o DOCX; máximo 10 MB.</p>
                      </div>
                    )}
                  </fieldset>
                )) : (
                  <label class="block text-sm font-medium">Tu respuesta
                    <textarea name="answer_general" rows="6" required minlength="5" maxlength="20000" class="mt-2 block w-full rounded-xl border border-kumo-line p-3 font-normal leading-6" placeholder="Escribe aquí tu procedimiento o respuesta"></textarea>
                  </label>
                )}

                {questions.length > 0 && !questions.some((q) => q.type === 'file_upload') && (
                  <div class="rounded-2xl bg-gray-50 p-4">
                    <label class="block text-sm font-medium">Archivo adjunto <span class="font-normal text-kumo-muted">(opcional)</span>
                      <input type="file" name="submission_file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.docx" class="mt-2 block w-full text-sm" />
                    </label>
                    <p class="mt-2 text-xs text-kumo-muted">PDF, PNG, JPG, WEBP, TXT o DOCX; máximo 10 MB.</p>
                  </div>
                )}

                <div class="flex flex-col gap-3 border-t border-kumo-line pt-5 sm:flex-row sm:items-center sm:justify-between">
                  <p class="max-w-lg text-xs leading-5 text-kumo-muted">Enviar tu respuesta no significa que ya esté aprobada. Podrás consultar aquí la calificación y la retroalimentación.</p>
                  <button type="submit" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-kumo-inverted px-5 py-3 text-sm font-semibold text-kumo-base">Enviar respuesta</button>
                </div>
                <p id="submission-message" class="text-sm" aria-live="polite"></p>
              </form>
            </div>
          </details>
        )}

        {progress?.grade !== null && progress?.grade !== undefined && (
          <section class="mt-5 rounded-3xl border border-kumo-line bg-white p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-kumo-muted">Retroalimentación docente</p>
            <h2 class="mt-2 text-xl font-semibold">Tu calificación: {lesson.tex_node_id ? (progress.grade / 10).toFixed(1) + '/10' : progress.grade + '/100'}</h2>
            {progress.graded_at && <p class="mt-1 text-xs text-kumo-muted">Revisada el {progress.graded_at}</p>}
            <p class="mt-4 whitespace-pre-wrap text-sm leading-6">{progress.feedback || 'Todavía no hay comentarios adicionales.'}</p>
          </section>
        )}

        <nav aria-label="Navegación entre unidades" class="mt-6 grid gap-3 sm:grid-cols-2">
          {previous ? (
            <a class="rounded-2xl border border-kumo-line bg-white p-4 transition hover:bg-gray-50" href={`/escuela/cursos/${courseSlug}/${previous.slug}`}>
              <span class="text-xs text-kumo-muted">Unidad anterior</span>
              <span class="mt-1 block font-semibold">← {previous.title}</span>
            </a>
          ) : <div></div>}
          {next ? (
            <a class="rounded-2xl border border-kumo-line bg-white p-4 text-left transition hover:bg-gray-50 sm:text-right" href={`/escuela/cursos/${courseSlug}/${next.slug}`}>
              <span class="text-xs text-kumo-muted">Siguiente unidad</span>
              <span class="mt-1 block font-semibold">{next.title} →</span>
            </a>
          ) : (
            <a class="rounded-2xl border border-kumo-line bg-white p-4 transition hover:bg-gray-50 sm:text-right" href="/account/courses">
              <span class="text-xs text-kumo-muted">Terminaste el recorrido</span>
              <span class="mt-1 block font-semibold">Volver a mis cursos →</span>
            </a>
          )}
        </nav>
      </div>

      <aside class="min-w-0 space-y-4 lg:sticky lg:top-6">
        <section class="rounded-3xl border border-kumo-line bg-white p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-kumo-muted">Estás estudiando</p>
          <h2 class="mt-2 text-lg font-semibold leading-snug">{access.course_title}</h2>
          <p class="mt-1 text-sm text-kumo-muted">{access.area_title || 'Área de estudio'} · {access.level_code}</p>
          <a href="/account/courses" class="mt-4 inline-flex text-sm font-semibold underline underline-offset-4">Ver todos mis cursos</a>
        </section>

        <section class="overflow-hidden rounded-3xl border border-kumo-line bg-white">
          <div class="border-b border-kumo-line p-5">
            <h2 class="font-semibold">Recorrido del curso</h2>
            <p class="mt-1 text-xs text-kumo-muted">Unidad {Math.max(0, index + 1)} de {nav.length}</p>
          </div>
          <nav aria-label="Índice del curso" class="max-h-[60vh] space-y-1 overflow-y-auto p-2">
            {nav.map((item, i) => (
              <a
                class={`flex items-start gap-3 rounded-xl p-3 text-sm transition ${i === index ? 'bg-kumo-inverted text-kumo-base' : 'hover:bg-gray-50'} ${i > lastUnlockedIndex ? 'pointer-events-none opacity-40' : ''}`}
                href={i <= lastUnlockedIndex ? `/escuela/cursos/${courseSlug}/${item.slug}` : '#'}
                aria-current={i === index ? 'page' : undefined}
                aria-disabled={i > lastUnlockedIndex ? 'true' : undefined}
              >
                <span class="grid size-7 shrink-0 place-items-center rounded-lg border border-current/20 text-xs font-semibold">{item.progress_status === 'completed' ? '✓' : i + 1}</span>
                <span class="min-w-0 flex-1 leading-5">{item.title}<span class="mt-0.5 block text-xs opacity-70">{item.progress_status === 'completed' ? 'Completada' : i === index ? 'Estás aquí' : i > lastUnlockedIndex ? 'Se desbloquea al avanzar' : 'Pendiente'}</span></span>
              </a>
            ))}
          </nav>
        </section>

        <a href="/account/messages" class="block rounded-2xl border border-kumo-line bg-white p-4 text-sm transition hover:bg-gray-50">
          <span class="font-semibold">¿Necesitas ayuda?</span>
          <span class="mt-1 block text-kumo-muted">Escribe a la administración →</span>
        </a>
      </aside>
    </div>
  </main>

  <script is:inline>
    const root = document.getElementById('school-lesson');

    if (root?.dataset.type === 'reading' && document.getElementById('lesson-status')?.textContent?.includes('Aún estás leyendo')) {
      fetch(root.dataset.api, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'read' }),
      }).then(async (response) => {
        if (!response.ok) return;
        const status = document.getElementById('lesson-status');
        const statusText = status?.querySelector('p');
        if (statusText) statusText.textContent = 'Lectura completada';
        const detail = document.getElementById('lesson-status-detail');
        if (detail) detail.textContent = 'Esta lectura quedó registrada automáticamente.';
      }).catch(() => {});
    }

    const form = document.getElementById('lesson-submission');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = document.getElementById('submission-message');
      const button = form.querySelector('button[type="submit"]');
      if (button) button.disabled = true;
      if (message) message.textContent = 'Enviando…';

      try {
        const response = await fetch(root.dataset.api, {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'No se pudo registrar la entrega.');

        if (message) message.textContent = 'Entrega registrada. Puedes consultar la calificación y la retroalimentación en esta página.';
        const status = document.getElementById('lesson-status');
        const statusText = status?.querySelector('p');
        if (statusText) statusText.textContent = 'Entrega registrada';
        const detail = document.getElementById('lesson-status-detail');
        if (detail) detail.textContent = 'Tu entrega está pendiente de revisión por la administración.';
      } catch (error) {
        if (message) message.textContent = error instanceof Error ? error.message : 'No se pudo registrar la entrega.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
