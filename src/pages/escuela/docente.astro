---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { ensureCustomerAccount } from '../../features/auth/customerIdentity';
if(!(await accountsEnabled()))return Astro.redirect('/',303);const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);const client=await ensureCustomerAccount(env.DB,email);
const teacher=await env.DB.prepare("SELECT teacher_number,display_name,status FROM school_teachers WHERE client_number=?").bind(client).first<{teacher_number:string;display_name:string;status:string}>();
const rooms=teacher?(await env.DB.prepare(`SELECT r.id,r.classroom_code,r.name,r.starts_on,r.ends_on,r.status,c.title AS course_title,c.slug AS course_slug,y.name AS cycle_name,(SELECT COUNT(*) FROM school_classroom_students s WHERE s.classroom_id=r.id AND s.status='active') AS student_count FROM school_classroom_teachers t JOIN school_classrooms r ON r.id=t.classroom_id JOIN school_courses c ON c.id=r.course_id JOIN school_academic_cycles y ON y.id=r.cycle_id WHERE t.teacher_number=? AND t.status='active' AND r.status IN ('active','planned') ORDER BY r.starts_on`).bind(teacher.teacher_number).all<any>()).results??[]:[];
---
<Layout title="Mis grupos"><main class="mx-auto max-w-5xl px-4 py-8 sm:px-6"><a href="/account/profile" class="text-sm underline">← Mi perfil</a><h1 class="mt-4 text-3xl font-semibold">Mis grupos</h1>{teacher?<><p class="mt-2 text-sm text-muted">{teacher.display_name} · número de maestro <strong>{teacher.teacher_number}</strong> · {teacher.status}</p><div class="mt-6 grid gap-4 md:grid-cols-2">{rooms.length?rooms.map((r:any)=><article class="rounded-2xl border border-line bg-surface p-5"><p class="text-xs uppercase tracking-wide text-muted">{r.cycle_name} · {r.classroom_code}</p><h2 class="mt-1 text-xl font-semibold">{r.course_title}</h2><p class="mt-1 text-sm text-muted">{r.name} · {r.starts_on} al {r.ends_on} · {r.student_count} alumnos</p><a class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href={`/escuela/aulas/${r.id}`}>Abrir aula y comunicarme</a></article>):<p>No tienes aulas asignadas.</p>}</div></>:<p class="mt-5 rounded-xl bg-surface p-4 text-sm">No hay un registro activo de maestro asociado a este número de cliente.</p>}</main></Layout>
