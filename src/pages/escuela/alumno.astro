---
export const prerender=false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../features/auth/customer';
import { ensureCustomerAccount } from '../../features/auth/customerIdentity';
if(!(await accountsEnabled()))return Astro.redirect('/',303);const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);const client=await ensureCustomerAccount(env.DB,email);
const student=await env.DB.prepare('SELECT student_number,status,career_id FROM school_students WHERE client_number=?').bind(client).first<{student_number:string;status:string;career_id:string|null}>();
const application=await env.DB.prepare('SELECT status,correction_request FROM school_enrollment_applications WHERE client_number=?').bind(client).first<{status:string;correction_request:string}>();
// Read only the student's active classroom roster and expose a course link during its active cycle window.
const rooms=student&&student.status==='active'?(await env.DB.prepare(`SELECT r.id,r.classroom_code,r.name,r.starts_on,r.ends_on,r.status,c.title AS course_title,c.slug AS course_slug,y.name AS cycle_name,CASE WHEN r.status='active' AND y.status='active' AND date('now') BETWEEN r.starts_on AND r.ends_on THEN 1 ELSE 0 END AS can_open,(SELECT l.slug FROM school_lessons l WHERE l.course_id=c.id AND l.status='published' ORDER BY l.sequence_no,l.id LIMIT 1) AS first_lesson FROM school_classroom_students s JOIN school_classrooms r ON r.id=s.classroom_id JOIN school_courses c ON c.id=r.course_id JOIN school_academic_cycles y ON y.id=r.cycle_id WHERE s.student_number=? AND s.status='active' AND r.status IN ('active','planned') ORDER BY r.starts_on`).bind(student.student_number).all<any>()).results??[]:[];
---
<Layout title="Mis aulas"><main class="mx-auto max-w-4xl px-4 py-8 sm:px-6"><a href="/account/profile" class="text-sm underline">← Mi perfil</a><h1 class="mt-4 text-3xl font-semibold">Mis aulas</h1>{student?<><p class="mt-2 text-sm text-muted">Número de alumno <strong>{student.student_number}</strong></p><div class="mt-6 grid gap-4">{rooms.length?rooms.map((r:any)=><article class="rounded-2xl border border-line bg-surface p-5"><div class="flex flex-wrap justify-between gap-2"><div><p class="text-xs uppercase tracking-wide text-muted">{r.cycle_name} · {r.classroom_code}</p><h2 class="mt-1 text-xl font-semibold">{r.course_title}</h2><p class="mt-1 text-sm text-muted">{r.name} · {r.starts_on} al {r.ends_on}</p></div><span class="h-fit rounded-full bg-green-100 px-3 py-1 text-xs">{r.status}</span></div><div class="mt-4 flex flex-wrap gap-3">{r.can_open&&r.first_lesson&&<a class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white" href={`/escuela/cursos/${r.course_slug}/${r.first_lesson}`}>Abrir curso</a>}<a class="rounded-lg border border-line px-4 py-2 text-sm" href={`/escuela/aulas/${r.id}`}>Mensajes del aula</a></div></article>):<p class="rounded-xl bg-surface p-4 text-sm">Todavía no tienes aulas activas.</p>}</div></>:<section class="mt-5 rounded-2xl border border-line bg-surface p-5"><h2 class="font-semibold">Aún no tienes número de alumno</h2><p class="mt-2 text-sm text-muted">{application?.status==='pending'?'Tu solicitud está en revisión.':application?.status==='correction_requested'?'La escuela solicitó corregir tus datos.':''}</p><a href="/escuela/inscripcion" class="mt-4 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white">{application?'Ver solicitud':'Solicitar inscripción'}</a></section>}</main></Layout>
