---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { accountsEnabled,getCustomerEmail } from '../../../features/auth/customer';
if(!(await accountsEnabled()))return Astro.redirect('/',303);
const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);
const courses=(await env.DB.prepare(`SELECT c.id,c.title,c.slug,c.level_code,a.title AS area_title,p.title AS program_title FROM school_courses c LEFT JOIN school_areas a ON a.id=c.area_id LEFT JOIN school_programs p ON p.slug=a.program_slug WHERE c.status='published' AND c.content_kind IN ('course','reading') AND (EXISTS(SELECT 1 FROM school_course_assignments x WHERE x.course_id=c.id AND x.student_email=? COLLATE NOCASE AND x.status='active' AND EXISTS(SELECT 1 FROM school_area_diagnostics d WHERE d.student_email=x.student_email COLLATE NOCASE AND d.area_id=c.area_id AND d.status='approved' AND d.approved_level=c.level_code AND d.attempt_no=(SELECT MAX(d2.attempt_no) FROM school_area_diagnostics d2 WHERE d2.student_email=d.student_email COLLATE NOCASE AND d2.area_id=d.area_id)) AND EXISTS(SELECT 1 FROM school_fee_payments f WHERE f.student_email=x.student_email COLLATE NOCASE AND f.fee_type='enrollment' AND f.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments f WHERE f.student_email=x.student_email COLLATE NOCASE AND f.fee_type='monthly' AND f.valid_until>=date('now'))) OR EXISTS(SELECT 1 FROM order_items oi JOIN orders o ON o.id=oi.order_id WHERE oi.school_course_id=c.id AND lower(trim(o.email))=lower(trim(?)) AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents)) ORDER BY p.title,a.title,c.title`).bind(email,email).all<{id:string;title:string;slug:string;level_code:string;area_title:string|null;program_title:string|null}>()).results??[];
const reports=await Promise.all(courses.map(async(course)=>{
  const grades=(await env.DB.prepare(`SELECT l.title,l.slug,l.sequence_no,l.grading_weight,l.tex_node_id,p.status,p.submission_at,p.grade,p.feedback,p.graded_at FROM school_lessons l JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' AND p.submission_at IS NOT NULL ORDER BY l.sequence_no`).bind(email,course.id).all<{title:string;slug:string;sequence_no:number;grading_weight:number;tex_node_id:string|null;status:string;submission_at:string|null;grade:number|null;feedback:string;graded_at:string|null}>()).results??[];
  const scored=grades.filter((g)=>g.grade!==null);const totalWeight=scored.reduce((sum,g)=>sum+g.grading_weight,0);const average=totalWeight?Math.round(scored.reduce((sum,g)=>sum+(g.grade??0)*(g.tex_node_id?10:1)*g.grading_weight,0)/totalWeight*100)/100:null;
  return {...course,grades,average};
}));
---
<Layout title="Mis calificaciones" description="Calificaciones de tus cursos y áreas.">
  <main class="mx-auto max-w-4xl px-4 py-7 sm:px-6"><a href="/escuela/mi-escuela" class="text-sm underline">← Mi escuela</a><header class="mt-3"><p class="text-xs uppercase tracking-widest text-kumo-muted">Tu avance</p><h1 class="mt-1 text-2xl font-bold">Mis calificaciones</h1><p class="mt-1 text-sm text-kumo-muted">Consulta entregas y retroalimentación de todos tus cursos.</p></header>
    {reports.length? <div class="mt-5 space-y-4">{reports.map((report)=><details class="rounded-2xl border border-kumo-line bg-white" open={reports.length===1}><summary class="flex cursor-pointer flex-wrap items-center justify-between gap-3 p-4"><span><span class="block text-xs text-kumo-muted">{report.program_title??'Escuela'} · {report.area_title??'Área'} · {report.level_code}</span><strong class="mt-1 block">{report.title}</strong></span><span class="text-sm font-semibold">Promedio: {report.average===null?'—':`${report.average}/100`}</span></summary><div class="space-y-3 border-t border-kumo-line p-3">{report.grades.length?report.grades.map((g)=><article class="rounded-xl bg-kumo-subtle p-3"><div class="flex flex-wrap items-start justify-between gap-2"><div><a class="text-sm font-semibold underline" href={`/escuela/cursos/${report.slug}/${g.slug}`}>{g.sequence_no}. {g.title}</a><p class="mt-1 text-xs text-kumo-muted">Peso {g.grading_weight} · Enviada {g.submission_at}</p></div><strong class="text-sm">{g.grade===null?'Pendiente':g.tex_node_id?`${(g.grade/10).toFixed(1)}/10`:`${g.grade}/100`}</strong></div>{g.grade!==null&&<div class="mt-3 border-t border-kumo-line pt-2"><p class="text-xs font-semibold">Retroalimentación</p><p class="mt-1 whitespace-pre-wrap text-sm">{g.feedback||'No hay comentarios adicionales.'}</p></div>}</article>):<p class="p-2 text-sm text-kumo-muted">Aún no hay actividades enviadas para este curso.</p>}</div></details>)}</div>:<p class="mt-5 rounded-xl border border-kumo-line p-5 text-sm text-kumo-muted">No encontramos cursos asignados o comprados con acceso vigente.</p>}
  </main>
</Layout>
