---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail } from '../../../features/auth/customer';

if (!(await accountsEnabled())) return Astro.redirect('/',303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login',303);
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const assignment = await env.DB.prepare(`SELECT x.id AS assignment_id,c.id AS course_id,c.slug,c.title,c.level_code,a.title AS area_title FROM school_course_assignments x JOIN school_courses c ON c.id=x.course_id JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE AND i.status='approved' AND i.selected_area_id=c.area_id AND i.approved_level=c.level_code LEFT JOIN school_areas a ON a.id=c.area_id WHERE x.student_email=? COLLATE NOCASE AND x.status='active' AND c.status='published' AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='enrollment' AND p.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='monthly' AND p.valid_until>=date('now')) LIMIT 1`).bind(email).first<{assignment_id:string;course_id:string;slug:string;title:string;level_code:string;area_title:string|null}>();
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData(); const lessonId = String(form.get('lesson_id') ?? '').trim();
    if (!assignment || !lessonId) throw new Error('No hay un curso activo o la lección no es válida.');
    const lesson = await env.DB.prepare(`SELECT id FROM school_lessons WHERE id=? AND course_id=? AND status='published'`).bind(lessonId,assignment.course_id).first<{id:string}>();
    if (!lesson) throw new Error('La lección no pertenece a tu curso asignado.');
    await env.DB.prepare(`INSERT INTO school_lesson_progress (id,student_email,lesson_id,status,attempts,started_at,completed_at,last_activity_at) VALUES (?,?,?,'completed',1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now')) ON CONFLICT(student_email,lesson_id) DO UPDATE SET status='completed',completed_at=strftime('%Y-%m-%dT%H:%M:%fZ','now'),last_activity_at=strftime('%Y-%m-%dT%H:%M:%fZ','now'),updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now'),attempts=school_lesson_progress.attempts+1`).bind(crypto.randomUUID(),email,lessonId).run();
    const counts = await env.DB.prepare(`SELECT COUNT(*) AS total,SUM(CASE WHEN p.status='completed' THEN 1 ELSE 0 END) AS completed FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' AND l.required_to_complete=1`).bind(email,assignment.course_id).first<{total:number;completed:number|null}>();
    const total = Number(counts?.total ?? 0); const completed = Number(counts?.completed ?? 0); const status = total > 0 && completed >= total ? 'completed' : 'in_progress';
    await env.DB.prepare(`INSERT INTO school_course_progress (id,student_email,course_id,status,started_at,completed_at,updated_at) VALUES (?,?,?, ?,strftime('%Y-%m-%dT%H:%M:%fZ','now'),CASE WHEN ?='completed' THEN strftime('%Y-%m-%dT%H:%M:%fZ','now') ELSE NULL END,strftime('%Y-%m-%dT%H:%M:%fZ','now')) ON CONFLICT(student_email,course_id) DO UPDATE SET status=excluded.status,started_at=COALESCE(school_course_progress.started_at,excluded.started_at),completed_at=excluded.completed_at,updated_at=excluded.updated_at`).bind(crypto.randomUUID(),email,assignment.course_id,status,status).run();
    return Astro.redirect('/escuela/mi-escuela/avance?ok=1',303);
  } catch (e) { const msg = e instanceof Error ? e.message : 'No se pudo registrar el avance.'; return Astro.redirect(`/escuela/mi-escuela/avance?error=${encodeURIComponent(msg.slice(0,140))}`,303); }
}
const lessons = assignment ? ((await env.DB.prepare(`SELECT l.id,l.slug,l.title,l.summary,l.sequence_no,l.required_to_complete,COALESCE(p.status,'not_started') AS progress_status,p.score,p.completed_at FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' ORDER BY l.sequence_no`).bind(email,assignment.course_id).all<{id:string;slug:string;title:string;summary:string;sequence_no:number;required_to_complete:number;progress_status:string;score:number|null;completed_at:string|null}>()).results ?? []) : [];
const totalRequired = lessons.filter(l=>l.required_to_complete===1).length;
const completedRequired = lessons.filter(l=>l.required_to_complete===1 && l.progress_status==='completed').length;
const percent = totalRequired ? Math.round(completedRequired/totalRequired*100) : 0;
---
<Layout title="Mi avance académico" 
  description="Consulta y actualiza tu avance en el curso asignado.">
  
  <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:py-12">
    <p class="text-xs uppercase tracking-widest text-kumo-muted">
      <a href="/escuela/mi-escuela" class="underline">Mi escuela</a> / Avance</p>
      <h1 class="mt-3 text-3xl font-bold">Mi avance académico</h1>
      <p class="mt-2 text-sm text-kumo-muted">Solo se muestra el curso que te asignó la administración.</p>

  {error && <p class="mt-5 rounded border border-red-200 bg-red-50 p-3 text-sm">{error}</p>}

  {ok && 
    <p class="mt-5 rounded border border-green-200 bg-green-50 p-3 text-sm">
      Tu avance se actualizó.</p>}

  {!assignment ? 
    <section class="mt-6 rounded-xl border border-kumo-line p-5">
        <h2 class="font-semibold">No hay un curso habilitado</h2>
        <p class="mt-2 text-sm text-kumo-muted">Revisa que tu inscripción, mensualidad y asignación académica estén vigentes.</p></section> : <><section class="mt-6 rounded-xl border border-kumo-line p-5"><p class="text-xs uppercase tracking-widest text-kumo-muted">{assignment.area_title} · {assignment.level_code}</p><h2 class="mt-2 text-2xl font-semibold">{assignment.title}</h2><div class="mt-5 flex items-center justify-between text-sm"><span>Lecciones obligatorias completadas</span><strong>{completedRequired} / {totalRequired} ({percent}%)</strong></div><div class="mt-2 h-3 overflow-hidden rounded-full bg-gray-200"><div class="h-full rounded-full bg-brand" style={`width:${percent}%`}></div></div></section>
    <section class="mt-6 rounded-xl border border-kumo-line p-5">
      <h2 class="font-semibold">Detalle por lección</h2>
      <ol class="mt-3 divide-y divide-kumo-line">
          {lessons.map(l=>
            <li class="py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-medium">{l.sequence_no}. {l.title}</p>
                  {l.summary && <p class="mt-1 text-sm text-kumo-muted">{l.summary}</p>}
                  <p class="mt-1 text-xs text-kumo-muted">
                    Estado: {l.progress_status==='completed' ?
                      'Completada':l.progress_status==='in_progress'?
                      'En curso':'Sin iniciar'}
                    {l.score!==null?
                      ` · Calificación ${l.score}`:''}
                      {l.required_to_complete!==1?' · No obligatoria':''}</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      <a class="rounded border border-kumo-line px-3 py-2 text-sm underline" href={`/escuela/cursos/${assignment.slug}/${l.slug}`}>
                        Abrir lección</a>
                      {l.progress_status!=='completed' && 
                        <form method="POST">
                          <input type="hidden" name="lesson_id" value={l.id}/>
                          <button class="rounded bg-kumo-strong px-3 py-2 text-sm font-semibold text-white" type="submit">
                            Marcar completada</button>
                        </form>}
                    </div>
                </div>
              </li>)}
        </ol>
        
        {lessons.length===0 && 
          <p class="mt-3 text-sm text-kumo-muted">Aún no hay lecciones publicadas.</p>}
        </section></>}
    <p class="mt-8 text-sm"><a href="/escuela/mi-escuela" class="underline">Volver a Mi escuela</a></p></main>

</Layout>
