---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { accountsEnabled, getCustomerEmail } from '../../../features/auth/customer';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);
const intake = await env.DB.prepare(`SELECT i.status,i.approved_level,a.title AS area_title FROM school_student_intake i LEFT JOIN school_areas a ON a.id=i.selected_area_id WHERE i.student_email=? COLLATE NOCASE`).bind(email).first<{status:string;approved_level:string|null;area_title:string|null}>();
const enrollment = await env.DB.prepare(`SELECT MAX(valid_until) AS valid_until FROM school_fee_payments WHERE student_email=? COLLATE NOCASE AND fee_type='enrollment' AND valid_until>=date('now')`).bind(email).first<{valid_until:string|null}>();
const monthly = await env.DB.prepare(`SELECT MAX(valid_until) AS valid_until FROM school_fee_payments WHERE student_email=? COLLATE NOCASE AND fee_type='monthly' AND valid_until>=date('now')`).bind(email).first<{valid_until:string|null}>();
const assignment = await env.DB.prepare(`SELECT x.id AS assignment_id,c.id AS course_id,c.slug,c.title,c.summary,c.level_code,a.title AS area_title FROM school_course_assignments x JOIN school_courses c ON c.id=x.course_id JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE AND i.status='approved' AND i.selected_area_id=c.area_id AND i.approved_level=c.level_code LEFT JOIN school_areas a ON a.id=c.area_id WHERE x.student_email=? COLLATE NOCASE AND x.status='active' AND c.status='published' ORDER BY x.assigned_at DESC LIMIT 1`).bind(email).first<{assignment_id:string;course_id:string;slug:string;title:string;summary:string;level_code:string;area_title:string|null}>();
const lessons = assignment ? ((await env.DB.prepare(`SELECT l.id,l.slug,l.title,l.summary,l.sequence_no,l.required_to_complete,COALESCE(p.status,'not_started') AS progress_status,p.score,p.completed_at FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' ORDER BY l.sequence_no`).bind(email,assignment.course_id).all<{id:string;slug:string;title:string;summary:string;sequence_no:number;required_to_complete:number;progress_status:string;score:number|null;completed_at:string|null}>()).results ?? []) : [];
const canStudy = Boolean(enrollment?.valid_until && monthly?.valid_until && assignment);
const totalRequired = lessons.filter(l=>l.required_to_complete===1).length;
const completedRequired = lessons.filter(l=>l.required_to_complete===1 && l.progress_status==='completed').length;
const percent = totalRequired ? Math.round(completedRequired/totalRequired*100) : 0;

---
<Layout title="Mi escuela" description="Tu espacio personal de aprendizaje.">
  <main class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:py-12">
    <header class="mb-8"><p class="text-sm font-medium text-kumo-muted">ESCUELA DE MATEMÁTICAS</p><h1 class="mt-2 text-3xl font-bold tracking-tight">Mi escuela</h1><p class="mt-2 text-sm text-kumo-muted">Tu área de interés y tu curso asignado por el equipo académico.</p></header>
    {!intake ? <section class="rounded-xl border border-kumo-line p-6"><h2 class="text-xl font-semibold">Comienza por elegir tu área</h2><p class="mt-2 text-sm text-kumo-muted">Indica qué área de matemáticas te interesa y envía tu diagnóstico inicial. La administración revisará tu nivel antes de asignarte un curso.</p><a href="/escuela/diagnostico" class="mt-4 inline-flex rounded-lg bg-kumo-strong px-4 py-2 text-sm font-semibold text-white">Elegir área y hacer diagnóstico</a></section> : <section class="mb-6 rounded-xl border border-kumo-line p-5"><p class="text-xs uppercase tracking-widest text-kumo-muted">Área de interés</p><h2 class="mt-1 text-xl font-semibold">{intake.area_title ?? 'Área seleccionada'}</h2><p class="mt-2 text-sm">Estado del diagnóstico: <strong>{intake.status==='approved' ? `Aprobado · ${intake.approved_level ?? ''}` : intake.status==='rejected' ? 'Requiere revisión' : 'Pendiente de revisión'}</strong></p><a href="/escuela/diagnostico" class="mt-3 inline-block text-sm underline">Actualizar diagnóstico</a></section>}
    <section class="mb-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-kumo-line p-5"><h2 class="font-semibold">Inscripción semestral</h2><p class="mt-2 text-sm text-kumo-muted">{enrollment?.valid_until ? `Vigente hasta ${enrollment.valid_until}` : 'No hay una inscripción vigente registrada.'}</p><p class="mt-2 text-xs text-kumo-muted">La inscripción se renueva cada seis meses. Si ya pagaste, espera a que administración confirme el pago.</p></div>
      <div class="rounded-xl border border-kumo-line p-5"><h2 class="font-semibold">Mensualidad</h2><p class="mt-2 text-sm text-kumo-muted">{monthly?.valid_until ? `Vigente hasta ${monthly.valid_until}` : 'No hay una mensualidad vigente registrada.'}</p><p class="mt-2 text-xs text-kumo-muted">La mensualidad incluye un solo curso asignado.</p></div>
    </section>
    {!enrollment?.valid_until || !monthly?.valid_until ? 
      <section class="mb-6 rounded-xl border border-kumo-line p-5">
        <h2 class="font-semibold">Acceso académico pendiente</h2>
        <p class="mt-2 text-sm text-kumo-muted">
          Para habilitar las lecciones necesitas inscripción semestral y mensualidad vigentes. Los pagos se verifican en la tienda y administración los registra en tu expediente.
        </p>
        <a href="/escuela/planes" class="mt-3 inline-block text-sm underline">
          Consultar pagos de la escuela
        </a>
      </section> 
      : 
      !assignment ? 
      <section class="mb-6 rounded-xl border border-kumo-line p-5">
        <h2 class="font-semibold">Todavía no tienes un curso asignado</h2>
        <p class="mt-2 text-sm text-kumo-muted">
          Cuando tu diagnóstico esté aprobado, la administración te asignará el nivel que corresponda a tu área.
        </p>
      </section> 
      : 

      /*Nueva parte de código agregada para mostrar el curso asignado y sus lecciones*/
      

        <><section class="mt-6 rounded-xl border border-kumo-line p-5">
          <p class="text-xs uppercase tracking-widest text-kumo-muted">
          Tu curso asignado
        </p>
        <h2 class="mt-2 text-2xl font-semibold">
          {assignment.title}
        </h2>
        <p class="mt-2 text-sm text-kumo-muted">
          {assignment.area_title} · {assignment.level_code}
        </p>
          <div class="mt-5 flex items-center justify-between text-sm">
            <span>Lecciones obligatorias completadas</span>
            <strong>{completedRequired} / {totalRequired} ({percent}%)</strong>
          </div>
          <div class="mt-2 h-3 overflow-hidden rounded-full bg-gray-200">
            <div class="h-full rounded-full bg-brand" style={`width:${percent}%`}>
            </div>
        </div>
    </section>

    <section class="mt-6 rounded-xl border border-kumo-line p-5">
      <h2 class="font-semibold">Detalle por lección</h2>
      <ol class="mt-3 divide-y divide-kumo-line">
          {lessons.map(l=>
            <li class="py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-medium">{l.sequence_no}. {l.title}</p>
                  {l.summary && <p class="mt-1 text-sm text-kumo-muted">{l.summary}</p>}
                  <p class="mt-1 text-xs text-kumo-muted">
                    Estado: {l.progress_status==='completed' ?
                      'Completada':l.progress_status==='in_progress'?
                      'En curso':'Sin iniciar'}
                    {l.score!==null?
                      ` · Calificación ${l.score}`:''}
                      {l.required_to_complete!==1?' · No obligatoria':''}</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      <a class="rounded border border-kumo-line px-3 py-2 text-sm underline" href={`/escuela/cursos/${assignment.slug}/${l.slug}`}>
                        Abrir lección</a>
                      {l.progress_status!=='completed' && 
                        <form method="POST">
                          <input type="hidden" name="lesson_id" value={l.id}/>
                          <button class="rounded bg-kumo-strong px-3 py-2 text-sm font-semibold text-white" type="submit">
                            Marcar completada</button>
                        </form>}
                    </div>
                </div>
              </li>)}
        </ol>
        
        {lessons.length===0 && 
          <p class="mt-3 text-sm text-kumo-muted">Aún no hay lecciones publicadas.</p>}
        </section>
      </>

      /*Final de la nueva parte de código agregada para mostrar el curso asignado y sus lecciones*/
      


      /*Sección antigua
      <section class="rounded-xl border border-kumo-line p-5">
        <p class="text-xs uppercase tracking-widest text-kumo-muted">
          Tu curso asignado
        </p>
        <h2 class="mt-2 text-2xl font-semibold">
          {assignment.title}
        </h2>
        <p class="mt-2 text-sm text-kumo-muted">
          {assignment.area_title} · {assignment.level_code}
        </p>

        {assignment.summary && <p class="mt-3 text-sm">{assignment.summary}</p>}
        
        <div class="mt-6">
          <h3 class="font-semibold">
            Lecciones
          </h3>
          
          {lessons.length ?
             <ol class="mt-3 divide-y divide-kumo-line">
                {lessons.map(l=>
                  <li class="py-3">
                    <a class="font-medium underline" href={`/escuela/cursos/${assignment.slug}/${l.slug}`}>
                      {l.sequence_no}. {l.title}
                    </a>
                    {l.summary && 
                      <p class="mt-1 text-sm text-kumo-muted">
                        {l.summary}</p>}
                        </li>)}
              </ol> : 
              <p class="mt-3 text-sm text-kumo-muted">
                El curso todavía no tiene lecciones publicadas.</p>}</div>
        </section>*/
    }
    <p class="mt-8 text-sm"><a class="underline" href="/account">Mi cuenta</a></p>
  </main>
</Layout>
