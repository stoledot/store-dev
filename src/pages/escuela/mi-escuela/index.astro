---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { accountsEnabled, getCustomerEmail } from '../../../features/auth/customer';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);
const enrollment = await env.DB.prepare(`SELECT MAX(valid_until) AS valid_until FROM school_fee_payments WHERE student_email=? COLLATE NOCASE AND fee_type='enrollment' AND valid_until>=date('now')`).bind(email).first<{valid_until:string|null}>();
const monthly = await env.DB.prepare(`SELECT MAX(valid_until) AS valid_until FROM school_fee_payments WHERE student_email=? COLLATE NOCASE AND fee_type='monthly' AND valid_until>=date('now')`).bind(email).first<{valid_until:string|null}>();
const interests = (await env.DB.prepare(`SELECT i.area_id,i.diagnostic_unlocked,a.title AS area_title,p.title AS program_title,d.status AS diagnostic_status,d.approved_level FROM school_student_interests i JOIN school_areas a ON a.id=i.area_id JOIN school_programs p ON p.slug=a.program_slug LEFT JOIN school_area_diagnostics d ON d.student_email=i.student_email COLLATE NOCASE AND d.area_id=i.area_id AND d.attempt_no=(SELECT MAX(d2.attempt_no) FROM school_area_diagnostics d2 WHERE d2.student_email=i.student_email COLLATE NOCASE AND d2.area_id=i.area_id) WHERE i.student_email=? COLLATE NOCASE AND i.selected=1 ORDER BY p.title,a.title`).bind(email).all<{area_id:string;diagnostic_unlocked:number;area_title:string;program_title:string;diagnostic_status:string|null;approved_level:string|null}>()).results ?? [];
const courseRows = (await env.DB.prepare(`SELECT c.id,c.slug,c.title,c.summary,c.level_code,c.area_id,c.omitted_activities_allowed,a.title AS area_title,p.title AS program_title FROM school_courses c LEFT JOIN school_areas a ON a.id=c.area_id LEFT JOIN school_programs p ON p.slug=a.program_slug WHERE c.status='published' AND c.content_kind IN ('course','reading') AND (EXISTS(SELECT 1 FROM school_course_assignments x WHERE x.course_id=c.id AND x.student_email=? COLLATE NOCASE AND x.status='active' AND EXISTS(SELECT 1 FROM school_area_diagnostics d WHERE d.student_email=x.student_email COLLATE NOCASE AND d.area_id=c.area_id AND d.status='approved' AND d.approved_level=c.level_code AND d.attempt_no=(SELECT MAX(d2.attempt_no) FROM school_area_diagnostics d2 WHERE d2.student_email=d.student_email COLLATE NOCASE AND d2.area_id=d.area_id)) AND EXISTS(SELECT 1 FROM school_fee_payments f WHERE f.student_email=x.student_email COLLATE NOCASE AND f.fee_type='enrollment' AND f.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments f WHERE f.student_email=x.student_email COLLATE NOCASE AND f.fee_type='monthly' AND f.valid_until>=date('now'))) OR EXISTS(SELECT 1 FROM order_items oi JOIN orders o ON o.id=oi.order_id WHERE oi.school_course_id=c.id AND lower(trim(o.email))=lower(trim(?)) AND o.status='paid' AND COALESCE(o.refunded_cents,0)<o.amount_total_cents)) ORDER BY p.title,a.title,c.title`).bind(email,email).all<{id:string;slug:string;title:string;summary:string;level_code:string;area_id:string|null;omitted_activities_allowed:number;area_title:string|null;program_title:string|null}>()).results ?? [];
const courses = await Promise.all(courseRows.map(async (course) => {
  const lessons = (await env.DB.prepare(`SELECT l.slug,l.title,l.sequence_no,l.required_to_complete,l.lesson_type,COALESCE(lp.status,'not_started') AS progress_status FROM school_lessons l LEFT JOIN school_lesson_progress lp ON lp.lesson_id=l.id AND lp.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' ORDER BY l.sequence_no`).bind(email,course.id).all<{slug:string;title:string;sequence_no:number;required_to_complete:number;lesson_type:string;progress_status:string}>()).results ?? [];
  const required = lessons.filter((lesson)=>lesson.required_to_complete===1);
  const completed = required.filter((lesson)=>lesson.progress_status==='completed').length;
  const activities = required.filter((lesson)=>lesson.lesson_type!=='reading').length;
  const denominator = Math.max(0,required.length-Math.min(course.omitted_activities_allowed,activities));
  const percent = denominator===0?100:Math.min(100,Math.round(completed/denominator*100));
  return {...course,lessons,completed,required:required.length,percent,next:lessons.find((lesson)=>lesson.progress_status!=='completed')??lessons.at(-1)??null};
}));
// Every returned course already passed either the paid-order rule or the active-assignment rule.
const canStudy = true;
---
<Layout title="Mi escuela" description="Tus áreas y cursos en un solo lugar.">
  <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
    <header class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-kumo-muted">Tu espacio de aprendizaje</p><h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">Mi escuela</h1><p class="mt-2 text-sm text-kumo-muted">Tus intereses, diagnósticos y cursos, juntos y fáciles de consultar.</p></div><a href="/escuela/diagnostico" class="rounded-xl bg-kumo-inverted px-4 py-2.5 text-sm font-semibold text-kumo-base">Áreas y diagnósticos</a></header>
    <div class="mt-5 grid gap-3 sm:grid-cols-2"><div class="rounded-xl border border-kumo-line bg-white p-4"><p class="text-xs font-semibold uppercase tracking-wide text-kumo-muted">Inscripción</p><p class="mt-1 text-sm font-semibold">{enrollment?.valid_until?`Vigente hasta ${enrollment.valid_until}`:'Sin vigencia activa'}</p></div><div class="rounded-xl border border-kumo-line bg-white p-4"><p class="text-xs font-semibold uppercase tracking-wide text-kumo-muted">Mensualidad</p><p class="mt-1 text-sm font-semibold">{monthly?.valid_until?`Vigente hasta ${monthly.valid_until}`:'Sin vigencia activa'}</p></div></div>
    <section class="mt-6"><div class="mb-3 flex items-center justify-between"><h2 class="text-lg font-semibold">Mis áreas</h2><a class="text-sm underline" href="/escuela/diagnostico">Administrar</a></div>{interests.length?<div class="flex flex-wrap gap-2">{interests.map((interest)=><span class="rounded-full border border-kumo-line bg-white px-3 py-1.5 text-sm"><span class="text-xs text-kumo-muted">{interest.program_title} · </span>{interest.area_title}<span class="ml-2 text-xs">{interest.diagnostic_status==='approved'?`Aprobado ${interest.approved_level??''}`:interest.diagnostic_status==='pending'?'En revisión':interest.diagnostic_status==='rejected'?'Requiere atención':'Sin diagnóstico'}</span></span>)}</div>:<p class="rounded-xl border border-kumo-line bg-white p-4 text-sm text-kumo-muted">Aún no elegiste áreas. Puedes escoger varias y enviar un diagnóstico para cada una.</p>}</section>
    <section class="mt-7"><div class="mb-3 flex items-end justify-between"><div><h2 class="text-lg font-semibold">Mis cursos</h2><p class="text-xs text-kumo-muted">Cursos asignados y comprados</p></div><a href="/account/courses" class="text-sm underline">Vista completa</a></div>{!canStudy&&courses.length===0?<p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">Tu acceso académico requiere inscripción y mensualidad vigentes. Si ya pagaste, solicita a administración que confirme el pago.</p>:courses.length===0?<p class="rounded-xl border border-kumo-line bg-white p-4 text-sm text-kumo-muted">Aún no tienes cursos asignados o comprados.</p>:<div class="space-y-3">{courses.map((course)=><article class="rounded-2xl border border-kumo-line bg-white p-4 sm:p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><p class="text-xs text-kumo-muted">{course.program_title??'Escuela'}{course.area_title?` · ${course.area_title}`:''} · Nivel {course.level_code}</p><h3 class="mt-1 text-lg font-semibold">{course.title}</h3>{course.summary&&<p class="mt-1 text-sm text-kumo-muted">{course.summary}</p>}</div><span class="rounded-full bg-kumo-subtle px-3 py-1 text-xs font-semibold">{course.percent===100?'Completado':course.percent?'En curso':'Por comenzar'}</span></div><div class="mt-3 flex flex-wrap items-center gap-3"><span class="text-xs text-kumo-muted">{course.completed}/{course.required} obligatorias · {course.percent}% · {course.omitted_activities_allowed} omisiones permitidas</span>{canStudy&&course.next&&<a class="ml-auto rounded-lg bg-kumo-inverted px-3 py-2 text-sm font-semibold text-kumo-base" href={`/escuela/cursos/${course.slug}/${course.next.slug}`}>{course.percent===100?'Repasar':'Continuar'} →</a>}</div><details class="mt-3 border-t border-kumo-line pt-3"><summary class="cursor-pointer text-sm font-medium">Ver unidades ({course.lessons.length})</summary><ol class="mt-2 space-y-1">{course.lessons.map((lesson)=><li><a class="flex items-center justify-between rounded-lg px-2 py-2 text-sm hover:bg-kumo-subtle" href={canStudy?`/escuela/cursos/${course.slug}/${lesson.slug}`:'#'}><span>{lesson.sequence_no}. {lesson.title}</span><span class="text-xs text-kumo-muted">{lesson.progress_status==='completed'?'✓ Completada':lesson.progress_status==='in_progress'?'En curso':'Pendiente'}</span></a></li>)}</ol></details></article>)}</div>}</section>
    <footer class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-t border-kumo-line pt-4 text-sm"><a class="underline" href="/account/payments">Pagos</a><a class="underline" href="/escuela/mi-escuela/calificaciones">Calificaciones</a><a class="underline" href="/account/messages">Contactar administración</a></footer>
  </main>
</Layout>
