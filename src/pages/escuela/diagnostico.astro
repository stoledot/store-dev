---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login?next=%2Fescuela%2Fdiagnostico', 303);
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  try {
    if (action === 'save-interests') {
      const selected = [...new Set(form.getAll('area_id').map((v) => String(v).trim()).filter(Boolean))];
      if (!selected.length) throw new Error('Selecciona al menos un área de interés.');
      const placeholders = selected.map(() => '?').join(',');
      const valid = await env.DB.prepare(`SELECT COUNT(*) AS n FROM school_areas WHERE status='active' AND id IN (${placeholders})`).bind(...selected).first<{n:number}>();
      if (Number(valid?.n ?? 0) !== selected.length) throw new Error('Una de las áreas seleccionadas ya no está disponible.');
      await env.DB.prepare(`UPDATE school_student_interests SET selected=0,updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE student_email=? COLLATE NOCASE`).bind(email).run();
      await env.DB.batch(selected.map((areaId) => env.DB.prepare(`INSERT INTO school_student_interests (student_email,area_id,selected,diagnostic_unlocked) VALUES (?,?,1,1) ON CONFLICT(student_email,area_id) DO UPDATE SET selected=1,updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now')`).bind(email,areaId)));
      return Astro.redirect('/escuela/diagnostico?ok=areas', 303);
    }
    if (action === 'submit-diagnostic') {
      const areaId = String(form.get('area_id') ?? '').trim();
      const answers = String(form.get('diagnostic_answers') ?? '').trim().slice(0, 12000);
      if (answers.length < 30) throw new Error('Responde con al menos 30 caracteres.');
      const interest = await env.DB.prepare(`SELECT diagnostic_unlocked FROM school_student_interests WHERE student_email=? COLLATE NOCASE AND area_id=? AND selected=1`).bind(email,areaId).first<{diagnostic_unlocked:number}>();
      if (!interest) throw new Error('Guarda primero esta área en tu lista de intereses.');
      if (interest.diagnostic_unlocked !== 1) throw new Error('Este diagnóstico ya fue enviado. Solicita a la administración que habilite un nuevo envío.');
      const attempt = await env.DB.prepare(`SELECT COALESCE(MAX(attempt_no),0)+1 AS n FROM school_area_diagnostics WHERE student_email=? COLLATE NOCASE AND area_id=?`).bind(email,areaId).first<{n:number}>();
      const now = new Date().toISOString();
      await env.DB.batch([
        env.DB.prepare(`INSERT INTO school_area_diagnostics (id,student_email,area_id,attempt_no,diagnostic_answers,status,submitted_at) VALUES (?,?,?,?,?,'pending',?)`).bind(crypto.randomUUID(),email,areaId,Number(attempt?.n ?? 1),answers,now),
        env.DB.prepare(`UPDATE school_student_interests SET diagnostic_unlocked=0,updated_at=? WHERE student_email=? COLLATE NOCASE AND area_id=?`).bind(now,email,areaId),
        env.DB.prepare(`INSERT INTO school_student_intake (student_email,selected_area_id,diagnostic_answers,status,suggested_level,approved_level,admin_notes,submitted_at,reviewed_at) VALUES (?,?,?,'pending',NULL,NULL,'',?,NULL) ON CONFLICT(student_email) DO UPDATE SET selected_area_id=excluded.selected_area_id,diagnostic_answers=excluded.diagnostic_answers,status='pending',suggested_level=NULL,approved_level=NULL,admin_notes='',submitted_at=excluded.submitted_at,reviewed_at=NULL`).bind(email,areaId,answers,now),
      ]);
      return Astro.redirect('/escuela/diagnostico?ok=enviado', 303);
    }
    throw new Error('Acción de diagnóstico no reconocida.');
  } catch (cause) {
    const message = cause instanceof Error ? cause.message : 'No se pudo guardar la solicitud.';
    return Astro.redirect(`/escuela/diagnostico?error=${encodeURIComponent(message.slice(0,220))}`, 303);
  }
}

const areas = (await env.DB.prepare(`SELECT a.id,a.title,a.description,a.program_slug,p.title AS program_title FROM school_areas a LEFT JOIN school_programs p ON p.slug=a.program_slug WHERE a.status='active' AND p.status='active' ORDER BY p.title,a.title`).all<{id:string;title:string;description:string;program_slug:string;program_title:string}>()).results ?? [];
const interests = (await env.DB.prepare(`SELECT i.area_id,i.selected,i.diagnostic_unlocked,a.title AS area_title,a.program_slug,p.title AS program_title,d.id AS diagnostic_id,d.status AS diagnostic_status,d.diagnostic_answers,d.approved_level,d.admin_notes,d.submitted_at,d.attempt_no FROM school_student_interests i JOIN school_areas a ON a.id=i.area_id JOIN school_programs p ON p.slug=a.program_slug LEFT JOIN school_area_diagnostics d ON d.student_email=i.student_email COLLATE NOCASE AND d.area_id=i.area_id AND d.attempt_no=(SELECT MAX(last.attempt_no) FROM school_area_diagnostics last WHERE last.student_email=i.student_email COLLATE NOCASE AND last.area_id=i.area_id) WHERE i.student_email=? COLLATE NOCASE ORDER BY p.title,a.title`).bind(email).all<{area_id:string;selected:number;diagnostic_unlocked:number;area_title:string;program_slug:string;program_title:string;diagnostic_id:string|null;diagnostic_status:string|null;diagnostic_answers:string|null;approved_level:string|null;admin_notes:string|null;submitted_at:string|null;attempt_no:number|null}>()).results ?? [];
const selectedIds = new Set(interests.filter((i)=>i.selected===1).map((i)=>i.area_id));
const programs = [...new Set(areas.map((a)=>a.program_title))];
---
<Layout title="Áreas de interés y diagnósticos" description="Elige varias áreas y envía una evaluación para cada una.">
  <main class="mx-auto w-full max-w-4xl px-4 py-7 sm:px-6 sm:py-9">
    <a href="/escuela/mi-escuela" class="text-sm underline">← Mi escuela</a>
    <header class="mt-4 rounded-2xl border border-kumo-line bg-white p-5 sm:p-7"><p class="text-xs font-semibold uppercase tracking-widest text-kumo-muted">Tu ruta de aprendizaje</p><h1 class="mt-2 text-2xl font-bold sm:text-3xl">Áreas de interés</h1><p class="mt-2 text-sm leading-6 text-kumo-muted">Puedes elegir varias áreas de Matemáticas y Lectura. Envía un diagnóstico distinto para cada área; cuando uno sea aprobado, solo la administración puede habilitar otro envío.</p></header>
    {error && <p class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
    {ok==='areas' && <p class="mt-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-800">Áreas guardadas. Ahora puedes completar un diagnóstico para cada una.</p>}
    {ok==='enviado' && <p class="mt-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-800">Diagnóstico enviado. Ya no se aceptarán nuevos intentos para esta área hasta que la administración lo habilite.</p>}
    <form method="POST" class="mt-5 rounded-2xl border border-kumo-line bg-white p-5"><input type="hidden" name="action" value="save-interests"/><h2 class="text-lg font-semibold">Elige tus áreas</h2><div class="mt-4 grid gap-4 sm:grid-cols-2">{programs.map((program)=>{const group=areas.filter((a)=>a.program_title===program);return <fieldset class="rounded-xl bg-kumo-subtle p-4"><legend class="px-1 text-sm font-semibold">{program}</legend><div class="mt-2 space-y-2">{group.map((a)=><label class="flex items-start gap-3 rounded-lg bg-white p-3 text-sm"><input type="checkbox" name="area_id" value={a.id} checked={selectedIds.has(a.id)} class="mt-0.5"/><span><strong>{a.title}</strong>{a.description&&<span class="mt-0.5 block text-xs text-kumo-muted">{a.description}</span>}</span></label>)}</div></fieldset>})}</div><button class="mt-4 rounded-xl bg-kumo-inverted px-4 py-2.5 text-sm font-semibold text-kumo-base">Guardar mis áreas</button></form>
    <section class="mt-6 space-y-4"><h2 class="text-lg font-semibold">Diagnósticos por área</h2>{interests.filter((i)=>i.selected===1).length===0?<p class="rounded-xl border border-kumo-line bg-white p-5 text-sm text-kumo-muted">Selecciona y guarda tus áreas para comenzar.</p>:interests.filter((i)=>i.selected===1).map((i)=><article class="rounded-2xl border border-kumo-line bg-white p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs uppercase tracking-wide text-kumo-muted">{i.program_title}</p><h3 class="mt-1 text-lg font-semibold">{i.area_title}</h3></div><span class="rounded-full bg-kumo-subtle px-3 py-1 text-xs font-semibold">{i.diagnostic_status==='approved'?`Aprobado · ${i.approved_level??''}`:i.diagnostic_status==='pending'?'En revisión':i.diagnostic_status==='rejected'?'Requiere seguimiento':'Sin diagnóstico'}</span></div>{i.diagnostic_id&&<><p class="mt-3 whitespace-pre-wrap rounded-xl bg-kumo-subtle p-3 text-sm">{i.diagnostic_answers}</p>{i.admin_notes&&<p class="mt-2 text-sm text-kumo-muted">Nota de la escuela: {i.admin_notes}</p>}</>}{i.diagnostic_unlocked===1?<form method="POST" class="mt-4 space-y-3"><input type="hidden" name="action" value="submit-diagnostic"/><input type="hidden" name="area_id" value={i.area_id}/><label class="block text-sm font-medium">{i.attempt_no?'Nuevo diagnóstico':'Diagnóstico inicial'}<textarea name="diagnostic_answers" required minlength="30" maxlength="12000" rows="6" class="mt-2 block w-full rounded-xl border border-kumo-line p-3" placeholder={`Cuéntanos tu experiencia y resuelve ejercicios de ${i.area_title}.`}></textarea></label><button class="rounded-xl bg-kumo-inverted px-4 py-2.5 text-sm font-semibold text-kumo-base">Enviar diagnóstico de {i.area_title}</button></form>:<p class="mt-4 text-sm text-kumo-muted">{i.diagnostic_status==='approved'?'Diagnóstico aprobado. Para volver a enviarlo, pide a la administración que lo habilite.':'Diagnóstico enviado y pendiente de revisión.'}</p>}</article>)}</section>
  </main>
</Layout>
