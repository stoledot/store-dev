
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Escuela de Matemáticas">
  <main class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">
        Escuela de Matemáticas
      </h1>
      <p class="mt-2 text-sm text-kumo-muted">
        Aprende matemáticas puras desde cero, a tu ritmo.
      </p>
    </div>

    <section
      class="max-w-xl rounded-xl border border-kumo-line bg-kumo-base p-6 shadow-sm"
    >
      <span
        class="inline-flex rounded-full bg-kumo-subtle px-3 py-1 text-xs font-medium"
      >
        Formación online
      </span>

      <h2 class="mt-5 text-2xl font-semibold">
        Nivel 0 · Matemáticas puras
      </h2>

      <p class="mt-3 text-sm leading-6 text-kumo-muted">
        Introducción a la lógica proposicional, los axiomas
        fundamentales y las operaciones con conjuntos.
      </p>

      <div class="my-6 border-t border-kumo-line"></div>

      <p class="text-sm text-kumo-muted">Suscripción cada 28 días</p>

      <p class="mt-1 text-3xl font-bold">
        $1,680 <span class="text-sm font-normal">MXN</span>
      </p>

      <p class="mt-2 text-xs text-kumo-muted">
        Acceso al curso durante el periodo pagado.
        Renovación automática sujeta a las condiciones de pago.
      </p>

      <a
        href="/products/suscripcion-escuela-matematicas"
        class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-kumo-inverted px-4 py-3 text-sm font-medium text-kumo-inverted-foreground"
      >
        Suscribirme
      </a>
    </section>
  </main>
</Layout>
