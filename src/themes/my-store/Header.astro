---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * It renders on EVERY page, including cart, checkout, payment, account, and
 * Admin login. A broken header is a broken checkout, so keep the core controls
 * below and change their placement and styling rather than their markup.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

{/* Announcement bar. Deliberately NOT fixed: the header below is sticky, so a
    fixed bar would need the header offset by the bar's height — which varies
    as the message wraps on narrow screens. Static means it's seen on load,
    scrolls away, and costs no vertical space on mobile. */}
{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <div class="mx-auto max-w-6xl px-6 py-2 text-center text-xs tracking-wide">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-2 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </div>
    </div>
  )
}

<header class="sticky top-0 z-20 border-b border-line bg-paper/85 backdrop-blur">
  <div class="mx-auto flex min-w-0 max-w-6xl flex-wrap items-center gap-2 px-3 py-3 sm:flex-nowrap sm:gap-6 sm:px-6 sm:py-5">
    <a href="/" aria-label={model.storeName} class="w-full min-w-0 font-serif text-xl tracking-tight sm:w-auto sm:shrink sm:text-2xl">
      {
        model.logo ? (
          /* Not lazy: the header logo is above the fold on every page. The
             store name stays the alt text, so the header still reads the
             same to a screen reader or when the image fails. */
          <img src={model.logo.src} alt={model.logo.alt} class="h-8 max-w-full object-contain sm:h-10 sm:max-w-48" />
        ) : (
          <span class="block truncate">{model.storeName}</span>
        )
      }
    </a>
    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="ml-auto hidden flex-1 justify-end sm:flex"
    />
    {/* ml-auto pins the whole nav to the right edge of the header row, so it
        stays flush right no matter how few items a merchant has.
        min-w-0 is what lets long labels ellipsize instead of overflowing the
        page: flex items default to min-width:auto, and without it here the
        shrink stops at this level and the row grows past the viewport —
        putting min-w-0 only on the links themselves is not enough. */}
    <nav
      aria-label="Navegación principal"
      class="ml-auto flex w-full min-w-0 flex-wrap items-center justify-end gap-2 text-[0.65rem] uppercase tracking-widest text-muted sm:w-auto sm:shrink-0 sm:gap-6 sm:text-xs"
    >
      <StoreNav links={model.headerLinks} />
      <a href="/donar" class="rounded-full bg-red-600 px-3 py-2 font-bold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">Donar</a>
      {/* Search input is desktop-only; give mobile a link to the search page. */}
      <a href={model.search.action} class="hover:text-brand sm:hidden">Buscar</a>
      <details class="relative"><summary class="cursor-pointer list-none whitespace-nowrap hover:text-brand"><span class="sm:hidden">Social</span><span class="hidden sm:inline">Cuenta social</span></summary><div class="absolute right-0 z-30 mt-3 grid min-w-48 gap-1 rounded-xl border border-line bg-paper p-2 text-xs normal-case tracking-normal shadow-lg"><a class="rounded-lg px-3 py-2 hover:bg-surface" href="/account/social">Tu cuenta social</a><a class="rounded-lg px-3 py-2 hover:bg-surface" href="/account/social?view=groups">Tus grupos</a><a class="rounded-lg px-3 py-2 hover:bg-surface" href="/account/social?view=posts">Tus publicaciones</a><a class="rounded-lg px-3 py-2 hover:bg-surface" href="/account/social?view=saved">Publicaciones guardadas</a><a class="rounded-lg px-3 py-2 hover:bg-surface" href="/account">Cuenta académica</a></div></details>
      {model.cart.enabled && <StoreCartControl href={model.cart.href} />}
      {model.account.enabled && <StoreAccountControl href={model.account.href} />}
    </nav>
  </div>
</header>
