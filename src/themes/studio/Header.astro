---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';

/**
 * Studio — a masthead that gets out of the way.
 *
 * The wordmark is the only large thing; everything else is set in small caps at
 * the right edge so the eye drops straight to the work. Not sticky: a gallery
 * does not follow you around the room, and a fixed bar over a dark full-bleed
 * image reads as a smudge.
 *
 * Renders on checkout, the pay page, and Admin login too, so the controls stay
 * as they are.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
const small =
  'text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-muted)] hover:text-[color:var(--studio-bone)]';
---

{
  model.announcement && (
    <div class="bg-brand px-4 py-2.5 text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--color-paper)]">
      {model.announcement.href ? (
        <a href={model.announcement.href} class="underline-offset-4 hover:underline">
          {model.announcement.text}
        </a>
      ) : (
        model.announcement.text
      )}
    </div>
  )
}

<header class="border-b border-line">
  <div class="mx-auto flex min-w-0 max-w-[96rem] flex-wrap items-center gap-x-4 gap-y-3 px-3 py-3 sm:gap-x-8 sm:px-6 sm:pb-5 sm:pt-6 lg:gap-x-10 lg:px-12 lg:pb-6 lg:pt-8">
    <a href="/" aria-label={model.storeName} class="min-w-0 max-w-[48vw] shrink-0 sm:max-w-none">
      {
        model.logo ? (
          <img src={model.logo.src} alt={model.logo.alt} class="h-7 max-w-32 object-contain sm:h-9 sm:max-w-52" />
        ) : (
          <span class="block truncate font-serif text-xl leading-tight tracking-[-0.02em] sm:text-3xl">{model.storeName}</span>
        )
      }
    </a>

    <nav aria-label="Store" class="ml-auto flex min-w-0 items-center gap-2 sm:gap-4 lg:gap-6">
      <StoreNav
        links={model.headerLinks}
        class={`hidden min-w-0 items-center gap-6 xl:flex ${small}`}
        disclosureClass={`relative order-last xl:hidden ${small}`}
      />
      <a href={model.search.action} class={`${small} whitespace-nowrap sm:hidden`}>Buscar</a>
      {model.account.enabled && <StoreAccountControl href={model.account.href} class={small} />}
      {
        model.cart.enabled && (
          <StoreCartControl
            href={model.cart.href}
            class="inline-flex items-center text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-bone)] hover:text-brand"
          />
        )
      }
    </nav>

    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="order-last hidden w-full min-w-0 border-b border-line pb-1 focus-within:border-brand sm:block sm:w-56 lg:order-none"
      inputClass="w-full bg-transparent px-0 py-0.5 text-sm focus:outline-none"
    />
  </div>
</header>
