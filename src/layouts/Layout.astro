---
import { env } from 'cloudflare:workers';
import { getConfig } from '../config';
import { publicOrigin } from '../features/http/origin';
import { normalizeSearchQuery } from '../features/search/query';
import { EMPTY_MENUS, visibleItems } from '../features/navigation/db';
import { getEmailProvider } from '../features/email';
import { buildShellModel } from '../features/storefront/shell';
import StoreHeader from '#theme/Header.astro';
import StoreFooter from '#theme/Footer.astro';
import '../styles/global.css';
import SchoolQuickNav from './SchoolQuickNav.astro';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute image for social cards (made absolute below). */
  image?: string;
  /** Override the canonical URL. Used where two routes render the same content
   *  — the catalog is at both / and /products — so only one is indexable. */
  canonical?: string;
}

const { title, description, image, canonical: canonicalOverride } = Astro.props;
const config = getConfig();
const { features } = config;
// Runtime override (set by the setup wizard) wins over the build-time default.
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
// Optional header logo. Falls back to the text store name whenever unset, so
// the header can never end up empty.
const logoImageKey = Astro.locals.settings?.logoImageKey ?? null;
// Loaded by middleware alongside settings (one batched D1 read), so navigation
// costs no extra round trip on uncached routes like /cart and /checkout.
// Unavailable targets (draft pages, inactive products, deleted rows) are dropped
// here rather than rendered as dead links — the storefront has no way to explain
// the problem to a shopper, so admin is where it gets surfaced.
const menus = Astro.locals.menus ?? EMPTY_MENUS;
const headerItems = visibleItems(menus.header);
const footerItems = visibleItems(menus.footer);
// Cart can be switched off at runtime → browse-only catalog (hide the cart link).
const cartEnabled = Astro.locals.settings?.cartEnabled ?? true;
// Accounts nav link: the runtime toggle wins over the build-time default.
// The header must use the SAME predicate as /account, or it advertises a link
// that immediately redirects. The route requires the flag, AUTH_SECRET, and a
// configured email provider (accounts are passwordless, so without one there is
// no way to sign in). Judging by the flag alone rendered a dead link whenever a
// store enabled accounts before configuring email.
//
// No extra D1 read: settings are already loaded, and the provider lookup
// short-circuits before touching the vault unless email is actually enabled.
const accountsFlag = Astro.locals.settings?.accountsEnabled ?? features.accounts;
const accountsOn =
  accountsFlag && !!env.AUTH_SECRET && Astro.locals.settings
    ? (await getEmailProvider(Astro.locals.settings)) !== null
    : false;
// Announcement bar: the message is its own on/off switch (empty = hidden). Astro
// escapes both values on render, so admin-entered text can't inject markup.
const announcement = Astro.locals.settings?.announcement ?? '';
const announcementHref = Astro.locals.settings?.announcementHref ?? '';
const pageTitle = title ? `${title} — ${storeName}` : storeName;
const query =
  Astro.url.pathname === '/search'
    ? normalizeSearchQuery(Astro.url.searchParams.get('q') ?? '')
    : '';

const desc = (description ?? `Shop ${storeName}.`).slice(0, 160);
const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, origin).href;
const ogImage = image ? new URL(image, origin).href : undefined;

// The header and footer are store-owned, so they receive a model rather than
// request context. Built from values middleware already loaded — no extra D1
// read, on routes (checkout, pay) least able to afford one.
const shell = buildShellModel({
  storeName,
  logoImageKey,
  imageBaseUrl: config.images.baseUrl,
  announcement,
  announcementHref,
  headerItems,
  footerItems,
  searchQuery: query,
  cartEnabled,
  accountsEnabled: accountsOn,
});
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>window.MathJax={tex:{inlineMath:[['$','$'],['\\(','\\)']],displayMath:[['$$','$$'],['\\[','\\]']],processEscapes:true},options:{skipHtmlTags:['script','noscript','style','textarea','pre','code','math']},startup:{typeset:true}};</script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-chtml.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Declared so Safari stops probing the site root for it. Those probes are
        not free here: /apple-touch-icon*.png is not excluded by the middleware's
        document check, so each 404 ran the settings+menus D1 batch and rendered
        the branded 404 page. The files are also present as static assets, which
        answers the agents that probe regardless without invoking the Worker. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={storeName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Progressive image reveal, site-wide. The marker class is added in <head>,
        before any image markup is parsed, so incomplete images start on their
        neutral frame instead of flashing white. Capture-phase listeners catch
        every [data-image-fade] on the page, including images added later. With
        scripts blocked the class is never added and images stay visible. */}
    <script is:inline>
      document.documentElement.classList.add('image-fade-enabled');
      const finishImageFade = (event) => {
        const image = event.target;
        if (image instanceof HTMLImageElement && image.hasAttribute('data-image-fade')) {
          image.setAttribute('data-image-loaded', '');
        }
      };
      document.addEventListener('load', finishImageFade, true);
      document.addEventListener('error', finishImageFade, true);
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <StoreHeader model={shell} />
    
    <SchoolQuickNav />

    <main class="page-shell">
      <slot />
    </main>

    <StoreFooter model={shell} />

    {/* Slide-out cart drawer. Progressive enhancement: hidden + inert until JS
        opens it; the /cart page and plain form posts are the no-JS baseline. */}
    <div
      data-cart-drawer
      class="invisible pointer-events-none fixed inset-0 z-40"
      role="dialog"
      aria-modal="true"
      aria-label="Carrito de compras"
    >
      <div data-cart-backdrop class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-300"></div>
      <aside
        data-cart-panel
        class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-paper shadow-xl transition-transform duration-300"
      >
        <div class="flex items-center justify-between border-b border-line px-6 py-5">
          <h2 class="font-serif text-2xl tracking-tight">Tu carrito</h2>
          {/* 44px box, not a bare glyph: the hit area was only as big as the
              × itself, which is well under the 44×44 minimum for a touch target
              — and this is the primary way out of a full-height mobile drawer.
              -mr-2 pulls the enlarged box back so the × stays optically aligned
              with the panel's px-6 edge. */}
          <button
            type="button"
            data-cart-close
            aria-label="Cerrar carrito"
            class="-mr-2 flex h-11 w-11 items-center justify-center rounded-md text-3xl leading-none text-faint transition-colors hover:bg-surface hover:text-brand"
          >
            &times;
          </button>
        </div>
        <div data-cart-body class="flex-1 overflow-y-auto px-6 py-5"></div>
      </aside>
    </div>

    <!-- ========================================== -->
    <!-- BARRA DE NAVEGACIÓN INFERIOR (BOTTOM NAV)  -->
    <!-- ========================================== -->
    <nav class="fixed bottom-4 inset-x-4 max-w-md mx-auto z-50">
      <div class="bg-white/85 backdrop-blur-lg border border-slate-200/80 shadow-xl shadow-slate-900/10 rounded-2xl px-2 py-2 flex justify-around items-center">
        
        <!-- Opción 1: Inicio (Estado Activo) -->
        <a href="/feed" class="nav-item group relative flex flex-col items-center justify-center w-16 py-1 text-indigo-600 transition-all duration-200">
          <!-- Indicador superior activo -->
          <span class="active-dot absolute -top-2 w-6 h-1 bg-indigo-600 rounded-full transition-all duration-300"></span>
          
          <svg class="w-6 h-6 mb-1 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="text-[11px] font-semibold tracking-wide">Inicio</span>
        </a>

        <!-- Opción 2: Tienda -->
        <a href="/shop" class="nav-item group relative flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-indigo-600 transition-all duration-200">
          <span class="active-dot hidden absolute -top-2 w-6 h-1 bg-indigo-600 rounded-full transition-all duration-300"></span>
          
          <svg class="w-6 h-6 mb-1 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="text-[11px] font-medium tracking-wide">Tienda</span>
        </a>

        <!-- Opción 3: Grupos -->
        <a href="/grupos" class="nav-item group relative flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-indigo-600 transition-all duration-200">
          <span class="active-dot hidden absolute -top-2 w-6 h-1 bg-indigo-600 rounded-full transition-all duration-300"></span>
          
          <svg class="w-6 h-6 mb-1 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span class="text-[11px] font-medium tracking-wide">Grupos</span>
        </a>

        <!-- Opción: Escuela -->
        <a href="/escuela/mi-escuela" class="nav-item group relative flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-indigo-600 transition-all duration-200">
          <span class="active-dot hidden absolute -top-2 w-6 h-1 bg-indigo-600 rounded-full transition-all duration-300"></span>
          
          <svg class="w-6 h-6 mb-1 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" />
          </svg>
          <span class="text-[11px] font-medium tracking-wide">Escuela</span>
        </a>


        <!-- Opción 4: Cuenta -->
        <a href="/account" class="nav-item group relative flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-indigo-600 transition-all duration-200">
          <span class="active-dot hidden absolute -top-2 w-6 h-1 bg-indigo-600 rounded-full transition-all duration-300"></span>
          
          <svg class="w-6 h-6 mb-1 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-[11px] font-medium tracking-wide">Cuenta</span>
        </a>

      </div>
    </nav>

    <!-- Script opcional para cambiar el estado activo al hacer clic -->
    <script>
      const navItems = document.querySelectorAll('.nav-item');

      navItems.forEach(item => {
        item.addEventListener('click', function() {
          // Resetear todos los elementos
          navItems.forEach(nav => {
            nav.classList.remove('text-indigo-600');
            nav.classList.add('text-slate-400');
            nav.querySelector('.active-dot')?.classList.add('hidden');
            nav.querySelector('span:last-child')?.classList.replace('font-semibold', 'font-medium');
          });

          // Activar el elemento seleccionado
          item.classList.remove('text-slate-400');
          item.classList.add('text-indigo-600');
          item.querySelector('.active-dot')?.classList.remove('hidden');
          item.querySelector('span:last-child')?.classList.replace('font-medium', 'font-semibold');
        });
      });
    </script>

    <script>
      // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
      const drawer = document.querySelector('[data-cart-drawer]');
      if (drawer instanceof HTMLElement) {
        const panel = drawer.querySelector('[data-cart-panel]');
        const backdrop = drawer.querySelector('[data-cart-backdrop]');
        const body = drawer.querySelector('[data-cart-body]');
        const label = document.querySelector('[data-cart-count-label]');
        const cartCountKey = 'minshop_cart_count';

        const renderBadge = (n) => {
          const count = Math.max(0, Number(n) || 0);
          if (label) label.textContent = count > 0 ? ` (${count > 99 ? '99+' : count})` : '';
          return count;
        };
        // The count lives in a script-readable cookie written beside the (httpOnly)
        // cart, so the badge needs no request on page load and can't drift from the
        // real cart the way a separate localStorage copy would.
        const countFromCookie = () => {
          const m = document.cookie.match(/(?:^|;\s*)cart_n=(\d+)/);
          return m ? Number(m[1]) : 0;
        };
        const setBadge = (n) => {
          const count = renderBadge(n);
          // localStorage is not the source of truth here — writing it only fires the
          // `storage` event, which is how OTHER open tabs learn to re-read the cookie.
          try {
            localStorage.setItem(cartCountKey, String(count));
          } catch {
            // Storage can be unavailable in restricted browsing modes.
          }
        };
        if (label) {
          renderBadge(countFromCookie());
          window.addEventListener('storage', (event) => {
            // Another tab changed the cart; the cookie is already shared, so re-read it.
            if (event.key === cartCountKey) renderBadge(countFromCookie());
          });
          // Returning via bfcache (back button) can restore stale markup — re-read.
          window.addEventListener('pageshow', () => renderBadge(countFromCookie()));
        }
        const open = () => {
          // The nav disclosure is pure CSS and knows nothing about the cart, so
          // without this both panels sit open at once on a narrow viewport.
          document.querySelector('[data-nav-disclosure]')?.removeAttribute('open');
          drawer.classList.remove('invisible', 'pointer-events-none');
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              panel?.classList.remove('translate-x-full');
              backdrop?.classList.remove('opacity-0');
            }),
          );
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          panel?.classList.add('translate-x-full');
          backdrop?.classList.add('opacity-0');
          document.body.style.overflow = '';
          setTimeout(() => drawer.classList.add('invisible', 'pointer-events-none'), 300);
        };
        const refresh = async () => {
          const html = await fetch('/partials/cart', { headers: { 'X-Partial': '1' } }).then((r) =>
            r.text(),
          );
          if (body) body.innerHTML = html;
          const root = body?.querySelector('[data-cart-count]');
          setBadge(root ? Number(root.getAttribute('data-cart-count')) : 0);
        };

        // Open from the header cart link (anchor stays a real link with no JS).
        for (const el of document.querySelectorAll('[data-cart-open]')) {
          el.addEventListener('click', async (e) => {
            e.preventDefault();
            await refresh();
            open();
          });
        }
        drawer.querySelector('[data-cart-close]')?.addEventListener('click', close);
        backdrop?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer.classList.contains('invisible')) close();
        });

        // Intercept add/update/remove posts everywhere EXCEPT the full /cart page,
        // which keeps its own server-rendered flow.
        document.addEventListener('submit', async (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement)) return;
          if ((form.getAttribute('action') || '') !== '/api/cart') return;
          // Opt-out: "Buy now" adds to cart then navigates to the full /cart page —
          // let it do the native post + redirect, no drawer. The flag can sit on the
          // form (separate buy-now form) or on the clicked button (shared options form).
          if (form.hasAttribute('data-fullpage')) return;
          if (e.submitter instanceof HTMLElement && e.submitter.hasAttribute('data-fullpage'))
            return;
          if (location.pathname === '/cart') return;
          e.preventDefault();
          await fetch('/api/cart', {
            method: 'POST',
            headers: { 'X-Partial': '1' },
            body: new URLSearchParams(new FormData(form)),
          });
          await refresh();
          open();
        });
      }
    </script>
    <script type="module" src="/js/latex-renderer.js?v=5"></script>
  </body>
</html>
