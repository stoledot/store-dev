<!-- Script opcional para cambiar el estado activo al hacer clic -->
<script>
    const navItems = document.querySelectorAll('.nav-item');
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

    navItems.forEach((item) => {
    const link = item.getAttribute('href');
    if (!link) return;

    const linkPath = link.replace(/\/$/, '') || '/';

    // Comparación de ruta exacta
    const isActive = currentPath === linkPath;

    item.classList.toggle('text-indigo-600', isActive);
    item.classList.toggle('text-slate-400', !isActive);

    const dot = item.querySelector('.active-dot');
    dot?.classList.toggle('hidden', !isActive);

    const label = item.querySelector('span:last-child');
    label?.classList.toggle('font-semibold', isActive);
    label?.classList.toggle('font-medium', !isActive);

    if (isActive) {
        item.setAttribute('aria-current', 'page');
    } else {
        item.removeAttribute('aria-current');
    }
    });
</script>

