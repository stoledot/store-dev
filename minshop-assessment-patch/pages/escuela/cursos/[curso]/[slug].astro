---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail } from '../../../../features/auth/customer';
import { renderMarkdown } from '../../../../features/pages/markdown';
if (!(await accountsEnabled())) return Astro.redirect('/',303);
const email=await getCustomerEmail(Astro.cookies); if(!email) return Astro.redirect('/account/login',303);
const courseSlug=Astro.params.curso??''; const lessonSlug=Astro.params.slug??'';
const access=await env.DB.prepare(`SELECT c.id AS course_id,c.title AS course_title,c.slug AS course_slug,c.level_code,a.title AS area_title FROM school_course_assignments x JOIN school_courses c ON c.id=x.course_id JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE AND i.status='approved' AND i.selected_area_id=c.area_id AND i.approved_level=c.level_code LEFT JOIN school_areas a ON a.id=c.area_id WHERE x.student_email=? COLLATE NOCASE AND x.status='active' AND c.slug=? AND c.status='published' AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='enrollment' AND p.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='monthly' AND p.valid_until>=date('now')) LIMIT 1`).bind(email,courseSlug).first<{course_id:string;course_title:string;course_slug:string;level_code:string;area_title:string|null}>();
if(!access) return Astro.redirect('/escuela/mi-escuela',303);
const lesson=await env.DB.prepare(`SELECT id,slug,title,summary,content_md,content_html,sequence_no,lesson_type,content_version,assessment_json,grading_weight FROM school_lessons WHERE course_id=? AND slug=? AND status='published' LIMIT 1`).bind(access.course_id,lessonSlug).first<{id:string;slug:string;title:string;summary:string;content_md:string;content_html:string|null;sequence_no:number;lesson_type:'reading'|'quiz'|'exercise'|'assignment';content_version:number;assessment_json:string;grading_weight:number}>();
if(!lesson) return Astro.redirect('/escuela/mi-escuela',303);
const lessonHtml=lesson.content_html||renderMarkdown(lesson.content_md);
let questions:{id:string;type:'multiple_choice'|'short_answer'|'long_answer'|'file_upload';prompt:string;options?:string[];required?:boolean}[]=[];
try { const parsed=JSON.parse(lesson.assessment_json||'{}'); questions=Array.isArray(parsed.questions)?parsed.questions:[]; } catch {}
const nav=(await env.DB.prepare(`SELECT slug,title,sequence_no FROM school_lessons WHERE course_id=? AND status='published' ORDER BY sequence_no`).bind(access.course_id).all<{slug:string;title:string;sequence_no:number}>()).results??[];
const index=nav.findIndex((item)=>item.slug===lessonSlug); const previous=index>0?nav[index-1]:null; const next=index>=0&&index<nav.length-1?nav[index+1]:null;
const progress=await env.DB.prepare(`SELECT status,completed_at,submission_at,grade,feedback,student_response,graded_at FROM school_lesson_progress WHERE student_email=? COLLATE NOCASE AND lesson_id=? LIMIT 1`).bind(email,lesson.id).first<{status:string;completed_at:string|null;submission_at:string|null;grade:number|null;feedback:string;student_response:string;graded_at:string|null}>();
const isReading=lesson.lesson_type==='reading'; const isComplete=progress?.status==='completed'; const apiUrl=`/api/escuela/cursos/${encodeURIComponent(courseSlug)}/${encodeURIComponent(lessonSlug)}`;
---
<Layout title={lesson.title} description={lesson.summary||lesson.title}>
  <main id="school-lesson" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:py-12" data-course={courseSlug} data-slug={lessonSlug} data-api={apiUrl} data-type={lesson.lesson_type}>
    <p class="text-xs uppercase tracking-widest text-kumo-muted"><a href="/escuela/mi-escuela" class="underline">Mi escuela</a> / {access.area_title||'Área de estudio'} / {access.level_code}</p>
    <h1 class="mt-3 text-3xl font-bold">{lesson.title}</h1>{lesson.summary&&<p class="mt-3 text-kumo-muted">{lesson.summary}</p>}
    <div class="mt-5 rounded-lg border border-kumo-line p-4" aria-live="polite"><p id="lesson-status" class="font-medium">{isComplete?(isReading?'Lectura completada':'Entrega registrada'):(isReading?'Lectura en curso':'Actividad pendiente')}</p><p id="lesson-status-detail" class="mt-1 text-sm text-kumo-muted">{isComplete?(isReading?'Esta lectura ya está registrada.':progress?.grade!==null&&progress?.grade!==undefined?`Calificada: ${progress.grade}/100`:'Tu entrega quedó registrada y está pendiente de revisión.'):(isReading?'La lectura se marcará automáticamente al abrirla.':'Completa las preguntas y envía tu actividad para que el administrador pueda revisarla.')}</p></div>
    <article id="lesson-content" class="prose mt-8 max-w-none" set:html={lessonHtml}></article>
    {isReading ? <p class="mt-6 text-sm text-kumo-muted">La lectura se registra automáticamente. Puedes continuar a la siguiente lección cuando termines.</p> : <section class="mt-8 rounded-xl border border-kumo-line p-5"><h2 class="text-xl font-semibold">Tu entrega</h2><p class="mt-1 text-sm text-kumo-muted">Las respuestas serán revisadas por el equipo docente. El envío no implica que la actividad esté aprobada.</p>
      <form id="lesson-submission" class="mt-5 space-y-5" enctype="multipart/form-data">
        {questions.length ? questions.map((q,i)=><fieldset class="rounded-lg border border-kumo-line p-4"><legend class="px-1 font-medium">{i+1}. {q.prompt}{q.required!==false?' *':''}</legend>
          {q.type==='multiple_choice' ? <div class="mt-3 space-y-2">{(q.options??[]).map((option,j)=><label class="flex items-start gap-2 text-sm"><input type="radio" name={`answer_${q.id}`} value={option} required={q.required!==false}/><span>{option}</span></label>)}</div> : q.type==='short_answer' ? <input name={`answer_${q.id}`} maxlength="20000" required={q.required!==false} class="mt-3 block w-full rounded border border-kumo-line p-2" placeholder="Escribe tu respuesta"/> : q.type==='long_answer' ? <textarea name={`answer_${q.id}`} rows="6" maxlength="20000" required={q.required!==false} class="mt-3 block w-full rounded border border-kumo-line p-2" placeholder="Desarrolla tu respuesta"></textarea> : <div class="mt-3"><input type="file" name="submission_file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.docx" required={q.required!==false&&!progress?.submission_at} class="block w-full text-sm"/><p class="mt-1 text-xs text-kumo-muted">PDF, PNG, JPG, WEBP, TXT o DOCX; máximo 10 MB.</p></div>}
        </fieldset>) : <label class="block text-sm">Respuesta<textarea name="answer_general" rows="6" required minlength="5" maxlength="20000" class="mt-2 block w-full rounded border border-kumo-line p-2" placeholder="Escribe aquí tu procedimiento o respuesta"></textarea></label>}
        {questions.length>0&&!questions.some(q=>q.type==='file_upload')&&<div><label class="block text-sm">Archivo adjunto (opcional)<input type="file" name="submission_file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.docx" class="mt-2 block w-full text-sm"/></label><p class="mt-1 text-xs text-kumo-muted">PDF, PNG, JPG, WEBP, TXT o DOCX; máximo 10 MB.</p></div>}
        <button type="submit" class="rounded-lg bg-kumo-inverted px-5 py-3 text-sm font-medium text-kumo-base">Enviar actividad</button><p id="submission-message" class="text-sm" aria-live="polite"></p>
      </form></section>}
    {progress?.grade!==null&&progress?.grade!==undefined&&<section class="mt-6 rounded-xl border border-kumo-line p-5"><h2 class="text-lg font-semibold">Tu calificación: {progress.grade}/100</h2>{progress.graded_at&&<p class="mt-1 text-xs text-kumo-muted">Revisada el {progress.graded_at}</p>}<h3 class="mt-4 font-medium">Retroalimentación</h3><p class="mt-2 whitespace-pre-wrap text-sm">{progress.feedback||'No se agregó retroalimentación.'}</p></section>}
    <nav class="mt-10 flex items-center justify-between gap-4 border-t border-kumo-line pt-5"><div>{previous&&<a class="text-sm underline" href={`/escuela/cursos/${courseSlug}/${previous.slug}`}>← {previous.title}</a>}</div><div>{next&&<a class="text-sm underline" href={`/escuela/cursos/${courseSlug}/${next.slug}`}>{next.title} →</a>}</div></nav>
    <p class="mt-5 text-sm"><a class="underline" href="/escuela/mi-escuela/calificaciones">Ver mis calificaciones</a></p>
  </main>
  <script is:inline>
    const root=document.getElementById('school-lesson');
    if(root?.dataset.type==='reading') fetch(root.dataset.api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'read'})}).then(async(response)=>{if(!response.ok)return;const status=document.getElementById('lesson-status');if(status)status.textContent='Lectura completada';const detail=document.getElementById('lesson-status-detail');if(detail)detail.textContent='Esta lectura quedó registrada automáticamente.';}).catch(()=>{});
    const form=document.getElementById('lesson-submission');
    form?.addEventListener('submit',async(event)=>{event.preventDefault();const message=document.getElementById('submission-message');const button=form.querySelector('button[type="submit"]');if(button)button.disabled=true;if(message)message.textContent='Enviando…';try{const response=await fetch(root.dataset.api,{method:'POST',body:new FormData(form)});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.error||'No se pudo registrar la entrega.');if(message)message.textContent='Entrega registrada. Puedes consultar la calificación y retroalimentación en esta página.';const status=document.getElementById('lesson-status');if(status)status.textContent='Entrega registrada';const detail=document.getElementById('lesson-status-detail');if(detail)detail.textContent='Tu entrega está pendiente de revisión por el administrador.';}catch(error){if(message)message.textContent=error instanceof Error?error.message:'No se pudo registrar la entrega.';}finally{if(button)button.disabled=false;}});
  </script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
</Layout>
