---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { accountsEnabled, getCustomerEmail } from '../../../features/auth/customer';
if(!(await accountsEnabled())) return Astro.redirect('/',303);
const email=await getCustomerEmail(Astro.cookies);if(!email)return Astro.redirect('/account/login',303);
const course=await env.DB.prepare(`SELECT c.id,c.title,c.slug,c.level_code,a.title AS area_title FROM school_course_assignments x JOIN school_courses c ON c.id=x.course_id JOIN school_student_intake i ON i.student_email=x.student_email COLLATE NOCASE AND i.status='approved' AND i.selected_area_id=c.area_id AND i.approved_level=c.level_code LEFT JOIN school_areas a ON a.id=c.area_id WHERE x.student_email=? COLLATE NOCASE AND x.status='active' AND c.status='published' AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='enrollment' AND p.valid_until>=date('now')) AND EXISTS(SELECT 1 FROM school_fee_payments p WHERE p.student_email=x.student_email COLLATE NOCASE AND p.fee_type='monthly' AND p.valid_until>=date('now')) LIMIT 1`).bind(email).first<{id:string;title:string;slug:string;level_code:string;area_title:string|null}>();
if(!course)return Astro.redirect('/escuela/mi-escuela',303);
const summary=await env.DB.prepare(`SELECT COUNT(*) AS graded_count,CASE WHEN SUM(CASE WHEN p.grade IS NOT NULL AND p.submission_at IS NOT NULL THEN l.grading_weight ELSE 0 END)>0 THEN ROUND(SUM(CASE WHEN p.grade IS NOT NULL AND p.submission_at IS NOT NULL THEN p.grade*l.grading_weight ELSE 0 END)/SUM(CASE WHEN p.grade IS NOT NULL AND p.submission_at IS NOT NULL THEN l.grading_weight ELSE 0 END),2) ELSE NULL END AS weighted_average FROM school_lessons l LEFT JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published'`).bind(email,course.id).first<{graded_count:number;weighted_average:number|null}>();
const grades=(await env.DB.prepare(`SELECT l.title,l.slug,l.sequence_no,l.grading_weight,p.status,p.submission_at,p.grade,p.feedback,p.graded_at FROM school_lessons l JOIN school_lesson_progress p ON p.lesson_id=l.id AND p.student_email=? COLLATE NOCASE WHERE l.course_id=? AND l.status='published' AND p.submission_at IS NOT NULL ORDER BY l.sequence_no`).bind(email,course.id).all<{title:string;slug:string;sequence_no:number;grading_weight:number;status:string;submission_at:string|null;grade:number|null;feedback:string;graded_at:string|null}>()).results??[];
const percent=(summary?.weighted_average??null);
---
<Layout title="Mis calificaciones" description="Calificaciones y retroalimentación de tus actividades.">
  <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6"><p class="text-xs uppercase tracking-widest text-kumo-muted"><a href="/escuela/mi-escuela" class="underline">Mi escuela</a> / Calificaciones</p><h1 class="mt-3 text-3xl font-bold">Mis calificaciones</h1><p class="mt-2 text-sm text-kumo-muted">{course.area_title||'Área de estudio'} · {course.title} · {course.level_code}</p>
    <section class="mt-6 rounded-xl border border-kumo-line p-5"><p class="text-sm text-kumo-muted">Promedio ponderado de actividades calificadas</p><p class="mt-2 text-4xl font-semibold">{percent===null?'—':`${percent}/100`}</p><p class="mt-2 text-xs text-kumo-muted">Se calcula como suma de (calificación × peso) dividida entre la suma de los pesos de las lecciones calificadas. Las entregas pendientes no entran al promedio. Peso 1 = normal; mayor que 1 = mayor importancia; menor que 1 = menor importancia.</p></section>
    <section class="mt-8 space-y-4">{grades.length?grades.map((g)=><article class="rounded-xl border border-kumo-line p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><h2 class="font-semibold"><a class="underline" href={`/escuela/cursos/${course.slug}/${g.slug}`}>{g.sequence_no}. {g.title}</a></h2><p class="mt-1 text-xs text-kumo-muted">Peso: {g.grading_weight} · Entrega: {g.submission_at}</p></div><p class="text-lg font-semibold">{g.grade===null?'Pendiente':`${g.grade}/100`}</p></div>{g.grade!==null&&<div class="mt-4 rounded-lg bg-kumo-subtle p-4"><h3 class="text-sm font-semibold">Retroalimentación</h3><p class="mt-2 whitespace-pre-wrap text-sm">{g.feedback||'Tu profesor no agregó comentarios.'}</p>{g.graded_at&&<p class="mt-2 text-xs text-kumo-muted">Revisada: {g.graded_at}</p>}</div>}</article>):<p class="rounded-xl border border-kumo-line p-5 text-sm">Todavía no has enviado actividades calificables. Cuando entregues una actividad, aparecerá aquí.</p>}</section>
  </main>
</Layout>
